   "source": [
    "import csv, json, re, urllib.request as ureq # Modul standar I/O, JSON, regex, dan HTTP request\n",
    "from collections import Counter # Struktur penghitung frekuensi kategori\n",
    "from datetime import date, datetime # Utilitas tanggal ekstraksi dan validasi kalender\n",
    "from pathlib import Path # Manajemen path direktori lintas platform\n",
    "import numpy as np, pandas as pd, pyarrow as pa, pyarrow.parquet as pq # Library komputasi array, dataframe, dan Parquet\n",
    "import matplotlib.pyplot as plt, shapely # Library visualisasi grafik dan komputasi geometri vektor\n",
    "from shapely import contains_xy # Fungsi uji titik-dalam-poligon tervekktorisasi C-engine\n",
    "from shapely.geometry import shape, mapping # Konversi objek GeoJSON ke geometri Shapely\n",
    "from shapely.ops import unary_union # Penggabungan multipoligon daratan\n",
    "\n",
    "IN_FILE, OUT_DIR = r\"C:\\Users\\radit\\Skripsi\\data\\data_FIX.csv\", Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\") # Path input & output\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True); CHUNK, EXT_DATE, REUSE_PQ = 100_000, date.today(), True # Parameter batch & konfigurasi\n",
    "RAW_PQ, META_P = OUT_DIR / \"raw_aves_indonesia.parquet\", OUT_DIR / \"raw_source_meta.json\" # Path Raw Parquet & penanda berkas sumber\n",
    "PUB_P, ID_GJ, OTH_GJ = OUT_DIR / \"publisher_lookup_cache.json\", OUT_DIR / \"indonesia_land_polygon.geojson\", OUT_DIR / \"other_countries_land_polygon.geojson\" # Path cache\n",
    "NE_URL = \"https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_10m_admin_0_countries.geojson\" # URL poligon Natural Earth\n",
    "GBIF_API = \"https://api.gbif.org/v1/organization/{key}\" # Endpoint REST API GBIF untuk resolusi nama publisher\n",
    "\n",
    "TARGET_COLS = [\"gbifID\", \"occurrenceID\", \"datasetKey\", \"basisOfRecord\", \"occurrenceStatus\", \"eventDate\", \"year\", \"month\", \"countryCode\", \"stateProvince\", \"decimalLatitude\", \"decimalLongitude\", \"hasCoordinate\", \"hasGeospatialIssues\", \"scientificName\", \"verbatimScientificName\", \"taxonKey\", \"taxonRank\", \"family\", \"genus\", \"species\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\", \"publisher\"] # 26 atribut target\n",
    "DERIVED_COLS, MAND_9 = [\"hasCoordinate\", \"hasGeospatialIssues\", \"publisher\"], [\"occurrenceID\", \"scientificName\", \"taxonRank\", \"decimalLatitude\", \"decimalLongitude\", \"eventDate\", \"basisOfRecord\", \"publisher\", \"recordedBy\"] # 3 kolom turunan & 9 atribut wajib\n",
    "GEO_FLAGS = [\"ZERO_COORDINATE\", \"COORDINATE_OUT_OF_RANGE\", \"COORDINATE_INVALID\", \"COUNTRY_COORDINATE_MISMATCH\"] # 4 flag isu geospasial GBIF\n",
    "GEO_RX, NA_SET = r\"(?:^|;)(?:\" + \"|\".join(GEO_FLAGS) + r\")(?:;|$)\", {\"\", \"N/A\", \"n/a\", \"NA\", \"na\", \"NULL\", \"null\", \"None\", \"none\", \"-\", \"<NA>\", \"nan\", \"NaN\"} # Regex isu & penanda NULL\n",
    "RE_ISO, RE_YMD = re.compile(r\"^(\\d{4})-(\\d{2})-(\\d{2})$\"), re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})$\") # Regex tanggal ISO ketat & YYYY-M-D\n",
    "RE_T00, RE_TS = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})[T\\s]00:00(?::00(?:\\.0+)?)?(?:Z|[+-]\\d{2}:?\\d{2})?$\"), re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})[T\\s](\\d{2}:\\d{2}.*)$\") # Regex timestamp\n",
    "RE_INTV, RE_PART = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})/(\\d{4})-(\\d{1,2})-(\\d{1,2}).*$\"), re.compile(r\"^\\d{4}(?:-\\d{1,2})?$\") # Regex interval penuh & parsial tahun/bulan\n",
    "RE_PINT, RE_SLSH = re.compile(r\"^\\d{4}(?:-\\d{1,2})?(?:T[^/]+)?/\\d{4}(?:-\\d{1,2})?(?:-\\d{1,2})?(?:T.+)?$\"), re.compile(r\"^(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})$\") # Regex interval parsial & slash\n",
    "\n",
    "if not (ID_GJ.exists() and OTH_GJ.exists()): # Unduh & bangun cache poligon daratan Indonesia serta negara lain jika belum ada\n",
    "    with ureq.urlopen(ureq.Request(NE_URL, headers={\"User-Agent\": \"UB-DataScience-Thesis/1.0\"}), timeout=120) as r: feats = json.loads(r.read().decode(\"utf-8\")).get(\"features\", []) # Unduh GeoJSON\n",
    "    is_id = lambda f: f.get(\"properties\", {}).get(\"ISO_A2\") == \"ID\" or f.get(\"properties\", {}).get(\"ADM0_A3\") == \"IDN\" or f.get(\"properties\", {}).get(\"ADMIN\") == \"Indonesia\" # Filter IDN\n",
    "    if not ID_GJ.exists(): ID_GJ.write_text(json.dumps({\"type\": \"FeatureCollection\", \"features\": [f for f in feats if is_id(f)]}), encoding=\"utf-8\") # Simpan poligon Indonesia\n",
    "    if not OTH_GJ.exists(): OTH_GJ.write_text(json.dumps({\"type\": \"FeatureCollection\", \"features\": [{\"type\": \"Feature\", \"properties\": {}, \"geometry\": mapping(unary_union([shape(f[\"geometry\"]) for f in feats if not is_id(f)]))}]}), encoding=\"utf-8\") # Simpan gabungan negara lain\n",
    "\n",
    "id_poly = unary_union([shape(f[\"geometry\"]) for f in json.loads(ID_GJ.read_text(encoding=\"utf-8\"))[\"features\"]]); shapely.prepare(id_poly) # Siapkan R-tree poligon daratan Indonesia\n",
    "oth_poly = unary_union([shape(f[\"geometry\"]) for f in json.loads(OTH_GJ.read_text(encoding=\"utf-8\"))[\"features\"]]); shapely.prepare(oth_poly) # Siapkan R-tree poligon negara lain\n",
    "is_miss = lambda s: s.isna() | s.astype(\"string\").str.strip().isin(NA_SET).fillna(True) # Fungsi vektorisasi pendeteksi baris bernilai kosong/marker NULL\n",
    "cls_land = lambda la, lo: np.where(contains_xy(id_poly, lo, la), 1, np.where(contains_xy(oth_poly, lo, la), 2, 0)) # 1=Daratan IDN, 2=Negara lain, 0=Laut/Pesisir\n",
    "\n",
    "def infer_dtype(s: pd.Series) -> str: # Inferensi label tipe data awal pada kolom mentah berdasarkan 500 sampel non-NULL pertama\n",
    "    nn = s.dropna() # Buang nilai NaN\n",
    "    if len(nn) == 0: return \"empty (NULL)\" # Jika seluruh isi kolom kosong\n",
    "    smp = nn.head(500).astype(str).str.strip() # Ambil maksimal 500 sampel pertama\n",
    "    if smp.str.upper().isin([\"TRUE\", \"FALSE\"]).all(): return \"boolean (string)\" # Deteksi tipe boolean dalam bentuk teks\n",
    "    num = pd.to_numeric(smp.str.replace(\",\", \".\", regex=False), errors=\"coerce\") # Uji konversi ke numerik\n",
    "    return (\"integer (string)\" if (num % 1 == 0).all() else \"float/decimal (string)\") if num.notna().all() else \"string (teks)\" # Klasifikasi angka vs teks\n",
    "\n",
    "def check_dates(s: pd.Series) -> tuple[pd.Series, pd.Series, Counter]: # Evaluasi cepat eventDate berbasis nilai unik (dictionary mapping)\n",
    "    v_st, v_dt = {}, {} # Kamus pemetaan string unik ke status validitas dan objek date\n",
    "    for raw in s.dropna().unique(): # Iterasi hanya pada nilai string tanggal yang unik (sangat cepat)\n",
    "        st = str(raw).strip() # Bersihkan spasi\n",
    "        if not st or st in NA_SET: v_st[raw], v_dt[raw] = \"INVALID_MISSING\", None; continue # Nilai kosong atau marker N/A\n",
    "        m = RE_ISO.match(st) # Cek kesesuaian dengan format ISO 8601 ketat (YYYY-MM-DD)\n",
    "        if m: # Jika cocok pola YYYY-MM-DD, uji validitas tanggal kalender\n",
    "            try: dt = date(int(m.group(1)), int(m.group(2)), int(m.group(3))); v_st[raw], v_dt[raw] = (\"INVALID_FUTURE_DATE\" if dt > EXT_DATE else \"VALID_ISO_STRICT\"), dt # Cek masa depan\n",
    "            except ValueError: v_st[raw], v_dt[raw] = \"INVALID_UNPARSEABLE\", None # Tanggal kalender tidak valid\n",
    "        elif RE_T00.match(st) or RE_YMD.match(st) or RE_TS.match(st) or RE_INTV.match(st): v_st[raw], v_dt[raw] = \"WARNING_NEEDS_STANDARDIZATION\", None # Format non-baku\n",
    "        elif RE_PART.match(st) or RE_PINT.match(st): v_st[raw], v_dt[raw] = \"WARNING_PARTIAL_OR_INTERVAL\", None # Tanggal parsial (YYYY / YYYY-MM)\n",
    "        elif RE_SLSH.match(st): v_st[raw], v_dt[raw] = \"WARNING_SLASH_FORMAT\", None # Format garis miring (DD/MM/YYYY)\n",
    "        else: v_st[raw], v_dt[raw] = \"INVALID_UNPARSEABLE\", None # Format rusak tidak dikenali\n",
    "    st_s = s.map(v_st).fillna(\"INVALID_MISSING\").astype(\"string\") # Petakan hasil klasifikasi kembali ke seluruh baris Series\n",
    "    return st_s, s.map(v_dt), Counter(st_s.value_counts().to_dict()) # Kembalikan Series status, Series date, dan Counter frekuensi\n",
    "\n",
    "pub_cache = json.loads(PUB_P.read_text(encoding=\"utf-8\")) if PUB_P.exists() else {}; pub_failed = set() # Muat cache nama publisher GBIF\n",
    "\n",
    "def add_derived(df: pd.DataFrame) -> pd.DataFrame: # Pembentukan 3 atribut turunan (hasCoordinate, hasGeospatialIssues, publisher)\n",
    "    if \"hasCoordinate\" not in df.columns: df[\"hasCoordinate\"] = np.where((~is_miss(df[\"decimalLatitude\"])) & (~is_miss(df[\"decimalLongitude\"])), \"true\", \"false\") # Cek koordinat\n",
    "    if \"hasGeospatialIssues\" not in df.columns: df[\"hasGeospatialIssues\"] = np.where(df[\"issue\"].astype(\"string\").fillna(\"\").str.contains(GEO_RX, regex=True), \"true\", \"false\") # Cek flag isu\n",
    "    if \"publisher\" not in df.columns: # Resolusi publishingOrgKey ke nama instansi publisher menggunakan cache & GBIF API\n",
    "        keys = df[\"publishingOrgKey\"].astype(\"string\").str.strip(); k_map = {} # Ambil seri kunci organisasi penerbit\n",
    "        for k in keys.dropna().unique(): # Iterasi hanya pada UUID organisasi yang unik\n",
    "            if k not in pub_cache: # Jika UUID belum ada di cache lokal, ambil dari REST API GBIF\n",
    "                try:\n",
    "                    with ureq.urlopen(ureq.Request(GBIF_API.format(key=k), headers={\"User-Agent\": \"UB-DataScience-Thesis/1.0\"}), timeout=30) as r:\n",
    "                        t = json.loads(r.read().decode(\"utf-8\")).get(\"title\") # Ekstrak nama organisasi\n",
    "                    if t and t.strip(): pub_cache[k] = t.strip() # Simpan ke kamus cache jika berhasil\n",
    "                    else: pub_failed.add(k) # Catat ke daftar gagal jika kosong\n",
    "                except Exception: pub_failed.add(k) # Catat jika koneksi timeout/error\n",
    "            k_map[k] = pub_cache.get(k, k) # Gunakan nama publisher atau fallback ke UUID\n",
    "        df[\"publisher\"] = keys.map(k_map).astype(\"string\") # Petakan nama publisher ke seluruh baris chunk\n",
    "    return df # Kembalikan DataFrame dengan 53 kolom lengkap\n",
    "\n",
    "in_p = Path(IN_FILE); src_sig = {\"file\": in_p.name, \"size_bytes\": in_p.stat().st_size} if in_p.exists() else None # Sidik jari berkas CSV\n",
    "use_pq = REUSE_PQ and RAW_PQ.exists() and META_P.exists() and ((src_sig is None) or (json.loads(META_P.read_text(encoding=\"utf-8\")) == src_sig)) # Cek kelayakan pakai ulang Parquet\n",
    "if in_p.exists() and not use_pq: # Hitung baris fisik berkas CSV hanya bila perlu membaca ulang dari CSV mentah\n",
    "    with open(in_p, \"rb\") as f_raw: phys_rows = max(0, sum(1 for _ in f_raw) - 1) # Total baris fisik dikurangi 1 baris header\n",
    "else: phys_rows = None # Jika menggunakan Raw Parquet yang sudah valid, lewati pembacaan fisik CSV berukuran ratusan MB\n",
    "\n",
    "n_rows = inc_mand = dup_ex = dup_occ = dup_cat = dup_uni = inv_sp = inv_vmt = inc_ym = 0 # Inisialisasi seluruh akumulator metrik kualitas\n",
    "all_cols, col_dtypes, nan_cnt, cust_miss = [], {}, None, None # Penampung daftar kolom, tipe data, dan jumlah missing\n",
    "seen_ex, seen_occ, seen_cat, coord_cache, dt_cnt = set(), set(), set(), {}, Counter() # Himpunan hash keunikan & cache koordinat unik (lat, lon)\n",
    "sp_break = Counter({k: 0 for k in [\"VALID_INDONESIA_LAND_POLYGON\", \"INVALID_OTHER_COUNTRY_LAND\", \"WARNING_OR_INVALID_SEA_AREA\", \"INVALID_OUTSIDE_INDONESIA_BBOX\", \"INVALID_MISSING_COORD\", \"INVALID_ZERO_COORD\", \"INVALID_GEOSPATIAL_ISSUE_FLAG\"]}) # Rincian spasial\n",
    "\n",
    "if use_pq: # Jalur cepat (~1 menit): baca langsung dari berkas Raw Parquet yang sudah ada\n",
    "    print(f\"Menggunakan Raw Parquet: {RAW_PQ}\"); ch_iter = (b.to_pandas() for b in pq.ParquetFile(RAW_PQ).iter_batches(batch_size=CHUNK)); pq_w = None\n",
    "else: # Jalur konversi awal: baca bertahap dari CSV mentah dan tulis ke Raw Parquet\n",
    "    print(f\"Membaca CSV {in_p} -> {RAW_PQ}...\"); RAW_PQ.unlink(missing_ok=True); pq_w = pq_sch = None\n",
    "    ch_iter = pd.read_csv(in_p, sep=\"\\t\", chunksize=CHUNK, quoting=csv.QUOTE_NONE, dtype=str, low_memory=False, on_bad_lines=\"warn\")\n",
    "\n",
    "for idx, ch in enumerate(ch_iter, start=1): # Iterasi pemrosesan per chunk 100.000 baris\n",
    "    n_rows += len(ch); ch = add_derived(ch) # Tambahkan jumlah record & pastikan 3 kolom turunan tersedia\n",
    "    if idx == 1: # Inisialisasi struktur profil pada chunk pertama\n",
    "        all_cols = list(ch.columns); col_dtypes = {c: infer_dtype(ch[c]) for c in all_cols} # Deteksi tipe data awal 53 kolom\n",
    "        nan_cnt, cust_miss = pd.Series(0, index=all_cols, dtype=\"int64\"), pd.Series(0, index=all_cols, dtype=\"int64\") # Series counter NaN & missing\n",
    "        if not use_pq: pq_sch = pa.schema([(c, pa.string()) for c in all_cols]); pq_w = pq.ParquetWriter(RAW_PQ, pq_sch, compression=\"snappy\") # Writer Parquet\n",
    "    for c in TARGET_COLS: # Perbarui label tipe data jika pada chunk pertama kebetulan seluruh sampel masih NULL\n",
    "        if c in ch.columns and col_dtypes.get(c) == \"empty (NULL)\" and ch[c].notna().any(): col_dtypes[c] = infer_dtype(ch[c])\n",
    "    nan_cnt += ch.isna().sum(); miss_map = {c: is_miss(ch[c]) for c in TARGET_COLS if c in ch.columns} # Hitung NaN & cache masker missing 26 kolom\n",
    "    for c, m_s in miss_map.items(): cust_miss[c] += int(m_s.sum()) # Akumulasi jumlah missing (termasuk marker string) pada 26 kolom target\n",
    "    oth_c = [c for c in all_cols if c not in TARGET_COLS]; cust_miss[oth_c] += ch[oth_c].isna().sum() # Akumulasi NaN pada kolom non-target\n",
    "    inc_mand += int(pd.concat([miss_map[c] for c in MAND_9 if c in miss_map], axis=1).any(axis=1).sum()) # A. Kelengkapan (L): baris tidak lengkap pada 9 atribut wajib\n",
    "\n",
    "    is_dup = np.zeros(len(ch), dtype=bool); ex_c = [\"taxonKey\", \"decimalLatitude\", \"decimalLongitude\", \"eventDate\", \"recordedBy\", \"publisher\"] # B. Keunikan (U)\n",
    "    if all(c in ch.columns for c in ex_c): # 1) Cek duplikasi eksak 6 kolom kunci ketika keenamnya tidak kosong (non-NULL)\n",
    "        ex_ok = (~(miss_map[\"taxonKey\"] | miss_map[\"decimalLatitude\"] | miss_map[\"decimalLongitude\"] | miss_map[\"eventDate\"] | miss_map[\"recordedBy\"] | miss_map[\"publisher\"])).to_numpy()\n",
    "        ex_h = pd.util.hash_pandas_object(ch[ex_c].astype(\"string\").fillna(\"\"), index=False).to_numpy() # Hash 64-bit kombinasi 6 kolom\n",
    "        for i in np.where(ex_ok)[0]: # Iterasi hanya pada indeks baris yang valid (non-NULL)\n",
    "            h = ex_h[i]\n",
    "            if h in seen_ex: dup_ex += 1; is_dup[i] = True # Tandai sebagai duplikat eksak jika hash sudah pernah muncul\n",
    "            else: seen_ex.add(h) # Simpan hash baru ke memori\n",
    "    if \"occurrenceID\" in ch.columns: # 2) Cek duplikasi identifier global occurrenceID\n",
    "        oc_ok = (~miss_map[\"occurrenceID\"]).to_numpy(); oc_v = ch[\"occurrenceID\"].astype(\"string\").fillna(\"\").str.strip().to_numpy()\n",
    "        for i in np.where(oc_ok)[0]:\n",
    "            h = hash(oc_v[i])\n",
    "            if h in seen_occ: dup_occ += 1; is_dup[i] = True # Tandai jika occurrenceID duplikat\n",
    "            else: seen_occ.add(h)\n",
    "    cat_c = [\"institutionCode\", \"collectionCode\", \"catalogNumber\"] # 3) Cek duplikasi triplet katalog spesimen\n",
    "    if all(c in ch.columns for c in cat_c):\n",
    "        ct_ok = (~(miss_map[\"institutionCode\"] | miss_map[\"collectionCode\"] | miss_map[\"catalogNumber\"])).to_numpy()\n",
    "        ct_h = pd.util.hash_pandas_object(ch[cat_c].astype(\"string\").fillna(\"\"), index=False).to_numpy()\n",
    "        for i in np.where(ct_ok)[0]:\n",
    "            h = ct_h[i]\n",
    "            if h in seen_cat: dup_cat += 1; is_dup[i] = True # Tandai jika kode katalog spesimen duplikat\n",
    "            else: seen_cat.add(h)\n",
    "    dup_uni += int(is_dup.sum()) # Akumulasi total baris duplikat gabungan (union tanpa hitung ganda)\n",
    "\n",
    "    lat = pd.to_numeric(ch[\"decimalLatitude\"].astype(\"string\").str.replace(\",\", \".\", regex=False), errors=\"coerce\") # C. Validitas Spasial (VS)\n",
    "    lon = pd.to_numeric(ch[\"decimalLongitude\"].astype(\"string\").str.replace(\",\", \".\", regex=False), errors=\"coerce\") # Konversi koordinat ke float\n",
    "    c_miss = lat.isna() | lon.isna(); c_zero = (~c_miss) & (lat == 0.0) & (lon == 0.0) # Deteksi koordinat kosong dan koordinat (0,0)\n",
    "    in_bb = (~c_miss) & (~c_zero) & lat.between(-11.5, 6.5) & lon.between(94.5, 141.5); out_bb = (~c_miss) & (~c_zero) & (~in_bb) # Cek bounding box Indonesia\n",
    "    new_pts = [pt for pt in set(zip(lat[in_bb], lon[in_bb])) if pt not in coord_cache] # Ambil hanya titik koordinat unik baru yang belum pernah diuji poligon\n",
    "    if new_pts: # Uji Point-in-Polygon hanya untuk titik unik baru (menghemat >90% komputasi geometri!)\n",
    "        la_a, lo_a = np.array([p[0] for p in new_pts], dtype=\"float64\"), np.array([p[1] for p in new_pts], dtype=\"float64\")\n",
    "        for pt, cd in zip(new_pts, cls_land(la_a, lo_a)): coord_cache[pt] = int(cd) # Simpan hasil klasifikasi poligon ke cache koordinat\n",
    "    l_code = pd.Series([coord_cache.get(pt, 0) for pt in zip(lat.fillna(0.0), lon.fillna(0.0))], index=ch.index) # Petakan kode daratan dari cache\n",
    "    on_id, in_oth, in_sea = (l_code == 1), in_bb & (l_code == 2), in_bb & (l_code == 0) # Masker daratan Indonesia, negara tetangga, dan laut\n",
    "    g_iss = in_bb & on_id & (ch[\"hasGeospatialIssues\"].astype(\"string\").fillna(\"\").str.upper().str.strip() == \"TRUE\") # Cek flag isu geospasial di daratan IDN\n",
    "    v_land = in_bb & on_id & (~g_iss); inv_sp += int((~v_land).sum()) # Baris spasial valid murni vs luar daratan/laut/invalid\n",
    "    for k, m_v in [(\"INVALID_MISSING_COORD\", c_miss), (\"INVALID_ZERO_COORD\", c_zero), (\"INVALID_OUTSIDE_INDONESIA_BBOX\", out_bb), (\"INVALID_OTHER_COUNTRY_LAND\", in_oth), (\"WARNING_OR_INVALID_SEA_AREA\", in_sea), (\"INVALID_GEOSPATIAL_ISSUE_FLAG\", g_iss), (\"VALID_INDONESIA_LAND_POLYGON\", v_land)]: sp_break[k] += int(m_v.sum())\n",
    "\n",
    "    yr_n, mn_n = pd.to_numeric(ch[\"year\"], errors=\"coerce\"), pd.to_numeric(ch[\"month\"], errors=\"coerce\") # D. Validitas Metadata & Temporal (VMT)\n",
    "    ed_st, ed_dt, st_c = check_dates(ch[\"eventDate\"]); dt_cnt.update(st_c) # Klasifikasi format tanggal eventDate secara tervekktorisasi unik\n",
    "    ed_y = pd.Series([d.year if d is not None else np.nan for d in ed_dt], index=ch.index) # Ekstrak tahun dari eventDate valid\n",
    "    ed_m = pd.Series([d.month if d is not None else np.nan for d in ed_dt], index=ch.index) # Ekstrak bulan dari eventDate valid\n",
    "    y_mis, m_mis = yr_n.notna() & ed_y.notna() & (yr_n != ed_y), mn_n.notna() & ed_m.notna() & (mn_n != ed_m) # Cek ketidaksinkronan tahun & bulan\n",
    "    inc_ym += int((y_mis | m_mis).sum()); vmt_ok = (~miss_map[\"basisOfRecord\"]) & (~miss_map[\"publisher\"]) & (ed_st == \"VALID_ISO_STRICT\") & (~y_mis) & (~m_mis) # Syarat VMT valid\n",
    "    inv_vmt += int((~vmt_ok).sum()) # Akumulasi baris VMT yang bermasalah/belum terstandardisasi\n",
    "    if pq_w is not None: pq_w.write_table(pa.Table.from_pandas(ch.astype(\"string\"), schema=pq_sch, preserve_index=False)) # Tulis chunk ke Parquet jika mode build\n",
    "    print(f\"  [Chunk {idx:02d}] {n_rows:,} record selesai diprofil...\") # Log progres per chunk\n",
    "\n",
    "if pq_w is not None: # Tutup ParquetWriter dan simpan metadata sidik jari berkas sumber\n",
    "    pq_w.close()\n",
    "    if src_sig is not None: META_P.write_text(json.dumps(src_sig), encoding=\"utf-8\")\n",
    "PUB_P.write_text(json.dumps(pub_cache, ensure_ascii=False, indent=2), encoding=\"utf-8\") # Simpan cache nama publisher GBIF\n",
    "if phys_rows is None: phys_rows = n_rows # Jika membaca dari Parquet yang sudah terverifikasi, baris fisik valid sama dengan total_rows\n",
    "skip_malf = max(0, phys_rows - n_rows) # Hitung selisih baris rusak/terlewati (malformed)\n",
    "\n",
    "L_b, U_b = ((n_rows - inc_mand) / n_rows) * 100.0, ((n_rows - dup_uni) / n_rows) * 100.0 # Skor Baseline Kelengkapan (L) & Keunikan (U)\n",
    "VS_b, VMT_b = ((n_rows - inv_sp) / n_rows) * 100.0, ((n_rows - inv_vmt) / n_rows) * 100.0 # Skor Baseline Spasial (VS) & Metadata/Temporal (VMT)\n",
    "\n",
    "pd.DataFrame({\"kolom\": nan_cnt.index, \"tipe_data_awal\": [col_dtypes[c] for c in nan_cnt.index], \"jumlah_NaN\": nan_cnt.values, \"persentase_NaN\": (nan_cnt.values / n_rows * 100).round(2)}).sort_values(\"persentase_NaN\", ascending=False).to_csv(OUT_DIR / \"01_profiling_missing_semua_kolom.csv\", index=False) # Simpan CSV profil semua kolom\n",
    "pd.DataFrame([{\"No\": i, \"Atribut_Darwin_Core\": c, \"Wajib_Tabel_2_7\": \"Ya\" if c in MAND_9 else \"Tidak\", \"Tipe_Data_Raw\": col_dtypes.get(c, \"TIDAK_ADA\"), \"Jumlah_Missing\": int(cust_miss[c]) if c in all_cols else n_rows, \"Persentase_Missing (%)\": round((int(cust_miss[c]) if c in all_cols else n_rows) / n_rows * 100, 4), \"Persentase_Terisi (%)\": round(100.0 - round((int(cust_miss[c]) if c in all_cols else n_rows) / n_rows * 100, 4), 4)} for i, c in enumerate(TARGET_COLS, 1)]).to_csv(OUT_DIR / \"01_profiling_atribut_target.csv\", index=False) # Simpan CSV 26 atribut target\n",
    "\n",
    "rep = {\"generated_at\": datetime.now().isoformat(timespec=\"seconds\"), \"physical_lines_minus_header\": int(phys_rows), \"total_records\": int(n_rows), \"skipped_malformed_lines\": int(skip_malf), \"total_columns_raw\": len(all_cols), \"source_file\": in_p.name, \"source_format\": \"GBIF Simple CSV (tab-delimited)\", \"derived_columns\": DERIVED_COLS, \"geospatial_issue_flags_used\": GEO_FLAGS, \"publisher_lookup_failed_keys\": sorted(pub_failed), \"baseline_metrics\": {\"L\": round(L_b, 4), \"U\": round(U_b, 4), \"VS\": round(VS_b, 4), \"TRT\": None, \"VMT\": round(VMT_b, 4)}, \"baseline_details_with_warning_excluded\": {\"m_c_incomplete_mandatory\": int(inc_mand), \"d_duplicate_union\": int(dup_uni), \"dup_exact_non_null\": int(dup_ex), \"dup_occurrenceID\": int(dup_occ), \"dup_catalog\": int(dup_cat), \"i_s_invalid_or_marine_spatial\": int(inv_sp), \"spatial_baseline_breakdown\": {k: int(v) for k, v in sp_break.items()}, \"i_mt_invalid_or_unstandardized_vmt\": int(inv_vmt), \"raw_eventDate_status_breakdown\": {k: int(v) for k, v in dt_cnt.items()}, \"vmt_inconsistent_year_month_records\": int(inc_ym)}} # Struktur JSON laporan Tahap 1 (kompatibel penuh dengan Tahap 2-7)\n",
    "(OUT_DIR / \"01_baseline_profile_report.json\").write_text(json.dumps(rep, indent=2), encoding=\"utf-8\") # Simpan JSON laporan baseline\n",
    "print(f\"\\n[TAHAP 1 SELESAI] Record: {n_rows:,} | L={L_b:.2f}% | U={U_b:.2f}% | VS={VS_b:.2f}% | VMT={VMT_b:.2f}%\") # Cetak ringkasan eksekusi\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(20, 5.5)) # Buat kanvas grafik 3 panel (Skor Baseline, Komposisi Spasial, Status eventDate)\n",
    "d_nm, d_sc = [\"Kelengkapan (L)\", \"Keunikan (U)\", \"Validitas Spasial (VS)\", \"Metadata & Temporal (VMT)\"], [L_b, U_b, VS_b, VMT_b] # Data Panel 1\n",
    "bars = axes[0].bar(d_nm, d_sc, color=[\"#264653\", \"#2a9d8f\", \"#e9c46a\", \"#f4a261\"]); axes[0].set_ylim(0, 110); axes[0].set_title(\"Skor baseline 4 dimensi kualitas data\") # Plot Panel 1\n",
    "for b, v in zip(bars, d_sc): axes[0].text(b.get_x() + b.get_width() / 2, v, f\"{v:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=9) # Label % Panel 1\n",
    "plt.setp(axes[0].get_xticklabels(), rotation=15, ha=\"right\") # Rotasi label sumbu X Panel 1\n",
    "for ax, cnt_d, ttl in [(axes[1], sp_break, \"Komposisi hasil cek spasial\"), (axes[2], dt_cnt, \"Status format eventDate (data mentah)\")]: # Loop Panel 2 & 3\n",
    "    lbls, vals = list(cnt_d.keys()), [cnt_d[k] for k in cnt_d.keys()]; yp = np.arange(len(lbls)) # Ekstrak label & nilai kategori\n",
    "    cols = [\"#2a9d8f\" if k.startswith(\"VALID\") else \"#e9c46a\" if k.startswith(\"WARNING\") else \"#e76f51\" for k in lbls] # Warna berdasarkan status\n",
    "    ax.barh(yp, vals, color=cols); ax.set_yticks(yp); ax.set_yticklabels(lbls, fontsize=8); ax.invert_yaxis(); ax.set_xlim(0, max(vals) * 1.4); ax.set_title(ttl) # Plot horizontal bar\n",
    "    for y_i, v in zip(yp, vals): ax.text(v, y_i, f\" {v:,} ({v / n_rows * 100:.2f}%)\", va=\"center\", fontsize=8) # Anotasi jumlah & persentase\n",
    "plt.tight_layout(); plt.savefig(OUT_DIR / \"01_grafik_profiling_baseline.png\", dpi=200); plt.show() # Simpan dan tampilkan grafik"
   ]
