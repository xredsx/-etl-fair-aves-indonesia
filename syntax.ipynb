    "MISSING_MARKERS = {\"\", \"N/A\", \"n/a\", \"NA\", \"na\", \"NULL\", \"null\", \"None\", \"none\", \"-\", \"<NA>\", \"nan\", \"NaN\"}\n",
    "\n",
    "DARWIN_CORE_COLUMN_MAP = {col: [col, col.lower()] for col in TARGET_COLUMNS}\n",
    "DARWIN_CORE_COLUMN_MAP[\"license\"] = [\"license\"]\n",
    "\n",
    "# Regex eventDate (Tabel 2.9) - identik dengan Tahap 1\n",
    "RE_ISO_EXACT = re.compile(r\"^(\\d{4})-(\\d{2})-(\\d{2})$\")\n",
    "RE_YMD_SINGLE = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})$\")\n",
    "RE_MIDNIGHT_T00 = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})[T\\s]00:00(?::00(?:\\.0+)?)?(?:Z|[+-]\\d{2}:?\\d{2})?$\")\n",
    "RE_NON_MIDNIGHT_TS = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})[T\\s](\\d{2}:\\d{2}.*)$\")\n",
    "RE_FULL_DATE_INTERVAL = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})/(\\d{4})-(\\d{1,2})-(\\d{1,2}).*$\")\n",
    "RE_PARTIAL_YM_OR_Y = re.compile(r\"^\\d{4}(?:-\\d{1,2})?$\")\n",
    "RE_PARTIAL_INTERVAL = re.compile(r\"^\\d{4}(?:-\\d{1,2})?(?:T[^/]+)?/\\d{4}(?:-\\d{1,2})?(?:-\\d{1,2})?(?:T.+)?$\")\n",
    "RE_SLASH_DATE = re.compile(r\"^(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})$\")\n",
    "\n",
    "DATE_STATUS_KEYS = [\n",
    "    \"VALID_ISO\",\n",
    "    \"STANDARDIZED_DETERMINISTIC\",\n",
    "    \"STANDARDIZED_TIME_TRUNCATED\",\n",
    "    \"WARNING_PARTIAL_OR_INTERVAL\",\n",
    "    \"WARNING_AMBIGUOUS\",\n",
    "    \"INVALID_FUTURE_DATE\",\n",
    "    \"INVALID_UNPARSEABLE\",\n",
    "    \"MISSING\",\n",
    "]\n",
    "\n",
    "\n",
    "def clean_missing_strings(series: pd.Series) -> tuple[pd.Series, int]:\n",
    "    was_not_na = series.notna()\n",
    "    s_clean = series.astype(\"string\").str.strip()\n",
    "    is_marker = s_clean.isin(MISSING_MARKERS)\n",
    "    return s_clean.mask(is_marker, pd.NA), int((was_not_na & is_marker).sum())\n",
    "\n",
    "\n",
    "def _to_iso(y, m, d) -> str | None:\n",
    "    try:\n",
    "        return datetime(int(y), int(m), int(d)).strftime(\"%Y-%m-%d\")\n",
    "    except ValueError:\n",
    "        return None\n",
    "\n",
    "\n",
    "def _classify_raw(s: str) -> tuple[str | None, str]:\n",
    "    \"\"\"Klasifikasi satu nilai eventDate. Mengembalikan (tanggal ISO atau None, status).\"\"\"\n",
    "    if not s or s in MISSING_MARKERS:\n",
    "        return None, \"MISSING\"\n",
    "\n",
    "    m = RE_ISO_EXACT.match(s)\n",
    "    if m:\n",
    "        iso = _to_iso(m.group(1), m.group(2), m.group(3))\n",
    "        return (iso, \"VALID_ISO\") if iso else (None, \"INVALID_UNPARSEABLE\")\n",
    "\n",
    "    m = RE_MIDNIGHT_T00.match(s) or RE_YMD_SINGLE.match(s)\n",
    "    if m:\n",
    "        iso = _to_iso(m.group(1), m.group(2), m.group(3))\n",
    "        return (iso, \"STANDARDIZED_DETERMINISTIC\") if iso else (None, \"INVALID_UNPARSEABLE\")\n",
    "\n",
    "    m = RE_NON_MIDNIGHT_TS.match(s) or RE_FULL_DATE_INTERVAL.match(s)\n",
    "    if m:\n",
    "        iso = _to_iso(m.group(1), m.group(2), m.group(3))\n",
    "        return (iso, \"STANDARDIZED_TIME_TRUNCATED\") if iso else (None, \"INVALID_UNPARSEABLE\")\n",
    "\n",
    "    if RE_PARTIAL_YM_OR_Y.match(s) or RE_PARTIAL_INTERVAL.match(s):\n",
    "        return None, \"WARNING_PARTIAL_OR_INTERVAL\"\n",
    "\n",
    "    m = RE_SLASH_DATE.match(s)\n",
    "    if m:\n",
    "        p1, p2, y = int(m.group(1)), int(m.group(2)), int(m.group(3))\n",
    "        iso, status = None, None\n",
    "        if p1 == p2 and 1 <= p1 <= 12:\n",
    "            # Contoh 05/05/2020: hari = bulan, tidak ambigu\n",
    "            iso, status = _to_iso(y, p2, p1), \"STANDARDIZED_DETERMINISTIC\"\n",
    "        elif 1 <= p1 <= 12 and 1 <= p2 <= 12:\n",
    "            # Contoh 03/04/2020: bisa DD/MM atau MM/DD. Diasumsikan DD/MM, ditandai Warning\n",
    "            iso, status = _to_iso(y, p2, p1), \"WARNING_AMBIGUOUS\"\n",
    "        elif p1 > 12 and 1 <= p2 <= 12:\n",
    "            iso, status = _to_iso(y, p2, p1), \"STANDARDIZED_DETERMINISTIC\"   # DD/MM\n",
    "        elif p2 > 12 and 1 <= p1 <= 12:\n",
    "            iso, status = _to_iso(y, p1, p2), \"STANDARDIZED_DETERMINISTIC\"   # MM/DD\n",
    "        if iso:\n",
    "            return iso, status\n",
    "\n",
    "    return None, \"INVALID_UNPARSEABLE\"\n",
    "\n",
    "\n",
    "@lru_cache(maxsize=None)\n",
    "def classify_event_date_value(s: str) -> tuple[str | None, str]:\n",
    "    \"\"\"Sama seperti _classify_raw, ditambah aturan tanggal masa depan seperti di Tahap 1.\"\"\"\n",
    "    iso, status = _classify_raw(s)\n",
    "    if iso is not None and iso > EXTRACTION_ISO:\n",
    "        return iso, \"INVALID_FUTURE_DATE\"\n",
    "    return iso, status\n",
    "\n",
    "\n",
    "def classify_and_standardize_event_date(series: pd.Series) -> tuple[pd.Series, pd.Series, dict]:\n",
    "    unique_vals = series.dropna().unique()\n",
    "    results = {v: classify_event_date_value(str(v).strip()) for v in unique_vals}\n",
    "    iso_map = {v: r[0] for v, r in results.items()}\n",
    "    status_map = {v: r[1] for v, r in results.items()}\n",
    "\n",
    "    iso_series = series.map(iso_map).astype(\"string\")\n",
    "    status_series = series.map(status_map).fillna(\"MISSING\").astype(\"string\")\n",
    "    vc = status_series.value_counts()\n",
    "    counts = {k: int(vc.get(k, 0)) for k in DATE_STATUS_KEYS}\n",
    "    return iso_series, status_series, counts\n",
    "\n",
    "\n",
    "def harmonize_boolean(series: pd.Series) -> pd.Series:\n",
    "    mapping = {\"TRUE\": True, \"T\": True, \"1\": True, \"YES\": True, \"FALSE\": False, \"F\": False, \"0\": False, \"NO\": False}\n",
    "    return series.astype(\"string\").str.strip().str.upper().map(mapping).astype(\"boolean\")\n",
    "\n",
    "\n",
    "def harmonize_coordinate(series: pd.Series) -> tuple[pd.Series, int]:\n",
    "    s_str = series.astype(\"string\").str.strip()\n",
    "    comma_fixed = int(s_str.str.contains(\",\", na=False).sum())\n",
    "    num = pd.to_numeric(s_str.str.replace(\",\", \".\", regex=False), errors=\"coerce\").astype(\"float64\")\n",
    "    return num, comma_fixed\n",
    "\n",
    "\n",
    "def _raw_text(val) -> str:\n",
    "    return \"(kosong)\" if (val is None or pd.isna(val)) else f'\"{val}\"'\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# PEMETAAN SPASIAL: kelas daratan + jarak ke daratan Indonesia (km)\n",
    "# ------------------------------------------------------------------------------\n",
    "with open(geojson_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    indonesia_land_polygon = unary_union([shape(ft[\"geometry\"]) for ft in json.load(f)[\"features\"]])\n",
    "shapely.prepare(indonesia_land_polygon)\n",
    "with open(other_geojson_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    other_land_polygon = unary_union([shape(ft[\"geometry\"]) for ft in json.load(f)[\"features\"]])\n",
    "shapely.prepare(other_land_polygon)\n",
    "\n",
    "EARTH_RADIUS_KM = 6371.0088\n",
    "LAT_RANGE, LON_RANGE = (-11.5, 6.5), (94.5, 141.5)     # sama dengan Tahap 1 & Tahap 4\n",
    "\n",
    "_edges = [0.0, 0.1, 0.5, DISTANCE_CLEAN_KM, 5.0, 22.224, 100.0]\n",
    "DIST_BIN_EDGES = _edges + [np.inf]\n",
    "DIST_BIN_LABELS = [f\"<={_edges[1]:g}\"] + [f\"{a:g}-{b:g}\" for a, b in zip(_edges[1:-1], _edges[2:])] + [f\">{_edges[-1]:g}\"]\n",
    "\n",
    "SPATIAL_CLASS_ORDER = [\"INDONESIA_LAND\", \"SEA_OR_COAST\", \"OTHER_COUNTRY_LAND\", \"OUTSIDE_BBOX\", \"NO_COORD\"]\n",
    "SPATIAL_STATUS_ORDER = [\"CLEAN_LAND\", \"CLEAN_COASTAL_TOLERANCE\", \"NEEDS_HABITAT_CHECK\", \"NO_COORD\"]\n",
    "\n",
    "_spatial_cache = {}   # (lat, lon) -> (kelas, jarak_km)\n",
    "\n",
    "\n",
    "def _project_km(lat_deg, lon_deg):\n",
    "    \"\"\"Proyeksi equirectangular sederhana (km); cukup akurat untuk Indonesia (dekat khatulistiwa).\"\"\"\n",
    "    return EARTH_RADIUS_KM * np.radians(lon_deg), EARTH_RADIUS_KM * np.radians(lat_deg)\n",
    "\n",
    "\n",
    "def _build_indonesia_tree():\n",
    "    polys = list(indonesia_land_polygon.geoms) if hasattr(indonesia_land_polygon, \"geoms\") else [indonesia_land_polygon]\n",
    "    projected = shapely.transform(\n",
    "        np.array(polys, dtype=object),\n",
    "        lambda c: np.column_stack(_project_km(c[:, 1], c[:, 0])),\n",
    "    )\n",
    "    return shapely.STRtree(projected)\n",
    "\n",
    "\n",
    "indonesia_tree = _build_indonesia_tree()\n",
    "\n",
    "\n",
    "def _distance_to_indonesia_km(lats: np.ndarray, lons: np.ndarray) -> np.ndarray:\n",
    "    x, y = _project_km(lats, lons)\n",
    "    idx, dist = indonesia_tree.query_nearest(shapely.points(x, y), return_distance=True, all_matches=False)\n",
    "    out = np.full(len(lats), np.nan)\n",
    "    out[idx[0]] = dist\n",
    "    return out\n",
    "\n",
    "\n",
    "def _compute_new_points(keys: list) -> None:\n",
    "    lats = np.array([k[0] for k in keys], dtype=\"float64\")\n",
    "    lons = np.array([k[1] for k in keys], dtype=\"float64\")\n",
    "    in_bbox = (lats >= LAT_RANGE[0]) & (lats <= LAT_RANGE[1]) & (lons >= LON_RANGE[0]) & (lons <= LON_RANGE[1])\n",
    "    on_id = contains_xy(indonesia_land_polygon, lons, lats)\n",
    "    on_other = contains_xy(other_land_polygon, lons, lats)\n",
    "    cls = np.where(\n",
    "        ~in_bbox, \"OUTSIDE_BBOX\",\n",
    "        np.where(on_id, \"INDONESIA_LAND\", np.where(on_other, \"OTHER_COUNTRY_LAND\", \"SEA_OR_COAST\")),\n",
    "    )\n",
    "    dist = np.zeros(len(keys))\n",
    "    need = cls != \"INDONESIA_LAND\"\n",
    "    if need.any():\n",
    "        dist[need] = _distance_to_indonesia_km(lats[need], lons[need])\n",
    "    for k, c, d in zip(keys, cls, dist):\n",
    "        _spatial_cache[k] = (str(c), float(d))\n",
    "\n",
    "\n",
    "def map_spatial(lat: pd.Series, lon: pd.Series) -> pd.DataFrame:\n",
    "    \"\"\"Mengembalikan kolom cls, dist, status (indeks sama dengan input).\"\"\"\n",
    "    out = pd.DataFrame({\"cls\": \"NO_COORD\", \"dist\": np.nan}, index=lat.index)\n",
    "    valid = (lat.notna() & lon.notna() & ~((lat == 0.0) & (lon == 0.0))).to_numpy()\n",
    "    if valid.any():\n",
    "        pts = pd.DataFrame({\"lat\": lat.to_numpy()[valid], \"lon\": lon.to_numpy()[valid]})\n",
    "        uniq = pts.drop_duplicates().reset_index(drop=True)\n",
    "        keys = list(zip(uniq[\"lat\"], uniq[\"lon\"]))\n",
    "        new_keys = [k for k in keys if k not in _spatial_cache]\n",
    "        if new_keys:\n",
    "            _compute_new_points(new_keys)\n",
    "        uniq[\"cls\"] = [_spatial_cache[k][0] for k in keys]\n",
    "        uniq[\"dist\"] = [_spatial_cache[k][1] for k in keys]\n",
    "        merged = pts.merge(uniq, on=[\"lat\", \"lon\"], how=\"left\")\n",
    "        out.loc[valid, \"cls\"] = merged[\"cls\"].to_numpy()\n",
    "        out.loc[valid, \"dist\"] = merged[\"dist\"].to_numpy()\n",
    "\n",
    "    out[\"status\"] = np.select(\n",
    "        [out[\"cls\"] == \"NO_COORD\", out[\"cls\"] == \"INDONESIA_LAND\", out[\"dist\"] <= DISTANCE_CLEAN_KM],\n",
    "        [\"NO_COORD\", \"CLEAN_LAND\", \"CLEAN_COASTAL_TOLERANCE\"],\n",
    "        default=\"NEEDS_HABITAT_CHECK\",\n",
    "    )\n",
    "    return out\n",
    "\n",
    "\n",
    "\n",
    "# 2. EKSEKUSI HARMONISASI DARWIN CORE DARI RAW PARQUET\n",
    "\n",
    "if harmonized_parquet_path.exists():\n",
    "    harmonized_parquet_path.unlink()\n",
    "\n",
    "pf = pq.ParquetFile(raw_parquet_path)\n",
    "available_raw_cols = set(pf.schema.names)\n",
    "\n",
    "resolved_source_cols = {\n",
    "    target_col: next((c for c in candidates if c in available_raw_cols), None)\n",
    "    for target_col, candidates in DARWIN_CORE_COLUMN_MAP.items()\n",
    "}\n",
    "missing_in_raw = [c for c in TARGET_COLUMNS if resolved_source_cols[c] is None]\n",
    "if missing_in_raw:\n",
    "    raise ValueError(\n",
    "        f\"Kolom berikut tidak ada di raw parquet: {missing_in_raw}. \"\n",
    "        \"Pastikan raw parquet dibuat oleh Tahap 1 versi CSV (jalankan ulang Tahap 1).\"\n",
    "    )\n",
    "cols_to_read = [src for src in resolved_source_cols.values() if src is not None]\n",
    "\n",
    "harmonized_arrow_schema = pa.schema([\n",
    "    (\"gbifID\", pa.string()), (\"occurrenceID\", pa.string()),\n",
    "    (\"basisOfRecord\", pa.string()), (\"occurrenceStatus\", pa.string()),\n",
    "    (\"eventDate\", pa.string()), (\"eventDateParsed\", pa.date32()),\n",
    "    (\"verbatimEventDateRaw\", pa.string()), (\"eventDateParseStatus\", pa.string()),\n",
    "    (\"year\", pa.int64()), (\"month\", pa.int64()),\n",
    "    (\"countryCode\", pa.string()), (\"stateProvince\", pa.string()),\n",
    "    (\"decimalLatitude\", pa.float64()), (\"decimalLongitude\", pa.float64()),\n",
    "    (\"hasCoordinate\", pa.bool_()), (\"hasGeospatialIssues\", pa.bool_()),\n",
    "    (\"scientificName\", pa.string()), (\"verbatimScientificName\", pa.string()),\n",
    "    (\"taxonKey\", pa.string()), (\"taxonRank\", pa.string()), (\"family\", pa.string()),\n",
    "    (\"genus\", pa.string()), (\"species\", pa.string()),\n",
    "    (\"institutionCode\", pa.string()), (\"collectionCode\", pa.string()),\n",
    "    (\"catalogNumber\", pa.string()), (\"recordedBy\", pa.string()),\n",
    "    (\"publisher\", pa.string()), (\"datasetKey\", pa.string()), (\"license\", pa.string()),\n",
    "    (\"spatialLandClass\", pa.string()), (\"distanceToIndonesiaLandKm\", pa.float64()),\n",
    "    (\"spatialPreliminaryStatus\", pa.string()),\n",
    "])\n",
    "\n",
    "harm_writer = pq.ParquetWriter(harmonized_parquet_path, harmonized_arrow_schema, compression=\"snappy\")\n",
    "\n",
    "total_harm_rows = 0\n",
    "na_markers_converted = {col: 0 for col in DARWIN_CORE_COLUMN_MAP}\n",
    "null_after_per_col = {col: 0 for col in DARWIN_CORE_COLUMN_MAP}\n",
    "lat_comma_fixed_total, lon_comma_fixed_total = 0, 0\n",
    "date_status_totals = {k: 0 for k in DATE_STATUS_KEYS}\n",
    "real_examples_table_2_3 = {}\n",
    "\n",
    "spatial_class_counts, spatial_status_counts = Counter(), Counter()\n",
    "dist_bin_records = {lab: 0 for lab in DIST_BIN_LABELS}\n",
    "offland_point_counts = Counter()      # koordinat unik di luar daratan Indonesia (untuk peta)\n",
    "\n",
    "print(f\"Membaca langsung dari file Tahap 1: {raw_parquet_path}\")\n",
    "for batch_idx, batch in enumerate(pf.iter_batches(batch_size=CHUNK_SIZE, columns=cols_to_read), start=1):\n",
    "    raw_df = batch.to_pandas()\n",
    "    total_harm_rows += len(raw_df)\n",
    "    df_harm = pd.DataFrame(index=raw_df.index)\n",
    "\n",
    "    for target_col, src_col in resolved_source_cols.items():\n",
    "        if src_col is not None and src_col in raw_df.columns:\n",
    "            cleaned_s, n_conv = clean_missing_strings(raw_df[src_col])\n",
    "            df_harm[target_col] = cleaned_s\n",
    "            na_markers_converted[target_col] += n_conv\n",
    "        else:\n",
    "            df_harm[target_col] = pd.Series(pd.NA, index=raw_df.index, dtype=\"string\")\n",
    "\n",
    "    df_harm[\"verbatimEventDateRaw\"] = df_harm[\"eventDate\"]\n",
    "    iso_str, parse_status, status_counts = classify_and_standardize_event_date(df_harm[\"eventDate\"])\n",
    "    df_harm[\"eventDate\"] = iso_str\n",
    "    df_harm[\"eventDateParseStatus\"] = parse_status\n",
    "    df_harm[\"eventDateParsed\"] = pd.to_datetime(iso_str, format=\"%Y-%m-%d\", errors=\"coerce\").dt.date\n",
    "    for k, v in status_counts.items():\n",
    "        date_status_totals[k] += v\n",
    "\n",
    "    df_harm[\"year\"] = pd.to_numeric(df_harm[\"year\"], errors=\"coerce\").astype(\"Int64\")\n",
    "    df_harm[\"month\"] = pd.to_numeric(df_harm[\"month\"], errors=\"coerce\").astype(\"Int64\")\n",
    "\n",
    "    df_harm[\"decimalLatitude\"], n_lat_c = harmonize_coordinate(df_harm[\"decimalLatitude\"])\n",
    "    df_harm[\"decimalLongitude\"], n_lon_c = harmonize_coordinate(df_harm[\"decimalLongitude\"])\n",
    "    lat_comma_fixed_total += n_lat_c\n",
    "    lon_comma_fixed_total += n_lon_c\n",
    "\n",
    "    df_harm[\"hasCoordinate\"] = harmonize_boolean(df_harm[\"hasCoordinate\"])\n",
    "    df_harm[\"hasGeospatialIssues\"] = harmonize_boolean(df_harm[\"hasGeospatialIssues\"])\n",
    "\n",
    "    # Pemetaan spasial: kelas daratan, jarak ke daratan Indonesia, status awal\n",
    "    sp = map_spatial(df_harm[\"decimalLatitude\"], df_harm[\"decimalLongitude\"])\n",
    "    df_harm[\"spatialLandClass\"] = sp[\"cls\"].astype(\"string\")\n",
    "    df_harm[\"distanceToIndonesiaLandKm\"] = sp[\"dist\"].astype(\"float64\")\n",
    "    df_harm[\"spatialPreliminaryStatus\"] = sp[\"status\"].astype(\"string\")\n",
    "    spatial_class_counts.update(sp[\"cls\"].value_counts().to_dict())\n",
    "    spatial_status_counts.update(sp[\"status\"].value_counts().to_dict())\n",
    "    off_mask = sp[\"cls\"].isin([\"OTHER_COUNTRY_LAND\", \"SEA_OR_COAST\", \"OUTSIDE_BBOX\"])\n",
    "    if off_mask.any():\n",
    "        bin_idx, bin_cnt = np.unique(np.digitize(sp.loc[off_mask, \"dist\"].to_numpy(), DIST_BIN_EDGES[1:-1], right=True), return_counts=True)\n",
    "        for b_i, b_c in zip(bin_idx, bin_cnt):\n",
    "            dist_bin_records[DIST_BIN_LABELS[b_i]] += int(b_c)\n",
    "        offland_point_counts.update(zip(df_harm.loc[off_mask, \"decimalLatitude\"], df_harm.loc[off_mask, \"decimalLongitude\"]))\n",
    "\n",
    "    # Contoh riil untuk Tabel 2.3 (nilai \"Sebelum\" diambil dari data mentah, bukan hasil olahan)\n",
    "    src_occ = resolved_source_cols.get(\"occurrenceID\")\n",
    "    if \"occurrenceID\" not in real_examples_table_2_3 and src_occ:\n",
    "        raw_occ = raw_df[src_occ]\n",
    "        null_occ = raw_occ.isna() | raw_occ.astype(\"string\").str.strip().isin(MISSING_MARKERS)\n",
    "        if null_occ.any():\n",
    "            real_examples_table_2_3[\"occurrenceID\"] = {\n",
    "                \"Kolom\": \"occurrenceID\",\n",
    "                \"Sebelum\": f\"{_raw_text(raw_occ[null_occ].iloc[0])} (kosong pada CSV sumber)\",\n",
    "                \"Sesudah\": \"NULL (pd.NA)\",\n",
    "                \"Perubahan\": \"Nilai kosong diseragamkan menjadi NULL\",\n",
    "            }\n",
    "\n",
    "    if \"eventDate_T00\" not in real_examples_table_2_3:\n",
    "        m_t00 = (\n",
    "            (df_harm[\"eventDateParseStatus\"] == \"STANDARDIZED_DETERMINISTIC\")\n",
    "            & df_harm[\"verbatimEventDateRaw\"].str.match(RE_MIDNIGHT_T00.pattern, na=False)\n",
    "        )\n",
    "        if m_t00.any():\n",
    "            r_ed = df_harm[m_t00].iloc[0]\n",
    "            real_examples_table_2_3[\"eventDate_T00\"] = {\n",
    "                \"Kolom\": \"eventDate (T00:00)\",\n",
    "                \"Sebelum\": f'\"{r_ed[\"verbatimEventDateRaw\"]}\" (string)',\n",
    "                \"Sesudah\": f'{r_ed[\"eventDate\"]} (date32)',\n",
    "                \"Perubahan\": \"Standardisasi deterministik waktu T00:00 ke ISO 8601\",\n",
    "            }\n",
    "    if \"eventDate_Trunc\" not in real_examples_table_2_3:\n",
    "        m_tr = df_harm[\"eventDateParseStatus\"] == \"STANDARDIZED_TIME_TRUNCATED\"\n",
    "        if m_tr.any():\n",
    "            r_tr = df_harm[m_tr].iloc[0]\n",
    "            real_examples_table_2_3[\"eventDate_Trunc\"] = {\n",
    "                \"Kolom\": \"eventDate (Waktu Spesifik)\",\n",
    "                \"Sebelum\": f'\"{r_tr[\"verbatimEventDateRaw\"]}\" (string)',\n",
    "                \"Sesudah\": f'{r_tr[\"eventDate\"]} (date32)',\n",
    "                \"Perubahan\": \"Pemotongan komponen jam ke tanggal ISO 8601 (jam asli di verbatimEventDateRaw)\",\n",
    "            }\n",
    "    if \"eventDate_Partial\" not in real_examples_table_2_3:\n",
    "        m_pt = df_harm[\"eventDateParseStatus\"] == \"WARNING_PARTIAL_OR_INTERVAL\"\n",
    "        if m_pt.any():\n",
    "            r_pt = df_harm[m_pt].iloc[0]\n",
    "            real_examples_table_2_3[\"eventDate_Partial\"] = {\n",
    "                \"Kolom\": \"eventDate (Parsial/Interval)\",\n",
    "                \"Sebelum\": f'\"{r_pt[\"verbatimEventDateRaw\"]}\" (string)',\n",
    "                \"Sesudah\": \"NULL (Warning: Partial/Interval)\",\n",
    "                \"Perubahan\": \"Tanggal parsial tidak dikarang ke 01-01; ditandai sebagai Warning\",\n",
    "            }\n",
    "    src_lat = resolved_source_cols.get(\"decimalLatitude\")\n",
    "    if \"decimalLatitude\" not in real_examples_table_2_3 and src_lat and df_harm[\"decimalLatitude\"].notna().any():\n",
    "        idx_lat = df_harm[\"decimalLatitude\"].first_valid_index()\n",
    "        real_examples_table_2_3[\"decimalLatitude\"] = {\n",
    "            \"Kolom\": \"decimalLatitude\",\n",
    "            \"Sebelum\": f'{_raw_text(raw_df.at[idx_lat, src_lat])} (string)',\n",
    "            \"Sesudah\": f'{df_harm.at[idx_lat, \"decimalLatitude\"]} (float64)',\n",
    "            \"Perubahan\": \"Penyelarasan tipe data teks ke float64\",\n",
    "        }\n",
    "    src_hc = resolved_source_cols.get(\"hasCoordinate\")\n",
    "    if \"hasCoordinate\" not in real_examples_table_2_3 and src_hc and df_harm[\"hasCoordinate\"].notna().any():\n",
    "        idx_hc = df_harm[\"hasCoordinate\"].first_valid_index()\n",
    "        real_examples_table_2_3[\"hasCoordinate\"] = {\n",
    "            \"Kolom\": \"hasCoordinate\",\n",
    "            \"Sebelum\": f'{_raw_text(raw_df.at[idx_hc, src_hc])} (string)',\n",
    "            \"Sesudah\": f'{df_harm.at[idx_hc, \"hasCoordinate\"]} (boolean)',\n",
    "            \"Perubahan\": \"Penyelarasan tipe data teks ke boolean\",\n",
    "        }\n",
    "\n",
    "    for upper_col in [\"basisOfRecord\", \"occurrenceStatus\", \"countryCode\", \"taxonRank\"]:\n",
    "        df_harm[upper_col] = df_harm[upper_col].astype(\"string\").str.strip().str.upper()\n",
    "\n",
    "    for col in DARWIN_CORE_COLUMN_MAP:\n",
    "        null_after_per_col[col] += int(df_harm[col].isna().sum())\n",
    "\n",
    "    ordered_cols = [field.name for field in harmonized_arrow_schema]\n",
    "    harm_table = pa.Table.from_pandas(df_harm[ordered_cols], schema=harmonized_arrow_schema, preserve_index=False)\n",
    "    harm_writer.write_table(harm_table)\n",
    "    print(f\"  [Batch {batch_idx:02d}] {total_harm_rows:,} record selesai diharmonisasi...\")\n",
    "\n",
    "harm_writer.close()\n",
    "\n",
    "\n",
    "# 3. CEK KONSISTENSI DENGAN TAHAP 1 & REKAPITULASI\n",
    "\n",
    "consistency = {\n",
    "    \"tahap1_total_records\": None,\n",
    "    \"tahap2_total_records\": int(total_harm_rows),\n",
    "    \"total_records_match\": None,\n",
    "    \"columns_with_fewer_nulls_than_raw\": [],\n",
    "}\n",
    "\n",
    "if tahap1_report_path.exists():\n",
    "    with open(tahap1_report_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        t1_json = json.load(f)\n",
    "    t1_total = t1_json.get(\"total_records\")\n",
    "    t1_sp = t1_json.get(\"baseline_details_with_warning_excluded\", {}).get(\"spatial_baseline_breakdown\", {})\n",
    "    if t1_sp:\n",
    "        t1_expected = {\n",
    "            \"INDONESIA_LAND\": t1_sp.get(\"VALID_INDONESIA_LAND_POLYGON\", 0) + t1_sp.get(\"INVALID_GEOSPATIAL_ISSUE_FLAG\", 0),\n",
    "            \"SEA_OR_COAST\": t1_sp.get(\"WARNING_OR_INVALID_SEA_AREA\", 0),\n",
    "            \"OTHER_COUNTRY_LAND\": t1_sp.get(\"INVALID_OTHER_COUNTRY_LAND\", 0),\n",
    "            \"OUTSIDE_BBOX\": t1_sp.get(\"INVALID_OUTSIDE_INDONESIA_BBOX\", 0),\n",
    "            \"NO_COORD\": t1_sp.get(\"INVALID_MISSING_COORD\", 0) + t1_sp.get(\"INVALID_ZERO_COORD\", 0),\n",
    "        }\n",
    "        consistency[\"spatial_class_vs_tahap1\"] = {\n",
    "            k: {\"tahap1\": int(v), \"tahap2\": int(spatial_class_counts.get(k, 0)), \"match\": int(v) == int(spatial_class_counts.get(k, 0))}\n",
    "            for k, v in t1_expected.items()\n",
    "        }\n",
    "        for k, v in consistency[\"spatial_class_vs_tahap1\"].items():\n",
    "            if not v[\"match\"]:\n",
    "                print(f\"PERINGATAN: kelas spasial {k} berbeda: Tahap 1 = {v['tahap1']:,} | Tahap 2 = {v['tahap2']:,}\")\n",
    "    consistency[\"tahap1_total_records\"] = t1_total\n",
    "    consistency[\"total_records_match\"] = (t1_total == total_harm_rows)\n",
    "    if t1_total != total_harm_rows:\n",
    "        print(f\"PERINGATAN: total record Tahap 1 ({t1_total:,}) berbeda dengan Tahap 2 ({total_harm_rows:,}).\")\n",
    "\n",
    "raw_missing_map = {}\n",
    "if tahap1_target_csv_path.exists():\n",
    "    df_t1 = pd.read_csv(tahap1_target_csv_path)\n",
    "    raw_missing_map = dict(zip(df_t1[\"Atribut_Darwin_Core\"], df_t1[\"Jumlah_Missing\"]))\n",
    "\n",
    "df_examples = pd.DataFrame(list(real_examples_table_2_3.values()))\n",
    "df_examples.to_csv(out_dir / \"02_tabel_2_3_contoh_sebelum_sesudah_harmonisasi.csv\", index=False)\n",
    "\n",
    "schema_rows = []\n",
    "for idx, col in enumerate(TARGET_COLUMNS, start=1):\n",
    "    null_cnt = null_after_per_col[col]\n",
    "    raw_miss = raw_missing_map.get(col)\n",
    "    added_null = (null_cnt - int(raw_miss)) if raw_miss is not None else None\n",
    "    if added_null is not None and added_null < 0:\n",
    "        consistency[\"columns_with_fewer_nulls_than_raw\"].append(col)\n",
    "        print(f\"PERINGATAN: kolom {col} punya NULL lebih sedikit dari data mentah Tahap 1 (selisih {added_null:,}).\")\n",
    "    schema_rows.append({\n",
    "        \"No\": idx,\n",
    "        \"Atribut_Darwin_Core\": col,\n",
    "        \"Tipe_Data_Sesudah\": str(harmonized_arrow_schema.field(col).type),\n",
    "        \"Jumlah_Missing_Raw_Tahap1\": raw_miss,\n",
    "        \"Marker_Missing_Diseragamkan_ke_NULL\": na_markers_converted[col],\n",
    "        \"Jumlah_NULL_Sesudah\": null_cnt,\n",
    "        \"Tambahan_NULL_Akibat_Konversi\": added_null,\n",
    "        \"Persentase_Terisi (%)\": round((total_harm_rows - null_cnt) / total_harm_rows * 100, 4),\n",
    "    })\n",
    "df_schema_summary = pd.DataFrame(schema_rows)\n",
    "df_schema_summary.to_csv(out_dir / \"02_skema_atribut_terharmonisasi.csv\", index=False)\n",
    "\n",
    "with open(out_dir / \"02_harmonization_report.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\n",
    "        \"total_records_harmonized\": total_harm_rows,\n",
    "        \"extraction_date_reference\": EXTRACTION_ISO,\n",
    "        \"eventDate_standardization\": date_status_totals,\n",
    "        \"coordinate_comma_fixed\": {\"latitude\": lat_comma_fixed_total, \"longitude\": lon_comma_fixed_total},\n",
    "        \"missing_marker_conversions_target_cols\": {c: int(na_markers_converted[c]) for c in TARGET_COLUMNS},\n",
    "        \"spatial_mapping\": {\n",
    "            \"distance_clean_threshold_km\": DISTANCE_CLEAN_KM,\n",
    "            \"class_counts\": {k: int(spatial_class_counts.get(k, 0)) for k in SPATIAL_CLASS_ORDER},\n",
    "            \"preliminary_status_counts\": {k: int(spatial_status_counts.get(k, 0)) for k in SPATIAL_STATUS_ORDER},\n",
    "            \"offland_records_by_distance_km\": dist_bin_records,\n",
    "        },\n",
    "        \"consistency_check_vs_tahap1\": consistency,\n",
    "        \"real_examples_table_2_3\": list(real_examples_table_2_3.values()),\n",
    "    }, f, indent=2, default=str)\n",
    "\n",
    "print(\"\\n=== RINGKASAN TAHAP 2 (HARMONISASI DARWIN CORE) ===\")\n",
    "print(f\"Total Record : {total_harm_rows:,}\")\n",
    "for st_k, st_v in date_status_totals.items():\n",
    "    print(f\"  - {st_k:<30}: {st_v:>10,} record ({st_v / total_harm_rows * 100:.4f}%)\")\n",
    "print(\"\\nContoh Riil Sebelum & Sesudah Harmonisasi (Tabel 2.3):\")\n",
    "print(df_examples.to_string(index=False))\n",
    "\n",
    "print(\"\\nPEMETAAN SPASIAL (kelas daratan & status awal):\")\n",
    "for k in SPATIAL_CLASS_ORDER:\n",
    "    v = int(spatial_class_counts.get(k, 0))\n",
    "    print(f\"  - {k:<22}: {v:>10,} record ({v / total_harm_rows * 100:.4f}%)\")\n",
    "print(f\"Status awal (ambang toleransi pesisir = {DISTANCE_CLEAN_KM:g} km):\")\n",
    "for k in SPATIAL_STATUS_ORDER:\n",
    "    v = int(spatial_status_counts.get(k, 0))\n",
    "    print(f\"  - {k:<24}: {v:>10,} record ({v / total_harm_rows * 100:.4f}%)\")\n",
    "\n",
    "\n",
    "# 4. GRAFIK SEBARAN SPASIAL\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(21, 6.5), gridspec_kw={\"width_ratios\": [1, 1, 1.3]})\n",
    "\n",
    "# Grafik 1: status awal spasial\n",
    "ax = axes[0]\n",
    "st_vals = [int(spatial_status_counts.get(k, 0)) for k in SPATIAL_STATUS_ORDER]\n",
    "st_colors = [\"#2a9d8f\", \"#8ecae6\", \"#d62828\", \"#adb5bd\"]\n",
    "ypos = np.arange(len(SPATIAL_STATUS_ORDER))\n",
    "ax.barh(ypos, st_vals, color=st_colors)\n",
    "for y_i, v in zip(ypos, st_vals):\n",
    "    ax.text(v, y_i, f\" {v:,} ({v / total_harm_rows * 100:.2f}%)\", va=\"center\", fontsize=8)\n",
    "ax.set_yticks(ypos)\n",
    "ax.set_yticklabels(SPATIAL_STATUS_ORDER, fontsize=8)\n",
    "ax.invert_yaxis()\n",
    "ax.set_xlim(0, max(st_vals) * 1.4)\n",
    "ax.set_xlabel(\"Jumlah record\")\n",
    "ax.set_title(\"Status awal spasial\")\n",
    "\n",
    "# Grafik 2: sebaran jarak record di luar daratan Indonesia\n",
    "ax = axes[1]\n",
    "d_vals = np.array([dist_bin_records[lab] for lab in DIST_BIN_LABELS], dtype=float)\n",
    "d_pct = d_vals / d_vals.sum() * 100 if d_vals.sum() > 0 else d_vals\n",
    "d_colors = [\"#2a9d8f\" if DIST_BIN_EDGES[i + 1] <= DISTANCE_CLEAN_KM else \"#d62828\" for i in range(len(DIST_BIN_LABELS))]\n",
    "bars = ax.bar(DIST_BIN_LABELS, d_pct, color=d_colors)\n",
    "for b_, v, n in zip(bars, d_pct, d_vals):\n",
    "    ax.text(b_.get_x() + b_.get_width() / 2, v, f\"{v:.1f}%\\n({int(n):,})\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "ax.set_ylim(0, max(d_pct.max() * 1.25, 1) if len(d_pct) else 1)\n",
    "ax.set_xlabel(\"Jarak ke daratan Indonesia terdekat (km)\")\n",
    "ax.set_ylabel(\"Persen record di luar daratan (%)\")\n",
    "ax.set_title(f\"Sebaran jarak (hijau: <= {DISTANCE_CLEAN_KM:g} km, bersih)\")\n",
    "plt.setp(ax.get_xticklabels(), rotation=20, ha=\"right\", fontsize=8)\n",
    "\n",
    "# Grafik 3: peta titik di luar daratan Indonesia\n",
    "ax = axes[2]\n",
    "simplified = indonesia_land_polygon.simplify(0.02)\n",
    "for geom in (simplified.geoms if hasattr(simplified, \"geoms\") else [simplified]):\n",
    "    gx, gy = geom.exterior.xy\n",
    "    ax.fill(gx, gy, color=\"#e9ecef\", zorder=0)\n",
    "    ax.plot(gx, gy, color=\"#adb5bd\", linewidth=0.3, zorder=1)\n",
    "\n",
    "if offland_point_counts:\n",
    "    off_keys = list(offland_point_counts.keys())\n",
    "    o_lat = np.array([k[0] for k in off_keys])\n",
    "    o_lon = np.array([k[1] for k in off_keys])\n",
    "    o_dist = np.array([_spatial_cache[k][1] for k in off_keys])\n",
    "    in_win = (o_lat >= -12) & (o_lat <= 7) & (o_lon >= 94) & (o_lon <= 142)\n",
    "    near_m = in_win & (o_dist <= DISTANCE_CLEAN_KM)\n",
    "    far_m = in_win & (o_dist > DISTANCE_CLEAN_KM)\n",
    "    ax.scatter(o_lon[near_m], o_lat[near_m], s=3, color=\"#2a9d8f\", alpha=0.6, zorder=2, label=f\"<= {DISTANCE_CLEAN_KM:g} km ({int(near_m.sum()):,} titik unik)\")\n",
    "    ax.scatter(o_lon[far_m], o_lat[far_m], s=5, color=\"#d62828\", alpha=0.7, zorder=3, label=f\"> {DISTANCE_CLEAN_KM:g} km ({int(far_m.sum()):,} titik unik)\")\n",
    "    out_win = int((~in_win).sum())\n",
    "    ax.legend(loc=\"lower left\", fontsize=8)\n",
    "    ax.set_title(f\"Peta titik di luar daratan Indonesia ({out_win:,} titik unik di luar jendela peta)\")\n",
    "ax.set_xlim(94, 142)\n",
    "ax.set_ylim(-12, 7)\n",
    "ax.set_xlabel(\"Bujur\")\n",
    "ax.set_ylabel(\"Lintang\")\n",
    "ax.set_aspect(\"equal\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(out_dir / \"02_grafik_sebaran_spasial.png\", dpi=200)\n",
    "plt.show()"
   ]
