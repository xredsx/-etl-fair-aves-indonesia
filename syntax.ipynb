    "# Perhitungan Skor per Dimensi (Persamaan 2.8) dan Overall FAIR Score (Persamaan 2.9)\n",
    "dim_order = [\"Findable (F)\", \"Accessible (A)\", \"Interoperable (I)\", \"Reusable (R)\"]\n",
