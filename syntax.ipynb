    "import json\n",
    "from collections import Counter\n",
    "from datetime import date\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import pyarrow as pa\n",
    "\n",
    "# Pengaman agar tidak pernah muncul ArrowKeyError: pandas.period already defined\n",
    "try:\n",
    "    import pandas.core.arrays.arrow.extension_types  # noqa: F401\n",
    "except Exception:\n",
    "    pass\n",
    "import pyarrow.parquet as pq\n",
    "\n",
    "\n",
    "# 1. KONFIGURASI MANDIRI TAHAP 4 & 5 (TERHUBUNG KE OUTPUT TAHAP 1, 2, & 3 COL XR)\n",
    "\n",
    "OUTPUT_DIR = r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"\n",
    "CHUNK_SIZE = 100_000\n",
    "EXTRACTION_DATE = date.today()\n",
    "\n",
    "# Mode perhitungan Baseline TRT (Sebelum ETL):\n",
    "# - \"ACCEPTED_ONLY\"       : Baseline sebelum ETL hanya menghitung record yang sejak awal sudah berstatus\n",
    "#                           Accepted (n_accepted / N_awal), karena Synonym resolved & Fuzzy match baru\n",
    "#                           diresolusi pada Tahap 3.\n",
    "# - \"EQ_2_5_ACC_PLUS_SYN\" : Menggunakan nilai Persamaan 2.5 (n_accepted + n_synonym_resolved) / N_awal.\n",
    "TRT_BASELINE_MODE = \"ACCEPTED_ONLY\"\n",
    "\n",
    "out_dir = Path(OUTPUT_DIR)\n",
    "normalized_parquet_path = out_dir / \"normalized_taxonomy_aves_indonesia.parquet\"\n",
    "validated_clean_parquet_path = out_dir / \"clean_set_aves_indonesia.parquet\"\n",
    "validated_quarantine_parquet_path = out_dir / \"quarantine_store_aves_indonesia.parquet\"\n",
    "\n",
    "tahap1_report_path = out_dir / \"01_baseline_profile_report.json\"\n",
    "tahap2_report_path = out_dir / \"02_harmonization_report.json\"\n",
    "tahap3_tax_report_path = out_dir / \"03_taxonomic_normalization_report.json\"\n",
    "tahap3_hab_report_path = out_dir / \"03_habitat_check_report.json\"\n",
    "\n",
    "if not normalized_parquet_path.exists():\n",
    "    raise FileNotFoundError(f\"File {normalized_parquet_path} belum ada. Jalankan Tahap 3 terlebih dahulu.\")\n",
    "\n",
    "MANDATORY_9_COLUMNS = [\n",
    "    \"occurrenceID\", \"scientificName\", \"taxonRank\",\n",
    "    \"decimalLatitude\", \"decimalLongitude\", \"eventDate\",\n",
    "    \"basisOfRecord\", \"publisher\", \"recordedBy\",\n",
    "]\n",
    "\n",
    "DIM_COLS = [\n",
    "    (\"Completeness\", \"status_completeness\"),\n",
    "    (\"Uniqueness\", \"status_uniqueness\"),\n",
    "    (\"Spatial\", \"status_spatial\"),\n",
    "    (\"Taxonomy\", \"status_taxonomy\"),\n",
    "    (\"Metadata_Temporal\", \"status_metadata_temporal\"),\n",
    "]\n",
    "\n",
    "\n",
    "def flag_duplicates(hashes: np.ndarray, present: np.ndarray, seen: set) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    True untuk record yang kuncinya sudah pernah muncul, baik di batch sebelumnya\n",
    "    maupun lebih awal di batch ini. Record pertama tetap dianggap asli (UNIQUE).\n",
    "    \"\"\"\n",
    "    flag = np.zeros(len(hashes), dtype=bool)\n",
    "    idx = np.flatnonzero(present)\n",
    "    if idx.size == 0:\n",
    "        return flag\n",
    "    keys = hashes[idx]\n",
    "    within_batch = pd.Series(keys).duplicated(keep=\"first\").to_numpy()\n",
    "    key_list = keys.tolist()\n",
    "    prior = np.fromiter((k in seen for k in key_list), dtype=bool, count=len(key_list))\n",
    "    flag[idx] = within_batch | prior\n",
    "    seen.update(key_list)\n",
    "    return flag\n",
    "\n",
    "\n",
    "\n",
    "# 2. PERSIAPAN SKEMA & PEMERIKSAAN KOLOM DARI TAHAP 2 DAN TAHAP 3 (COL XR)\n",
    "\n",
    "for p in [validated_clean_parquet_path, validated_quarantine_parquet_path]:\n",
    "    if p.exists():\n",
    "        p.unlink()\n",
    "\n",
    "pf_norm = pq.ParquetFile(normalized_parquet_path)\n",
    "validated_arrow_schema = pq.read_schema(normalized_parquet_path)\n",
    "schema_col_names = set(validated_arrow_schema.names)\n",
    "\n",
    "# Pastikan seluruh kolom hasil Tahap 2 & Tahap 3 (termasuk 3 atribut Darwin Core dari COL XR) telah tersedia\n",
    "required_t2_t3_cols = {\n",
    "    \"spatialPreliminaryStatus\",\n",
    "    \"spatialLandClass\",\n",
    "    \"spatialHabitatStatus\",\n",
    "    \"taxonomyValidationStatus\",\n",
    "    \"acceptedScientificName\",\n",
    "    \"acceptedTaxonKey\",\n",
    "    \"taxonomicStatus\",\n",
    "    \"matchedTaxonKey\",\n",
    "    \"matchedAcceptedScientificName\",\n",
    "}\n",
    "missing_t2_t3 = required_t2_t3_cols - schema_col_names\n",
    "if missing_t2_t3:\n",
    "    raise KeyError(\n",
    "        f\"Kolom hasil Tahap 2/3 belum lengkap di {normalized_parquet_path.name}: {sorted(missing_t2_t3)}. \"\n",
    "        \"Pastikan telah menjalankan sel Tahap 2 dan sel Tahap 3 versi Catalogue of Life (COL XR).\"\n",
    "    )\n",
    "\n",
    "for val_field in [\n",
    "    pa.field(\"spatial_validation_detail\", pa.string()),\n",
    "    pa.field(\"vmt_validation_detail\", pa.string()),\n",
    "    pa.field(\"status_completeness\", pa.string()),\n",
    "    pa.field(\"status_uniqueness\", pa.string()),\n",
    "    pa.field(\"status_spatial\", pa.string()),\n",
    "    pa.field(\"status_taxonomy\", pa.string()),\n",
    "    pa.field(\"status_metadata_temporal\", pa.string()),\n",
    "    pa.field(\"duplicate_type\", pa.string()),\n",
    "    pa.field(\"record_routing_status\", pa.string()),\n",
    "    pa.field(\"Invalid_Reasons\", pa.string()),\n",
    "]:\n",
    "    if val_field.name not in schema_col_names:\n",
    "        validated_arrow_schema = validated_arrow_schema.append(val_field)\n",
    "        schema_col_names.add(val_field.name)\n",
    "\n",
    "ordered_cols = [f.name for f in validated_arrow_schema]\n",
    "\n",
    "clean_writer = pq.ParquetWriter(validated_clean_parquet_path, validated_arrow_schema, compression=\"snappy\")\n",
    "quarantine_writer = pq.ParquetWriter(validated_quarantine_parquet_path, validated_arrow_schema, compression=\"snappy\")\n",
    "\n",
    "total_val_rows = 0\n",
    "seen_exact_hashes, seen_occ_ids, seen_cat_hashes = set(), set(), set()\n",
    "\n",
    "dim_status_counts = {label: Counter() for label, _ in DIM_COLS}\n",
    "mandatory_missing_counts = Counter({c: 0 for c in MANDATORY_9_COLUMNS})\n",
    "spatial_detail_counts = Counter()\n",
    "vmt_detail_counts = Counter()\n",
    "dup_breakdown_counts = Counter({\"UNIQUE\": 0, \"DUP_EXACT\": 0, \"DUP_OCCURRENCE_ID\": 0, \"DUP_CATALOG\": 0})\n",
    "dup_rule_total_counts = Counter({\"dup_exact_non_null\": 0, \"dup_occurrenceID\": 0, \"dup_catalog\": 0, \"dup_union_total\": 0})\n",
    "routing_counts = Counter({\"Clean\": 0, \"Warning\": 0, \"Quarantine\": 0})\n",
    "invalid_reason_counts = Counter()\n",
    "invalid_single_dim_counts = Counter()\n",
    "\n",
    "clean_set_total = 0\n",
    "clean_only_total = 0\n",
    "clean_set_valid_counts = Counter({\"L\": 0, \"U\": 0, \"VS\": 0, \"TRT\": 0, \"VMT_strict\": 0, \"VMT_with_warning\": 0})\n",
    "\n",
    "dim_labels_arr = np.array([label for label, _ in DIM_COLS])\n",
    "status_col_names = [col for _, col in DIM_COLS]\n",
    "\n",
    "\n",
    "# 3. EKSEKUSI VALIDASI 5 DIMENSI & ROUTING DATA PER BATCH\n",
    "\n",
    "print(f\"Membaca langsung dari file Tahap 3: {normalized_parquet_path}\")\n",
    "for batch_idx, batch in enumerate(pf_norm.iter_batches(batch_size=CHUNK_SIZE), start=1):\n",
    "    dfb = batch.to_pandas()\n",
    "    n_b = len(dfb)\n",
    "    total_val_rows += n_b\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    # 1. KELENGKAPAN (L - Tabel 2.7 & Persamaan 2.2: 9 Kolom Wajib)\n",
    "    # --------------------------------------------------------------------------\n",
    "    missing_mandatory = pd.Series(False, index=dfb.index)\n",
    "    for mcol in MANDATORY_9_COLUMNS:\n",
    "        col_check = \"verbatimEventDateRaw\" if mcol == \"eventDate\" else mcol\n",
    "        if mcol in (\"decimalLatitude\", \"decimalLongitude\"):\n",
    "            col_miss = dfb[col_check].isna()\n",
    "        else:\n",
    "            col_miss = dfb[col_check].isna() | (dfb[col_check].astype(\"string\").str.strip() == \"\")\n",
    "        mandatory_missing_counts[mcol] += int(col_miss.sum())\n",
    "        missing_mandatory |= col_miss\n",
    "\n",
    "    dfb[\"status_completeness\"] = pd.Series(\n",
    "        np.where(missing_mandatory, \"INVALID\", \"VALID\"), index=dfb.index, dtype=\"string\"\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    # 2. KEUNIKAN (U - Tabel 2.8 & Persamaan 2.3: Duplikasi Eksak, occurrenceID, & Katalog)\n",
    "    # --------------------------------------------------------------------------\n",
    "    tk_col = dfb[\"acceptedTaxonKey\"].fillna(dfb[\"taxonKey\"]).astype(\"string\").str.strip()\n",
    "    ed_col = dfb[\"eventDate\"].fillna(dfb[\"verbatimEventDateRaw\"]).astype(\"string\").str.strip()\n",
    "    rec_col = dfb[\"recordedBy\"].astype(\"string\").str.strip()\n",
    "    pub_col = dfb[\"publisher\"].astype(\"string\").str.strip()\n",
    "\n",
    "    exact_all_present = (\n",
    "        tk_col.notna() & (tk_col != \"\")\n",
    "        & dfb[\"decimalLatitude\"].notna()\n",
    "        & dfb[\"decimalLongitude\"].notna()\n",
    "        & ed_col.notna() & (ed_col != \"\")\n",
    "        & rec_col.notna() & (rec_col != \"\")\n",
    "        & pub_col.notna() & (pub_col != \"\")\n",
    "    ).to_numpy()\n",
    "\n",
    "    exact_df = pd.DataFrame({\n",
    "        \"tk\": tk_col.fillna(\"\"),\n",
    "        \"lat\": dfb[\"decimalLatitude\"].astype(\"string\").fillna(\"\"),\n",
    "        \"lon\": dfb[\"decimalLongitude\"].astype(\"string\").fillna(\"\"),\n",
    "        \"ed\": ed_col.fillna(\"\"),\n",
    "        \"rec\": rec_col.fillna(\"\"),\n",
    "        \"pub\": pub_col.fillna(\"\"),\n",
    "    })\n",
    "    exact_hashes = pd.util.hash_pandas_object(exact_df, index=False).to_numpy()\n",
    "\n",
    "    occ_vals = dfb[\"occurrenceID\"].astype(\"string\").str.strip()\n",
    "    occ_pres_arr = (occ_vals.notna() & (occ_vals != \"\")).to_numpy()\n",
    "    occ_hashes = pd.util.hash_pandas_object(occ_vals.fillna(\"\"), index=False).to_numpy()\n",
    "\n",
    "    cat_pres_arr = (\n",
    "        dfb[\"institutionCode\"].notna() & (dfb[\"institutionCode\"].astype(\"string\").str.strip() != \"\")\n",
    "        & dfb[\"collectionCode\"].notna() & (dfb[\"collectionCode\"].astype(\"string\").str.strip() != \"\")\n",
    "        & dfb[\"catalogNumber\"].notna() & (dfb[\"catalogNumber\"].astype(\"string\").str.strip() != \"\")\n",
    "    ).to_numpy()\n",
    "    cat_hashes = pd.util.hash_pandas_object(\n",
    "        dfb[[\"institutionCode\", \"collectionCode\", \"catalogNumber\"]].astype(\"string\").fillna(\"\"),\n",
    "        index=False,\n",
    "    ).to_numpy()\n",
    "\n",
    "    dup_exact = flag_duplicates(exact_hashes, exact_all_present, seen_exact_hashes)\n",
    "    dup_occ = flag_duplicates(occ_hashes, occ_pres_arr, seen_occ_ids)\n",
    "    dup_cat = flag_duplicates(cat_hashes, cat_pres_arr, seen_cat_hashes)\n",
    "    dup_any = dup_exact | dup_occ | dup_cat\n",
    "\n",
    "    dup_rule_total_counts[\"dup_exact_non_null\"] += int(dup_exact.sum())\n",
    "    dup_rule_total_counts[\"dup_occurrenceID\"] += int(dup_occ.sum())\n",
    "    dup_rule_total_counts[\"dup_catalog\"] += int(dup_cat.sum())\n",
    "    dup_rule_total_counts[\"dup_union_total\"] += int(dup_any.sum())\n",
    "\n",
    "    dup_type_arr = np.select(\n",
    "        [dup_exact, dup_occ, dup_cat],\n",
    "        [\"DUP_EXACT\", \"DUP_OCCURRENCE_ID\", \"DUP_CATALOG\"],\n",
    "        default=\"UNIQUE\",\n",
    "    )\n",
    "\n",
    "    dfb[\"duplicate_type\"] = pd.Series(dup_type_arr, index=dfb.index, dtype=\"string\")\n",
    "    dfb[\"status_uniqueness\"] = pd.Series(\n",
    "        np.where(dup_type_arr == \"UNIQUE\", \"VALID\", \"INVALID\"), index=dfb.index, dtype=\"string\"\n",
    "    )\n",
    "    dup_breakdown_counts.update(dfb[\"duplicate_type\"].value_counts().to_dict())\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    # 3. VALIDITAS SPASIAL (VS - Persamaan 2.4: Terhubung ke Tahap 2 & Tahap 3)\n",
    "    # --------------------------------------------------------------------------\n",
    "    prelim_sp = dfb[\"spatialPreliminaryStatus\"].fillna(\"NO_COORD\").astype(str).to_numpy()\n",
    "    land_cls = dfb[\"spatialLandClass\"].fillna(\"NO_COORD\").astype(str).to_numpy()\n",
    "    hab_st = dfb[\"spatialHabitatStatus\"].fillna(\"NOT_REQUIRED\").astype(str).to_numpy()\n",
    "    geo_issue = dfb[\"hasGeospatialIssues\"].fillna(False).to_numpy(dtype=bool)\n",
    "    needs_check = prelim_sp == \"NEEDS_HABITAT_CHECK\"\n",
    "\n",
    "    sp_detail_arr = np.select(\n",
    "        [\n",
    "            prelim_sp == \"NO_COORD\",\n",
    "            land_cls == \"OUTSIDE_BBOX\",\n",
    "            geo_issue,\n",
    "            prelim_sp == \"CLEAN_LAND\",\n",
    "            prelim_sp == \"CLEAN_COASTAL_TOLERANCE\",\n",
    "            needs_check & (hab_st == \"SUPPORTED\"),\n",
    "            needs_check & (hab_st == \"UNVERIFIABLE_TAXON\"),\n",
    "            needs_check & (hab_st == \"ANOMALY\"),\n",
    "        ],\n",
    "        [\n",
    "            \"INVALID_NO_COORD\",\n",
    "            \"INVALID_OUTSIDE_BBOX\",\n",
    "            \"INVALID_GEOSPATIAL_ISSUE\",\n",
    "            \"VALID_CLEAN_LAND\",\n",
    "            \"VALID_COASTAL_TOLERANCE_LE_1KM\",\n",
    "            \"VALID_HABITAT_SUPPORTED_GT_1KM\",\n",
    "            \"INVALID_UNVERIFIABLE_TAXON\",\n",
    "            \"INVALID_HABITAT_ANOMALY\",\n",
    "        ],\n",
    "        default=\"INVALID_HABITAT_ANOMALY\",\n",
    "    )\n",
    "\n",
    "    sp_status_arr = np.where(\n",
    "        np.isin(sp_detail_arr, [\"VALID_CLEAN_LAND\", \"VALID_COASTAL_TOLERANCE_LE_1KM\", \"VALID_HABITAT_SUPPORTED_GT_1KM\"]),\n",
    "        \"VALID\",\n",
    "        \"INVALID\",\n",
    "    )\n",
    "\n",
    "    dfb[\"spatial_validation_detail\"] = pd.Series(sp_detail_arr, index=dfb.index, dtype=\"string\")\n",
    "    dfb[\"status_spatial\"] = pd.Series(sp_status_arr, index=dfb.index, dtype=\"string\")\n",
    "    spatial_detail_counts.update(dfb[\"spatial_validation_detail\"].value_counts().to_dict())\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    # 4. RESOLUSI TAKSONOMI (TRT - Persamaan 2.5: Mengikuti taxonomyValidationStatus COL XR Tahap 3)\n",
    "    # --------------------------------------------------------------------------\n",
    "    tax_val = dfb[\"taxonomyValidationStatus\"].fillna(\"INVALID\")\n",
    "    dfb[\"status_taxonomy\"] = pd.Series(\n",
    "        np.where(tax_val == \"VALID\", \"VALID\", \"INVALID\"),\n",
    "        index=dfb.index, dtype=\"string\"\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    # 5. VALIDITAS METADATA & TEMPORAL (VMT - Tabel 2.9 & Persamaan 2.6)\n",
    "    # --------------------------------------------------------------------------\n",
    "    bor_invalid = (dfb[\"basisOfRecord\"].isna() | (dfb[\"basisOfRecord\"].astype(\"string\").str.strip() == \"\")).to_numpy(dtype=bool)\n",
    "    ed_status = dfb[\"eventDateParseStatus\"].fillna(\"MISSING\").astype(str).to_numpy()\n",
    "    ed_parsed = dfb[\"eventDateParsed\"]\n",
    "    ed_future = (ed_parsed.notna() & (ed_parsed > EXTRACTION_DATE)).to_numpy(dtype=bool) | (ed_status == \"INVALID_FUTURE_DATE\")\n",
    "    ed_missing_or_unparseable = np.isin(ed_status, [\"MISSING\", \"INVALID_UNPARSEABLE\"])\n",
    "\n",
    "    vmt_invalid = bor_invalid | ed_missing_or_unparseable | ed_future\n",
    "\n",
    "    ed_dt = pd.to_datetime(dfb[\"eventDate\"], format=\"%Y-%m-%d\", errors=\"coerce\")\n",
    "    yr_inconsistent = (dfb[\"year\"].notna() & ed_dt.notna() & (dfb[\"year\"] != ed_dt.dt.year)).to_numpy(dtype=bool)\n",
    "    mn_inconsistent = (dfb[\"month\"].notna() & ed_dt.notna() & (dfb[\"month\"] != ed_dt.dt.month) ).to_numpy(dtype=bool)\n",
    "    pub_missing = (dfb[\"publisher\"].isna() | (dfb[\"publisher\"].astype(\"string\").str.strip() == \"\")).to_numpy(dtype=bool)\n",
    "    ed_partial = ed_status == \"WARNING_PARTIAL_OR_INTERVAL\"\n",
    "    ed_ambiguous = ed_status == \"WARNING_AMBIGUOUS\"\n",
    "\n",
    "    vmt_warning = (~vmt_invalid) & (\n",
    "        ed_partial | ed_ambiguous | yr_inconsistent | mn_inconsistent | pub_missing\n",
    "    )\n",
    "\n",
    "    vmt_detail_arr = np.select(\n",
    "        [\n",
    "            bor_invalid,\n",
    "            ed_future,\n",
    "            ed_missing_or_unparseable,\n",
    "            ed_partial,\n",
    "            ed_ambiguous,\n",
    "            yr_inconsistent | mn_inconsistent,\n",
    "            pub_missing,\n",
    "        ],\n",
    "        [\n",
    "            \"INVALID_MISSING_BASIS_OF_RECORD\",\n",
    "            \"INVALID_FUTURE_DATE\",\n",
    "            \"INVALID_MISSING_OR_UNPARSEABLE_DATE\",\n",
    "            \"WARNING_PARTIAL_OR_INTERVAL_DATE\",\n",
    "            \"WARNING_AMBIGUOUS_SLASH_DATE\",\n",
    "            \"WARNING_YEAR_MONTH_MISMATCH\",\n",
    "            \"WARNING_MISSING_PUBLISHER\",\n",
    "        ],\n",
    "        default=\"VALID_ISO_AND_METADATA\",\n",
    "    )\n",
    "\n",
    "    dfb[\"vmt_validation_detail\"] = pd.Series(vmt_detail_arr, index=dfb.index, dtype=\"string\")\n",
    "    dfb[\"status_metadata_temporal\"] = pd.Series(\n",
    "        np.select([vmt_invalid, vmt_warning], [\"INVALID\", \"WARNING\"], default=\"VALID\"),\n",
    "        index=dfb.index, dtype=\"string\"\n",
    "    )\n",
    "    vmt_detail_counts.update(dfb[\"vmt_validation_detail\"].value_counts().to_dict())\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    # TAHAP 5: ROUTING DATA (Clean vs Warning vs Quarantine)\n",
    "    # --------------------------------------------------------------------------\n",
    "    status_df = dfb[status_col_names]\n",
    "    inv_matrix = (status_df == \"INVALID\").to_numpy(dtype=bool)\n",
    "    warn_matrix = (status_df == \"WARNING\").to_numpy(dtype=bool)\n",
    "    any_invalid = inv_matrix.any(axis=1)\n",
    "    any_warning = (~any_invalid) & warn_matrix.any(axis=1)\n",
    "\n",
    "    dfb[\"record_routing_status\"] = pd.Series(\n",
    "        np.select([any_invalid, any_warning], [\"Quarantine\", \"Warning\"], default=\"Clean\"),\n",
    "        index=dfb.index, dtype=\"string\"\n",
    "    )\n",
    "\n",
    "    reasons_arr = np.full(n_b, None, dtype=object)\n",
    "    for i in np.flatnonzero(any_invalid):\n",
    "        dims_inv = dim_labels_arr[inv_matrix[i]]\n",
    "        reasons_arr[i] = \";\".join(dims_inv)\n",
    "        for d_lbl in dims_inv:\n",
    "            invalid_single_dim_counts[d_lbl] += 1\n",
    "    dfb[\"Invalid_Reasons\"] = pd.Series(reasons_arr, index=dfb.index, dtype=\"string\")\n",
    "\n",
    "    for dim_label, col_st in DIM_COLS:\n",
    "        dim_status_counts[dim_label].update(dfb[col_st].value_counts().to_dict())\n",
    "    routing_counts.update(dfb[\"record_routing_status\"].value_counts().to_dict())\n",
    "    invalid_reason_counts.update(dfb[\"Invalid_Reasons\"].dropna().value_counts().to_dict())\n",
    "\n",
    "    df_clean_sub = dfb[dfb[\"record_routing_status\"].isin([\"Clean\", \"Warning\"])][ordered_cols]\n",
    "    df_quar_sub = dfb[dfb[\"record_routing_status\"] == \"Quarantine\"][ordered_cols]\n",
    "\n",
    "    clean_set_total += len(df_clean_sub)\n",
    "    clean_only_total += int((dfb[\"record_routing_status\"] == \"Clean\").sum())\n",
    "    if len(df_clean_sub) > 0:\n",
    "        clean_set_valid_counts[\"L\"] += int((df_clean_sub[\"status_completeness\"] == \"VALID\").sum())\n",
    "        clean_set_valid_counts[\"U\"] += int((df_clean_sub[\"status_uniqueness\"] == \"VALID\").sum())\n",
    "        clean_set_valid_counts[\"VS\"] += int((df_clean_sub[\"status_spatial\"] == \"VALID\").sum())\n",
    "        clean_set_valid_counts[\"TRT\"] += int((df_clean_sub[\"status_taxonomy\"] == \"VALID\").sum())\n",
    "        clean_set_valid_counts[\"VMT_strict\"] += int((df_clean_sub[\"status_metadata_temporal\"] == \"VALID\").sum())\n",
    "        clean_set_valid_counts[\"VMT_with_warning\"] += int((df_clean_sub[\"status_metadata_temporal\"] != \"INVALID\").sum())\n",
    "\n",
    "        clean_writer.write_table(pa.Table.from_pandas(df_clean_sub, schema=validated_arrow_schema, preserve_index=False))\n",
    "\n",
    "    if len(df_quar_sub) > 0:\n",
    "        quarantine_writer.write_table(pa.Table.from_pandas(df_quar_sub, schema=validated_arrow_schema, preserve_index=False))\n",
    "\n",
    "    print(f\"  [Batch {batch_idx:02d}] {total_val_rows:,} record selesai divalidasi & di-routing...\")\n",
    "\n",
    "clean_writer.close()\n",
    "quarantine_writer.close()\n",
    "\n",
    "\n",
    "# 4. REKAPITULASI HASIL VALIDASI 5 DIMENSI, RINCIAN PER DIMENSI, & ROUTING\n",
    "\n",
    "val_summary_rows = []\n",
    "for dim_name, cnt_dict in dim_status_counts.items():\n",
    "    n_v, n_w, n_i = int(cnt_dict.get(\"VALID\", 0)), int(cnt_dict.get(\"WARNING\", 0)), int(cnt_dict.get(\"INVALID\", 0))\n",
    "    val_summary_rows.append({\n",
    "        \"Dimensi_Kualitas\": dim_name,\n",
    "        \"Valid\": n_v, \"Valid (%)\": round(n_v / total_val_rows * 100, 4),\n",
    "        \"Warning\": n_w, \"Warning (%)\": round(n_w / total_val_rows * 100, 4),\n",
    "        \"Invalid\": n_i, \"Invalid (%)\": round(n_i / total_val_rows * 100, 4),\n",
    "    })\n",
    "\n",
    "df_val_summary = pd.DataFrame(val_summary_rows)\n",
    "df_val_summary.to_csv(out_dir / \"04_rekapitulasi_validasi_5_dimensi.csv\", index=False)\n",
    "\n",
    "# Rincian Kelengkapan 9 Atribut Wajib (Tabel 2.7)\n",
    "completeness_detail_rows = []\n",
    "for idx, mcol in enumerate(MANDATORY_9_COLUMNS, start=1):\n",
    "    n_miss = int(mandatory_missing_counts.get(mcol, 0))\n",
    "    n_fill = total_val_rows - n_miss\n",
    "    completeness_detail_rows.append({\n",
    "        \"No\": idx,\n",
    "        \"Atribut_Wajib_Tabel_2_7\": mcol,\n",
    "        \"Jumlah_Terisi\": n_fill,\n",
    "        \"Persentase_Terisi (%)\": round(n_fill / total_val_rows * 100, 4),\n",
    "        \"Jumlah_Kosong_NULL\": n_miss,\n",
    "        \"Persentase_Kosong (%)\": round(n_miss / total_val_rows * 100, 4),\n",
    "    })\n",
    "df_comp_detail = pd.DataFrame(completeness_detail_rows)\n",
    "df_comp_detail.to_csv(out_dir / \"04_rincian_kelengkapan_9_atribut_wajib.csv\", index=False)\n",
    "\n",
    "# Rincian Keunikan & Duplikasi (Tabel 2.8)\n",
    "dup_detail_rows = [\n",
    "    (\"UNIQUE\", \"VALID\", \"Record unik (kemunculan pertama/asli)\", int(dup_breakdown_counts[\"UNIQUE\"])),\n",
    "    (\"DUP_EXACT\", \"INVALID\", \"Duplikasi eksak 6 atribut non-NULL (acceptedTaxonKey/taxonKey, lat, lon, eventDate, recordedBy, publisher)\", int(dup_breakdown_counts[\"DUP_EXACT\"])),\n",
    "    (\"DUP_OCCURRENCE_ID\", \"INVALID\", \"Duplikasi kunci occurrenceID (di luar duplikat eksak)\", int(dup_breakdown_counts[\"DUP_OCCURRENCE_ID\"])),\n",
    "    (\"DUP_CATALOG\", \"INVALID\", \"Duplikasi kombinasi institutionCode + collectionCode + catalogNumber (di luar eksak & occurrenceID)\", int(dup_breakdown_counts[\"DUP_CATALOG\"])),\n",
    "]\n",
    "df_dup_detail = pd.DataFrame([\n",
    "    {\n",
    "        \"Kategori_Keunikan\": k,\n",
    "        \"Status_Dimensi_U\": st,\n",
    "        \"Keterangan\": desc,\n",
    "        \"Jumlah_Record\": cnt,\n",
    "        \"Proporsi (%)\": round(cnt / total_val_rows * 100, 4),\n",
    "    }\n",
    "    for k, st, desc, cnt in dup_detail_rows\n",
    "])\n",
    "df_dup_detail.to_csv(out_dir / \"04_rincian_keunikan_duplikasi.csv\", index=False)\n",
    "\n",
    "# Rincian Validitas Spasial-Habitat\n",
    "spatial_detail_order = [\n",
    "    (\"VALID_CLEAN_LAND\", \"VALID\", \"Daratan Indonesia (CLEAN_LAND)\"),\n",
    "    (\"VALID_COASTAL_TOLERANCE_LE_1KM\", \"VALID\", \"Luar Daratan <= 1 km dari Pantai (CLEAN_COASTAL_TOLERANCE)\"),\n",
    "    (\"VALID_HABITAT_SUPPORTED_GT_1KM\", \"VALID\", \"Luar Daratan > 1 km & Habitat Spesies Sesuai (SUPPORTED)\"),\n",
    "    (\"INVALID_HABITAT_ANOMALY\", \"INVALID\", \"Luar Daratan > 1 km & Anomali Habitat Spesies (ANOMALY)\"),\n",
    "    (\"INVALID_UNVERIFIABLE_TAXON\", \"INVALID\", \"Luar Daratan > 1 km & Takson Tidak Terverifikasi (UNVERIFIABLE_TAXON)\"),\n",
    "    (\"INVALID_GEOSPATIAL_ISSUE\", \"INVALID\", \"Memiliki Flag Isu Geospasial GBIF (hasGeospatialIssues=True)\"),\n",
    "    (\"INVALID_OUTSIDE_BBOX\", \"INVALID\", \"Koordinat di Luar Bounding Box Indonesia\"),\n",
    "    (\"INVALID_NO_COORD\", \"INVALID\", \"Koordinat Kosong atau (0, 0)\"),\n",
    "]\n",
    "spatial_detail_rows = []\n",
    "for code_key, st_dim, desc_label in spatial_detail_order:\n",
    "    cnt = int(spatial_detail_counts.get(code_key, 0))\n",
    "    spatial_detail_rows.append({\n",
    "        \"Kategori_Detail_Spasial\": code_key,\n",
    "        \"Status_Dimensi_VS\": st_dim,\n",
    "        \"Keterangan\": desc_label,\n",
    "        \"Jumlah_Record\": cnt,\n",
    "        \"Proporsi (%)\": round(cnt / total_val_rows * 100, 4),\n",
    "    })\n",
    "df_spatial_detail = pd.DataFrame(spatial_detail_rows)\n",
    "df_spatial_detail.to_csv(out_dir / \"04_rincian_validasi_spasial_habitat.csv\", index=False)\n",
    "\n",
    "# Rincian Validitas Metadata & Temporal (Tabel 2.9)\n",
    "vmt_detail_order = [\n",
    "    (\"VALID_ISO_AND_METADATA\", \"VALID\", \"Tanggal ISO 8601 valid, konsisten dengan year/month, serta basisOfRecord & publisher terisi\"),\n",
    "    (\"WARNING_PARTIAL_OR_INTERVAL_DATE\", \"WARNING\", \"Tanggal parsial (YYYY / YYYY-MM) atau interval tanggal (verbatimEventDateRaw dipertahankan)\"),\n",
    "    (\"WARNING_AMBIGUOUS_SLASH_DATE\", \"WARNING\", \"Tanggal format garis miring ambigu DD/MM vs MM/DD\"),\n",
    "    (\"WARNING_YEAR_MONTH_MISMATCH\", \"WARNING\", \"Ketidaksesuaian nilai kolom year/month terhadap tanggal eventDate\"),\n",
    "    (\"WARNING_MISSING_PUBLISHER\", \"WARNING\", \"Atribut publisher kosong meskipun tanggal dan basisOfRecord valid\"),\n",
    "    (\"INVALID_MISSING_OR_UNPARSEABLE_DATE\", \"INVALID\", \"Tanggal eventDate kosong atau tidak dapat dikenali\"),\n",
    "    (\"INVALID_FUTURE_DATE\", \"INVALID\", \"Tanggal observasi melebihi tanggal ekstraksi dataset\"),\n",
    "    (\"INVALID_MISSING_BASIS_OF_RECORD\", \"INVALID\", \"Atribut basisOfRecord kosong\"),\n",
    "]\n",
    "vmt_detail_rows = []\n",
    "for code_key, st_dim, desc_label in vmt_detail_order:\n",
    "    cnt = int(vmt_detail_counts.get(code_key, 0))\n",
    "    vmt_detail_rows.append({\n",
    "        \"Kategori_Detail_VMT\": code_key,\n",
    "        \"Status_Dimensi_VMT\": st_dim,\n",
    "        \"Keterangan\": desc_label,\n",
    "        \"Jumlah_Record\": cnt,\n",
    "        \"Proporsi (%)\": round(cnt / total_val_rows * 100, 4),\n",
    "    })\n",
    "df_vmt_detail = pd.DataFrame(vmt_detail_rows)\n",
    "df_vmt_detail.to_csv(out_dir / \"04_rincian_validasi_metadata_temporal.csv\", index=False)\n",
    "\n",
    "# Rekapitulasi Routing (Tahap 5)\n",
    "routing_rows = []\n",
    "for r_status in [\"Clean\", \"Warning\", \"Quarantine\"]:\n",
    "    cnt = int(routing_counts.get(r_status, 0))\n",
    "    routing_rows.append({\n",
    "        \"Status_Akhir_Record\": r_status,\n",
    "        \"Target_Penyimpanan\": \"Clean Set (DuckDB & Parquet)\" if r_status in [\"Clean\", \"Warning\"] else \"Quarantine Store (DuckDB & Parquet)\",\n",
    "        \"Jumlah_Record\": cnt,\n",
    "        \"Proporsi (%)\": round(cnt / total_val_rows * 100, 4),\n",
    "    })\n",
    "df_routing_summary = pd.DataFrame(routing_rows)\n",
    "df_routing_summary.to_csv(out_dir / \"05_rekapitulasi_routing_record.csv\", index=False)\n",
    "\n",
    "# Rincian kombinasi Invalid_Reasons pada Quarantine Store\n",
    "n_quar = int(routing_counts.get(\"Quarantine\", 0))\n",
    "quar_reason_rows = []\n",
    "for rank_i, (reason_combo, cnt) in enumerate(invalid_reason_counts.most_common(), start=1):\n",
    "    quar_reason_rows.append({\n",
    "        \"No\": rank_i,\n",
    "        \"Kombinasi_Invalid_Reasons\": reason_combo,\n",
    "        \"Jumlah_Record\": int(cnt),\n",
    "        \"Proporsi_terhadap_Quarantine (%)\": round(cnt / n_quar * 100, 4) if n_quar else 0.0,\n",
    "        \"Proporsi_terhadap_Total_Dataset (%)\": round(cnt / total_val_rows * 100, 4),\n",
    "    })\n",
    "df_quar_reasons = pd.DataFrame(quar_reason_rows)\n",
    "df_quar_reasons.to_csv(out_dir / \"05_rincian_alasan_quarantine.csv\", index=False)\n",
    "\n",
    "\n",
    "# 5. PERBANDINGAN METRIK SEBELUM vs SESUDAH ETL (PERSAMAAN 2.7: DELTA X)\n",
    "#    Hanya menampilkan 3 kolom metrik utama: Baseline (%), Sesudah ETL (%), dan Kenaikan (%)\n",
    "\n",
    "t1_metrics = {}\n",
    "t1_total = None\n",
    "if tahap1_report_path.exists():\n",
    "    t1_data = json.loads(tahap1_report_path.read_text(encoding=\"utf-8\"))\n",
    "    t1_metrics = t1_data.get(\"baseline_metrics\", {})\n",
    "    t1_total = t1_data.get(\"total_records\")\n",
    "\n",
    "t3_data = {}\n",
    "if tahap3_tax_report_path.exists():\n",
    "    t3_data = json.loads(tahap3_tax_report_path.read_text(encoding=\"utf-8\"))\n",
    "\n",
    "# Skor Baseline (Sebelum Transformasi ETL)\n",
    "L_before = float(t1_metrics.get(\"L\") or (dim_status_counts[\"Completeness\"][\"VALID\"] / total_val_rows * 100))\n",
    "U_before = float(t1_metrics.get(\"U\") or (dim_status_counts[\"Uniqueness\"][\"VALID\"] / total_val_rows * 100))\n",
    "VS_before = float(t1_metrics.get(\"VS\") or 0.0)\n",
    "VMT_before = float(t1_metrics.get(\"VMT\") or (dim_status_counts[\"Metadata_Temporal\"][\"VALID\"] / total_val_rows * 100))\n",
    "\n",
    "# Baseline TRT:\n",
    "# Jika TRT_BASELINE_MODE == \"ACCEPTED_ONLY\", dihitung dari proporsi record yang sejak awal sudah Accepted\n",
    "# (sebelum Synonym resolved dan Fuzzy match diresolusi ke Accepted pada Tahap 3).\n",
    "if TRT_BASELINE_MODE == \"ACCEPTED_ONLY\" and t3_data.get(\"n_accepted\") is not None:\n",
    "    TRT_before = float(t3_data[\"n_accepted\"]) / total_val_rows * 100.0\n",
    "else:\n",
    "    TRT_before = float(\n",
    "        t3_data.get(\"TRT_baseline_eq_2_5_pct\")\n",
    "        if t3_data.get(\"TRT_baseline_eq_2_5_pct\") is not None\n",
    "        else (t1_metrics.get(\"TRT\") or (dim_status_counts[\"Taxonomy\"][\"VALID\"] / total_val_rows * 100))\n",
    "    )\n",
    "\n",
    "# Skor Sesudah ETL (Clean Set Akhir)\n",
    "L_after = clean_set_valid_counts[\"L\"] / clean_set_total * 100 if clean_set_total else 0.0\n",
    "U_after = clean_set_valid_counts[\"U\"] / clean_set_total * 100 if clean_set_total else 0.0\n",
    "VS_after = clean_set_valid_counts[\"VS\"] / clean_set_total * 100 if clean_set_total else 0.0\n",
    "TRT_after = clean_set_valid_counts[\"TRT\"] / clean_set_total * 100 if clean_set_total else 0.0\n",
    "VMT_after = clean_set_valid_counts[\"VMT_with_warning\"] / clean_set_total * 100 if clean_set_total else 0.0\n",
    "VMT_after_strict = clean_set_valid_counts[\"VMT_strict\"] / clean_set_total * 100 if clean_set_total else 0.0\n",
    "\n",
    "delta_rows = [\n",
    "    {\n",
    "        \"Kode\": \"L\",\n",
    "        \"Dimensi_Kualitas\": \"Kelengkapan (Completeness)\",\n",
    "        \"Baseline_Sebelum_ETL (%)\": round(L_before, 4),\n",
    "        \"Sesudah_ETL_Clean_Set (%)\": round(L_after, 4),\n",
    "        \"Kenaikan_Delta_X (%)\": round(L_after - L_before, 4),\n",
    "    },\n",
    "    {\n",
    "        \"Kode\": \"U\",\n",
    "        \"Dimensi_Kualitas\": \"Keunikan (Uniqueness)\",\n",
    "        \"Baseline_Sebelum_ETL (%)\": round(U_before, 4),\n",
    "        \"Sesudah_ETL_Clean_Set (%)\": round(U_after, 4),\n",
    "        \"Kenaikan_Delta_X (%)\": round(U_after - U_before, 4),\n",
    "    },\n",
    "    {\n",
    "        \"Kode\": \"VS\",\n",
    "        \"Dimensi_Kualitas\": \"Validitas Spasial (Spatial Validity)\",\n",
    "        \"Baseline_Sebelum_ETL (%)\": round(VS_before, 4),\n",
    "        \"Sesudah_ETL_Clean_Set (%)\": round(VS_after, 4),\n",
    "        \"Kenaikan_Delta_X (%)\": round(VS_after - VS_before, 4),\n",
    "    },\n",
    "    {\n",
    "        \"Kode\": \"TRT\",\n",
    "        \"Dimensi_Kualitas\": \"Tingkat Resolusi Taksonomi (Catalogue of Life XR)\",\n",
    "        \"Baseline_Sebelum_ETL (%)\": round(TRT_before, 4),\n",
    "        \"Sesudah_ETL_Clean_Set (%)\": round(TRT_after, 4),\n",
    "        \"Kenaikan_Delta_X (%)\": round(TRT_after - TRT_before, 4),\n",
    "    },\n",
    "    {\n",
    "        \"Kode\": \"VMT\",\n",
    "        \"Dimensi_Kualitas\": \"Validitas Metadata & Temporal\",\n",
    "        \"Baseline_Sebelum_ETL (%)\": round(VMT_before, 4),\n",
    "        \"Sesudah_ETL_Clean_Set (%)\": round(VMT_after, 4),\n",
    "        \"Kenaikan_Delta_X (%)\": round(VMT_after - VMT_before, 4),\n",
    "    },\n",
    "]\n",
    "df_delta = pd.DataFrame(delta_rows)\n",
    "df_delta.to_csv(out_dir / \"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\", index=False)\n",
    "\n",
    "consistency_checks = {\n",
    "    \"tahap1_total_records\": t1_total,\n",
    "    \"tahap3_total_records\": t3_data.get(\"total_records\"),\n",
    "    \"tahap4_5_total_records\": int(total_val_rows),\n",
    "    \"clean_plus_quarantine_equals_total\": (clean_set_total + n_quar) == total_val_rows,\n",
    "}\n",
    "\n",
    "with open(out_dir / \"04_05_validation_and_routing_report.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\n",
    "        \"total_records_validated\": int(total_val_rows),\n",
    "        \"clean_set_records\": int(clean_set_total),\n",
    "        \"clean_only_records\": int(clean_only_total),\n",
    "        \"warning_records_in_clean_set\": int(routing_counts.get(\"Warning\", 0)),\n",
    "        \"quarantine_records\": int(n_quar),\n",
    "        \"retention_rate_pct\": round(clean_set_total / total_val_rows * 100, 4),\n",
    "        \"trt_baseline_mode\": TRT_BASELINE_MODE,\n",
    "        \"dimension_status_breakdown\": val_summary_rows,\n",
    "        \"completeness_9_mandatory_breakdown\": completeness_detail_rows,\n",
    "        \"duplicate_breakdown\": {k: int(v) for k, v in dup_breakdown_counts.items()},\n",
    "        \"duplicate_rule_totals\": {k: int(v) for k, v in dup_rule_total_counts.items()},\n",
    "        \"spatial_habitat_detail_breakdown\": spatial_detail_rows,\n",
    "        \"vmt_detail_breakdown\": vmt_detail_rows,\n",
    "        \"routing_summary\": routing_rows,\n",
    "        \"invalid_records_by_single_dimension\": {k: int(v) for k, v in invalid_single_dim_counts.items()},\n",
    "        \"top_invalid_reasons_combinations\": dict(invalid_reason_counts.most_common(15)),\n",
    "        \"before_vs_after_comparison_eq_2_7\": delta_rows,\n",
    "        \"clean_set_post_etl_metrics\": {\n",
    "            \"L_after\": round(L_after, 4),\n",
    "            \"U_after\": round(U_after, 4),\n",
    "            \"VS_after\": round(VS_after, 4),\n",
    "            \"TRT_after\": round(TRT_after, 4),\n",
    "            \"VMT_after\": round(VMT_after, 4),\n",
    "            \"VMT_after_strict_iso\": round(VMT_after_strict, 4),\n",
    "        },\n",
    "        \"consistency_checks\": consistency_checks,\n",
    "    }, f, indent=2, default=str)\n",
    "\n",
    "print(\"\\n=== RINGKASAN TAHAP 4: HASIL VALIDASI 5 DIMENSI KUALITAS DATA ===\")\n",
    "print(df_val_summary.to_string(index=False))\n",
    "\n",
    "print(\"\\n=== RINCIAN KELENGKAPAN 9 ATRIBUT WAJIB (TABEL 2.7) ===\")\n",
    "print(df_comp_detail.to_string(index=False))\n",
    "\n",
    "print(\"\\n=== RINCIAN KEUNIKAN & DUPLIKASI (TABEL 2.8) ===\")\n",
    "print(df_dup_detail.to_string(index=False))\n",
    "print(\n",
    "    f\"  Total per aturan duplikasi (sebelum prioritas label): \"\n",
    "    f\"Eksak non-NULL = {dup_rule_total_counts['dup_exact_non_null']:,} | \"\n",
    "    f\"occurrenceID = {dup_rule_total_counts['dup_occurrenceID']:,} | \"\n",
    "    f\"Katalog = {dup_rule_total_counts['dup_catalog']:,} | \"\n",
    "    f\"Gabungan (Union) = {dup_rule_total_counts['dup_union_total']:,}\"\n",
    ")\n",
    "\n",
    "print(\"\\n=== RINCIAN VALIDASI SPASIAL-HABITAT (TAHAP 2 + TAHAP 3 -> TAHAP 4) ===\")\n",
    "print(df_spatial_detail.to_string(index=False))\n",
    "\n",
    "print(\"\\n=== RINCIAN VALIDASI METADATA & TEMPORAL (TABEL 2.9) ===\")\n",
    "print(df_vmt_detail.to_string(index=False))\n",
    "\n",
    "print(\"\\n=== RINGKASAN TAHAP 5: HASIL ROUTING DATA ===\")\n",
    "print(df_routing_summary.to_string(index=False))\n",
    "\n",
    "print(\"\\n=== 10 KOMBINASI PENYEBAB QUARANTINE TERBANYAK (Invalid_Reasons) ===\")\n",
    "print(df_quar_reasons.head(10).to_string(index=False))\n",
    "\n",
    "print(\"\\n=== PERBANDINGAN METRIK SEBELUM vs SESUDAH ETL (PERSAMAAN 2.7: DELTA X) ===\")\n",
    "print(df_delta.to_string(index=False))\n",
    "\n",
    "\n",
    "# 6. GRAFIK VALIDASI 5 DIMENSI, ROUTING DATA, & PENYEBAB QUARANTINE\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(21, 6))\n",
    "\n",
    "# Grafik 1: Perbandingan Skor Baseline (Sebelum ETL) vs Sesudah ETL (Clean Set)\n",
    "ax = axes[0]\n",
    "x_idx = np.arange(len(df_delta))\n",
    "width = 0.36\n",
    "b1 = ax.bar(x_idx - width / 2, df_delta[\"Baseline_Sebelum_ETL (%)\"], width, label=\"Sebelum ETL (Baseline)\", color=\"#e76f51\")\n",
    "b2 = ax.bar(x_idx + width / 2, df_delta[\"Sesudah_ETL_Clean_Set (%)\"], width, label=\"Sesudah ETL (Clean Set)\", color=\"#2a9d8f\")\n",
    "for bars in (b1, b2):\n",
    "    for b_ in bars:\n",
    "        v = b_.get_height()\n",
    "        ax.text(b_.get_x() + b_.get_width() / 2, v + 0.8, f\"{v:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "ax.set_xticks(x_idx)\n",
    "ax.set_xticklabels(df_delta[\"Kode\"], fontsize=9)\n",
    "ax.set_ylim(0, 115)\n",
    "ax.set_ylabel(\"Skor Kualitas Data (%)\")\n",
    "ax.set_title(\"Perbandingan Skor 5 Dimensi Sebelum vs Sesudah ETL\")\n",
    "ax.legend(fontsize=8.5, loc=\"lower right\")\n",
    "\n",
    "# Grafik 2: Komposisi Routing Record (Tahap 5)\n",
    "ax = axes[1]\n",
    "r_labels = [\"Clean\", \"Warning\", \"Quarantine\"]\n",
    "r_vals = [int(routing_counts.get(k, 0)) for k in r_labels]\n",
    "r_colors = [\"#2a9d8f\", \"#e9c46a\", \"#d62828\"]\n",
    "bars = ax.bar(r_labels, r_vals, color=r_colors)\n",
    "for b_, v in zip(bars, r_vals):\n",
    "    pct = v / total_val_rows * 100 if total_val_rows else 0\n",
    "    ax.text(b_.get_x() + b_.get_width() / 2, v, f\"{v:,}\\n({pct:.2f}%)\", ha=\"center\", va=\"bottom\", fontsize=8.5)\n",
    "ax.set_ylim(0, max(r_vals) * 1.25 if max(r_vals) > 0 else 1)\n",
    "ax.set_ylabel(\"Jumlah record\")\n",
    "ax.set_title(f\"Hasil Routing Data Tahap 5 (Retensi Clean Set: {clean_set_total / total_val_rows * 100:.2f}%)\")\n",
    "\n",
    "# Grafik 3: Jumlah Record Invalid per Dimensi pada Quarantine Store\n",
    "ax = axes[2]\n",
    "dim_order_inv = [\"Taxonomy\", \"Uniqueness\", \"Spatial\", \"Completeness\", \"Metadata_Temporal\"]\n",
    "inv_vals = [int(invalid_single_dim_counts.get(d, 0)) for d in dim_order_inv]\n",
    "ypos = np.arange(len(dim_order_inv))\n",
    "ax.barh(ypos, inv_vals, color=\"#e76f51\")\n",
    "for y_i, v in zip(ypos, inv_vals):\n",
    "    pct_q = (v / n_quar * 100) if n_quar else 0.0\n",
    "    ax.text(v, y_i, f\" {v:,} ({pct_q:.1f}% dr Quarantine)\", va=\"center\", fontsize=8)\n",
    "ax.set_yticks(ypos)\n",
    "ax.set_yticklabels(dim_order_inv, fontsize=8.5)\n",
    "ax.invert_yaxis()\n",
    "ax.set_xlim(0, max(inv_vals) * 1.42 if max(inv_vals) > 0 else 1)\n",
    "ax.set_xlabel(\"Jumlah record INVALID\")\n",
    "ax.set_title(\"Kontribusi Dimensi Penyebab Quarantine\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(out_dir / \"04_05_grafik_validasi_dan_routing.png\", dpi=200)\n",
    "plt.show()"
   ]
  },
