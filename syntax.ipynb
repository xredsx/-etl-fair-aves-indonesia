    "     \"Essential\", 3, s_R1_3, bukti_R1_3),\n",
    "]\n",
    "\n",
    "df_fair_indicators = pd.DataFrame(\n",
    "    indicators_data,\n",
    "    columns=[\n",
    "        \"Dimensi\",\n",
