   "source": [
    "import gc, hashlib, subprocess, duckdb # Modul garbage collector, hash SHA-256, eksekusi Git, dan DuckDB\n",
    "from pathlib import Path # Manajemen path direktori proyek lintas platform\n",
    "\n",
    "for _o in list(globals().values()) + gc.get_objects(): # Tutup koneksi DuckDB yang masih terbuka di memori Jupyter\n",
    "    try:\n",
    "        if isinstance(_o, duckdb.DuckDBPyConnection): _o.close()\n",
    "    except Exception: pass\n",
    "\n",
    "PROJ_DIR, OUT_DIR = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\"), Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\") # Direktori proyek & output\n",
    "GH_REPO_URL = \"https://github.com/xredsx/-etl-fair-aves-indonesia.git\" # URL HTTPS repositori GitHub publik\n",
    "GH_TOKEN, APPLY_41, MAX_MB = \"\", True, 95.0 # Personal Access Token opsional, saklar 41 kolom, & batas ukuran file GitHub\n",
    "COL_KEY = \"7ddf754f-d193-4cc9-b351-99906754a03b\" # ChecklistKey resmi Catalogue of Life eXtended Release (COL XR)\n",
    "CLEAN_DB = OUT_DIR / \"db\" / \"clean_store_aves_indonesia.duckdb\" # Path berkas basis data DuckDB Clean Set\n",
    "CLEAN_TBL, CLEAN_PQ = \"occurrence_clean\", OUT_DIR / \"final_parquet\" / \"occurrence_clean.parquet\" # Tabel & Parquet final Clean Set\n",
    "\n",
    "CLEAN_41_ORD = [\"gbifID\", \"occurrenceID\", \"basisOfRecord\", \"occurrenceStatus\", \"datasetKey\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\", \"publisher\", \"eventDate\", \"year\", \"month\", \"countryCode\", \"stateProvince\", \"decimalLatitude\", \"decimalLongitude\", \"hasGeospatialIssues\", \"scientificName\", \"verbatimScientificName\", \"taxonKey\", \"acceptedTaxonKey\", \"taxonomicStatus\", \"taxonRank\", \"family\", \"genus\", \"species\", \"license\", \"verbatimEventDateRaw\", \"eventDateParseStatus\", \"vmt_validation_detail\", \"matchType\", \"matchedRank\", \"matchedStatus\", \"taxonomicMatchCategory\", \"distanceToIndonesiaLandKm\", \"spatialHabitatStatus\", \"spatialHabitatSupportKm\", \"spatial_validation_detail\", \"status_metadata_temporal\", \"record_routing_status\"] # Urutan baku 41 kolom Clean DB (Tabel 4.13)\n",
    "sql_p = lambda p: p.as_posix().replace(\"'\", \"''\") # Helper format path untuk kueri SQL DuckDB\n",
    "\n",
    "def sha256_file(p: Path) -> str: # Hitung hash kriptografis SHA-256 berkas Parquet\n",
    "    h = hashlib.sha256()\n",
    "    with open(p, \"rb\") as f:\n",
    "        for ch in iter(lambda: f.read(1048576), b\"\"): h.update(ch)\n",
    "    return h.hexdigest()\n",
    "\n",
    "if APPLY_41 and CLEAN_DB.exists(): # 1. Sinkronisasi tabel utama Clean DB & Parquet final agar tepat berisi 41 kolom bersih (Tabel 4.13)\n",
    "    with duckdb.connect(str(CLEAN_DB)) as con:\n",
    "        ex_c = [r[0] for r in con.execute(f'DESCRIBE \"{CLEAN_TBL}\"').fetchall()]; tgt_c = [c for c in CLEAN_41_ORD if c in ex_c]\n",
    "        if len(ex_c) != len(tgt_c) or ex_c != tgt_c:\n",
    "            print(f\"[Sync 41 Kolom] Menyesuaikan {CLEAN_TBL} dari {len(ex_c)} kolom -> {len(tgt_c)} kolom bersih...\")\n",
    "            con.execute(f'CREATE OR REPLACE TABLE \"{CLEAN_TBL}_tmp\" AS SELECT {\", \".join(f\"{chr(34)}{c}{chr(34)}\" for c in tgt_c)} FROM \"{CLEAN_TBL}\"')\n",
    "            con.execute(f'DROP TABLE \"{CLEAN_TBL}\"'); con.execute(f'ALTER TABLE \"{CLEAN_TBL}_tmp\" RENAME TO \"{CLEAN_TBL}\"')\n",
    "            con.execute(f\"CREATE OR REPLACE VIEW v_clean_only AS SELECT * FROM \\\"{CLEAN_TBL}\\\" WHERE record_routing_status = 'Clean'\")\n",
    "            con.execute(f\"CREATE OR REPLACE VIEW v_warning_only AS SELECT * FROM \\\"{CLEAN_TBL}\\\" WHERE record_routing_status = 'Warning'\")\n",
    "            if \"data_dictionary\" in {r[0] for r in con.execute(\"SELECT table_name FROM information_schema.tables WHERE table_schema='main'\").fetchall()}:\n",
    "                con.execute(f\"CREATE OR REPLACE TABLE data_dictionary_tmp AS SELECT ROW_NUMBER() OVER () AS no, kelompok, atribut, tipe_data_duckdb, fungsi, catatan_etl, sumber FROM data_dictionary WHERE atribut IN ({', '.join(chr(39) + c + chr(39) for c in tgt_c)})\")\n",
    "                con.execute(\"DROP TABLE data_dictionary\"); con.execute(\"ALTER TABLE data_dictionary_tmp RENAME TO data_dictionary\")\n",
    "            CLEAN_PQ.unlink(missing_ok=True); con.execute(f\"COPY \\\"{CLEAN_TBL}\\\" TO '{sql_p(CLEAN_PQ)}' (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 122880)\")\n",
    "            con.execute(\"CHECKPOINT\"); con.execute(\"VACUUM\")\n",
    "            print(f\"[Sync 41 Kolom] Selesai: {CLEAN_DB.name} ({CLEAN_DB.stat().st_size / 1048576:.2f} MB) | {CLEAN_PQ.name} ({CLEAN_PQ.stat().st_size / 1048576:.2f} MB)\")\n",
    "\n",
    "def push_project_to_github(proj_d: Path, repo_url: str, token: str = \"\") -> dict: # 2. Fungsi inisialisasi Git, .gitignore, README, commit, & push\n",
    "    cu = repo_url.strip().rstrip(\"/\")[:-4] if repo_url.strip().rstrip(\"/\").endswith(\".git\") else repo_url.strip().rstrip(\"/\")\n",
    "    if not cu or \"USERNAME_ANDA\" in cu: raise ValueError(\"Isi GH_REPO_URL dengan URL repositori GitHub publik Anda terlebih dahulu.\")\n",
    "    ign = [\"# Abaikan CSV mentah & Parquet perantara Tahap 1-5 agar tidak melebihi batas 100 MB GitHub\", \"*.csv\", \"!output/*.csv\", \"*.zip\", \"output/raw_aves_indonesia.parquet\", \"output/harmonized_aves_indonesia.parquet\", \"output/normalized_taxonomy_aves_indonesia.parquet\", \"output/clean_set_aves_indonesia.parquet\", \"output/quarantine_store_aves_indonesia.parquet\", \"*.wal\", \"*.tmp\", \"__pycache__/\", \".ipynb_checkpoints/\"]\n",
    "    for f in proj_d.rglob(\"*\"): # Deteksi otomatis berkas > 95 MB di dalam folder proyek dan tambahkan ke .gitignore\n",
    "        if f.is_file() and \".git\" not in f.parts and (sz := f.stat().st_size / 1048576) > MAX_MB and (rp := f.relative_to(proj_d).as_posix()) not in ign:\n",
    "            print(f\"[Git Info] Mengabaikan berkas >{MAX_MB:.0f} MB di .gitignore: {rp} ({sz:.2f} MB)\"); ign.append(rp)\n",
    "    (proj_d / \".gitignore\").write_text(\"\\n\".join(ign) + \"\\n\", encoding=\"utf-8\") # Tulis berkas .gitignore\n",
    "\n",
    "    rdm = [ # Susun dokumen README.md standar repositori dataset penelitian skripsi\n",
    "        \"# Pipeline ETL Berbasis FAIR untuk Integrasi Data Biodiversitas dari GBIF: Studi Kasus Aves Indonesia\\n\",\n",
    "        \"- **Judul**: *Rancang Bangun Pipeline ETL Berbasis FAIR untuk Integrasi Data Biodiversitas dari GBIF: Studi Kasus Aves Indonesia*\",\n",
    "        \"- **Peneliti**: Raditya Sajid (Program Studi S1 Sains Data, Departemen Statistika, FMIPA Universitas Brawijaya)\",\n",
    "        \"- **Sumber Data**: Global Biodiversity Information Facility (GBIF) — Kelas *Aves* di Indonesia (`https://doi.org/10.15468/dl.w5dmpc`)\",\n",
    "        f\"- **Otoritas Taksonomi**: *Catalogue of Life eXtended Release* (`checklistKey = {COL_KEY}`)\",\n",
    "        \"- **Total Data Diproses**: `1.551.741` *record* (`1.501.875` *Clean Set* | `49.866` *Quarantine Store*)\\n\",\n",
    "        \"## Struktur Keluaran Utama (`output/`)\",\n",
    "        \"- `final_parquet/occurrence_clean.parquet`: Dataset bersih berformat *Apache Parquet* (41 kolom aktif).\",\n",
    "        \"- `final_parquet/occurrence_quarantine.parquet`: Dataset karantina berformat *Apache Parquet* (55 kolom aktif).\",\n",
    "        \"- `db/clean_store_aves_indonesia.duckdb`: Basis data analitik *DuckDB* untuk *Clean Set*.\",\n",
    "        \"- `db/quarantine_store_aves_indonesia.duckdb`: Basis data analitik *DuckDB* untuk *Quarantine Store*.\",\n",
    "        \"- `07_dataset_metadata_fair.json`: Dokumen metadata deskriptif, lisensi, dan provenansi berstandar FAIR.\",\n",
    "        \"- `07_tabel_2_10_evaluasi_indikator_fair.csv`: Hasil penilaian otomatis 12 indikator *RDA FAIR Data Maturity Model*.\\n\",\n",
    "    ]\n",
    "    (proj_d / \"README.md\").write_text(\"\\n\".join(rdm), encoding=\"utf-8\") # Tulis berkas README.md\n",
    "\n",
    "    r_git = lambda args, chk=True: subprocess.run([\"git\", \"-C\", str(proj_d)] + args, text=True, capture_output=True, check=chk) # Helper CLI Git\n",
    "    if not (proj_d / \".git\").exists(): print(\"[Git] Menginisialisasi repositori Git lokal...\"); r_git([\"init\"])\n",
    "    r_git([\"config\", \"http.postBuffer\", \"524288000\"], False); r_git([\"branch\", \"-M\", \"main\"], False) # Set buffer HTTP 500 MB & branch main\n",
    "    if not r_git([\"config\", \"user.name\"], False).stdout.strip(): r_git([\"config\", \"user.name\", \"Raditya Sajid\"], False) # Set identitas user Git\n",
    "    if not r_git([\"config\", \"user.email\"], False).stdout.strip(): r_git([\"config\", \"user.email\", \"radityasajid@student.ub.ac.id\"], False)\n",
    "    pu = f\"https://{token.strip()}@github.com/{cu.split('github.com/', 1)[1]}.git\" if (token.strip() and \"github.com/\" in cu) else f\"{cu}.git\"\n",
    "    r_git([\"remote\", \"set-url\" if \"origin\" in r_git([\"remote\"], False).stdout.split() else \"add\", \"origin\", pu]) # Atur URL remote origin\n",
    "    print(\"[Git] Menambahkan berkas ke staging area (git add)...\"); r_git([\"add\", \".\"])\n",
    "    if r_git([\"status\", \"--porcelain\"], False).stdout.strip():\n",
    "        print(\"[Git] Membuat commit lokal...\"); r_git([\"commit\", \"-m\", \"Unggah keluaran pipeline ETL Aves Indonesia dan metadata evaluasi FAIR\"])\n",
    "    print(f\"[Git] Mengunggah (git push) ke {cu} ...\")\n",
    "    if (pr := r_git([\"push\", \"-u\", \"origin\", \"main\", \"--force\"], False)).returncode != 0:\n",
    "        raise RuntimeError(f\"Gagal melakukan git push:\\n{pr.stderr}\\nPastikan repo {cu} sudah dibuat (Public) dan akun Git memiliki akses push.\")\n",
    "    if token.strip(): r_git([\"remote\", \"set-url\", \"origin\", f\"{cu}.git\"], False) # Bersihkan token dari konfigurasi remote lokal\n",
    "    sha = r_git([\"rev-parse\", \"HEAD\"], False).stdout.strip(); print(f\"[Git] Berhasil diunggah ke GitHub! Commit SHA: {sha[:10]}\")\n",
    "    return {\"github_https_url\": cu, \"commit_sha\": sha}\n",
    "\n",
    "git_info = push_project_to_github(PROJ_DIR, GH_REPO_URL, GH_TOKEN) # Eksekusi proses sinkronisasi & unggah ke GitHub publik\n",
    "print(f\"\\n[SELESAI] Repo aktif di: {git_info['github_https_url']} (Commit: {git_info['commit_sha'][:10]}). Jalankan kembali Tahap 7 untuk skor FAIR 100%.\")"
