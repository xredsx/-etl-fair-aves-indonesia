    "else:\n",
    "    s_A1_1 = 0.0\n",
    "    bukti_A1_1 = (\n",
    "        \"BELUM TERPENUHI (Skor 0.0): Karena dataset belum diunggah ke GitHub publik, \"\n",
    "        \"akses protokol terbuka bebas biaya secara daring belum aktif.\"\n",
    "    )\n",
    "\n",
    "# --- INTEROPERABLE (I) ---\n",
    "has_i1 = (\n",
    "    CLEAN_PARQUET_FINAL.exists()\n",
    "    and CLEAN_DB_PATH.exists()\n",
    "    and len(pq_col_names) == len(clean_cols)\n",
    "    and len(dwc_present_in_clean) >= 20\n",
    ")\n",
    "s_I1 = 1.0 if has_i1 else 0.0\n",
    "bukti_I1 = (\n",
    "    f\"Tersimpan dalam format terstruktur mesin Apache Parquet ZSTD ({CLEAN_PARQUET_FINAL.name}) dan tabel relasional DuckDB \"\n",
    "    f\"({CLEAN_DB_PATH.name} -> {CLEAN_TABLE}, {len(clean_cols)} kolom) yang mengacu pada Darwin Core.\"\n",
