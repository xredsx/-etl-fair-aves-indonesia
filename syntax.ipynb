   "source": [
    "import json, re, shapely # Modul standar JSON, ekspresi reguler, dan operasi geometri vektor\n",
    "from collections import Counter # Struktur penghitung distribusi frekuensi kategori\n",
    "from datetime import date, datetime # Utilitas tanggal referensi ekstraksi dan konversi kalender\n",
    "from functools import lru_cache # Dekorator memoization untuk mempercepat klasifikasi string tanggal unik\n",
    "from pathlib import Path # Manajemen path berkas lintas platform\n",
    "import numpy as np, pandas as pd, pyarrow as pa, pyarrow.parquet as pq # Library komputasi array, dataframe, dan Apache Parquet\n",
    "import matplotlib.pyplot as plt # Library visualisasi grafik sebaran spasial\n",
    "from shapely import contains_xy # Fungsi C-engine Point-in-Polygon tervekktorisasi\n",
    "from shapely.geometry import shape # Konversi geometri GeoJSON menjadi objek poligon Shapely\n",
    "from shapely.ops import unary_union # Penggabungan multipoligon kepulauan\n",
    "\n",
    "OUT_DIR, CHUNK, EXT_DATE = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"), 100_000, date.today() # Direktori kerja, ukuran batch, & tanggal referensi\n",
    "EXT_ISO, DIST_KM, R_EARTH = EXT_DATE.isoformat(), 1.0, 6371.0088 # String ISO tanggal ekstraksi, toleransi pesisir (1 km), & jari-jari bumi\n",
    "RAW_PQ, HARM_PQ = OUT_DIR / \"raw_aves_indonesia.parquet\", OUT_DIR / \"harmonized_aves_indonesia.parquet\" # Path Parquet input & output Tahap 2\n",
    "T1_REP, T1_CSV = OUT_DIR / \"01_baseline_profile_report.json\", OUT_DIR / \"01_profiling_atribut_target.csv\" # Path laporan baseline Tahap 1\n",
    "ID_GJ, OTH_GJ = OUT_DIR / \"indonesia_land_polygon.geojson\", OUT_DIR / \"other_countries_land_polygon.geojson\" # Cache poligon daratan Tahap 1\n",
    "for p in (RAW_PQ, ID_GJ, OTH_GJ): # Validasi ketersediaan berkas prasyarat dari Tahap 1\n",
    "    if not p.exists(): raise FileNotFoundError(f\"Berkas {p} belum tersedia. Jalankan Tahap 1 terlebih dahulu.\")\n",
    "\n",
    "TARGET_COLS = [\"gbifID\", \"occurrenceID\", \"datasetKey\", \"basisOfRecord\", \"occurrenceStatus\", \"eventDate\", \"year\", \"month\", \"countryCode\", \"stateProvince\", \"decimalLatitude\", \"decimalLongitude\", \"hasCoordinate\", \"hasGeospatialIssues\", \"scientificName\", \"verbatimScientificName\", \"taxonKey\", \"taxonRank\", \"family\", \"genus\", \"species\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\", \"publisher\"] # 26 atribut target\n",
    "NA_SET = {\"\", \"N/A\", \"n/a\", \"NA\", \"na\", \"NULL\", \"null\", \"None\", \"none\", \"-\", \"<NA>\", \"nan\", \"NaN\"} # Penanda nilai kosong (missing markers)\n",
    "DWC_MAP = {c: [c, c.lower()] for c in TARGET_COLS}; DWC_MAP[\"license\"] = [\"license\"] # Pemetaan kandidat nama kolom Darwin Core + license\n",
    "DT_KEYS = [\"VALID_ISO\", \"STANDARDIZED_DETERMINISTIC\", \"STANDARDIZED_TIME_TRUNCATED\", \"WARNING_PARTIAL_OR_INTERVAL\", \"WARNING_AMBIGUOUS\", \"INVALID_FUTURE_DATE\", \"INVALID_UNPARSEABLE\", \"MISSING\"] # 8 status eventDate\n",
    "SP_CLS_ORD = [\"INDONESIA_LAND\", \"SEA_OR_COAST\", \"OTHER_COUNTRY_LAND\", \"OUTSIDE_BBOX\", \"NO_COORD\"] # Urutan kelas daratan spasial\n",
    "SP_ST_ORD = [\"CLEAN_LAND\", \"CLEAN_COASTAL_TOLERANCE\", \"NEEDS_HABITAT_CHECK\", \"NO_COORD\"] # Urutan status awal spasial\n",
    "_edg = [0.0, 0.1, 0.5, DIST_KM, 5.0, 22.224, 100.0]; BIN_EDG = _edg + [np.inf] # Batas interval jarak ke garis pantai terdekat (km)\n",
    "BIN_LBL = [f\"<={_edg[1]:g}\"] + [f\"{a:g}-{b:g}\" for a, b in zip(_edg[1:-1], _edg[2:])] + [f\">{_edg[-1]:g}\"] # Label interval jarak (km)\n",
    "\n",
    "RE_ISO, RE_YMD = re.compile(r\"^(\\d{4})-(\\d{2})-(\\d{2})$\"), re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})$\") # Pola tanggal ISO ketat & YYYY-M-D\n",
    "RE_T00, RE_TS = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})[T\\s]00:00(?::00(?:\\.0+)?)?(?:Z|[+-]\\d{2}:?\\d{2})?$\"), re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})[T\\s](\\d{2}:\\d{2}.*)$\") # Pola timestamp T00:00 & jam spesifik\n",
    "RE_INTV, RE_PART = re.compile(r\"^(\\d{4})-(\\d{1,2})-(\\d{1,2})/(\\d{4})-(\\d{1,2})-(\\d{1,2}).*$\"), re.compile(r\"^\\d{4}(?:-\\d{1,2})?$\") # Pola rentang tanggal & tanggal parsial\n",
    "RE_PINT, RE_SLSH = re.compile(r\"^\\d{4}(?:-\\d{1,2})?(?:T[^/]+)?/\\d{4}(?:-\\d{1,2})?(?:-\\d{1,2})?(?:T.+)?$\"), re.compile(r\"^(\\d{1,2})[-/](\\d{1,2})[-/](\\d{4})$\") # Pola interval parsial & format slash\n",
    "\n",
    "def clean_na(s: pd.Series) -> tuple[pd.Series, int]: # Seragamkan seluruh variasi marker nilai kosong menjadi pd.NA (NULL)\n",
    "    nn = s.notna(); sc = s.astype(\"string\").str.strip(); m = sc.isin(NA_SET) # Deteksi sel berisi string penanda kosong\n",
    "    return sc.mask(m, pd.NA), int((nn & m).sum()) # Kembalikan Series bersih dan jumlah marker yang dikonversi ke NULL\n",
    "\n",
    "def _to_iso(y, m, d) -> str | None: # Konversi komponen tahun, bulan, hari menjadi string YYYY-MM-DD jika valid secara kalender\n",
    "    try: return datetime(int(y), int(m), int(d)).strftime(\"%Y-%m-%d\") # Format ke standar ISO 8601\n",
    "    except ValueError: return None # Kembalikan None jika tanggal tidak valid (misal 31 April)\n",
    "\n",
    "@lru_cache(maxsize=None)\n",
    "def classify_dt_val(s: str) -> tuple[str | None, str]: # Klasifikasi & standardisasi satu string tanggal unik (di-cache di memori)\n",
    "    if not s or s in NA_SET: return None, \"MISSING\" # Nilai kosong\n",
    "    iso, st = None, \"INVALID_UNPARSEABLE\" # Default apabila tidak cocok pola manapun\n",
    "    if (m := RE_ISO.match(s)): iso = _to_iso(m.group(1), m.group(2), m.group(3)); st = \"VALID_ISO\" if iso else st # Sudah YYYY-MM-DD baku\n",
    "    elif (m := RE_T00.match(s) or RE_YMD.match(s)): iso = _to_iso(m.group(1), m.group(2), m.group(3)); st = \"STANDARDIZED_DETERMINISTIC\" if iso else st # T00:00 / 1 digit\n",
    "    elif (m := RE_TS.match(s) or RE_INTV.match(s)): iso = _to_iso(m.group(1), m.group(2), m.group(3)); st = \"STANDARDIZED_TIME_TRUNCATED\" if iso else st # Potong jam/interval\n",
    "    elif RE_PART.match(s) or RE_PINT.match(s): return None, \"WARNING_PARTIAL_OR_INTERVAL\" # Hanya tahun/bulan, biarkan NULL & beri status Warning\n",
    "    elif (m := RE_SLSH.match(s)): # Resolusi tanggal berformat garis miring DD/MM/YYYY atau MM/DD/YYYY\n",
    "        p1, p2, y = int(m.group(1)), int(m.group(2)), int(m.group(3)) # Ekstrak bagian 1, bagian 2, dan tahun\n",
    "        if p1 == p2 and 1 <= p1 <= 12: iso, st = _to_iso(y, p2, p1), \"STANDARDIZED_DETERMINISTIC\" # Hari = bulan, tidak ambigu\n",
    "        elif 1 <= p1 <= 12 and 1 <= p2 <= 12: iso, st = _to_iso(y, p2, p1), \"WARNING_AMBIGUOUS\" # Ambigu DD/MM vs MM/DD\n",
    "        elif p1 > 12 and 1 <= p2 <= 12: iso, st = _to_iso(y, p2, p1), \"STANDARDIZED_DETERMINISTIC\" # Pasti DD/MM/YYYY\n",
    "        elif p2 > 12 and 1 <= p1 <= 12: iso, st = _to_iso(y, p1, p2), \"STANDARDIZED_DETERMINISTIC\" # Pasti MM/DD/YYYY\n",
    "        if not iso: st = \"INVALID_UNPARSEABLE\" # Gagal validasi kalender\n",
    "    if iso is not None and iso > EXT_ISO: return iso, \"INVALID_FUTURE_DATE\" # Tanggal melampaui tanggal ekstraksi\n",
    "    return iso, st # Kembalikan pasangan (string ISO atau None, label status)\n",
    "\n",
    "def std_event_date(s: pd.Series) -> tuple[pd.Series, pd.Series, dict]: # Vektorisasi standardisasi eventDate berbasis nilai unik\n",
    "    res = {v: classify_dt_val(str(v).strip()) for v in s.dropna().unique()} # Proses hanya nilai string tanggal unik\n",
    "    iso_s = s.map({v: r[0] for v, r in res.items()}).astype(\"string\") # Petakan hasil konversi ISO ke seluruh baris\n",
    "    st_s = s.map({v: r[1] for v, r in res.items()}).fillna(\"MISSING\").astype(\"string\"); vc = st_s.value_counts() # Petakan status & hitung frekuensi\n",
    "    return iso_s, st_s, {k: int(vc.get(k, 0)) for k in DT_KEYS} # Kembalikan kolom tanggal ISO, kolom status, dan kamus rekapitulasi\n",
    "\n",
    "BOOL_MAP = {\"TRUE\": True, \"T\": True, \"1\": True, \"YES\": True, \"FALSE\": False, \"F\": False, \"0\": False, \"NO\": False} # Kamus konversi boolean\n",
    "harm_bool = lambda s: s.astype(\"string\").str.strip().str.upper().map(BOOL_MAP).astype(\"boolean\") # Fungsi penyelarasan tipe boolean nullable\n",
    "raw_txt = lambda v: \"(kosong)\" if (v is None or pd.isna(v)) else f'\"{v}\"' # Helper format teks contoh Tabel 2.3\n",
    "proj_km = lambda la, lo: (R_EARTH * np.radians(lo), R_EARTH * np.radians(la)) # Proyeksi equirectangular (derajat ke km di sekitar khatulistiwa)\n",
    "\n",
    "def harm_coord(s: pd.Series) -> tuple[pd.Series, int]: # Standardisasi desimal koma ke titik dan konversi koordinat ke float64\n",
    "    ss = s.astype(\"string\").str.strip(); cf = int(ss.str.contains(\",\", na=False).sum()) # Hitung jumlah koordinat berformat koma\n",
    "    return pd.to_numeric(ss.str.replace(\",\", \".\", regex=False), errors=\"coerce\").astype(\"float64\"), cf # Konversi ke float64\n",
    "\n",
    "id_poly = unary_union([shape(ft[\"geometry\"]) for ft in json.loads(ID_GJ.read_text(encoding=\"utf-8\"))[\"features\"]]); shapely.prepare(id_poly) # Poligon daratan IDN\n",
    "oth_poly = unary_union([shape(ft[\"geometry\"]) for ft in json.loads(OTH_GJ.read_text(encoding=\"utf-8\"))[\"features\"]]); shapely.prepare(oth_poly) # Poligon negara lain\n",
    "_polys = list(id_poly.geoms) if hasattr(id_poly, \"geoms\") else [id_poly] # Pecah MultiPolygon daratan Indonesia menjadi daftar poligon pulau\n",
    "id_tree = shapely.STRtree(shapely.transform(np.array(_polys, dtype=object), lambda c: np.column_stack(proj_km(c[:, 1], c[:, 0])))) # Indeks spasial STRtree (km)\n",
    "_sp_cache = {} # Cache global koordinat unik: (lat, lon) -> (spatialLandClass, distanceToIndonesiaLandKm)\n",
    "\n",
    "def map_spatial(lat: pd.Series, lon: pd.Series) -> pd.DataFrame: # Pemetaan kelas daratan, jarak ke garis pantai (km), & status awal spasial\n",
    "    out = pd.DataFrame({\"cls\": \"NO_COORD\", \"dist\": np.nan}, index=lat.index) # Default untuk baris tanpa koordinat valid\n",
    "    val = (lat.notna() & lon.notna() & ~((lat == 0.0) & (lon == 0.0))).to_numpy() # Masker baris dengan koordinat numerik non-(0,0)\n",
    "    if val.any(): # Proses hanya bila terdapat koordinat valid pada batch\n",
    "        pts = pd.DataFrame({\"lat\": lat.to_numpy()[val], \"lon\": lon.to_numpy()[val]}) # Pasangan koordinat valid pada batch\n",
    "        unq = pts.drop_duplicates().reset_index(drop=True); keys = list(zip(unq[\"lat\"], unq[\"lon\"])) # Ekstrak titik unik pada batch\n",
    "        new_k = [k for k in keys if k not in _sp_cache] # Saring hanya titik koordinat baru yang belum ada di _sp_cache\n",
    "        if new_k: # Hitung poligon dan jarak STRtree hanya untuk titik unik baru (sangat cepat)\n",
    "            la, lo = np.array([k[0] for k in new_k], dtype=\"float64\"), np.array([k[1] for k in new_k], dtype=\"float64\") # Array koordinat baru\n",
    "            in_bb = (la >= -11.5) & (la <= 6.5) & (lo >= 94.5) & (lo <= 141.5) # Uji bounding box Indonesia\n",
    "            cls = np.where(~in_bb, \"OUTSIDE_BBOX\", np.where(contains_xy(id_poly, lo, la), \"INDONESIA_LAND\", np.where(contains_xy(oth_poly, lo, la), \"OTHER_COUNTRY_LAND\", \"SEA_OR_COAST\"))) # Klasifikasi daratan\n",
    "            dst = np.zeros(len(new_k)); nd = cls != \"INDONESIA_LAND\" # Titik di daratan Indonesia berjarak 0 km\n",
    "            if nd.any(): # Hitung jarak terdekat (km) ke poligon daratan Indonesia untuk titik di laut/luar daratan\n",
    "                x, y = proj_km(la[nd], lo[nd]); idx, d_km = id_tree.query_nearest(shapely.points(x, y), return_distance=True, all_matches=False)\n",
    "                tmp = np.full(int(nd.sum()), np.nan); tmp[idx[0]] = d_km; dst[nd] = tmp # Simpan jarak terdekat (km)\n",
    "            for k, c, d in zip(new_k, cls, dst): _sp_cache[k] = (str(c), float(d)) # Simpan ke kamus cache global\n",
    "        unq[\"cls\"], unq[\"dist\"] = [_sp_cache[k][0] for k in keys], [_sp_cache[k][1] for k in keys] # Ambil hasil dari cache\n",
    "        mrg = pts.merge(unq, on=[\"lat\", \"lon\"], how=\"left\"); out.loc[val, \"cls\"], out.loc[val, \"dist\"] = mrg[\"cls\"].to_numpy(), mrg[\"dist\"].to_numpy() # Gabung kembali\n",
    "    out[\"status\"] = np.select([out[\"cls\"] == \"NO_COORD\", out[\"cls\"] == \"INDONESIA_LAND\", out[\"dist\"] <= DIST_KM], [\"NO_COORD\", \"CLEAN_LAND\", \"CLEAN_COASTAL_TOLERANCE\"], default=\"NEEDS_HABITAT_CHECK\") # Status awal spasial\n",
    "    return out # Kembalikan DataFrame 3 kolom spasial\n",
    "\n",
    "HARM_PQ.unlink(missing_ok=True); pf = pq.ParquetFile(RAW_PQ); raw_cols = set(pf.schema.names) # Buka Raw Parquet hasil Tahap 1\n",
    "res_cols = {tc: next((c for c in cands if c in raw_cols), None) for tc, cands in DWC_MAP.items()} # Resolusi nama kolom sumber\n",
    "if any(res_cols[c] is None for c in TARGET_COLS): raise ValueError(\"Kolom wajib tidak lengkap di Raw Parquet. Jalankan ulang Tahap 1.\") # Validasi skema\n",
    "read_cols = [s for s in res_cols.values() if s is not None] # Daftar kolom yang dibaca dari Raw Parquet\n",
    "\n",
    "HARM_SCH = pa.schema([(\"gbifID\", pa.string()), (\"occurrenceID\", pa.string()), (\"basisOfRecord\", pa.string()), (\"occurrenceStatus\", pa.string()), (\"eventDate\", pa.string()), (\"eventDateParsed\", pa.date32()), (\"verbatimEventDateRaw\", pa.string()), (\"eventDateParseStatus\", pa.string()), (\"year\", pa.int64()), (\"month\", pa.int64()), (\"countryCode\", pa.string()), (\"stateProvince\", pa.string()), (\"decimalLatitude\", pa.float64()), (\"decimalLongitude\", pa.float64()), (\"hasCoordinate\", pa.bool_()), (\"hasGeospatialIssues\", pa.bool_()), (\"scientificName\", pa.string()), (\"verbatimScientificName\", pa.string()), (\"taxonKey\", pa.string()), (\"taxonRank\", pa.string()), (\"family\", pa.string()), (\"genus\", pa.string()), (\"species\", pa.string()), (\"institutionCode\", pa.string()), (\"collectionCode\", pa.string()), (\"catalogNumber\", pa.string()), (\"recordedBy\", pa.string()), (\"publisher\", pa.string()), (\"datasetKey\", pa.string()), (\"license\", pa.string()), (\"spatialLandClass\", pa.string()), (\"distanceToIndonesiaLandKm\", pa.float64()), (\"spatialPreliminaryStatus\", pa.string())]) # Skema PyArrow 33 kolom\n",
    "writer = pq.ParquetWriter(HARM_PQ, HARM_SCH, compression=\"snappy\"); ord_cols = [f.name for f in HARM_SCH] # Inisialisasi penulis Parquet Tahap 2\n",
    "\n",
    "n_harm = lat_cf = lon_cf = 0; na_conv, null_aft = {c: 0 for c in DWC_MAP}, {c: 0 for c in DWC_MAP} # Counter konversi NULL & perbaikan koma\n",
    "dt_tot, ex_2_3 = {k: 0 for k in DT_KEYS}, {}; sp_cls_cnt, sp_st_cnt, off_pts = Counter(), Counter(), Counter() # Counter temporal, contoh, & spasial\n",
    "dist_bins = {lab: 0 for lab in BIN_LBL} # Counter distribusi jarak titik di luar daratan\n",
    "\n",
    "for b_idx, batch in enumerate(pf.iter_batches(batch_size=CHUNK, columns=read_cols), start=1): # Proses streaming per 100.000 baris\n",
    "    rdf = batch.to_pandas(); n_harm += len(rdf); hdf = pd.DataFrame(index=rdf.index) # Konversi batch ke DataFrame Pandas\n",
    "    for tc, sc in res_cols.items(): # Seragamkan marker nilai kosong menjadi pd.NA pada seluruh atribut target + license\n",
    "        if sc and sc in rdf.columns: hdf[tc], nc = clean_na(rdf[sc]); na_conv[tc] += nc # Bersihkan marker N/A & catat jumlah konversinya\n",
    "        else: hdf[tc] = pd.Series(pd.NA, index=rdf.index, dtype=\"string\") # Isi pd.NA jika kolom opsional tidak tersedia\n",
    "    hdf[\"verbatimEventDateRaw\"] = hdf[\"eventDate\"] # Simpan teks asli eventDate sebelum dimodifikasi\n",
    "    iso_s, pst_s, st_c = std_event_date(hdf[\"eventDate\"]); hdf[\"eventDate\"], hdf[\"eventDateParseStatus\"] = iso_s, pst_s # Standardisasi ISO 8601\n",
    "    hdf[\"eventDateParsed\"] = pd.to_datetime(iso_s, format=\"%Y-%m-%d\", errors=\"coerce\").dt.date # Kolom bertipe date32 murni\n",
    "    for k, v in st_c.items(): dt_tot[k] += v # Akumulasi statistik status standardisasi tanggal\n",
    "    hdf[\"year\"], hdf[\"month\"] = pd.to_numeric(hdf[\"year\"], errors=\"coerce\").astype(\"Int64\"), pd.to_numeric(hdf[\"month\"], errors=\"coerce\").astype(\"Int64\") # Tipe Int64\n",
    "    hdf[\"decimalLatitude\"], n_la = harm_coord(hdf[\"decimalLatitude\"]); hdf[\"decimalLongitude\"], n_lo = harm_coord(hdf[\"decimalLongitude\"]) # Tipe float64\n",
    "    lat_cf += n_la; lon_cf += n_lo; hdf[\"hasCoordinate\"], hdf[\"hasGeospatialIssues\"] = harm_bool(hdf[\"hasCoordinate\"]), harm_bool(hdf[\"hasGeospatialIssues\"]) # Tipe boolean\n",
    "\n",
    "    sp = map_spatial(hdf[\"decimalLatitude\"], hdf[\"decimalLongitude\"]) # Hitung klasifikasi daratan dan jarak ke pantai terdekat\n",
    "    hdf[\"spatialLandClass\"], hdf[\"distanceToIndonesiaLandKm\"], hdf[\"spatialPreliminaryStatus\"] = sp[\"cls\"].astype(\"string\"), sp[\"dist\"].astype(\"float64\"), sp[\"status\"].astype(\"string\")\n",
    "    sp_cls_cnt.update(sp[\"cls\"].value_counts().to_dict()); sp_st_cnt.update(sp[\"status\"].value_counts().to_dict()) # Update counter spasial\n",
    "    off_m = sp[\"cls\"].isin([\"OTHER_COUNTRY_LAND\", \"SEA_OR_COAST\", \"OUTSIDE_BBOX\"]) # Masker titik di luar poligon daratan Indonesia\n",
    "    if off_m.any(): # Akumulasi distribusi bin jarak (km) dan daftar koordinat lepas pantai untuk visualisasi peta\n",
    "        bi, bc = np.unique(np.digitize(sp.loc[off_m, \"dist\"].to_numpy(), BIN_EDG[1:-1], right=True), return_counts=True)\n",
    "        for i, c in zip(bi, bc): dist_bins[BIN_LBL[i]] += int(c) # Tambahkan ke bin jarak yang sesuai\n",
    "        off_pts.update(zip(hdf.loc[off_m, \"decimalLatitude\"], hdf.loc[off_m, \"decimalLongitude\"])) # Simpan titik unik di luar daratan\n",
    "\n",
    "    s_occ = res_cols.get(\"occurrenceID\") # Ambil sampel riil perubahan data untuk Tabel 2.3 (1 kali saja saat pertama ditemukan)\n",
    "    if \"occurrenceID\" not in ex_2_3 and s_occ:\n",
    "        m_o = rdf[s_occ].isna() | rdf[s_occ].astype(\"string\").str.strip().isin(NA_SET)\n",
    "        if m_o.any(): ex_2_3[\"occurrenceID\"] = {\"Kolom\": \"occurrenceID\", \"Sebelum\": f\"{raw_txt(rdf[s_occ][m_o].iloc[0])} (kosong pada CSV sumber)\", \"Sesudah\": \"NULL (pd.NA)\", \"Perubahan\": \"Nilai kosong diseragamkan menjadi NULL\"}\n",
    "    if \"eventDate_T00\" not in ex_2_3 and (m_t0 := (hdf[\"eventDateParseStatus\"] == \"STANDARDIZED_DETERMINISTIC\") & hdf[\"verbatimEventDateRaw\"].str.match(RE_T00.pattern, na=False)).any():\n",
    "        r = hdf[m_t0].iloc[0]; ex_2_3[\"eventDate_T00\"] = {\"Kolom\": \"eventDate (T00:00)\", \"Sebelum\": f'\"{r[\"verbatimEventDateRaw\"]}\" (string)', \"Sesudah\": f'{r[\"eventDate\"]} (date32)', \"Perubahan\": \"Standardisasi deterministik waktu T00:00 ke ISO 8601\"}\n",
    "    if \"eventDate_Trunc\" not in ex_2_3 and (m_tr := hdf[\"eventDateParseStatus\"] == \"STANDARDIZED_TIME_TRUNCATED\").any():\n",
    "        r = hdf[m_tr].iloc[0]; ex_2_3[\"eventDate_Trunc\"] = {\"Kolom\": \"eventDate (Waktu Spesifik)\", \"Sebelum\": f'\"{r[\"verbatimEventDateRaw\"]}\" (string)', \"Sesudah\": f'{r[\"eventDate\"]} (date32)', \"Perubahan\": \"Pemotongan komponen jam ke tanggal ISO 8601 (jam asli di verbatimEventDateRaw)\"}\n",
    "    if \"eventDate_Partial\" not in ex_2_3 and (m_pt := hdf[\"eventDateParseStatus\"] == \"WARNING_PARTIAL_OR_INTERVAL\").any():\n",
    "        r = hdf[m_pt].iloc[0]; ex_2_3[\"eventDate_Partial\"] = {\"Kolom\": \"eventDate (Parsial/Interval)\", \"Sebelum\": f'\"{r[\"verbatimEventDateRaw\"]}\" (string)', \"Sesudah\": \"NULL (Warning: Partial/Interval)\", \"Perubahan\": \"Tanggal parsial tidak dikarang ke 01-01; ditandai sebagai Warning\"}\n",
    "    if \"decimalLatitude\" not in ex_2_3 and res_cols.get(\"decimalLatitude\") and hdf[\"decimalLatitude\"].notna().any():\n",
    "        ix = hdf[\"decimalLatitude\"].first_valid_index(); ex_2_3[\"decimalLatitude\"] = {\"Kolom\": \"decimalLatitude\", \"Sebelum\": f'{raw_txt(rdf.at[ix, res_cols[\"decimalLatitude\"]])} (string)', \"Sesudah\": f'{hdf.at[ix, \"decimalLatitude\"]} (float64)', \"Perubahan\": \"Penyelarasan tipe data teks ke float64\"}\n",
    "    if \"hasCoordinate\" not in ex_2_3 and res_cols.get(\"hasCoordinate\") and hdf[\"hasCoordinate\"].notna().any():\n",
    "        ix = hdf[\"hasCoordinate\"].first_valid_index(); ex_2_3[\"hasCoordinate\"] = {\"Kolom\": \"hasCoordinate\", \"Sebelum\": f'{raw_txt(rdf.at[ix, res_cols[\"hasCoordinate\"]])} (string)', \"Sesudah\": f'{hdf.at[ix, \"hasCoordinate\"]} (boolean)', \"Perubahan\": \"Penyelarasan tipe data teks ke boolean\"}\n",
    "\n",
    "    for uc in [\"basisOfRecord\", \"occurrenceStatus\", \"countryCode\", \"taxonRank\"]: hdf[uc] = hdf[uc].astype(\"string\").str.strip().str.upper() # Kapitalisasi kode standar\n",
    "    for c in DWC_MAP: null_aft[c] += int(hdf[c].isna().sum()) # Hitung total NULL sesudah harmonisasi per kolom\n",
    "    writer.write_table(pa.Table.from_pandas(hdf[ord_cols], schema=HARM_SCH, preserve_index=False)) # Tulis batch ke Parquet terharmonisasi\n",
    "    print(f\"  [Batch {b_idx:02d}] {n_harm:,} record selesai diharmonisasi...\") # Cetak progres batch\n",
    "writer.close() # Tutup file Parquet Tahap 2\n",
    "\n",
    "cons = {\"tahap1_total_records\": None, \"tahap2_total_records\": int(n_harm), \"total_records_match\": None, \"columns_with_fewer_nulls_than_raw\": []} # Struktur audit konsistensi\n",
    "if T1_REP.exists(): # Verifikasi silang jumlah baris dan distribusi kelas spasial terhadap laporan JSON Tahap 1\n",
    "    t1_j = json.loads(T1_REP.read_text(encoding=\"utf-8\")); t1_tot = t1_j.get(\"total_records\")\n",
    "    t1_sp = t1_j.get(\"baseline_details_with_warning_excluded\", {}).get(\"spatial_baseline_breakdown\", {})\n",
    "    if t1_sp:\n",
    "        exp = {\"INDONESIA_LAND\": t1_sp.get(\"VALID_INDONESIA_LAND_POLYGON\", 0) + t1_sp.get(\"INVALID_GEOSPATIAL_ISSUE_FLAG\", 0), \"SEA_OR_COAST\": t1_sp.get(\"WARNING_OR_INVALID_SEA_AREA\", 0), \"OTHER_COUNTRY_LAND\": t1_sp.get(\"INVALID_OTHER_COUNTRY_LAND\", 0), \"OUTSIDE_BBOX\": t1_sp.get(\"INVALID_OUTSIDE_INDONESIA_BBOX\", 0), \"NO_COORD\": t1_sp.get(\"INVALID_MISSING_COORD\", 0) + t1_sp.get(\"INVALID_ZERO_COORD\", 0)}\n",
    "        cons[\"spatial_class_vs_tahap1\"] = {k: {\"tahap1\": int(v), \"tahap2\": int(sp_cls_cnt.get(k, 0)), \"match\": int(v) == int(sp_cls_cnt.get(k, 0))} for k, v in exp.items()}\n",
    "    cons[\"tahap1_total_records\"], cons[\"total_records_match\"] = t1_tot, (t1_tot == n_harm)\n",
    "\n",
    "raw_miss = dict(zip((df_t1 := pd.read_csv(T1_CSV))[\"Atribut_Darwin_Core\"], df_t1[\"Jumlah_Missing\"])) if T1_CSV.exists() else {} # Ambil jumlah missing Tahap 1\n",
    "df_ex = pd.DataFrame(list(ex_2_3.values())); df_ex.to_csv(OUT_DIR / \"02_tabel_2_3_contoh_sebelum_sesudah_harmonisasi.csv\", index=False) # Simpan CSV Tabel 2.3\n",
    "sch_rows = [] # Susun tabel perbandingan tipe data dan jumlah NULL sebelum vs sesudah harmonisasi\n",
    "for idx, col in enumerate(TARGET_COLS, start=1):\n",
    "    nc, rm = null_aft[col], raw_miss.get(col); add_n = (nc - int(rm)) if rm is not None else None\n",
    "    if add_n is not None and add_n < 0: cons[\"columns_with_fewer_nulls_than_raw\"].append(col)\n",
    "    sch_rows.append({\"No\": idx, \"Atribut_Darwin_Core\": col, \"Tipe_Data_Sesudah\": str(HARM_SCH.field(col).type), \"Jumlah_Missing_Raw_Tahap1\": rm, \"Marker_Missing_Diseragamkan_ke_NULL\": na_conv[col], \"Jumlah_NULL_Sesudah\": nc, \"Tambahan_NULL_Akibat_Konversi\": add_n, \"Persentase_Terisi (%)\": round((n_harm - nc) / n_harm * 100, 4)})\n",
    "pd.DataFrame(sch_rows).to_csv(OUT_DIR / \"02_skema_atribut_terharmonisasi.csv\", index=False) # Simpan CSV skema atribut terharmonisasi\n",
    "\n",
    "(OUT_DIR / \"02_harmonization_report.json\").write_text(json.dumps({\"total_records_harmonized\": n_harm, \"extraction_date_reference\": EXT_ISO, \"eventDate_standardization\": dt_tot, \"coordinate_comma_fixed\": {\"latitude\": lat_cf, \"longitude\": lon_cf}, \"missing_marker_conversions_target_cols\": {c: int(na_conv[c]) for c in TARGET_COLS}, \"spatial_mapping\": {\"distance_clean_threshold_km\": DIST_KM, \"class_counts\": {k: int(sp_cls_cnt.get(k, 0)) for k in SP_CLS_ORD}, \"preliminary_status_counts\": {k: int(sp_st_cnt.get(k, 0)) for k in SP_ST_ORD}, \"offland_records_by_distance_km\": dist_bins}, \"consistency_check_vs_tahap1\": cons, \"real_examples_table_2_3\": list(ex_2_3.values())}, indent=2, default=str), encoding=\"utf-8\") # Simpan JSON laporan Tahap 2\n",
    "print(f\"\\n[TAHAP 2 SELESAI] Total Record: {n_harm:,} | Clean Land: {sp_st_cnt['CLEAN_LAND']:,} | Coastal <=1km: {sp_st_cnt['CLEAN_COASTAL_TOLERANCE']:,} | Needs Habitat Check: {sp_st_cnt['NEEDS_HABITAT_CHECK']:,}\") # Ringkasan konsol\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(21, 6.5), gridspec_kw={\"width_ratios\": [1, 1, 1.3]}) # Siapkan kanvas grafik 3 panel Tahap 2\n",
    "st_v = [int(sp_st_cnt.get(k, 0)) for k in SP_ST_ORD]; yp = np.arange(len(SP_ST_ORD)) # Data Panel 1: Status awal spasial\n",
    "axes[0].barh(yp, st_v, color=[\"#2a9d8f\", \"#8ecae6\", \"#d62828\", \"#adb5bd\"]); axes[0].set_yticks(yp); axes[0].set_yticklabels(SP_ST_ORD, fontsize=8); axes[0].invert_yaxis(); axes[0].set_xlim(0, max(st_v) * 1.4); axes[0].set_title(\"Status awal spasial\") # Plot Panel 1\n",
    "for y_i, v in zip(yp, st_v): axes[0].text(v, y_i, f\" {v:,} ({v / n_harm * 100:.2f}%)\", va=\"center\", fontsize=8) # Label jumlah & % Panel 1\n",
    "d_v = np.array([dist_bins[l] for l in BIN_LBL], dtype=float); d_p = d_v / d_v.sum() * 100 if d_v.sum() > 0 else d_v # Data Panel 2: Distribusi jarak\n",
    "bars = axes[1].bar(BIN_LBL, d_p, color=[\"#2a9d8f\" if BIN_EDG[i + 1] <= DIST_KM else \"#d62828\" for i in range(len(BIN_LBL))]); axes[1].set_ylim(0, max(d_p.max() * 1.25, 1) if len(d_p) else 1); axes[1].set_title(f\"Sebaran jarak (hijau: <= {DIST_KM:g} km, bersih)\") # Plot Panel 2\n",
    "for b, v, n in zip(bars, d_p, d_v): axes[1].text(b.get_x() + b.get_width() / 2, v, f\"{v:.1f}%\\n({int(n):,})\", ha=\"center\", va=\"bottom\", fontsize=8) # Label Panel 2\n",
    "plt.setp(axes[1].get_xticklabels(), rotation=20, ha=\"right\", fontsize=8); simp = id_poly.simplify(0.02) # Sederhanakan garis pantai untuk plot peta Panel 3\n",
    "for gm in (simp.geoms if hasattr(simp, \"geoms\") else [simp]): gx, gy = gm.exterior.xy; axes[2].fill(gx, gy, color=\"#e9ecef\", zorder=0); axes[2].plot(gx, gy, color=\"#adb5bd\", linewidth=0.3, zorder=1) # Gambar peta dasar Indonesia\n",
    "if off_pts: # Plot sebaran titik koordinat unik di luar daratan Indonesia (hijau <= 1 km, merah > 1 km)\n",
    "    ok = list(off_pts.keys()); ola, olo, odi = np.array([k[0] for k in ok]), np.array([k[1] for k in ok]), np.array([_sp_cache[k][1] for k in ok])\n",
    "    iw = (ola >= -12) & (ola <= 7) & (olo >= 94) & (olo <= 142); nm, fm = iw & (odi <= DIST_KM), iw & (odi > DIST_KM) # Filter jendela peta Indonesia\n",
    "    axes[2].scatter(olo[nm], ola[nm], s=3, color=\"#2a9d8f\", alpha=0.6, zorder=2, label=f\"<= {DIST_KM:g} km ({int(nm.sum()):,} titik unik)\") # Titik pesisir <= 1 km\n",
    "    axes[2].scatter(olo[fm], ola[fm], s=5, color=\"#d62828\", alpha=0.7, zorder=3, label=f\"> {DIST_KM:g} km ({int(fm.sum()):,} titik unik)\") # Titik laut > 1 km\n",
    "    axes[2].legend(loc=\"lower left\", fontsize=8); axes[2].set_title(f\"Peta titik di luar daratan Indonesia ({int((~iw).sum()):,} titik di luar peta)\") # Judul Panel 3\n",
    "axes[2].set_xlim(94, 142); axes[2].set_ylim(-12, 7); axes[2].set_aspect(\"equal\"); plt.tight_layout(); plt.savefig(OUT_DIR / \"02_grafik_sebaran_spasial.png\", dpi=200); plt.show() # Simpan PNG"
   ]
  },
