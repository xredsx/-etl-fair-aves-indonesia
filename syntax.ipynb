    "            \"reference_backbone\": f\"Catalogue of Life eXtended Release (COL XR, checklistKey={COL_CHECKLIST_KEY}) via GBIF Species Match API v2\",\n",
    "        },\n",
    "        \"spatial_coverage\": {\n",
    "            \"country\": \"Indonesia (ID)\",\n",
    "            \"min_latitude\": round(float(spatial_temporal[0]), 6) if spatial_temporal[0] is not None else None,\n",
    "            \"max_latitude\": round(float(spatial_temporal[1]), 6) if spatial_temporal[1] is not None else None,\n",
    "            \"min_longitude\": round(float(spatial_temporal[2]), 6) if spatial_temporal[2] is not None else None,\n",
    "            \"max_longitude\": round(float(spatial_temporal[3]), 6) if spatial_temporal[3] is not None else None,\n",
    "            \"distinct_provinces\": int(spatial_temporal[11] or 0),\n",
    "        },\n",
    "        \"temporal_coverage\": {\n",
    "            \"min_eventDate_iso8601\": str(spatial_temporal[4]) if spatial_temporal[4] is not None else None,\n",
    "            \"max_eventDate_iso8601\": str(spatial_temporal[5]) if spatial_temporal[5] is not None else None,\n",
    "            \"min_year\": int(spatial_temporal[6]) if spatial_temporal[6] is not None else None,\n",
    "            \"max_year\": int(spatial_temporal[7]) if spatial_temporal[7] is not None else None,\n",
    "        },\n",
    "        \"record_counts\": {\n",
    "            \"total_records_processed\": int(n_clean_total + n_quar_total),\n",
    "            \"clean_set_records\": int(n_clean_total),\n",
    "            \"clean_routing_breakdown\": {k: int(v) for k, v in routing_dist.items()},\n",
    "            \"quarantine_store_records\": int(n_quar_total),\n",
    "        },\n",
    "        \"data_quality_before_vs_after_etl\": df_delta_x.to_dict(orient=\"records\") if not df_delta_x.empty else [],\n",
    "    },\n",
    "    \"F3_data_identifiers_and_distributions\": {\n",
    "        \"described_dataset_id\": dataset_pid,\n",
    "        \"distributions\": [\n",
    "            {\n",
    "                \"artifact_role\": \"Clean Set DuckDB Database\",\n",
    "                \"file_name\": CLEAN_DB_PATH.name,\n",
    "                \"table_name\": CLEAN_TABLE,\n",
    "                \"format\": \"DuckDB\",\n",
    "                \"records\": int(n_clean_total),\n",
    "                \"columns\": len(clean_cols),\n",
    "            },\n",
    "            {\n",
    "                \"artifact_role\": \"Clean Set Final Parquet\",\n",
    "                \"file_name\": CLEAN_PARQUET_FINAL.name,\n",
    "                \"format\": \"Apache Parquet (ZSTD)\",\n",
    "                \"sha256\": clean_parquet_sha256,\n",
    "                \"records\": int(n_clean_total),\n",
    "            },\n",
    "            {\n",
    "                \"artifact_role\": \"Quarantine Store DuckDB Database\",\n",
    "                \"file_name\": QUARANTINE_DB_PATH.name,\n",
    "                \"table_name\": QUARANTINE_TABLE,\n",
    "                \"format\": \"DuckDB\",\n",
    "                \"records\": int(n_quar_total),\n",
    "            },\n",
    "            {\n",
    "                \"artifact_role\": \"Quarantine Store Final Parquet\",\n",
    "                \"file_name\": QUARANTINE_PARQUET_FINAL.name,\n",
    "                \"format\": \"Apache Parquet (ZSTD)\",\n",
    "                \"sha256\": quar_parquet_sha256,\n",
    "                \"records\": int(n_quar_total),\n",
    "            },\n",
    "        ],\n",
    "    },\n",
    "    \"A1_access_protocol_and_github_status\": {\n",
    "        \"access_protocol\": \"HTTPS (GitHub Public Repository)\" if github_status[\"http_accessible\"] else \"Local File System (Belum Diunggah ke GitHub)\",\n",
    "        \"github_uploaded_and_verified\": bool(github_status[\"http_accessible\"] and github_status[\"github_has_files_online\"]),\n",
    "        \"github_url\": github_status[\"github_https_url\"],\n",
    "        \"http_status_code\": github_status[\"http_status_code\"],\n",
    "        \"open_free_access\": bool(github_status[\"is_open_free_access\"]),\n",
    "        \"detection_summary\": github_status[\"detail_message\"],\n",
    "    },\n",
    "    \"I1_I2_I3_interoperability_and_standards\": {\n",
    "        \"machine_readable_formats\": [\"Apache Parquet (ZSTD)\", \"DuckDB Relational Table\", \"JSON Metadata\"],\n",
    "        \"community_standard\": \"Darwin Core (DwC) Simple Darwin Core\",\n",
    "        \"vocabulary_authorities\": [\n",
    "            \"Darwin Core Terms (tdwg.org)\",\n",
    "            f\"Catalogue of Life eXtended Release (COL XR, checklistKey={COL_CHECKLIST_KEY})\",\n",
    "        ],\n",
    "        \"darwin_core_columns_active\": dwc_present_in_clean,\n",
    "        \"darwin_core_columns_merged_deduplicated\": merged_dwc_names,\n",
    "        \"qualified_references_coverage\": {\n",
    "            \"taxonKey_populated_records\": int(qref_stats[0]),\n",
    "            \"taxonKey_coverage_pct\": round(qref_stats[0] * 100.0 / n_clean_total, 4) if n_clean_total else 0.0,\n",
    "            \"datasetKey_populated_records\": int(qref_stats[1]),\n",
    "            \"datasetKey_coverage_pct\": round(qref_stats[1] * 100.0 / n_clean_total, 4) if n_clean_total else 0.0,\n",
    "        },\n",
    "    },\n",
    "    \"R1_1_license_and_usage_terms\": {\n",
    "        \"dataset_curation_license\": \"CC-BY-4.0 (mengikuti atribusi sumber GBIF pada tiap record)\",\n",
    "        \"record_level_license_column\": \"license\",\n",
    "        \"record_level_license_populated_pct\": round(qref_stats[2] * 100.0 / n_clean_total, 4) if n_clean_total else 0.0,\n",
    "        \"record_level_license_distribution\": {str(k): int(v) for k, v in license_dist.items()},\n",
    "    },\n",
    "    \"R1_2_provenance\": {\n",
    "        \"primary_source\": \"Global Biodiversity Information Facility (GBIF) Occurrence Download (Simple CSV, Taxonomy: Catalogue of Life) - Class Aves, Country ID\",\n",
    "        \"record_level_provenance_columns\": [\n",
    "            c for c in [\"gbifID\", \"occurrenceID\", \"datasetKey\", \"publisher\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\"]\n",
    "            if c in clean_col_set\n",
    "        ],\n",
    "        \"etl_pipeline_stages\": [\n",
    "            \"Tahap 1: Ekstraksi & Ingesti Data Mentah GBIF Simple CSV Aves Indonesia (26 Atribut Target + 3 Kolom Turunan: hasCoordinate, hasGeospatialIssues, publisher)\",\n",
    "            \"Tahap 2: Harmonisasi Skema Darwin Core, Normalisasi Temporal ISO 8601 (eventDate), & Klasifikasi Spasial Daratan/Pesisir Indonesia\",\n",
    "            f\"Tahap 3: Resolusi Taksonomi terhadap Catalogue of Life (COL XR, checklistKey={COL_CHECKLIST_KEY}) via GBIF Species Match API v2, Pembentukan acceptedScientificName/acceptedTaxonKey/taxonomicStatus, & Evaluasi Habitat Spasial Spesies\",\n",
    "            \"Tahap 4: Evaluasi Multi-Dimensi Kualitas Data (Completeness, Uniqueness, Spatial, Taxonomy, Metadata-Temporal)\",\n",
    "            \"Tahap 5: Routing Record Otomatis ke Clean Set (Clean & Warning) dan Quarantine Store beserta Invalid_Reasons\",\n",
    "            \"Tahap 6: Deduplikasi Kolom Identik, Pemuatan ke DuckDB, Pembuatan Kamus Data (data_dictionary), & Ekspor Parquet ZSTD\",\n",
    "        ],\n",
    "    },\n",
    "}\n",
    "\n",
    "with open(METADATA_JSON_PATH, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(dataset_metadata_fair, f, indent=2, ensure_ascii=False)\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. EVALUASI OTOMATIS 12 INDIKATOR FAIR (TABEL 2.10) & PERHITUNGAN RUMUS (2.8 & 2.9)\n",
    "# ==============================================================================\n",
    "pq_schema = pq.read_schema(CLEAN_PARQUET_FINAL)\n",
    "pq_col_names = pq_schema.names\n",
    "\n",
    "# --- FINDABLE (F) ---\n",
    "has_pid_in_meta = bool(dataset_metadata_fair[\"F1_persistent_identifier\"][\"dataset_id\"])\n",
    "has_record_ids = qref_stats[3] == n_clean_total  # occurrenceID & gbifID 100% terisi\n",
    "if PERSISTENT_DOI_OR_PID_MANUAL.strip() or (github_status[\"http_accessible\"] and github_status[\"github_has_files_online\"]):\n",
    "    s_F1 = 1.0\n",
    "    bukti_F1 = (\n",
    "        f\"Terpenuhi penuh: Dataset memiliki identifier persisten publik ({dataset_pid}), \"\n",
    "        f\"checksum SHA-256 ({clean_parquet_sha256[:16]}...), serta gbifID & occurrenceID unik pada 100% ({n_clean_total:,}) record.\"\n",
    "    )\n",
    "else:\n",
    "    s_F1 = 1.0 if has_pid_in_meta and has_record_ids else 0.5\n",
    "    bukti_F1 = (\n",
    "        f\"Dataset memiliki identifier unik berbasis SHA-256 ({dataset_pid}) pada 07_dataset_metadata_fair.json \"\n",
    "        f\"serta gbifID & occurrenceID unik pada 100% ({n_clean_total:,}) record.\"\n",
    "    )\n",
    "\n",
    "desc_meta = dataset_metadata_fair[\"F2_R1_descriptive_metadata\"]\n",
    "has_f2_all = all([\n",
    "    bool(desc_meta.get(\"title\")),\n",
    "    bool(desc_meta.get(\"description\")),\n",
    "    desc_meta[\"taxonomic_coverage\"][\"distinct_species_scientificName\"] > 0,\n",
    "    desc_meta[\"spatial_coverage\"][\"min_latitude\"] is not None,\n",
    "    desc_meta[\"temporal_coverage\"][\"min_eventDate_iso8601\"] is not None,\n",
    "    desc_meta[\"record_counts\"][\"clean_set_records\"] == n_clean_total,\n",
    "])\n",
    "s_F2 = 1.0 if has_f2_all else 0.0\n",
    "bukti_F2 = (\n",
    "    f\"File 07_dataset_metadata_fair.json memuat judul, deskripsi, cakupan taksonomi Catalogue of Life \"\n",
    "    f\"({desc_meta['taxonomic_coverage']['distinct_species_scientificName']:,} spesies, {desc_meta['taxonomic_coverage']['distinct_families']:,} famili), \"\n",
    "    f\"spasial ({desc_meta['spatial_coverage']['min_latitude']} s/d {desc_meta['spatial_coverage']['max_latitude']} LS/LU), \"\n",
    "    f\"temporal ({desc_meta['temporal_coverage']['min_eventDate_iso8601']} s/d {desc_meta['temporal_coverage']['max_eventDate_iso8601']}), \"\n",
    "    f\"dan jumlah record ({n_clean_total:,} Clean, {n_quar_total:,} Quarantine).\"\n",
    ")\n",
    "\n",
    "f3_meta = dataset_metadata_fair[\"F3_data_identifiers_and_distributions\"]\n",
    "has_f3_all = (\n",
    "    f3_meta.get(\"described_dataset_id\") == dataset_pid\n",
    "    and len(f3_meta.get(\"distributions\", [])) >= 2\n",
    "    and all(d.get(\"file_name\") for d in f3_meta[\"distributions\"])\n",
    ")\n",
    "s_F3 = 1.0 if has_f3_all else 0.0\n",
    "bukti_F3 = (\n",
    "    f\"Metadata mencantumkan eksplisit described_dataset_id ({dataset_pid}) beserta nama file fisik \"\n",
    "    f\"({CLEAN_DB_PATH.name}, {CLEAN_PARQUET_FINAL.name}) dan hash SHA-256 masing-masing artefak.\"\n",
    ")\n",
    "\n",
    "# --- ACCESSIBLE (A) ---\n",
    "if github_status[\"http_accessible\"] and github_status[\"github_has_files_online\"]:\n",
