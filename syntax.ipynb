    "    len(dataset_metadata_fair[\"R1_2_provenance\"][\"etl_pipeline_stages\"]) == 6\n",
    "    and \"etl_load_log\" in existing_clean_tables\n",
    "    and all(c in clean_col_set for c in [\"gbifID\", \"datasetKey\", \"publisher\", \"recordedBy\", \"verbatimScientificName\", \"verbatimEventDateRaw\"])\n",
    ")\n",
    "s_R1_2 = 1.0 if has_r1_2 else 0.0\n",
    "bukti_R1_2 = (\n",
    "    \"Menyertakan riwayat asal-usul data GBIF (datasetKey, publisher, institutionCode, recordedBy), \"\n",
    "    \"nilai asli sebelum transformasi (verbatimScientificName, verbatimEventDateRaw), log waktu muat (etl_load_log), \"\n",
    "    \"dan dokumentasi 6 tahapan pipeline ETL.\"\n",
    ")\n",
    "has_r1_3 = (\n",
    "    core_29_mapped_count >= 29\n",
    "    and \"eventDate\" in clean_col_set\n",
    "    and \"decimalLatitude\" in clean_col_set\n",
    "    and \"decimalLongitude\" in clean_col_set\n",
    ")\n",
    "s_R1_3 = 1.0 if has_r1_3 else 0.0\n",
    "bukti_R1_3 = (\n",
    "    f\"Struktur kolom mematuhi standar komunitas Simple Darwin Core (seluruh {core_29_mapped_count}/29 atribut inti terpetakan: \"\n",
    "    f\"{len(dwc_present_in_clean)} atribut Darwin Core aktif + {len(merged_dwc_names)} atribut identik yang disatukan, \"\n",
    "    f\"eventDate bertipe DATE ISO 8601, koordinat desimal WGS84).\"\n",
    ")\n",
    "# Susun DataFrame 12 Indikator sesuai Tabel 2.10 Skripsi\n",
    "indicators_data = [\n",
    "    (\"Findable (F)\", \"F1\", \"F1. Persistent Identifier\",\n",
    "     \"Dataset/output memiliki persistent identifier yang dapat digunakan untuk mengidentifikasi dataset secara unik.\",\n",
    "     \"Essential\", 3, s_F1, bukti_F1),\n",
    "    (\"Findable (F)\", \"F2\", \"F2. Rich Metadata\",\n",
    "     \"Tersedia metadata deskriptif yang memuat judul, deskripsi, cakupan taksonomi/spasial/temporal, dan jumlah record.\",\n",
    "     \"Essential\", 3, s_F2, bukti_F2),\n",
    "    (\"Findable (F)\", \"F3\", \"F3. Metadata–Data Identifier\",\n",
    "     \"Metadata mencantumkan identifier dataset yang dideskripsikannya secara eksplisit.\",\n",
    "     \"Essential\", 3, s_F3, bukti_F3),\n",
    "    (\"Accessible (A)\", \"A1\", \"A1. Standardized Access Protocol\",\n",
    "     \"Dataset dapat diakses melalui identifier menggunakan protokol standar seperti HTTP/HTTPS.\",\n",
    "     \"Essential\", 3, s_A1, bukti_A1),\n",
    "    (\"Accessible (A)\", \"A1.1\", \"A1.1. Open/Free Access\",\n",
    "     \"Dataset dapat diakses melalui protokol yang tidak memerlukan pembayaran.\",\n",
    "     \"Important\", 2, s_A1_1, bukti_A1_1),\n",
    "    (\"Interoperable (I)\", \"I1\", \"I1. Knowledge Representation\",\n",
    "     \"Dataset tersimpan dalam format yang bisa dibaca mesin dengan struktur kolom mengacu pada Darwin Core.\",\n",
    "     \"Important\", 2, s_I1, bukti_I1),\n",
    "    (\"Interoperable (I)\", \"I2\", \"I2. FAIR Vocabulary\",\n",
    "     \"Nama kolom dan istilah utama menggunakan istilah baku Darwin Core dan referensi taksonomi Catalogue of Life (COL XR).\",\n",
    "     \"Important\", 2, s_I2, bukti_I2),\n",
    "    (\"Interoperable (I)\", \"I3\", \"I3. Qualified References\",\n",
    "     \"Dataset memiliki referensi eksplisit dan bermakna terhadap data atau entitas terkait, misalnya taxonKey dan datasetKey.\",\n",
    "     \"Important\", 2, s_I3, bukti_I3),\n",
    "    (\"Reusable (R)\", \"R1\", \"R1. Sufficient Metadata\",\n",
    "     \"Metadata memuat deskripsi, cakupan, jumlah record, dan tanggal pembuatan dataset.\",\n",
    "     \"Essential\", 3, s_R1, bukti_R1),\n",
    "    (\"Reusable (R)\", \"R1.1\", \"R1.1. License\",\n",
    "     \"Dataset menyertakan informasi lisensi atau ketentuan penggunaan secara eksplisit.\",\n",
    "     \"Essential\", 3, s_R1_1, bukti_R1_1),\n",
    "    (\"Reusable (R)\", \"R1.2\", \"R1.2. Provenance\",\n",
    "     \"Dataset menyertakan informasi sumber GBIF, tanggal ekstraksi, dan tahapan pipeline yang dilalui.\",\n",
    "     \"Important\", 2, s_R1_2, bukti_R1_2),\n",
    "    (\"Reusable (R)\", \"R1.3\", \"R1.3. Community Standard\",\n",
    "     \"Struktur dan istilah dataset mengikuti standar Darwin Core pada field yang relevan.\",\n",
    "     \"Essential\", 3, s_R1_3, bukti_R1_3),\n",
    "]\n",
    "df_fair_indicators = pd.DataFrame(\n",
    "    indicators_data,\n",
    "    columns=[\n",
    "        \"Dimensi\",\n",
    "        \"Kode_Indikator\",\n",
    "        \"Nama_Indikator\",\n",
    "        \"Operasionalisasi_dan_Kriteria_Pemenuhan\",\n",
    "        \"Prioritas\",\n",
    "        \"Bobot (w_i)\",\n",
    "        \"Skor_Pemenuhan (s_i)\",\n",
    "        \"Bukti_Operasional_Keluaran_Pipeline\",\n",
    "    ],\n",
    ")\n",
    "df_fair_indicators[\"Skor_Tertimbang (w_i * s_i)\"] = (\n",
    "    df_fair_indicators[\"Bobot (w_i)\"] * df_fair_indicators[\"Skor_Pemenuhan (s_i)\"]\n",
    ")\n",
    "df_fair_indicators[\"Status_Pemenuhan\"] = df_fair_indicators[\"Skor_Pemenuhan (s_i)\"].apply(\n",
    "    lambda s: \"Terpenuhi (100%)\" if s >= 0.9999 else (\"Terpenuhi Sebagian\" if s > 0 else \"Belum Terpenuhi (0%)\")\n",
    ")\n",
    "# Simpan hasil evaluasi ke CSV dan JSON\n",
    "df_fair_indicators.to_csv(out_dir / \"07_tabel_2_10_evaluasi_indikator_fair.csv\", index=False, encoding=\"utf-8-sig\")\n",
    "with open(out_dir / \"07_fair_compliance_report.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\n",
    "        \"evaluated_at\": datetime.now().isoformat(timespec=\"seconds\"),\n",
    "        \"github_detection\": github_status,\n",
    "        \"before_vs_after_quality_delta_x\": df_delta_x.to_dict(orient=\"records\") if not df_delta_x.empty else [],\n",
    "        \"indicators_table_2_10\": df_fair_indicators.to_dict(orient=\"records\"),\n",
    "    }, f, indent=2, ensure_ascii=False)\n",
    "# 5. TAMPILAN HASIL PERBANDINGAN DELTA X, INDIKATOR FAIR, & BUKTI FISIK (UNTUK BAB IV)\n",
    "pd.set_option(\"display.max_columns\", None)\n",
    "pd.set_option(\"display.max_colwidth\", None)\n",
    "pd.set_option(\"display.width\", 1000)\n",
    "if not df_delta_x.empty:\n",
    "    print(\"=\" * 105)\n",
    "    print(\"=== 0. RINGKASAN EVALUASI KUALITAS DATA SEBELUM vs SESUDAH ETL (PERSAMAAN 2.7: DELTA X) ===\")\n",
    "    print(\"=\" * 105)\n",
    "    display(df_delta_x)\n",
    "print(\"\\n\" + \"=\" * 105)\n",
    "print(\"STATUS DETEKSI OTOMATIS REPOSITORI GITHUB & PROTOKOL AKSES (INDIKATOR F1, A1, A1.1)\")\n",
    "print(\"=\" * 105)\n",
    "print(f\"Metode Deteksi        : {github_status['detection_method']}\")\n",
    "print(f\"Folder Git Lokal      : {github_status['git_root'] or 'Tidak ditemukan (.git belum diinisialisasi)'}\")\n",
    "print(f\"URL Remote GitHub     : {github_status['github_https_url'] or 'Belum diatur'}\")\n",
    "print(f\"Terverifikasi Online  : {'YA (HTTP 200 OK)' if github_status['http_accessible'] else 'BELUM'}\")\n",
    "print(f\"Akses Terbuka/Gratis  : {'YA (Public Repo)' if github_status['is_open_free_access'] else 'BELUM'}\")\n",
    "print(f\"Kesimpulan Status     : {github_status['detail_message']}\")\n",
    "print(\"\\n\" + \"=\" * 105)\n",
    "print(\"=== 1. TABEL BUKTI OPERASIONAL 12 INDIKATOR FAIR (TABEL 2.10) ===\")\n",
    "print(\"=\" * 105)\n",
    "display(\n",
    "    df_fair_indicators[[\n",
    "        \"Dimensi\",\n",
    "        \"Kode_Indikator\",\n",
    "        \"Nama_Indikator\",\n",
    "        \"Prioritas\",\n",
    "        \"Bobot (w_i)\",\n",
    "        \"Skor_Pemenuhan (s_i)\",\n",
    "        \"Skor_Tertimbang (w_i * s_i)\",\n",
    "        \"Bukti_Operasional_Keluaran_Pipeline\",\n",
    "    ]]\n",
    ")\n",
    "# 2. Bukti Fisik Indikator Findable (F1, F2, F3) & Reusable (R1, R1.1, R1.2) dari File Metadata JSON\n",
    "print(\"\\n\" + \"=\" * 105)\n",
    "print(\"=== 2. BUKTI FISIK DOKUMEN METADATA FAIR (07_dataset_metadata_fair.json) ===\")\n",
    "print(\"=\" * 105)\n",
    "with open(METADATA_JSON_PATH, \"r\", encoding=\"utf-8\") as f:\n",
    "    meta_bukti = json.load(f)\n",
    "print(json.dumps(meta_bukti, indent=2, ensure_ascii=False))\n",
    "# 3. Bukti Fisik Indikator Interoperable (I1, I2, I3) & Reusable (R1.1, R1.3) langsung dari Tabel DuckDB\n",
    "print(\"\\n\" + \"=\" * 105)\n",
    "print(\"=== 3. BUKTI FISIK PADA LEVEL RECORD DI DUCKDB (I2, I3, R1.1, R1.3 - CATALOGUE OF LIFE XR) ===\")\n",
    "print(\"=\" * 105)\n",
    "con_bukti = open_db(CLEAN_DB_PATH)\n",
    "try:\n",
    "    accepted_taxon_expr = (\n",
    "        '\"acceptedTaxonKey\" AS acceptedTaxonKey_COL'\n",
    "        if \"acceptedTaxonKey\" in clean_col_set\n",
    "        else ('\"matchedTaxonKey\" AS acceptedTaxonKey_COL' if \"matchedTaxonKey\" in clean_col_set else '\"taxonKey\" AS acceptedTaxonKey_COL')\n",
    "    )\n",
    "    df_bukti_record = query_df(\n",
    "        con_bukti,\n",
    "        f\"\"\"\n",
    "        SELECT\n",
    "            gbifID,\n",
    "            occurrenceID,\n",
    "            scientificName,\n",
    "            taxonKey AS taxonKey_COL,\n",
    "            {accepted_taxon_expr},\n",
    "            datasetKey AS datasetKey_QualifiedRef,\n",
    "            license AS License_R1_1,\n",
    "            eventDate AS ISO8601_Date,\n",
    "            decimalLatitude,\n",
    "            decimalLongitude,\n",
    "            record_routing_status\n",
    "        FROM \"{CLEAN_TABLE}\"\n",
    "        WHERE occurrenceID IS NOT NULL\n",
    "          AND eventDate IS NOT NULL\n",
    "        LIMIT 5\n",
    "        \"\"\",\n",
    "    )\n",
    "finally:\n",
    "    con_bukti.close()\n",
    "display(df_bukti_record)"
   ]
  },
