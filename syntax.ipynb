    "\n",
    "# Kolom pembantu yang selalu dianggap redundan karena eventDate sudah dikonversi ke tipe DATE di DuckDB\n",
    "REDUNDANT_COLUMNS = {\n",
    "    \"eventDateParsed\": (\"eventDate\", \"isinya sama dengan eventDate (bertipe DATE di DuckDB)\"),\n",
