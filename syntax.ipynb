    "        )\n",
    "    }\n",
    "    if \"etl_merged_columns\" in existing_clean_tables:\n",
    "        merged_cols_info = query_df(con_clean, \"SELECT * FROM etl_merged_columns\").to_dict(orient=\"records\")\n",
    "finally:\n",
    "    con_clean.close()\n",
    "    con_quar.close()\n",
    "# Hitung SHA-256 file Parquet final sebagai Persistent Content Identifier\n",
    "clean_parquet_sha256 = compute_sha256(CLEAN_PARQUET_FINAL)\n",
