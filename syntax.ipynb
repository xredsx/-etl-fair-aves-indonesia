    "import json\n",
    "import os\n",
    "import re\n",
    "import subprocess\n",
    "import sys\n",
    "import time\n",
    "import urllib.parse\n",
    "import urllib.request\n",
    "from collections import Counter\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import pyarrow as pa\n",
    "\n",
    "# Pengaman agar tidak pernah muncul ArrowKeyError: pandas.period already defined\n",
    "try:\n",
    "    import pandas.core.arrays.arrow.extension_types  # noqa: F401\n",
    "except Exception:\n",
    "    pass\n",
    "import pyarrow.parquet as pq\n",
    "\n",
    "try:\n",
    "    import requests\n",
    "    from requests.adapters import HTTPAdapter\n",
    "    HAS_REQUESTS = True\n",
    "except ImportError:\n",
    "    HAS_REQUESTS = False\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. KONFIGURASI MANDIRI TAHAP 3 (CATALOGUE OF LIFE XR) & LEVENSHTEIN DISTANCE\n",
    "# ==============================================================================\n",
    "OUTPUT_DIR = r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"\n",
    "CHUNK_SIZE = 100_000\n",
    "\n",
    "MAX_FUZZY_EDIT_DISTANCE = 2\n",
    "MIN_FUZZY_CONFIDENCE = 80\n",
    "\n",
    "# Dataset key resmi Catalogue of Life eXtended Release (COL XR) pada GBIF / ChecklistBank\n",
    "# Sesuai dengan opsi taksonomi Catalogue of Life saat pengunduhan dataset GBIF (data_FIX.csv)\n",
    "COL_CHECKLIST_KEY = \"7ddf754f-d193-4cc9-b351-99906754a03b\"\n",
    "GBIF_MATCH_API_V2_URL = \"https://api.gbif.org/v2/species/match\"\n",
    "\n",
    "out_dir = Path(OUTPUT_DIR)\n",
    "harmonized_parquet_path = out_dir / \"harmonized_aves_indonesia.parquet\"\n",
    "normalized_parquet_path = out_dir / \"normalized_taxonomy_aves_indonesia.parquet\"\n",
    "tahap1_report_path = out_dir / \"01_baseline_profile_report.json\"\n",
    "\n",
    "# Cache khusus Catalogue of Life (COL XR) agar tidak tercampur dengan cache GBIF Backbone lama\n",
    "taxon_cache_path = out_dir / \"03_col_species_match_cache.json\"\n",
    "\n",
    "if not harmonized_parquet_path.exists():\n",
    "    raise FileNotFoundError(f\"File {harmonized_parquet_path} belum ada. Jalankan Tahap 2 terlebih dahulu.\")\n",
    "\n",
    "# Tingkatan takson di atas spesies yang dikategorikan sebagai Higher-rank match (Tabel 2.5)\n",
    "HIGHER_RANKS = {\n",
    "    \"DOMAIN\", \"SUPERKINGDOM\", \"KINGDOM\", \"SUBKINGDOM\", \"INFRAKINGDOM\",\n",
    "    \"SUPERPHYLUM\", \"PHYLUM\", \"SUBPHYLUM\", \"INFRAPHYLUM\", \"PARVPHYLUM\",\n",
    "    \"SUPERCLASS\", \"CLASS\", \"SUBCLASS\", \"INFRACLASS\", \"PARVCLASS\",\n",
    "    \"SUPERORDER\", \"ORDER\", \"SUBORDER\", \"INFRAORDER\", \"PARVORDER\",\n",
    "    \"SUPERFAMILY\", \"FAMILY\", \"SUBFAMILY\", \"TRIBE\", \"SUBTRIBE\",\n",
    "    \"GENUS\", \"SUBGENUS\", \"SECTION\", \"SUBSECTION\",\n",
    "}\n",
    "\n",
    "SPECIES_OR_BELOW_RANKS = {\n",
    "    \"SPECIES\", \"SUBSPECIES\", \"VARIETY\", \"SUBVARIETY\", \"FORM\", \"SUBFORM\",\n",
    "    \"INFRASPECIFIC_NAME\", \"INFRASUBSPECIFIC_NAME\",\n",
    "}\n",
    "\n",
    "\n",
    "def extract_canonical_words(sci_name: str) -> str:\n",
    "    \"\"\"Mengekstrak kata kanonik (genus + penunjuk spesies/subspesies) tanpa nama pengarang/tahun.\"\"\"\n",
    "    if not sci_name or pd.isna(sci_name):\n",
    "        return \"\"\n",
    "    s = str(sci_name).strip()\n",
    "    s = re.sub(r\"\\([^)]*\\)\", \" \", s)\n",
    "    tokens = s.split()\n",
    "    canon = []\n",
    "    for idx, tok in enumerate(tokens):\n",
    "        clean_tok = re.sub(r\"[^a-zA-Z\\-]\", \"\", tok)\n",
    "        if not clean_tok:\n",
    "            continue\n",
    "        if idx == 0:\n",
    "            canon.append(clean_tok.lower())\n",
    "        elif clean_tok.islower() and len(canon) < 3:\n",
    "            canon.append(clean_tok.lower())\n",
    "        else:\n",
    "            break\n",
    "    return \" \".join(canon)\n",
    "\n",
    "\n",
    "def levenshtein_distance(s1: str, s2: str) -> int:\n",
    "    if len(s1) < len(s2):\n",
    "        return levenshtein_distance(s2, s1)\n",
    "    if len(s2) == 0:\n",
    "        return len(s1)\n",
    "    prev_row = list(range(len(s2) + 1))\n",
    "    for i, c1 in enumerate(s1):\n",
    "        curr_row = [i + 1]\n",
    "        for j, c2 in enumerate(s2):\n",
    "            insertions = prev_row[j + 1] + 1\n",
    "            deletions = curr_row[j] + 1\n",
    "            substitutions = prev_row[j] + (c1 != c2)\n",
    "            curr_row.append(min(insertions, deletions, substitutions))\n",
    "        prev_row = curr_row\n",
    "    return prev_row[-1]\n",
    "\n",
    "\n",
    "def classify_and_verify_taxonomic_match(\n",
    "    input_name: str,\n",
    "    matched_name: str | None,\n",
    "    match_type: str | None,\n",
    "    status: str | None,\n",
    "    confidence: int | float | None,\n",
    "    matched_rank: str | None = None,\n",
    ") -> tuple[str, str, int | None]:\n",
    "    \"\"\"\n",
    "    Mengelompokkan hasil pencocokan Catalogue of Life ke dalam 5 kategori Tabel 2.5:\n",
    "    Accepted, Synonym resolved, Higher-rank match, Fuzzy match, atau No match.\n",
    "    \"\"\"\n",
    "    mt = (match_type or \"NONE\").upper().strip()\n",
    "    st = (status or \"\").upper().strip()\n",
    "    mr = (matched_rank or \"\").upper().strip()\n",
    "    conf = float(confidence) if confidence is not None else 0.0\n",
    "\n",
    "    if mt in (\"NONE\", \"API_ERROR\") or not mt or not matched_name:\n",
    "        return \"No match\", \"INVALID\", None\n",
    "\n",
    "    # Jika matchType HIGHERRANK atau tingkatan takson hasil pencocokan masih di atas spesies (mis. GENUS/FAMILY/ORDER/CLASS)\n",
    "    if mt == \"HIGHERRANK\" or mr in HIGHER_RANKS:\n",
    "        return \"Higher-rank match\", \"INVALID\", None\n",
    "\n",
    "    if mt in (\"EXACT\", \"VARIANT\"):\n",
    "        if \"SYNONYM\" in st:\n",
    "            return \"Synonym resolved\", \"VALID\", 0\n",
    "        return \"Accepted\", \"VALID\", 0\n",
    "\n",
    "    if mt == \"FUZZY\":\n",
    "        c_in = extract_canonical_words(input_name)\n",
    "        c_out = extract_canonical_words(matched_name)\n",
    "        dist = levenshtein_distance(c_in, c_out) if (c_in and c_out) else 99\n",
    "        if dist <= MAX_FUZZY_EDIT_DISTANCE and conf >= MIN_FUZZY_CONFIDENCE:\n",
    "            return \"Fuzzy match\", \"VALID\", dist\n",
    "        return \"Fuzzy match\", \"INVALID\", dist\n",
    "\n",
    "    return \"No match\", \"INVALID\", None\n",
    "\n",
    "\n",
    "# Koneksi HTTP bersama agar ribuan request ke API berjalan cepat & stabil\n",
    "_http_session = None\n",
    "if HAS_REQUESTS:\n",
    "    _http_session = requests.Session()\n",
    "    _adapter = HTTPAdapter(pool_connections=32, pool_maxsize=32, max_retries=0)\n",
    "    _http_session.mount(\"https://\", _adapter)\n",
    "    _http_session.mount(\"http://\", _adapter)\n",
    "    _http_session.headers.update({\"User-Agent\": \"UB-DataScience-Thesis-ETL/3.0-COL\"})\n",
    "\n",
    "\n",
    "def _parse_v2_match_response(data: dict) -> dict:\n",
    "    \"\"\"Mengekstrak atribut taksonomi dari struktur JSON GBIF Species Match API v2 (Catalogue of Life).\"\"\"\n",
    "    diagnostics = data.get(\"diagnostics\") or {}\n",
    "    usage = data.get(\"usage\") or {}\n",
    "    accepted_usage = data.get(\"acceptedUsage\") or {}\n",
    "    classification = data.get(\"classification\") or []\n",
    "\n",
    "    match_type = str(diagnostics.get(\"matchType\") or data.get(\"matchType\") or \"NONE\").upper().strip()\n",
    "    confidence = diagnostics.get(\"confidence\", data.get(\"confidence\"))\n",
    "\n",
    "    raw_status = (\n",
    "        usage.get(\"status\")\n",
    "        or data.get(\"taxonomicStatus\")\n",
    "        or diagnostics.get(\"status\")\n",
    "        or data.get(\"status\")\n",
    "    )\n",
    "    status = str(raw_status).upper().strip() if raw_status else None\n",
    "\n",
    "    usage_key = usage.get(\"key\") if usage.get(\"key\") is not None else data.get(\"usageKey\")\n",
    "    accepted_key = accepted_usage.get(\"key\") if accepted_usage.get(\"key\") is not None else data.get(\"acceptedUsageKey\")\n",
    "\n",
    "    is_synonym = (\n",
    "        bool(data.get(\"synonym\"))\n",
    "        or (status is not None and \"SYNONYM\" in status)\n",
    "        or (accepted_key is not None and usage_key is not None and str(accepted_key) != str(usage_key))\n",
    "    )\n",
    "    if is_synonym and (status is None or \"SYNONYM\" not in status):\n",
    "        status = \"SYNONYM\"\n",
    "    elif not is_synonym and status is None and usage_key is not None and match_type not in (\"NONE\", \"API_ERROR\"):\n",
    "        status = \"ACCEPTED\"\n",
    "\n",
    "    final_taxon_key = (\n",
    "        str(accepted_key if accepted_key is not None else usage_key).strip()\n",
    "        if (accepted_key is not None or usage_key is not None)\n",
    "        else None\n",
    "    )\n",
    "    matched_usage_key = str(usage_key).strip() if usage_key is not None else None\n",
    "\n",
    "    matched_raw_name = (\n",
    "        usage.get(\"name\")\n",
    "        or usage.get(\"canonicalName\")\n",
    "        or data.get(\"scientificName\")\n",
    "        or data.get(\"canonicalName\")\n",
    "        or data.get(\"species\")\n",
    "    )\n",
    "    accepted_sci_name = (\n",
    "        accepted_usage.get(\"name\")\n",
    "        or accepted_usage.get(\"canonicalName\")\n",
    "        or matched_raw_name\n",
    "    )\n",
    "    matched_rank = (\n",
    "        accepted_usage.get(\"rank\")\n",
    "        or usage.get(\"rank\")\n",
    "        or data.get(\"rank\")\n",
    "    )\n",
    "\n",
    "    # Ekstrak hierarki family, genus, species dari array classification COL XR bila tersedia\n",
    "    cls_map = {}\n",
    "    if isinstance(classification, list):\n",
    "        for node in classification:\n",
    "            if isinstance(node, dict) and node.get(\"rank\") and node.get(\"name\"):\n",
    "                cls_map[str(node[\"rank\"]).upper().strip()] = str(node[\"name\"]).strip()\n",
    "\n",
    "    return {\n",
    "        \"match_type\": match_type,\n",
    "        \"confidence\": confidence,\n",
    "        \"status\": status,\n",
    "        \"final_taxon_key\": final_taxon_key,\n",
    "        \"matched_usage_key\": matched_usage_key,\n",
    "        \"matched_raw_name\": matched_raw_name,\n",
    "        \"accepted_sci_name\": accepted_sci_name,\n",
    "        \"matched_rank\": matched_rank,\n",
    "        \"matched_family\": cls_map.get(\"FAMILY\"),\n",
    "        \"matched_genus\": cls_map.get(\"GENUS\"),\n",
    "        \"matched_species\": cls_map.get(\"SPECIES\"),\n",
    "    }\n",
    "\n",
    "\n",
    "def fetch_col_species_match(query_tuple: tuple) -> tuple[str, dict]:\n",
    "    \"\"\"\n",
    "    Mencocokkan kombinasi nama ilmiah ke Catalogue of Life (COL XR) melalui\n",
    "    GBIF Species Match API v2 (checklistKey=7ddf754f-d193-4cc9-b351-99906754a03b).\n",
    "    \"\"\"\n",
    "    cache_key, name_q, rank_q, genus_q, family_q = query_tuple\n",
    "\n",
    "    if not name_q:\n",
    "        return cache_key, {\n",
    "            \"checklistKey\": COL_CHECKLIST_KEY,\n",
    "            \"matchedTaxonKey\": None,\n",
    "            \"matchedUsageKey\": None,\n",
    "            \"matchedAcceptedScientificName\": None,\n",
    "            \"matchedRawScientificName\": None,\n",
    "            \"matchType\": \"NONE\",\n",
    "            \"matchedStatus\": None,\n",
    "            \"matchedRank\": None,\n",
    "            \"matchedFamily\": None,\n",
    "            \"matchedGenus\": None,\n",
    "            \"matchedSpecies\": None,\n",
    "            \"confidence\": None,\n",
    "            \"taxonomicMatchCategory\": \"No match\",\n",
    "            \"taxonomyValidationStatus\": \"INVALID\",\n",
    "            \"fuzzyEditDistance\": None,\n",
    "            \"apiSuccess\": True,\n",
    "        }\n",
    "\n",
    "    def _call_api(params_dict: dict) -> dict | None:\n",
    "        for attempt in range(5):\n",
    "            try:\n",
    "                if _http_session is not None:\n",
    "                    resp = _http_session.get(GBIF_MATCH_API_V2_URL, params=params_dict, timeout=15)\n",
    "                    if resp.status_code == 200:\n",
    "                        return resp.json()\n",
    "                else:\n",
    "                    url = f\"{GBIF_MATCH_API_V2_URL}?{urllib.parse.urlencode(params_dict)}\"\n",
    "                    req = urllib.request.Request(\n",
    "                        url,\n",
    "                        headers={\"User-Agent\": \"UB-DataScience-Thesis-ETL/3.0-COL\", \"Connection\": \"keep-alive\"},\n",
    "                    )\n",
    "                    with urllib.request.urlopen(req, timeout=15) as r:\n",
    "                        return json.loads(r.read().decode(\"utf-8\"))\n",
    "            except Exception:\n",
    "                time.sleep(0.3 * (attempt + 1))\n",
    "        return None\n",
    "\n",
    "    # Parameter standar v2/species/match dengan checklistKey Catalogue of Life\n",
    "    params = {\n",
    "        \"checklistKey\": COL_CHECKLIST_KEY,\n",
    "        \"scientificName\": name_q,\n",
    "        \"kingdom\": \"Animalia\",\n",
    "        \"class\": \"Aves\",\n",
    "        \"verbose\": \"true\",\n",
    "    }\n",
    "    if rank_q and rank_q.upper() not in (\"UNRANKED\", \"OTHER\"):\n",
    "        params[\"taxonRank\"] = rank_q\n",
    "    if genus_q:\n",
    "        params[\"genus\"] = genus_q\n",
    "    if family_q:\n",
    "        params[\"family\"] = family_q\n",
    "\n",
    "    data = _call_api(params)\n",
    "    parsed = _parse_v2_match_response(data) if data is not None else None\n",
    "\n",
    "    # Fallback tanpa pembatas rank/genus/family apabila:\n",
    "    # 1) Pencocokan awal menghasilkan NONE, atau\n",
    "    # 2) Input berupa nama spesies/subspesies (>= 2 kata kanonik), tetapi pencocokan awal\n",
    "    #    terlempar ke HIGHERRANK akibat perbedaan genus/famili lama vs revisi baru di COL\n",
    "    input_word_count = len(extract_canonical_words(name_q).split())\n",
    "    needs_fallback = (\n",
    "        parsed is not None\n",
    "        and (\n",
    "            parsed[\"match_type\"] == \"NONE\"\n",
    "            or (\n",
    "                input_word_count >= 2\n",
    "                and (\n",
    "                    parsed[\"match_type\"] == \"HIGHERRANK\"\n",
    "                    or (parsed[\"matched_rank\"] or \"\").upper() in HIGHER_RANKS\n",
    "                )\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "    if needs_fallback and (rank_q or genus_q or family_q):\n",
    "        data_fb = _call_api({\n",
    "            \"checklistKey\": COL_CHECKLIST_KEY,\n",
    "            \"scientificName\": name_q,\n",
    "            \"kingdom\": \"Animalia\",\n",
    "            \"class\": \"Aves\",\n",
    "            \"verbose\": \"true\",\n",
    "        })\n",
    "        if data_fb is not None:\n",
    "            parsed_fb = _parse_v2_match_response(data_fb)\n",
    "            if parsed_fb[\"match_type\"] not in (\"NONE\", \"API_ERROR\"):\n",
    "                # Gunakan hasil fallback bila memberikan kecocokan yang lebih spesifik\n",
    "                if parsed[\"match_type\"] == \"NONE\" or (\n",
    "                    parsed_fb[\"match_type\"] != \"HIGHERRANK\"\n",
    "                    and (parsed_fb[\"matched_rank\"] or \"\").upper() not in HIGHER_RANKS\n",
    "                ):\n",
    "                    parsed = parsed_fb\n",
    "\n",
    "    if parsed is None:\n",
    "        return cache_key, {\n",
    "            \"checklistKey\": COL_CHECKLIST_KEY,\n",
    "            \"matchedTaxonKey\": None,\n",
    "            \"matchedUsageKey\": None,\n",
    "            \"matchedAcceptedScientificName\": None,\n",
    "            \"matchedRawScientificName\": None,\n",
    "            \"matchType\": \"API_ERROR\",\n",
    "            \"matchedStatus\": None,\n",
    "            \"matchedRank\": None,\n",
    "            \"matchedFamily\": None,\n",
    "            \"matchedGenus\": None,\n",
    "            \"matchedSpecies\": None,\n",
    "            \"confidence\": None,\n",
    "            \"taxonomicMatchCategory\": \"No match\",\n",
    "            \"taxonomyValidationStatus\": \"INVALID\",\n",
    "            \"fuzzyEditDistance\": None,\n",
    "            \"apiSuccess\": False,\n",
    "        }\n",
    "\n",
    "    cat, val_st, edit_dist = classify_and_verify_taxonomic_match(\n",
    "        name_q,\n",
    "        parsed[\"matched_raw_name\"],\n",
    "        parsed[\"match_type\"],\n",
    "        parsed[\"status\"],\n",
    "        parsed[\"confidence\"],\n",
    "        parsed[\"matched_rank\"],\n",
    "    )\n",
    "\n",
    "    return cache_key, {\n",
    "        \"checklistKey\": COL_CHECKLIST_KEY,\n",
    "        \"matchedTaxonKey\": parsed[\"final_taxon_key\"],\n",
    "        \"matchedUsageKey\": parsed[\"matched_usage_key\"],\n",
    "        \"matchedAcceptedScientificName\": parsed[\"accepted_sci_name\"],\n",
    "        \"matchedRawScientificName\": parsed[\"matched_raw_name\"],\n",
    "        \"matchType\": parsed[\"match_type\"],\n",
    "        \"matchedStatus\": parsed[\"status\"],\n",
    "        \"matchedRank\": parsed[\"matched_rank\"],\n",
    "        \"matchedFamily\": parsed[\"matched_family\"],\n",
    "        \"matchedGenus\": parsed[\"matched_genus\"],\n",
    "        \"matchedSpecies\": parsed[\"matched_species\"],\n",
    "        \"confidence\": parsed[\"confidence\"],\n",
    "        \"taxonomicMatchCategory\": cat,\n",
    "        \"taxonomyValidationStatus\": val_st,\n",
    "        \"fuzzyEditDistance\": edit_dist,\n",
    "        \"apiSuccess\": True,\n",
    "    }\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. EKSTRAKSI KOMBINASI TAKSON UNIK & PENCOCOKAN KE CATALOGUE OF LIFE (COL XR)\n",
    "# ==============================================================================\n",
    "print(f\"Membaca langsung dari file Tahap 2: {harmonized_parquet_path}\")\n",
    "pf_harm = pq.ParquetFile(harmonized_parquet_path)\n",
    "\n",
    "tax_input_cols = [\"verbatimScientificName\", \"scientificName\", \"taxonRank\", \"genus\", \"family\"]\n",
    "unique_combos = {}\n",
    "\n",
    "for batch in pf_harm.iter_batches(batch_size=CHUNK_SIZE, columns=tax_input_cols):\n",
    "    dfb = batch.to_pandas()\n",
    "    name_used = dfb[\"verbatimScientificName\"].fillna(dfb[\"scientificName\"]).fillna(\"\").astype(str).str.strip()\n",
    "    rank_s = dfb[\"taxonRank\"].fillna(\"\").astype(str).str.strip()\n",
    "    genus_s = dfb[\"genus\"].fillna(\"\").astype(str).str.strip()\n",
    "    family_s = dfb[\"family\"].fillna(\"\").astype(str).str.strip()\n",
    "\n",
    "    combo_df = pd.DataFrame({\n",
    "        \"name\": name_used, \"rank\": rank_s, \"genus\": genus_s, \"family\": family_s\n",
    "    }).drop_duplicates()\n",
    "\n",
    "    for row in combo_df.itertuples(index=False):\n",
    "        ckey = f\"{row.name}||{row.rank}||{row.genus}||{row.family}\"\n",
    "        if ckey not in unique_combos:\n",
    "            unique_combos[ckey] = (ckey, row.name, row.rank, row.genus, row.family)\n",
    "\n",
    "if taxon_cache_path.exists():\n",
    "    with open(taxon_cache_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        loaded_cache = json.load(f)\n",
    "    # Pastikan hanya memakai entri cache yang berasal dari Catalogue of Life (COL_CHECKLIST_KEY)\n",
    "    taxon_cache = {\n",
    "        k: v for k, v in loaded_cache.items()\n",
    "        if isinstance(v, dict) and v.get(\"checklistKey\") == COL_CHECKLIST_KEY\n",
    "    }\n",
    "else:\n",
    "    taxon_cache = {}\n",
    "\n",
    "pending_queries = [\n",
    "    q for k, q in unique_combos.items()\n",
    "    if k not in taxon_cache or not taxon_cache[k].get(\"apiSuccess\", False)\n",
    "]\n",
    "print(f\"Referensi Taksonomi : Catalogue of Life eXtended Release (checklistKey={COL_CHECKLIST_KEY})\")\n",
    "print(f\"Total kombinasi unik: {len(unique_combos):,} | Perlu request API COL baru: {len(pending_queries):,}\")\n",
    "\n",
    "if pending_queries:\n",
    "    completed_api = 0\n",
    "    with ThreadPoolExecutor(max_workers=24) as executor:\n",
    "        futures = {executor.submit(fetch_col_species_match, q): q[0] for q in pending_queries}\n",
    "        for future in as_completed(futures):\n",
    "            ckey, result = future.result()\n",
    "            taxon_cache[ckey] = result\n",
    "            completed_api += 1\n",
    "            if completed_api % 500 == 0 or completed_api == len(pending_queries):\n",
    "                print(f\"  [API Matching COL] {completed_api:,} / {len(pending_queries):,} selesai...\")\n",
    "                with open(taxon_cache_path, \"w\", encoding=\"utf-8\") as f:\n",
    "                    json.dump(taxon_cache, f, ensure_ascii=False, indent=2, default=str)\n",
    "\n",
    "# Evaluasi ulang kategori & jarak edit fuzzy pada seluruh kombinasi di cache\n",
    "for ckey, q_tuple in unique_combos.items():\n",
    "    if ckey in taxon_cache:\n",
    "        item = taxon_cache[ckey]\n",
    "        in_name = q_tuple[1]\n",
    "        raw_matched = item.get(\"matchedRawScientificName\") or item.get(\"matchedAcceptedScientificName\")\n",
    "        cat, val_st, edit_dist = classify_and_verify_taxonomic_match(\n",
    "            in_name,\n",
    "            raw_matched,\n",
    "            item.get(\"matchType\"),\n",
    "            item.get(\"matchedStatus\"),\n",
    "            item.get(\"confidence\"),\n",
    "            item.get(\"matchedRank\"),\n",
    "        )\n",
    "        item[\"taxonomicMatchCategory\"] = cat\n",
    "        item[\"taxonomyValidationStatus\"] = val_st\n",
    "        item[\"fuzzyEditDistance\"] = edit_dist\n",
    "\n",
    "with open(taxon_cache_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(taxon_cache, f, ensure_ascii=False, indent=2, default=str)\n",
    "\n",
    "map_taxon_key = {k: v.get(\"matchedTaxonKey\") for k, v in taxon_cache.items()}\n",
    "map_accepted_name = {k: v.get(\"matchedAcceptedScientificName\") for k, v in taxon_cache.items()}\n",
    "map_match_type = {k: v.get(\"matchType\") for k, v in taxon_cache.items()}\n",
    "map_matched_rank = {k: v.get(\"matchedRank\") for k, v in taxon_cache.items()}\n",
    "map_matched_status = {k: v.get(\"matchedStatus\") for k, v in taxon_cache.items()}\n",
    "map_matched_family = {k: v.get(\"matchedFamily\") for k, v in taxon_cache.items()}\n",
    "map_matched_genus = {k: v.get(\"matchedGenus\") for k, v in taxon_cache.items()}\n",
    "map_matched_species = {k: v.get(\"matchedSpecies\") for k, v in taxon_cache.items()}\n",
    "map_category = {k: v.get(\"taxonomicMatchCategory\") for k, v in taxon_cache.items()}\n",
    "map_val_status = {k: v.get(\"taxonomyValidationStatus\") for k, v in taxon_cache.items()}\n",
    "map_fuzzy_dist = {k: v.get(\"fuzzyEditDistance\") for k, v in taxon_cache.items()}\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. PEMETAAN KE SELURUH RECORD & PEMBENTUKAN KOLOM TAKSONOMI DARWIN CORE\n",
    "#    (acceptedScientificName, acceptedTaxonKey, taxonomicStatus diisi di Tahap 3)\n",
    "# ==============================================================================\n",
    "if normalized_parquet_path.exists():\n",
    "    normalized_parquet_path.unlink()\n",
    "\n",
    "normalized_arrow_schema = pq.read_schema(harmonized_parquet_path)\n",
    "existing_schema_names = set(normalized_arrow_schema.names)\n",
    "\n",
    "# Tambahkan 3 atribut Darwin Core yang tidak ada di Simple CSV + atribut hasil pencocokan Tahap 3\n",
    "for new_field in [\n",
    "    pa.field(\"acceptedScientificName\", pa.string()),\n",
    "    pa.field(\"acceptedTaxonKey\", pa.string()),\n",
    "    pa.field(\"taxonomicStatus\", pa.string()),\n",
    "    pa.field(\"matchedTaxonKey\", pa.string()),\n",
    "    pa.field(\"matchedAcceptedScientificName\", pa.string()),\n",
    "    pa.field(\"matchType\", pa.string()),\n",
    "    pa.field(\"matchedRank\", pa.string()),\n",
    "    pa.field(\"matchedStatus\", pa.string()),\n",
    "    pa.field(\"taxonomicMatchCategory\", pa.string()),\n",
    "    pa.field(\"taxonomyValidationStatus\", pa.string()),\n",
    "    pa.field(\"fuzzyEditDistance\", pa.int64()),\n",
    "    pa.field(\"isTaxonKeyConsistent\", pa.bool_()),\n",
    "]:\n",
    "    if new_field.name not in existing_schema_names:\n",
    "        normalized_arrow_schema = normalized_arrow_schema.append(new_field)\n",
    "        existing_schema_names.add(new_field.name)\n",
    "\n",
    "norm_writer = pq.ParquetWriter(normalized_parquet_path, normalized_arrow_schema, compression=\"snappy\")\n",
    "\n",
    "total_norm_rows = 0\n",
    "taxon_key_consistent_count = 0\n",
    "category_counts = Counter({\n",
    "    \"Accepted\": 0, \"Synonym resolved\": 0, \"Higher-rank match\": 0, \"Fuzzy match\": 0, \"No match\": 0\n",
    "})\n",
    "fuzzy_sub_counts = Counter({\"Fuzzy_Valid_Accepted (<=2 huruf)\": 0, \"Fuzzy_Invalid (>2 huruf)\": 0})\n",
    "sample_category_examples = {}\n",
    "ckey_record_counts = Counter()\n",
    "\n",
    "\n",
    "def _safe_str(val) -> str:\n",
    "    return \"-\" if (pd.isna(val) or val is None) else str(val)\n",
    "\n",
    "\n",
    "for batch_idx, batch in enumerate(pf_harm.iter_batches(batch_size=CHUNK_SIZE), start=1):\n",
    "    dfb = batch.to_pandas()\n",
    "    total_norm_rows += len(dfb)\n",
    "\n",
    "    name_used = dfb[\"verbatimScientificName\"].fillna(dfb[\"scientificName\"]).fillna(\"\").astype(str).str.strip()\n",
    "    rank_s = dfb[\"taxonRank\"].fillna(\"\").astype(str).str.strip()\n",
    "    genus_s = dfb[\"genus\"].fillna(\"\").astype(str).str.strip()\n",
    "    family_s = dfb[\"family\"].fillna(\"\").astype(str).str.strip()\n",
    "\n",
    "    ckeys = name_used + \"||\" + rank_s + \"||\" + genus_s + \"||\" + family_s\n",
    "    ckey_record_counts.update(ckeys.value_counts().to_dict())\n",
    "\n",
    "    dfb[\"matchedTaxonKey\"] = ckeys.map(map_taxon_key).astype(\"string\")\n",
    "    dfb[\"matchedAcceptedScientificName\"] = ckeys.map(map_accepted_name).astype(\"string\")\n",
    "    dfb[\"matchType\"] = ckeys.map(map_match_type).astype(\"string\")\n",
    "    dfb[\"matchedRank\"] = ckeys.map(map_matched_rank).astype(\"string\")\n",
    "    dfb[\"matchedStatus\"] = ckeys.map(map_matched_status).astype(\"string\")\n",
    "    dfb[\"taxonomicMatchCategory\"] = ckeys.map(map_category).astype(\"string\")\n",
    "    dfb[\"taxonomyValidationStatus\"] = ckeys.map(map_val_status).astype(\"string\")\n",
    "    dfb[\"fuzzyEditDistance\"] = pd.to_numeric(ckeys.map(map_fuzzy_dist), errors=\"coerce\").astype(\"Int64\")\n",
    "\n",
    "    is_valid_tax = dfb[\"taxonomyValidationStatus\"] == \"VALID\"\n",
    "\n",
    "    # 1) Penyeragaman scientificName ke nama ilmiah yang diterima (accepted) bila taksonomi VALID\n",
    "    dfb[\"scientificName\"] = pd.Series(\n",
    "        np.where(\n",
    "            is_valid_tax & dfb[\"matchedAcceptedScientificName\"].notna(),\n",
    "            dfb[\"matchedAcceptedScientificName\"],\n",
    "            dfb[\"scientificName\"],\n",
    "        ),\n",
    "        index=dfb.index,\n",
    "        dtype=\"string\",\n",
    "    )\n",
    "\n",
    "    # 2) Pengisian 3 kolom Darwin Core yang tidak tersedia pada GBIF Simple CSV:\n",
    "    #    acceptedScientificName, acceptedTaxonKey, dan taxonomicStatus\n",
    "    base_acc_name = (\n",
    "        dfb[\"acceptedScientificName\"].astype(\"string\")\n",
    "        if \"acceptedScientificName\" in dfb.columns\n",
    "        else pd.Series(pd.NA, index=dfb.index, dtype=\"string\")\n",
    "    )\n",
    "    dfb[\"acceptedScientificName\"] = pd.Series(\n",
    "        np.where(\n",
    "            is_valid_tax & dfb[\"matchedAcceptedScientificName\"].notna(),\n",
    "            dfb[\"matchedAcceptedScientificName\"],\n",
    "            base_acc_name,\n",
    "        ),\n",
    "        index=dfb.index,\n",
    "        dtype=\"string\",\n",
    "    )\n",
    "\n",
    "    base_acc_key = (\n",
    "        dfb[\"acceptedTaxonKey\"].astype(\"string\")\n",
    "        if \"acceptedTaxonKey\" in dfb.columns\n",
    "        else pd.Series(pd.NA, index=dfb.index, dtype=\"string\")\n",
    "    )\n",
    "    dfb[\"acceptedTaxonKey\"] = pd.Series(\n",
    "        np.where(\n",
    "            is_valid_tax & dfb[\"matchedTaxonKey\"].notna(),\n",
    "            dfb[\"matchedTaxonKey\"],\n",
    "            base_acc_key,\n",
    "        ),\n",
    "        index=dfb.index,\n",
    "        dtype=\"string\",\n",
    "    )\n",
    "\n",
    "    base_tax_status = (\n",
    "        dfb[\"taxonomicStatus\"].astype(\"string\")\n",
    "        if \"taxonomicStatus\" in dfb.columns\n",
    "        else dfb[\"matchedStatus\"]\n",
    "    )\n",
    "    dfb[\"taxonomicStatus\"] = pd.Series(\n",
    "        np.where(is_valid_tax, \"ACCEPTED\", base_tax_status),\n",
    "        index=dfb.index,\n",
    "        dtype=\"string\",\n",
    "    )\n",
    "\n",
    "    # 3) Lengkapi family, genus, dan species yang kosong jika taksonomi VALID pada Catalogue of Life\n",
    "    matched_fam_s = ckeys.map(map_matched_family).astype(\"string\")\n",
    "    matched_gen_s = ckeys.map(map_matched_genus).astype(\"string\")\n",
    "    matched_spc_s = ckeys.map(map_matched_species).astype(\"string\")\n",
    "    dfb[\"family\"] = dfb[\"family\"].fillna(matched_fam_s.where(is_valid_tax)).astype(\"string\")\n",
    "    dfb[\"genus\"] = dfb[\"genus\"].fillna(matched_gen_s.where(is_valid_tax)).astype(\"string\")\n",
    "    dfb[\"species\"] = dfb[\"species\"].fillna(matched_spc_s.where(is_valid_tax)).astype(\"string\")\n",
    "\n",
    "    # 4) Verifikasi konsistensi taxonKey bawaan dataset (COL) terhadap matchedTaxonKey (COL)\n",
    "    orig_tk = dfb[\"taxonKey\"].astype(\"string\").str.strip()\n",
    "    match_tk = dfb[\"matchedTaxonKey\"].astype(\"string\").str.strip()\n",
    "    consistent_mask = orig_tk.notna() & match_tk.notna() & (orig_tk != \"\") & (orig_tk == match_tk)\n",
    "    dfb[\"isTaxonKeyConsistent\"] = consistent_mask.astype(\"boolean\")\n",
    "    taxon_key_consistent_count += int(consistent_mask.sum())\n",
    "\n",
    "    category_counts.update(dfb[\"taxonomicMatchCategory\"].value_counts().to_dict())\n",
    "    is_fuzzy = dfb[\"taxonomicMatchCategory\"] == \"Fuzzy match\"\n",
    "    fuzzy_sub_counts[\"Fuzzy_Valid_Accepted (<=2 huruf)\"] += int((is_fuzzy & is_valid_tax).sum())\n",
    "    fuzzy_sub_counts[\"Fuzzy_Invalid (>2 huruf)\"] += int((is_fuzzy & (~is_valid_tax)).sum())\n",
    "\n",
    "    for cat in [\"Accepted\", \"Synonym resolved\", \"Higher-rank match\", \"Fuzzy match\", \"No match\"]:\n",
    "        if cat not in sample_category_examples:\n",
    "            sub = dfb[dfb[\"taxonomicMatchCategory\"] == cat]\n",
    "            if len(sub) > 0:\n",
    "                r0 = sub.iloc[0]\n",
    "                sample_category_examples[cat] = {\n",
    "                    \"Kategori\": cat,\n",
    "                    \"verbatimScientificName\": _safe_str(r0[\"verbatimScientificName\"]),\n",
    "                    \"matchedAcceptedScientificName\": _safe_str(r0[\"matchedAcceptedScientificName\"]),\n",
    "                    \"matchedTaxonKey\": _safe_str(r0[\"matchedTaxonKey\"]),\n",
    "                    \"Status_Validasi_Tahap4\": _safe_str(r0[\"taxonomyValidationStatus\"]),\n",
    "                }\n",
    "\n",
    "    ordered_cols = [f.name for f in normalized_arrow_schema]\n",
    "    norm_table = pa.Table.from_pandas(dfb[ordered_cols], schema=normalized_arrow_schema, preserve_index=False)\n",
    "    norm_writer.write_table(norm_table)\n",
    "    print(f\"  [Batch {batch_idx:02d}] {total_norm_rows:,} record selesai dinormalisasi taksonomi (COL XR)...\")\n",
    "\n",
    "norm_writer.close()\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. PERHITUNGAN PERSAMAAN (2.1) & TRT BASELINE (PERSAMAAN 2.5)\n",
    "# ==============================================================================\n",
    "ordered_categories = [\"Accepted\", \"Synonym resolved\", \"Higher-rank match\", \"Fuzzy match\", \"No match\"]\n",
    "dist_rows = []\n",
    "for cat in ordered_categories:\n",
    "    n_stat = int(category_counts.get(cat, 0))\n",
    "    p_stat = round((n_stat / total_norm_rows) * 100.0, 4)\n",
    "    contoh_info = sample_category_examples.get(cat, {})\n",
    "    dist_rows.append({\n",
    "        \"Kategori_Tabel_2_5\": cat,\n",
    "        \"Jumlah_Record (n_status)\": n_stat,\n",
    "        \"Persentase_P_status (%)\": p_stat,\n",
    "        \"Contoh_Input_Verbatim\": contoh_info.get(\"verbatimScientificName\", \"-\"),\n",
    "        \"Contoh_Hasil_Matched\": contoh_info.get(\"matchedAcceptedScientificName\", \"-\"),\n",
    "        \"Contoh_matchedTaxonKey\": contoh_info.get(\"matchedTaxonKey\", \"-\"),\n",
    "        \"Keputusan_Validasi\": (\n",
    "            \"VALID (Diubah ke Accepted)\" if cat in [\"Accepted\", \"Synonym resolved\"]\n",
    "            else f\"VALID jika <= {MAX_FUZZY_EDIT_DISTANCE} huruf ({fuzzy_sub_counts['Fuzzy_Valid_Accepted (<=2 huruf)']:,}) / INVALID ({fuzzy_sub_counts['Fuzzy_Invalid (>2 huruf)']:,})\"\n",
    "            if cat == \"Fuzzy match\"\n",
    "            else \"INVALID (Masuk Quarantine)\"\n",
    "        ),\n",
    "    })\n",
    "\n",
    "df_tax_dist = pd.DataFrame(dist_rows)\n",
    "df_tax_dist.to_csv(out_dir / \"03_distribusi_normalisasi_taksonomi_tabel_2_5.csv\", index=False)\n",
    "\n",
    "n_acc = int(category_counts.get(\"Accepted\", 0))\n",
    "n_syn = int(category_counts.get(\"Synonym resolved\", 0))\n",
    "n_fuzzy_valid = int(fuzzy_sub_counts[\"Fuzzy_Valid_Accepted (<=2 huruf)\"])\n",
    "n_fuzzy_invalid = int(fuzzy_sub_counts[\"Fuzzy_Invalid (>2 huruf)\"])\n",
    "\n",
    "TRT_baseline_eq_2_5 = ((n_acc + n_syn) / total_norm_rows) * 100.0\n",
    "total_resolved_to_accepted = n_acc + n_syn + n_fuzzy_valid\n",
    "TRT_with_verified_fuzzy = (total_resolved_to_accepted / total_norm_rows) * 100.0\n",
    "taxon_key_consistent_pct = (taxon_key_consistent_count / total_norm_rows) * 100.0\n",
    "\n",
    "# Perbarui nilai TRT baseline pada 01_baseline_profile_report.json (Tahap 1) bila file tersedia\n",
    "if tahap1_report_path.exists():\n",
    "    try:\n",
    "        t1_rep = json.loads(tahap1_report_path.read_text(encoding=\"utf-8\"))\n",
    "        if \"baseline_metrics\" in t1_rep:\n",
    "            t1_rep[\"baseline_metrics\"][\"TRT\"] = round(float(TRT_baseline_eq_2_5), 4)\n",
    "        t1_rep.setdefault(\"baseline_details_with_warning_excluded\", {})[\"i_t_unstandardized_or_unresolved_taxonomy\"] = int(\n",
    "            total_norm_rows - (n_acc + n_syn)\n",
    "        )\n",
    "        tahap1_report_path.write_text(json.dumps(t1_rep, indent=2), encoding=\"utf-8\")\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "with open(out_dir / \"03_taxonomic_normalization_report.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\n",
    "        \"reference_taxonomy\": \"Catalogue of Life eXtended Release (COL XR)\",\n",
    "        \"checklist_key\": COL_CHECKLIST_KEY,\n",
    "        \"api_endpoint\": GBIF_MATCH_API_V2_URL,\n",
    "        \"total_records\": int(total_norm_rows),\n",
    "        \"unique_taxonomic_combinations_queried\": int(len(unique_combos)),\n",
    "        \"TRT_baseline_eq_2_5_pct\": round(float(TRT_baseline_eq_2_5), 4),\n",
    "        \"TRT_with_verified_fuzzy_pct\": round(float(TRT_with_verified_fuzzy), 4),\n",
    "        \"n_accepted\": int(n_acc),\n",
    "        \"n_synonym_resolved\": int(n_syn),\n",
    "        \"n_fuzzy_valid_resolved\": int(n_fuzzy_valid),\n",
    "        \"n_fuzzy_invalid_exceeded\": int(n_fuzzy_invalid),\n",
    "        \"n_higher_rank_invalid\": int(category_counts.get(\"Higher-rank match\", 0)),\n",
    "        \"n_no_match_invalid\": int(category_counts.get(\"No match\", 0)),\n",
    "        \"taxon_key_consistent_records\": int(taxon_key_consistent_count),\n",
    "        \"taxon_key_consistent_pct\": round(float(taxon_key_consistent_pct), 4),\n",
    "        \"category_distribution_eq_2_1\": dist_rows,\n",
    "    }, f, indent=2, default=str)\n",
    "\n",
    "print(\"\\n=== RINGKASAN TAHAP 3 (NORMALISASI TAKSONOMI CATALOGUE OF LIFE & VERIFIKASI FUZZY) ===\")\n",
    "print(f\"Referensi Taksonomi                         : Catalogue of Life XR ({COL_CHECKLIST_KEY})\")\n",
    "print(f\"Total Record Diproses                       : {total_norm_rows:,}\")\n",
    "print(f\"TRT Baseline Murni (Acc + Syn - Pers. 2.5)  : {TRT_baseline_eq_2_5:.2f}% ({n_acc + n_syn:,} record)\")\n",
    "print(f\"Fuzzy Match Lolos Verifikasi (<= 2 huruf)   : {n_fuzzy_valid:,} record (Otomatis dibenarkan ke Accepted)\")\n",
    "print(f\"TRT Setelah Verifikasi Fuzzy                : {TRT_with_verified_fuzzy:.2f}% ({total_resolved_to_accepted:,} record)\")\n",
    "print(f\"Fuzzy Match Gagal Verifikasi (> 2 huruf)    : {n_fuzzy_invalid:,} record (Ditetapkan INVALID)\")\n",
    "print(f\"Higher-rank & No Match (Ditetapkan INVALID) : {category_counts['Higher-rank match'] + category_counts['No match']:,} record\")\n",
    "print(f\"Konsistensi taxonKey Dataset vs COL Match   : {taxon_key_consistent_pct:.2f}% ({taxon_key_consistent_count:,} record)\")\n",
    "print(\"\\nTabel Distribusi Hasil Taxonomic Matching (Tabel 2.5):\")\n",
    "print(df_tax_dist.to_string(index=False))\n",
    "\n",
    "# ==============================================================================\n",
    "# 5. GRAFIK DISTRIBUSI KATEGORI & SEBARAN JARAK EDIT FUZZY (JUSTIFIKASI THRESHOLD)\n",
    "# ==============================================================================\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fz_rows = []\n",
    "for ckey, v in taxon_cache.items():\n",
    "    if str(v.get(\"matchType\", \"\")).upper() != \"FUZZY\":\n",
    "        continue\n",
    "    in_name = ckey.split(\"||\")[0]\n",
    "    out_name = v.get(\"matchedRawScientificName\") or v.get(\"matchedAcceptedScientificName\")\n",
    "    c_in = extract_canonical_words(in_name)\n",
    "    c_out = extract_canonical_words(out_name)\n",
    "    if not c_in or not c_out:\n",
    "        continue\n",
    "    fz_rows.append({\n",
    "        \"jarak_huruf\": levenshtein_distance(c_in, c_out),\n",
    "        \"confidence\": v.get(\"confidence\"),\n",
    "        \"jumlah_record\": int(ckey_record_counts.get(ckey, 0)),\n",
    "    })\n",
    "\n",
    "df_fz = pd.DataFrame(fz_rows)\n",
    "\n",
    "if df_fz.empty:\n",
    "    print(\"Tidak ada fuzzy match di cache, grafik threshold fuzzy tidak dibuat.\")\n",
    "else:\n",
    "    df_fz[\"confidence\"] = pd.to_numeric(df_fz[\"confidence\"], errors=\"coerce\")\n",
    "    MAX_SHOW = 8\n",
    "    df_fz[\"jarak_plot\"] = df_fz[\"jarak_huruf\"].clip(upper=MAX_SHOW)\n",
    "\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(19, 5.2))\n",
    "\n",
    "    # Grafik 1: sebaran jarak huruf + garis kumulatif\n",
    "    ax = axes[0]\n",
    "    g = df_fz.groupby(\"jarak_plot\")[\"jumlah_record\"].sum().reindex(range(0, MAX_SHOW + 1), fill_value=0)\n",
    "    total_fz_rec = g.sum()\n",
    "    pct = (g / total_fz_rec * 100) if total_fz_rec > 0 else g.astype(float)\n",
    "    bars = ax.bar(g.index, pct.values, color=[\"#2a9d8f\" if i <= MAX_FUZZY_EDIT_DISTANCE else \"#e76f51\" for i in g.index])\n",
    "    for b, v in zip(bars, pct.values):\n",
    "        if v > 0:\n",
    "            ax.text(b.get_x() + b.get_width() / 2, v, f\"{v:.1f}%\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "    ax2 = ax.twinx()\n",
    "    ax2.plot(g.index, pct.cumsum().values, color=\"black\", marker=\"o\", linewidth=1.5)\n",
    "    ax2.set_ylim(0, 105)\n",
    "    ax2.set_ylabel(\"Persen kumulatif (%)\")\n",
    "    ax.axvline(MAX_FUZZY_EDIT_DISTANCE + 0.5, color=\"red\", linestyle=\"--\")\n",
    "    ax.set_xticks(range(0, MAX_SHOW + 1))\n",
    "    ax.set_xticklabels([str(i) if i < MAX_SHOW else f\"{MAX_SHOW}+\" for i in range(0, MAX_SHOW + 1)])\n",
    "    ax.set_xlabel(\"Jarak edit Levenshtein (jumlah huruf berbeda)\")\n",
    "    ax.set_ylabel(\"Persen record fuzzy (%)\")\n",
    "    ax.set_title(\"Sebaran jarak edit fuzzy match\")\n",
    "\n",
    "    # Grafik 2: proporsi 5 kategori pencocokan taksonomi (Tabel 2.5)\n",
    "    ax = axes[1]\n",
    "    cat_labels = ordered_categories\n",
    "    cat_vals = [int(category_counts.get(c, 0)) for c in cat_labels]\n",
    "    cat_colors = [\"#2a9d8f\", \"#52b788\", \"#e9c46a\", \"#f4a261\", \"#e76f51\"]\n",
    "    ypos = np.arange(len(cat_labels))\n",
    "    ax.barh(ypos, cat_vals, color=cat_colors)\n",
    "    for y_i, v in zip(ypos, cat_vals):\n",
    "        ax.text(v, y_i, f\" {v:,} ({v / total_norm_rows * 100:.2f}%)\", va=\"center\", fontsize=8)\n",
    "    ax.set_yticks(ypos)\n",
    "    ax.set_yticklabels(cat_labels, fontsize=8)\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_xlim(0, max(cat_vals) * 1.38 if max(cat_vals) > 0 else 1)\n",
    "    ax.set_xlabel(\"Jumlah record\")\n",
    "    ax.set_title(\"Distribusi kategori pencocokan COL XR (Tabel 2.5)\")\n",
    "\n",
    "    # Grafik 3: simulasi TRT terhadap threshold jarak\n",
    "    ax = axes[2]\n",
    "    ts = list(range(0, 7))\n",
    "    trts = []\n",
    "    for t in ts:\n",
    "        ok = df_fz[(df_fz[\"jarak_huruf\"] <= t) & (df_fz[\"confidence\"].fillna(0) >= MIN_FUZZY_CONFIDENCE)]\n",
    "        trts.append((n_acc + n_syn + int(ok[\"jumlah_record\"].sum())) / total_norm_rows * 100)\n",
    "    ax.plot(ts, trts, marker=\"o\", color=\"#264653\")\n",
    "    ax.axvline(MAX_FUZZY_EDIT_DISTANCE, color=\"red\", linestyle=\"--\", label=f\"Dipilih = {MAX_FUZZY_EDIT_DISTANCE}\")\n",
    "    for t, v in zip(ts, trts):\n",
    "        ax.text(t, v, f\"{v:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "    ax.set_xlabel(\"Threshold jarak edit maksimum\")\n",
    "    ax.set_ylabel(\"TRT (%)\")\n",
    "    ax.set_title(\"Sensitivitas TRT terhadap threshold jarak edit\")\n",
    "    ax.legend()\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(out_dir / \"03_grafik_threshold_fuzzy.png\", dpi=200)\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 6. PENCOCOKAN SPASIAL DENGAN HABITAT SPESIES (TRANSFORMASI AKHIR TAHAP 3)\n",
    "#    Berlaku untuk record berstatus spatialPreliminaryStatus = NEEDS_HABITAT_CHECK\n",
    "#    (di luar daratan Indonesia dan lebih jauh dari toleransi pesisir, dari Tahap 2).\n",
    "#    Titik dianggap LOLOS bila spesies yang sama punya cukup titik lain (koordinat berbeda)\n",
    "#    di sekitarnya. Yang tidak lolos ditandai ANOMALY, lalu menjadi INVALID di Tahap 4.\n",
    "# ==============================================================================\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "try:\n",
    "    from scipy.spatial import cKDTree\n",
    "except ImportError:\n",
    "    print(\"Menginstal library scipy...\")\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"scipy\", \"-q\"])\n",
    "    from scipy.spatial import cKDTree\n",
    "\n",
    "HABITAT_SUPPORT_RADIUS_KM = 50.0   # radius pencarian titik pendukung\n",
    "HABITAT_MIN_NEIGHBORS = 3          # jumlah minimum koordinat lain dari spesies yang sama dalam radius tersebut\n",
    "HABITAT_REFERENCE = \"ALL\"          # \"ALL\": semua titik spesies | \"TRUSTED\": hanya titik di daratan/pesisir (<= toleransi)\n",
    "HABITAT_NMAX = 10                  # N terbesar untuk grafik sensitivitas\n",
    "SENS_RADII_KM = [5, 10, 25, 50, 100, 200, 500]\n",
    "SENS_N_LIST = [1, 3, 5, 10]\n",
    "EARTH_R_KM = 6371.0088\n",
    "TRUSTED_STATUSES = {\"CLEAN_LAND\", \"CLEAN_COASTAL_TOLERANCE\"}\n",
    "\n",
    "assert HABITAT_REFERENCE in (\"ALL\", \"TRUSTED\") and 1 <= HABITAT_MIN_NEIGHBORS <= HABITAT_NMAX\n",
    "\n",
    "_species_cache = {}\n",
    "\n",
    "\n",
    "def species_label(accepted_name) -> str | None:\n",
    "    \"\"\"Nama spesies (dua kata pertama dari nama kanonik). Tingkat genus ke atas -> None.\"\"\"\n",
    "    if accepted_name is None or pd.isna(accepted_name):\n",
    "        return None\n",
    "    if accepted_name not in _species_cache:\n",
    "        words = extract_canonical_words(str(accepted_name)).split()\n",
    "        _species_cache[accepted_name] = \" \".join(words[:2]) if len(words) >= 2 else None\n",
    "    return _species_cache[accepted_name]\n",
    "\n",
    "\n",
    "def species_series(df: pd.DataFrame) -> pd.Series:\n",
    "    \"\"\"Spesies per record, hanya bila taksonomi VALID (hasil Tahap 3).\"\"\"\n",
    "    sp = df[\"matchedAcceptedScientificName\"].map(species_label)\n",
    "    return sp.where(df[\"taxonomyValidationStatus\"] == \"VALID\", None)\n",
    "\n",
    "\n",
    "def to_xyz(lat_deg: np.ndarray, lon_deg: np.ndarray) -> np.ndarray:\n",
    "    la, lo = np.radians(lat_deg), np.radians(lon_deg)\n",
    "    return EARTH_R_KM * np.column_stack([np.cos(la) * np.cos(lo), np.cos(la) * np.sin(lo), np.sin(la)])\n",
    "\n",
    "\n",
    "def chord_to_arc_km(chord: np.ndarray) -> np.ndarray:\n",
    "    return 2 * EARTH_R_KM * np.arcsin(np.clip(chord / (2 * EARTH_R_KM), 0.0, 1.0))\n",
    "\n",
    "\n",
    "# --- Langkah A: kumpulkan titik unik per spesies beserta jumlah record ---\n",
    "print(\"\\n[Habitat] Mengumpulkan titik unik per spesies dari file Tahap 3...\")\n",
    "need_cols = [\"matchedAcceptedScientificName\", \"taxonomyValidationStatus\", \"decimalLatitude\", \"decimalLongitude\", \"spatialPreliminaryStatus\"]\n",
    "agg_frames = []\n",
    "with open(normalized_parquet_path, \"rb\") as fh:\n",
    "    pf_n = pq.ParquetFile(fh)\n",
    "    for batch in pf_n.iter_batches(batch_size=CHUNK_SIZE, columns=need_cols):\n",
    "        d = batch.to_pandas()\n",
    "        d[\"species\"] = species_series(d)\n",
    "        d = d[d[\"species\"].notna() & d[\"decimalLatitude\"].notna() & d[\"decimalLongitude\"].notna()\n",
    "              & (d[\"spatialPreliminaryStatus\"] != \"NO_COORD\")]\n",
    "        if len(d) == 0:\n",
    "            continue\n",
    "        agg_frames.append(\n",
    "            d.groupby([\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialPreliminaryStatus\"], observed=True)\n",
    "            .size().rename(\"n\").reset_index()\n",
    "        )\n",
    "\n",
    "hab_status_counts = Counter()\n",
    "if not agg_frames:\n",
    "    print(\"[Habitat] Tidak ada titik berspesies valid; pengecekan habitat dilewati.\")\n",
    "    flagged_results = pd.DataFrame(columns=[\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialHabitatStatus\", \"spatialHabitatSupportKm\"])\n",
    "    D_all = D_tr = np.empty((0, HABITAT_NMAX))\n",
    "    w_flag = np.empty(0)\n",
    "else:\n",
    "    pts = (\n",
    "        pd.concat(agg_frames, ignore_index=True)\n",
    "        .groupby([\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialPreliminaryStatus\"], observed=True)[\"n\"].sum()\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    # --- Langkah B: jarak ke tetangga terdekat ke-1..NMAX untuk tiap titik yang perlu dicek ---\n",
    "    res_species, res_lat, res_lon, res_w, res_dall, res_dtr = [], [], [], [], [], []\n",
    "    for sp_name, g in pts.groupby(\"species\", sort=False):\n",
    "        flagged = (g[\"spatialPreliminaryStatus\"] == \"NEEDS_HABITAT_CHECK\").to_numpy()\n",
    "        if not flagged.any():\n",
    "            continue\n",
    "        xyz = to_xyz(g[\"decimalLatitude\"].to_numpy(), g[\"decimalLongitude\"].to_numpy())\n",
    "        trusted = g[\"spatialPreliminaryStatus\"].isin(TRUSTED_STATUSES).to_numpy()\n",
    "        q = xyz[flagged]\n",
    "\n",
    "        # Referensi \"ALL\": titik itu sendiri ada di pohon (jarak 0), jadi kolom pertama dibuang\n",
    "        d_chord_all, _ = cKDTree(xyz).query(q, k=HABITAT_NMAX + 1)\n",
    "        d_all = chord_to_arc_km(d_chord_all[:, 1:])\n",
    "\n",
    "        # Referensi \"TRUSTED\": hanya titik di daratan/pesisir\n",
    "        if trusted.any():\n",
    "            d_chord_tr, _ = cKDTree(xyz[trusted]).query(q, k=HABITAT_NMAX)\n",
    "            d_tr = chord_to_arc_km(d_chord_tr)\n",
    "        else:\n",
    "            d_tr = np.full((q.shape[0], HABITAT_NMAX), np.inf)\n",
    "\n",
    "        res_species.extend([sp_name] * q.shape[0])\n",
    "        res_lat.append(g[\"decimalLatitude\"].to_numpy()[flagged])\n",
    "        res_lon.append(g[\"decimalLongitude\"].to_numpy()[flagged])\n",
    "        res_w.append(g[\"n\"].to_numpy()[flagged])\n",
    "        res_dall.append(d_all)\n",
    "        res_dtr.append(d_tr)\n",
    "\n",
    "    if res_species:\n",
    "        D_all, D_tr = np.vstack(res_dall), np.vstack(res_dtr)\n",
    "        w_flag = np.concatenate(res_w).astype(\"int64\")\n",
    "        flagged_results = pd.DataFrame({\n",
    "            \"species\": res_species,\n",
    "            \"decimalLatitude\": np.concatenate(res_lat),\n",
    "            \"decimalLongitude\": np.concatenate(res_lon),\n",
    "        })\n",
    "        D_used = D_all if HABITAT_REFERENCE == \"ALL\" else D_tr\n",
    "        support_km = D_used[:, HABITAT_MIN_NEIGHBORS - 1]\n",
    "        flagged_results[\"spatialHabitatSupportKm\"] = np.where(np.isfinite(support_km), support_km, np.nan)\n",
    "        flagged_results[\"spatialHabitatStatus\"] = np.where(support_km <= HABITAT_SUPPORT_RADIUS_KM, \"SUPPORTED\", \"ANOMALY\")\n",
    "    else:\n",
    "        flagged_results = pd.DataFrame(columns=[\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialHabitatStatus\", \"spatialHabitatSupportKm\"])\n",
    "        D_all = D_tr = np.empty((0, HABITAT_NMAX))\n",
    "        w_flag = np.empty(0)\n",
    "\n",
    "# --- Langkah C: tulis kolom hasil ke setiap record (file ditulis ulang lewat file sementara) ---\n",
    "tmp_path = normalized_parquet_path.with_suffix(\".habitat_tmp.parquet\")\n",
    "if tmp_path.exists():\n",
    "    tmp_path.unlink()\n",
    "\n",
    "with open(normalized_parquet_path, \"rb\") as fh:\n",
    "    pf_n = pq.ParquetFile(fh)\n",
    "    final_schema = pf_n.schema_arrow\n",
    "    for new_field in [pa.field(\"spatialHabitatStatus\", pa.string()), pa.field(\"spatialHabitatSupportKm\", pa.float64())]:\n",
    "        if new_field.name not in final_schema.names:\n",
    "            final_schema = final_schema.append(new_field)\n",
    "    hab_writer = pq.ParquetWriter(tmp_path, final_schema, compression=\"snappy\")\n",
    "    total_hab_rows = 0\n",
    "    for batch in pf_n.iter_batches(batch_size=CHUNK_SIZE):\n",
    "        dfb = batch.to_pandas()\n",
    "        total_hab_rows += len(dfb)\n",
    "        sp_rec = species_series(dfb)\n",
    "        needs = dfb[\"spatialPreliminaryStatus\"] == \"NEEDS_HABITAT_CHECK\"\n",
    "\n",
    "        status = pd.Series(\"NOT_REQUIRED\", index=dfb.index, dtype=\"object\")\n",
    "        support = pd.Series(np.nan, index=dfb.index, dtype=\"float64\")\n",
    "        status[needs & sp_rec.isna()] = \"UNVERIFIABLE_TAXON\"\n",
    "\n",
    "        chk = needs & sp_rec.notna()\n",
    "        if chk.any() and len(flagged_results):\n",
    "            left = pd.DataFrame({\n",
    "                \"species\": sp_rec[chk].to_numpy(),\n",
    "                \"decimalLatitude\": dfb.loc[chk, \"decimalLatitude\"].to_numpy(),\n",
    "                \"decimalLongitude\": dfb.loc[chk, \"decimalLongitude\"].to_numpy(),\n",
    "            })\n",
    "            m = left.merge(flagged_results, on=[\"species\", \"decimalLatitude\", \"decimalLongitude\"], how=\"left\")\n",
    "            status[chk] = m[\"spatialHabitatStatus\"].fillna(\"ANOMALY\").to_numpy()\n",
    "            support[chk] = m[\"spatialHabitatSupportKm\"].to_numpy()\n",
    "        elif chk.any():\n",
    "            status[chk] = \"ANOMALY\"\n",
    "\n",
    "        dfb[\"spatialHabitatStatus\"] = status.astype(\"string\")\n",
    "        dfb[\"spatialHabitatSupportKm\"] = support\n",
    "        hab_status_counts.update(dfb[\"spatialHabitatStatus\"].value_counts().to_dict())\n",
    "        hab_writer.write_table(pa.Table.from_pandas(dfb[final_schema.names], schema=final_schema, preserve_index=False))\n",
    "        print(f\"  [Habitat] {total_hab_rows:,} record selesai dicocokkan...\")\n",
    "    hab_writer.close()\n",
    "\n",
    "os.replace(tmp_path, normalized_parquet_path)\n",
    "\n",
    "n_need = sum(hab_status_counts.get(k, 0) for k in [\"SUPPORTED\", \"ANOMALY\", \"UNVERIFIABLE_TAXON\"])\n",
    "print(\"\\n=== RINGKASAN PENCOCOKAN SPASIAL DENGAN HABITAT SPESIES ===\")\n",
    "print(f\"Pengaturan : radius {HABITAT_SUPPORT_RADIUS_KM:g} km | minimal {HABITAT_MIN_NEIGHBORS} koordinat lain | referensi {HABITAT_REFERENCE}\")\n",
    "print(f\"Record yang perlu dicek (NEEDS_HABITAT_CHECK) : {n_need:,}\")\n",
    "for k in [\"SUPPORTED\", \"ANOMALY\", \"UNVERIFIABLE_TAXON\", \"NOT_REQUIRED\"]:\n",
    "    v = int(hab_status_counts.get(k, 0))\n",
    "    share = f\" ({v / n_need * 100:.2f}% dari yang dicek)\" if (n_need and k != \"NOT_REQUIRED\") else \"\"\n",
    "    print(f\"  - {k:<20}: {v:>10,} record{share}\")\n",
    "\n",
    "with open(out_dir / \"03_habitat_check_report.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\n",
    "        \"parameters\": {\n",
    "            \"radius_km\": HABITAT_SUPPORT_RADIUS_KM,\n",
    "            \"min_neighbor_coordinates\": HABITAT_MIN_NEIGHBORS,\n",
    "            \"reference\": HABITAT_REFERENCE,\n",
    "            \"species_key\": \"dua kata pertama nama kanonik matchedAcceptedScientificName (taksonomi VALID pada Catalogue of Life)\",\n",
    "        },\n",
    "        \"records_needing_check\": int(n_need),\n",
    "        \"status_counts\": {k: int(v) for k, v in hab_status_counts.items()},\n",
    "    }, f, indent=2)\n",
    "\n",
    "# --- Langkah D: grafik ---\n",
    "fig, axes = plt.subplots(1, 3, figsize=(21, 6))\n",
    "total_w = float(w_flag.sum()) if len(w_flag) else 0.0\n",
    "for ax, D, ttl in [(axes[0], D_all, \"Referensi: semua titik spesies\"), (axes[1], D_tr, \"Referensi: hanya titik daratan/pesisir\")]:\n",
    "    for n_ in SENS_N_LIST:\n",
    "        if total_w > 0:\n",
    "            shares = [w_flag[D[:, n_ - 1] <= r_].sum() / total_w * 100 for r_ in SENS_RADII_KM]\n",
    "        else:\n",
    "            shares = [0] * len(SENS_RADII_KM)\n",
    "        is_sel = (n_ == HABITAT_MIN_NEIGHBORS) and (HABITAT_REFERENCE == (\"ALL\" if D is D_all else \"TRUSTED\"))\n",
    "        ax.plot(SENS_RADII_KM, shares, marker=\"o\", linewidth=2.8 if is_sel else 1.3, label=f\"min {n_} koordinat\")\n",
    "    ax.axvline(HABITAT_SUPPORT_RADIUS_KM, color=\"red\", linestyle=\"--\", linewidth=1)\n",
    "    ax.set_xscale(\"log\")\n",
    "    ax.set_xticks(SENS_RADII_KM)\n",
    "    ax.set_xticklabels([str(r_) for r_ in SENS_RADII_KM])\n",
    "    ax.set_ylim(0, 105)\n",
    "    ax.set_xlabel(\"Radius pencarian (km)\")\n",
    "    ax.set_ylabel(\"Record lolos (%)\")\n",
    "    ax.set_title(ttl)\n",
    "    ax.legend(fontsize=8, loc=\"lower right\")\n",
    "\n",
    "ax = axes[2]\n",
    "labs = [\"SUPPORTED\", \"ANOMALY\", \"UNVERIFIABLE_TAXON\"]\n",
    "vals = [int(hab_status_counts.get(k, 0)) for k in labs]\n",
    "bars = ax.bar(labs, vals, color=[\"#2a9d8f\", \"#d62828\", \"#adb5bd\"])\n",
    "for b_, v in zip(bars, vals):\n",
    "    pct = (v / n_need * 100) if n_need else 0\n",
    "    ax.text(b_.get_x() + b_.get_width() / 2, v, f\"{v:,}\\n({pct:.1f}%)\", ha=\"center\", va=\"bottom\", fontsize=9)\n",
    "ax.set_ylim(0, (max(vals) if max(vals) > 0 else 1) * 1.25)\n",
    "ax.set_ylabel(\"Jumlah record\")\n",
    "ax.set_title(f\"Hasil pengecekan habitat (radius {HABITAT_SUPPORT_RADIUS_KM:g} km, min {HABITAT_MIN_NEIGHBORS} koordinat)\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(out_dir / \"03_grafik_pengecekan_habitat.png\", dpi=200)\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nSelesai.\")"
   ]
  },
