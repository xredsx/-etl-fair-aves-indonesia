    "    )\n",
    "\n",
    "if github_status[\"is_open_free_access\"] and github_status[\"github_has_files_online\"]:\n",
    "    s_A1_1 = 1.0\n",
    "    bukti_A1_1 = (\n",
    "        f\"Terverifikasi otomatis: Repositori GitHub ({github_status['github_https_url']}) bersifat publik (open/free access) \"\n",
    "        f\"dan dapat diunduh gratis tanpa autentikasi berbayar.\"\n",
    "    )\n",
    "elif github_status[\"github_https_url\"] and github_status[\"pushed_to_remote\"]:\n",
    "    s_A1_1 = 1.0\n",
    "    bukti_A1_1 = (\n",
    "        f\"Repositori menggunakan layanan terbuka GitHub ({github_status['github_https_url']}) \"\n",
    "        f\"yang bebas biaya akses (open/free access).\"\n",
