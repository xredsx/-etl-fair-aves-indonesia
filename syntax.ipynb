    "import gc\n",
    "from pathlib import Path\n",
    "import duckdb\n",
    "\n",
    "\n",
    "# 1. KONFIGURASI LOKASI BASIS DATA DUCKDB (HASIL TAHAP 6)\n",
    "\n",
    "OUTPUT_DIR = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\")\n",
    "\n",
    "CLEAN_DB_PATH = OUTPUT_DIR / \"db\" / \"clean_store_aves_indonesia.duckdb\"\n",
    "CLEAN_ALIAS = \"clean_db\"\n",
    "CLEAN_TABLE = \"occurrence_clean\"\n",
    "\n",
    "\n",
    "\n",
    "# 2. FUNGSI BANTU AKSES BASIS DATA DUCKDB\n",
    "\n",
    "def tutup_koneksi_aktif() -> None:\n",
    "    \"\"\"Menutup koneksi DuckDB yang masih terbuka di memori agar tidak terjadi konflik kunci berkas.\"\"\"\n",
    "    for obj in gc.get_objects():\n",
    "        if isinstance(obj, duckdb.DuckDBPyConnection):\n",
    "            try:\n",
    "                obj.close()\n",
    "            except Exception:\n",
    "                pass\n",
    "\n",
    "\n",
    "def attach_db_readonly(con: duckdb.DuckDBPyConnection, db_path: Path, alias: str) -> None:\n",
    "    \"\"\"Memasang berkas basis data DuckDB ke dalam koneksi aktif dalam mode baca-saja.\"\"\"\n",
    "    if not db_path.exists():\n",
    "        raise FileNotFoundError(f\"Basis data {db_path.name} tidak ditemukan.\")\n",
    "    path_sql = db_path.as_posix().replace(\"'\", \"''\")\n",
    "    con.sql(f\"ATTACH '{path_sql}' AS {alias} (READ_ONLY);\")\n",
    "\n",
    "\n",
    "def jalankan_kueri(con: duckdb.DuckDBPyConnection, judul: str, query: str) -> None:\n",
    "    \"\"\"Menjalankan kueri SQL menggunakan con.sql() dan menampilkan ringkasan hasilnya ke layar.\"\"\"\n",
    "    print(f\"\\n=== {judul} ===\")\n",
    "    con.sql(query).show()\n",
    "\n",
    "\n",
    "\n",
    "# 3. EKSEKUSI AKSES BACA-SAJA & 3 CONTOH KUERI ANALITIK (CLEAN DB)\n",
    "\n",
    "tutup_koneksi_aktif()\n",
    "con = duckdb.connect(\":memory:\")\n",
    "\n",
    "try:\n",
    "    # Pasang Clean DB dalam mode READ_ONLY\n",
    "    attach_db_readonly(con, CLEAN_DB_PATH, CLEAN_ALIAS)\n",
    "\n",
    "    # Contoh 1: 5 spesies Aves dengan observasi terbanyak\n",
    "    query_spesies = f\"\"\"\n",
    "    SELECT scientificName AS nama_ilmiah_accepted,\n",
    "           taxonKey AS taxon_key_col,\n",
    "           family AS famili,\n",
    "           COUNT(*) AS total_observasi,\n",
    "           COUNT(DISTINCT stateProvince) AS jumlah_provinsi\n",
    "    FROM {CLEAN_ALIAS}.main.{CLEAN_TABLE}\n",
    "    GROUP BY scientificName, taxonKey, family\n",
    "    ORDER BY total_observasi DESC\n",
    "    LIMIT 5;\n",
    "    \"\"\"\n",
    "    jalankan_kueri(con, \"Contoh 1 - Top 5 Spesies Aves\", query_spesies)\n",
    "\n",
    "    # Contoh 2: Sebaran jumlah record berdasarkan basisOfRecord\n",
    "    query_basis = f\"\"\"\n",
    "    SELECT basisOfRecord,\n",
    "           COUNT(*) AS jumlah_record,\n",
    "           COUNT(DISTINCT scientificName) AS jumlah_spesies_unik\n",
    "    FROM {CLEAN_ALIAS}.main.{CLEAN_TABLE}\n",
    "    GROUP BY basisOfRecord\n",
    "    ORDER BY jumlah_record DESC;\n",
    "    \"\"\"\n",
    "    jalankan_kueri(con, \"Contoh 2 - Agregasi Basis of Record\", query_basis)\n",
    "\n",
    "    # Contoh 3: Ringkasan status routing pada Clean DB (Clean vs Warning)\n",
    "    query_routing = f\"\"\"\n",
    "    SELECT record_routing_status,\n",
    "           COUNT(*) AS jumlah_record\n",
    "    FROM {CLEAN_ALIAS}.main.{CLEAN_TABLE}\n",
    "    GROUP BY record_routing_status\n",
    "    ORDER BY jumlah_record DESC;\n",
    "    \"\"\"\n",
    "    jalankan_kueri(con, \"Contoh 3 - Distribusi Status Routing\", query_routing)\n",
    "\n",
    "finally:\n",
    "    con.close()"
   ]
  },
