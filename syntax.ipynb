    "\n",
    "# Daftar pasangan pengecekan kolom ganda:\n",
    "# (label_pasangan, expr_utama, expr_pembanding, kolom_dibutuhkan, kolom_dipertahankan, kolom_dihapus_bila_double, is_derived)\n",
    "PAIR_CHECKS = [\n",
    "    (\"eventDate vs eventDateParsed\",\n",
    "     'TRY_CAST(\"eventDate\" AS DATE)', '\"eventDateParsed\"',\n",
    "     [\"eventDate\", \"eventDateParsed\"], \"eventDate\", \"eventDateParsed\", False),\n",
    "    (\"scientificName vs acceptedScientificName\",\n",
    "     '\"scientificName\"', '\"acceptedScientificName\"',\n",
    "     [\"scientificName\", \"acceptedScientificName\"], \"scientificName\", \"acceptedScientificName\", False),\n",
    "    (\"scientificName vs matchedAcceptedScientificName\",\n",
    "     '\"scientificName\"', '\"matchedAcceptedScientificName\"',\n",
    "     [\"scientificName\", \"matchedAcceptedScientificName\"], \"scientificName\", \"matchedAcceptedScientificName\", False),\n",
    "    (\"acceptedScientificName vs matchedAcceptedScientificName\",\n",
    "     '\"acceptedScientificName\"', '\"matchedAcceptedScientificName\"',\n",
    "     [\"acceptedScientificName\", \"matchedAcceptedScientificName\"], \"acceptedScientificName\", \"matchedAcceptedScientificName\", False),\n",
    "    (\"scientificName vs verbatimScientificName\",\n",
    "     '\"scientificName\"', '\"verbatimScientificName\"',\n",
    "     [\"scientificName\", \"verbatimScientificName\"], \"scientificName\", \"verbatimScientificName\", False),\n",
    "    (\"taxonKey vs acceptedTaxonKey\",\n",
    "     '\"taxonKey\"', '\"acceptedTaxonKey\"',\n",
    "     [\"taxonKey\", \"acceptedTaxonKey\"], \"taxonKey\", \"acceptedTaxonKey\", False),\n",
    "    (\"taxonKey vs matchedTaxonKey\",\n",
    "     '\"taxonKey\"', '\"matchedTaxonKey\"',\n",
    "     [\"taxonKey\", \"matchedTaxonKey\"], \"taxonKey\", \"matchedTaxonKey\", False),\n",
    "    (\"acceptedTaxonKey vs matchedTaxonKey\",\n",
    "     '\"acceptedTaxonKey\"', '\"matchedTaxonKey\"',\n",
    "     [\"acceptedTaxonKey\", \"matchedTaxonKey\"], \"acceptedTaxonKey\", \"matchedTaxonKey\", False),\n",
    "    (\"hasCoordinate vs (lintang & bujur terisi)\",\n",
    "     '\"hasCoordinate\"', '(\"decimalLatitude\" IS NOT NULL AND \"decimalLongitude\" IS NOT NULL)',\n",
    "     [\"hasCoordinate\", \"decimalLatitude\", \"decimalLongitude\"], \"decimalLatitude\", \"hasCoordinate\", True),\n",
    "    (\"year vs tahun dari eventDate\",\n",
    "     '\"year\"', 'year(TRY_CAST(\"eventDate\" AS DATE))',\n",
    "     [\"year\", \"eventDate\"], \"eventDate\", \"year\", True),\n",
    "    (\"month vs bulan dari eventDate\",\n",
    "     '\"month\"', 'month(TRY_CAST(\"eventDate\" AS DATE))',\n",
    "     [\"month\", \"eventDate\"], \"eventDate\", \"month\", True),\n",
    "]\n",
    "\n",
    "CORE_NAMES = [c[0] for c in CORE_29]\n",
    "ETL_NAMES = [c[0] for c in ETL_EXTRA]\n",
    "\n",
    "adjustment_notes: list[str] = []\n",
    "\n",
    "\n",
    "def sql_path(p: Path) -> str:\n",
    "    return p.as_posix().replace(\"'\", \"''\")\n",
    "\n",
    "\n",
    "def fmt(n) -> str:\n",
    "    return f\"{int(n):,}\"\n",
    "\n",
    "\n",
    "def run_sql(con, sql: str) -> list:\n",
    "    \"\"\"Jalankan query dan ambil semua barisnya supaya hasilnya tertutup (aman untuk DuckDB versi baru).\"\"\"\n",
    "    return con.execute(sql).fetchall()\n",
    "\n",
    "\n",
    "def fetch_one(con, sql: str):\n",
    "    \"\"\"Ambil satu baris hasil query.\"\"\"\n",
    "    return run_sql(con, sql)[0]\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. PEMBUATAN DATABASE: AUDIT & DEDUPLIKASI KOLOM GANDA, TABEL UTAMA, KAMUS DATA\n",
    "# ==============================================================================\n",
    "def build_database(db_path: Path, table: str, parquet_path: Path, label: str) -> dict:\n",
    "    for suffix in (\"\", \".wal\"):\n",
    "        f = Path(str(db_path) + suffix)\n",
    "        if f.exists():\n",
    "            try:\n",
    "                f.unlink()\n",
    "            except PermissionError:\n",
    "                raise RuntimeError(\n",
    "                    f\"File {f.name} sedang dipakai proses lain (misalnya notebook/kernel lain, DBeaver, atau DuckDB CLI). \"\n",
    "                    \"Tutup program tersebut atau Restart Kernel di sana, lalu jalankan Tahap 6 lagi.\"\n",
    "                ) from None\n",
    "\n",
    "    src = f\"read_parquet('{sql_path(parquet_path)}')\"\n",
    "\n",
    "    with duckdb.connect(str(db_path)) as con:\n",
    "        src_cols = [r[0] for r in run_sql(con, f\"DESCRIBE SELECT * FROM {src}\")]\n",
    "        src_set = set(src_cols)\n",
    "\n",
    "        # --- kolom inti 29 atribut harus ada di parquet sumber ---\n",
    "        missing_core = [c for c in CORE_NAMES if c not in src_set]\n",
    "        if missing_core:\n",
    "            raise KeyError(f\"[{label}] Kolom wajib struktur 29 atribut tidak ada di {parquet_path.name}: {missing_core}\")\n",
    "\n",
    "        missing_etl = [c for c in ETL_NAMES if c not in src_set]\n",
    "        if missing_etl:\n",
    "            adjustment_notes.append(f\"[{label}] Kolom tambahan ETL tidak ditemukan di parquet dan dilewati: {missing_etl}\")\n",
    "\n",
    "        # --- 1) Audit kolom ganda langsung dari parquet sumber SEBELUM memilih kolom tabel ---\n",
    "        dropped_by_map: dict[str, tuple[str, float]] = {}  # col_dropped -> (col_kept, pct)\n",
    "        for red_col, (keep_target, _reason) in REDUNDANT_COLUMNS.items():\n",
    "            if red_col in src_set and not KEEP_REDUNDANT_COLUMNS:\n",
    "                dropped_by_map[red_col] = (keep_target, 100.0)\n",
    "\n",
    "        audit_rows = []\n",
    "        for name, expr_a, expr_b, needed, keep_col, drop_col, is_derived in PAIR_CHECKS:\n",
    "            if not all(c in src_set for c in needed):\n",
    "                continue\n",
    "            n_cmp, n_same = fetch_one(\n",
    "                con,\n",
    "                f\"SELECT COUNT(*), SUM(CASE WHEN ({expr_a}) IS NOT DISTINCT FROM ({expr_b}) THEN 1 ELSE 0 END) FROM {src}\",\n",
    "            )\n",
    "            n_same = int(n_same or 0)\n",
    "            pct = n_same / n_cmp * 100 if n_cmp else 0.0\n",
    "\n",
    "            is_double = n_cmp > 0 and n_same >= n_cmp * DOUBLE_THRESHOLD_PCT / 100\n",
    "            is_protected = drop_col in PROTECTED_COLUMNS\n",
    "            should_drop = (\n",
    "                is_double\n",
    "                and not is_protected\n",
    "                and not KEEP_REDUNDANT_COLUMNS\n",
    "                and (DEDUP_DERIVED_COLUMNS or not is_derived)\n",
    "            )\n",
    "\n",
    "            effective_keep = keep_col\n",
    "            while effective_keep in dropped_by_map:\n",
    "                effective_keep = dropped_by_map[effective_keep][0]\n",
    "\n",
    "            if should_drop:\n",
    "                if drop_col not in dropped_by_map:\n",
    "                    dropped_by_map[drop_col] = (effective_keep, round(pct, 4))\n",
    "                action = f\"DIJADIKAN 1 -> simpan '{effective_keep}', hapus '{drop_col}'\"\n",
    "            elif is_double and is_protected:\n",
    "                action = f\"DOUBLE tetapi '{drop_col}' kolom terlindungi (tetap dimuat)\"\n",
    "                adjustment_notes.append(\n",
    "                    f\"[{label}] {name}: isi identik 100% tetapi '{drop_col}' ada di PROTECTED_COLUMNS, jadi tetap dimuat.\"\n",
    "                )\n",
    "            elif is_double:\n",
    "                action = \"DOUBLE (tetap dimuat sesuai konfigurasi)\"\n",
    "            elif pct >= 90:\n",
    "                action = f\"hampir sama, {fmt(n_cmp - n_same)} baris berbeda (tetap dimuat)\"\n",
    "            else:\n",
    "                action = \"berbeda (tetap dimuat)\"\n",
    "\n",
    "            flag = \"DOUBLE (isi identik)\" if is_double else (\"hampir sama\" if pct >= 90 else \"berbeda\")\n",
    "            audit_rows.append({\n",
    "                \"database\": label,\n",
    "                \"pasangan_kolom\": name,\n",
    "                \"jumlah_dibandingkan\": int(n_cmp),\n",
    "                \"baris_berbeda\": int(n_cmp - n_same),\n",
    "                \"identik_persen\": round(pct, 4),\n",
    "                \"keterangan\": flag,\n",
    "                \"tindakan\": action,\n",
    "            })\n",
    "\n",
    "        merged_into: dict[str, list[str]] = {}\n",
    "        for d_col, (k_col, _pct) in dropped_by_map.items():\n",
    "            while k_col in dropped_by_map:\n",
    "                k_col = dropped_by_map[k_col][0]\n",
    "            merged_into.setdefault(k_col, []).append(d_col)\n",
    "\n",
    "        # --- 2) Susun daftar kolom akhir (tanpa kolom ganda yang sudah disatukan) ---\n",
    "        unknown_cols = [\n",
    "            c for c in src_cols\n",
    "            if c not in CORE_NAMES and c not in ETL_NAMES and c not in REDUNDANT_COLUMNS\n",
    "        ]\n",
    "        if unknown_cols:\n",
    "            adjustment_notes.append(\n",
    "                f\"[{label}] Kolom di parquet yang tidak ada di struktur dan dimuat di bagian akhir: {unknown_cols}\"\n",
    "            )\n",
    "\n",
    "        candidate_cols = CORE_NAMES + [c for c in ETL_NAMES if c in src_set] + unknown_cols\n",
    "        if KEEP_REDUNDANT_COLUMNS:\n",
    "            candidate_cols += [c for c in REDUNDANT_COLUMNS if c in src_set and c not in candidate_cols]\n",
    "\n",
    "        ordered = [c for c in candidate_cols if c not in dropped_by_map]\n",
    "        dropped_cols_list = [c for c in src_cols if c in dropped_by_map]\n",
    "\n",
    "        # Pemeriksaan dilakukan pada parquet sumber, sebelum kolom konstan dihapus dari Clean Set\n",
    "        non_unique_source = (\n",
    "            fetch_one(con, f\"SELECT COUNT(*) FROM {src} WHERE \\\"duplicate_type\\\" <> 'UNIQUE'\")[0]\n",
    "            if \"duplicate_type\" in src_set else 0\n",
    "        )\n",
    "        removed_rows = []\n",
    "        if label == \"CLEAN\":\n",
    "            for c in CLEAN_CONSTANT_COLUMNS:\n",
    "                if c not in ordered:\n",
    "                    continue\n",
    "                n_val = fetch_one(con, f'SELECT COUNT(DISTINCT \"{c}\") FROM {src}')[0]\n",
    "                if n_val > 1:\n",
    "                    adjustment_notes.append(f\"[{label}] Kolom '{c}' memiliki {n_val} nilai berbeda, sehingga tidak dihapus.\")\n",
    "                    continue\n",
    "                val = fetch_one(con, f'SELECT MIN(\"{c}\") FROM {src}')[0]\n",
    "                removed_rows.append({\"database\": label, \"kolom_dihapus\": c,\n",
    "                                     \"alasan\": \"isi konstan pada Clean Set\",\n",
    "                                     \"nilai_tunggal\": \"kosong semua\" if val is None else str(val)})\n",
    "            for c in CLEAN_INTERMEDIATE_COLUMNS:\n",
    "                if c in ordered:\n",
    "                    removed_rows.append({\"database\": label, \"kolom_dihapus\": c,\n",
    "                                         \"alasan\": \"kolom perantara/turunan\", \"nilai_tunggal\": \"\"})\n",
    "            removed_set = {r[\"kolom_dihapus\"] for r in removed_rows}\n",
    "            ordered = [c for c in ordered if c not in removed_set]\n",
    "        removed_cols_list = [r[\"kolom_dihapus\"] for r in removed_rows]\n",
    "\n",
    "        parts = [f'TRY_CAST(\"{c}\" AS DATE) AS \"{c}\"' if c == \"eventDate\" else f'\"{c}\"' for c in ordered]\n",
    "\n",
    "        lost_date = fetch_one(\n",
    "            con, f'SELECT COUNT(*) FROM {src} WHERE \"eventDate\" IS NOT NULL AND TRY_CAST(\"eventDate\" AS DATE) IS NULL'\n",
    "        )[0]\n",
    "        if lost_date:\n",
    "            adjustment_notes.append(f\"[{label}] {fmt(lost_date)} nilai eventDate tidak bisa dikonversi ke DATE dan menjadi NULL.\")\n",
    "\n",
    "        # --- 3) Buat tabel utama (hanya berisi kolom unik yang telah disatukan) ---\n",
    "        run_sql(con, f'CREATE OR REPLACE TABLE \"{table}\" AS SELECT {\", \".join(parts)} FROM {src}')\n",
    "        n_rows = fetch_one(con, f'SELECT COUNT(*) FROM \"{table}\"')[0]\n",
    "\n",
    "        # --- 4) Buat kamus data (mencatat juga kolom ganda yang diwakili oleh kolom utama) ---\n",
    "        types = {r[0]: r[1] for r in run_sql(con, f'DESCRIBE \"{table}\"')}\n",
    "        meta = {c[0]: (c[1], c[2], c[3], \"Struktur 29 atribut\") for c in CORE_29}\n",
    "        meta.update({c[0]: (c[1], c[2], f\"Dihasilkan di {c[3]}\", c[3]) for c in ETL_EXTRA})\n",
    "        dict_rows = []\n",
    "        for i, c in enumerate(ordered, start=1):\n",
    "            grp, fungsi, note, sumber = meta.get(c, (\"Lainnya\", \"\", \"\", \"Tidak ada di struktur\"))\n",
    "            represented = merged_into.get(c, [])\n",
    "            if represented:\n",
    "                extra_note = f\"Mewakili kolom ganda yang disatukan: {', '.join(represented)}\"\n",
    "                note = f\"{note}; {extra_note}\" if note else extra_note\n",
    "            dict_rows.append({\n",
    "                \"no\": i,\n",
    "                \"kelompok\": grp,\n",
    "                \"atribut\": c,\n",
    "                \"tipe_data_duckdb\": types.get(c, \"\"),\n",
    "                \"fungsi\": fungsi,\n",
    "                \"catatan_etl\": note,\n",
    "                \"sumber\": sumber,\n",
    "            })\n",
    "        df_dict = pd.DataFrame(dict_rows)\n",
    "        con.register(\"df_dict\", df_dict)\n",
    "        run_sql(con, \"CREATE OR REPLACE TABLE data_dictionary AS SELECT * FROM df_dict\")\n",
    "        con.unregister(\"df_dict\")\n",
    "\n",
    "        dropped_rows = [\n",
    "            {\n",
    "                \"database\": label,\n",
    "                \"kolom_dihapus\": d_col,\n",
    "                \"disatukan_ke_kolom\": dropped_by_map[d_col][0],\n",
    "                \"identik_persen\": dropped_by_map[d_col][1],\n",
    "            }\n",
    "            for d_col in dropped_cols_list\n",
    "        ]\n",
    "        df_removed = pd.DataFrame(\n",
    "            removed_rows, columns=[\"database\", \"kolom_dihapus\", \"alasan\", \"nilai_tunggal\"]\n",
    "        )\n",
    "        con.register(\"df_removed\", df_removed)\n",
    "        run_sql(con, \"CREATE OR REPLACE TABLE etl_removed_columns AS SELECT * FROM df_removed\")\n",
    "        con.unregister(\"df_removed\")\n",
    "\n",
    "        df_dropped = pd.DataFrame(\n",
    "            dropped_rows,\n",
    "            columns=[\"database\", \"kolom_dihapus\", \"disatukan_ke_kolom\", \"identik_persen\"],\n",
    "        )\n",
    "        con.register(\"df_dropped\", df_dropped)\n",
    "        run_sql(con, \"CREATE OR REPLACE TABLE etl_merged_columns AS SELECT * FROM df_dropped\")\n",
    "        con.unregister(\"df_dropped\")\n",
    "\n",
    "        # --- rekap hasil validasi, routing, dan perbandingan sebelum-sesudah dari Tahap 4/5 ---\n",
    "        for csv_name, tbl in [\n",
    "            (\"05_rekapitulasi_routing_record.csv\", \"etl_routing_summary\"),\n",
    "            (\"04_rekapitulasi_validasi_5_dimensi.csv\", \"etl_dimension_summary\"),\n",
    "            (\"04_rincian_validasi_spasial_habitat.csv\", \"etl_spatial_detail\"),\n",
    "            (\"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\", \"etl_before_after_summary\"),\n",
    "        ]:\n",
    "            csv_path = out_dir / csv_name\n",
    "            if csv_path.exists():\n",
    "                df_csv = pd.read_csv(csv_path)\n",
    "                con.register(\"df_csv\", df_csv)\n",
    "                run_sql(con, f'CREATE OR REPLACE TABLE \"{tbl}\" AS SELECT * FROM df_csv')\n",
    "                con.unregister(\"df_csv\")\n",
    "\n",
    "        run_sql(con, f'''\n",
    "            CREATE OR REPLACE VIEW v_routing_in_this_db AS\n",
    "            SELECT record_routing_status, COUNT(*) AS jumlah_record,\n",
    "                   ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 4) AS proporsi_persen\n",
    "            FROM \"{table}\" GROUP BY record_routing_status ORDER BY record_routing_status\n",
    "        ''')\n",
    "\n",
    "        if label == \"CLEAN\":\n",
    "            run_sql(con, f'CREATE OR REPLACE VIEW v_clean_only AS SELECT * FROM \"{table}\" WHERE record_routing_status = \\'Clean\\'')\n",
    "            run_sql(con, f'CREATE OR REPLACE VIEW v_warning_only AS SELECT * FROM \"{table}\" WHERE record_routing_status = \\'Warning\\'')\n",
    "        else:\n",
    "            run_sql(con, f'''\n",
    "                CREATE OR REPLACE TABLE quarantine_reason_by_dimension AS\n",
    "                SELECT dimensi_invalid, COUNT(*) AS jumlah_record\n",
    "                FROM (SELECT unnest(string_split(\"Invalid_Reasons\", ';')) AS dimensi_invalid\n",
    "                      FROM \"{table}\" WHERE \"Invalid_Reasons\" IS NOT NULL)\n",
    "                GROUP BY dimensi_invalid ORDER BY jumlah_record DESC\n",
    "            ''')\n",
    "            run_sql(con, f'''\n",
    "                CREATE OR REPLACE TABLE quarantine_reason_combination AS\n",
    "                SELECT \"Invalid_Reasons\" AS kombinasi_dimensi_invalid, COUNT(*) AS jumlah_record\n",
    "                FROM \"{table}\" GROUP BY \"Invalid_Reasons\" ORDER BY jumlah_record DESC\n",
    "            ''')\n",
    "            run_sql(con, f'''\n",
    "                CREATE OR REPLACE TABLE quarantine_spatial_detail AS\n",
    "                SELECT spatial_validation_detail, COUNT(*) AS jumlah_record\n",
    "                FROM \"{table}\" GROUP BY spatial_validation_detail ORDER BY jumlah_record DESC\n",
    "            ''')\n",
    "\n",
    "        df_audit = pd.DataFrame(audit_rows)\n",
    "        con.register(\"df_audit\", df_audit)\n",
    "        run_sql(con, \"CREATE OR REPLACE TABLE etl_redundancy_audit AS SELECT * FROM df_audit\")\n",
    "        con.unregister(\"df_audit\")\n",
    "\n",
    "        n_id, n_distinct_id, n_null_id = fetch_one(\n",
    "            con, f'SELECT COUNT(*), COUNT(DISTINCT \"gbifID\"), COUNT(*) FILTER (WHERE \"gbifID\" IS NULL) FROM \"{table}\"'\n",
    "        )\n",
    "        dup_occ = fetch_one(\n",
    "            con,\n",
    "            f'''SELECT COUNT(*) FROM (SELECT \"occurrenceID\" FROM \"{table}\" WHERE \"occurrenceID\" IS NOT NULL\n",
    "                                      GROUP BY \"occurrenceID\" HAVING COUNT(*) > 1)''',\n",
    "        )[0]\n",
    "\n",
    "        # --- ekspor parquet final (dari tabel yang sudah bebas kolom ganda) ---\n",
    "        final_parquet = final_dir / f\"{table}.parquet\"\n",
    "        if final_parquet.exists():\n",
    "            final_parquet.unlink()\n",
    "        run_sql(\n",
    "            con,\n",
    "            f\"COPY \\\"{table}\\\" TO '{sql_path(final_parquet)}' (FORMAT PARQUET, COMPRESSION {PARQUET_COMPRESSION}, ROW_GROUP_SIZE 122880)\",\n",
    "        )\n",
    "\n",
    "        log_row = pd.DataFrame([{\n",
    "            \"loaded_at\": datetime.now().isoformat(timespec=\"seconds\"),\n",
    "            \"tabel\": table,\n",
    "            \"jumlah_record\": int(n_rows),\n",
    "            \"jumlah_kolom_awal\": len(src_cols),\n",
    "            \"jumlah_kolom_dihapus_ganda\": len(dropped_cols_list),\n",
    "            \"jumlah_kolom_dihapus_konstan_perantara\": len(removed_cols_list),\n",
    "            \"jumlah_kolom_akhir\": len(ordered),\n",
    "            \"kolom_ganda_dihapus\": \", \".join(dropped_cols_list),\n",
    "            \"kolom_konstan_perantara_dihapus\": \", \".join(removed_cols_list),\n",
    "            \"sumber_parquet\": parquet_path.name,\n",
    "            \"parquet_final\": final_parquet.name,\n",
    "            \"kompresi\": PARQUET_COMPRESSION,\n",
    "        }])\n",
    "        con.register(\"df_log\", log_row)\n",
    "        run_sql(con, \"CREATE OR REPLACE TABLE etl_load_log AS SELECT * FROM df_log\")\n",
    "        con.unregister(\"df_log\")\n",
    "\n",
    "        run_sql(con, \"CHECKPOINT\")\n",
    "\n",
    "    return {\n",
    "        \"label\": label,\n",
    "        \"table\": table,\n",
    "        \"rows\": int(n_rows),\n",
    "        \"cols_source\": len(src_cols),\n",
    "        \"cols\": len(ordered),\n",
    "        \"loaded_columns\": ordered,\n",
    "        \"dropped_columns\": dropped_rows,\n",
    "        \"removed_columns\": removed_rows,\n",
    "        \"non_unique_source\": int(non_unique_source),\n",
    "        \"distinct_gbifID\": int(n_distinct_id),\n",
    "        \"null_gbifID\": int(n_null_id),\n",
    "        \"dup_occurrenceID\": int(dup_occ),\n",
    "        \"audit\": df_audit,\n",
    "        \"final_parquet\": final_parquet,\n",
    "        \"db_path\": db_path,\n",
    "    }\n",
    "\n",
    "\n",
    "print(\"Memuat Clean Set ke DuckDB (menyatukan kolom ganda menjadi 1 kolom)...\")\n",
    "res_clean = build_database(CLEAN_DB_PATH, CLEAN_TABLE, clean_parquet_path, \"CLEAN\")\n",
    "print(\"Memuat Quarantine Store ke DuckDB (menyatukan kolom ganda menjadi 1 kolom)...\")\n",
    "res_quar = build_database(QUARANTINE_DB_PATH, QUARANTINE_TABLE, quarantine_parquet_path, \"QUARANTINE\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. VERIFIKASI ANTAR DATABASE\n",
    "# ==============================================================================\n",
    "clean_loaded_set = set(res_clean[\"loaded_columns\"])\n",
    "mandatory_null_clean = {}\n",
    "\n",
    "with duckdb.connect(\":memory:\") as vcon:\n",
    "    run_sql(vcon, f\"ATTACH '{sql_path(CLEAN_DB_PATH)}' AS c (READ_ONLY)\")\n",
    "    run_sql(vcon, f\"ATTACH '{sql_path(QUARANTINE_DB_PATH)}' AS q (READ_ONLY)\")\n",
    "\n",
    "    overlap_gbif = fetch_one(\n",
    "        vcon, f'SELECT COUNT(*) FROM c.\"{CLEAN_TABLE}\" a JOIN q.\"{QUARANTINE_TABLE}\" b ON a.\"gbifID\" = b.\"gbifID\"'\n",
    "    )[0]\n",
    "\n",
    "    routing_clean = dict(run_sql(vcon, f'SELECT record_routing_status, COUNT(*) FROM c.\"{CLEAN_TABLE}\" GROUP BY 1'))\n",
    "    routing_quar = dict(run_sql(vcon, f'SELECT record_routing_status, COUNT(*) FROM q.\"{QUARANTINE_TABLE}\" GROUP BY 1'))\n",
    "    non_unique_in_clean = res_clean[\"non_unique_source\"]  # diperiksa pada parquet sumber sebelum duplicate_type dihapus\n",
    "\n",
    "    for col in [\n",
    "        \"occurrenceID\", \"scientificName\", \"taxonRank\", \"decimalLatitude\", \"decimalLongitude\",\n",
    "        \"basisOfRecord\", \"publisher\", \"recordedBy\", \"verbatimEventDateRaw\",\n",
    "    ]:\n",
    "        if col in clean_loaded_set:\n",
    "            mandatory_null_clean[col] = fetch_one(vcon, f'SELECT COUNT(*) FROM c.\"{CLEAN_TABLE}\" WHERE \"{col}\" IS NULL')[0]\n",
    "    event_date_null_clean = fetch_one(vcon, f'SELECT COUNT(*) FROM c.\"{CLEAN_TABLE}\" WHERE \"eventDate\" IS NULL')[0]\n",
    "\n",
    "report = {}\n",
    "if report_json_path.exists():\n",
    "    with open(report_json_path, \"r\", encoding=\"utf-8\") as f:\n",
    "        report = json.load(f)\n",
    "\n",
    "total_loaded = res_clean[\"rows\"] + res_quar[\"rows\"]\n",
    "checks = []\n",
    "\n",
    "\n",
    "def add_check(name: str, ok: bool, detail: str):\n",
    "    checks.append({\"pemeriksaan\": name, \"hasil\": \"OK\" if ok else \"PERIKSA\", \"keterangan\": detail})\n",
    "\n",
    "\n",
    "if report:\n",
    "    add_check(\n",
    "        \"Total record Clean + Quarantine = total Tahap 4/5\",\n",
    "        total_loaded == report.get(\"total_records_validated\"),\n",
    "        f\"dimuat {fmt(total_loaded)} | Tahap 4/5 {fmt(report.get('total_records_validated', 0))}\",\n",
    "    )\n",
    "    add_check(\n",
    "        \"Jumlah Clean Set sesuai laporan Tahap 4/5\",\n",
    "        res_clean[\"rows\"] == report.get(\"clean_set_records\"),\n",
    "        f\"dimuat {fmt(res_clean['rows'])} | laporan {fmt(report.get('clean_set_records', 0))}\",\n",
    "    )\n",
    "    add_check(\n",
    "        \"Jumlah Quarantine sesuai laporan Tahap 4/5\",\n",
    "        res_quar[\"rows\"] == report.get(\"quarantine_records\"),\n",
    "        f\"dimuat {fmt(res_quar['rows'])} | laporan {fmt(report.get('quarantine_records', 0))}\",\n",
    "    )\n",
    "add_check(\n",
    "    \"Clean DB hanya berisi Clean/Warning\",\n",
    "    set(routing_clean) <= {\"Clean\", \"Warning\"},\n",
    "    f\"isi: {routing_clean}\",\n",
    ")\n",
    "add_check(\n",
    "    \"Quarantine DB hanya berisi Quarantine\",\n",
    "    set(routing_quar) <= {\"Quarantine\"},\n",
    "    f\"isi: {routing_quar}\",\n",
    ")\n",
    "add_check(\n",
    "    \"gbifID unik di Clean\",\n",
    "    res_clean[\"distinct_gbifID\"] + res_clean[\"null_gbifID\"] == res_clean[\"rows\"],\n",
    "    f\"{fmt(res_clean['rows'])} baris | {fmt(res_clean['distinct_gbifID'])} gbifID berbeda | {fmt(res_clean['null_gbifID'])} kosong\",\n",
    ")\n",
    "add_check(\n",
    "    \"gbifID unik di Quarantine\",\n",
    "    res_quar[\"distinct_gbifID\"] + res_quar[\"null_gbifID\"] == res_quar[\"rows\"],\n",
    "    f\"{fmt(res_quar['rows'])} baris | {fmt(res_quar['distinct_gbifID'])} gbifID berbeda | {fmt(res_quar['null_gbifID'])} kosong\",\n",
    ")\n",
    "add_check(\n",
    "    \"Tidak ada gbifID yang sama di Clean dan Quarantine\",\n",
    "    overlap_gbif == 0,\n",
    "    f\"irisan: {fmt(overlap_gbif)} record\",\n",
    ")\n",
    "add_check(\n",
    "    \"occurrenceID tidak berulang di Clean\",\n",
    "    res_clean[\"dup_occurrenceID\"] == 0,\n",
    "    f\"{fmt(res_clean['dup_occurrenceID'])} occurrenceID muncul lebih dari sekali\",\n",
    ")\n",
    "add_check(\n",
    "    \"Semua record Clean bertipe duplikat UNIQUE\",\n",
    "    non_unique_in_clean == 0,\n",
    "    f\"{fmt(non_unique_in_clean)} record non-UNIQUE di Clean\",\n",
    ")\n",
    "\n",
    "null_bad = {k: v for k, v in mandatory_null_clean.items() if v}\n",
    "add_check(\n",
    "    \"Kolom wajib di Clean tidak ada yang kosong\",\n",
    "    not null_bad,\n",
    "    \"semua terisi\" if not null_bad else f\"kolom kosong: { {k: fmt(v) for k, v in null_bad.items()} }\",\n",
    ")\n",
    "\n",
    "add_check(\n",
    "    \"Kolom ganda (DOUBLE) telah disatukan menjadi 1 kolom\",\n",
    "    not KEEP_REDUNDANT_COLUMNS,\n",
    "    f\"CLEAN: {len(res_clean['dropped_columns'])} kolom ganda dihapus ({res_clean['cols_source']} -> {res_clean['cols']} kolom) | \"\n",
    "    f\"QUARANTINE: {len(res_quar['dropped_columns'])} kolom ganda dihapus ({res_quar['cols_source']} -> {res_quar['cols']} kolom)\",\n",
    ")\n",
    "\n",
    "add_check(\n",
    "    \"Kolom konstan/perantara dihapus dari Clean Set (Quarantine tetap lengkap)\",\n",
    "    all(r[\"kolom_dihapus\"] not in clean_loaded_set for r in res_clean[\"removed_columns\"]),\n",
    "    f\"CLEAN: {len(res_clean['removed_columns'])} kolom dihapus | QUARANTINE: {len(res_quar['removed_columns'])} kolom dihapus\",\n",
    ")\n",
    "\n",
    "for chk in checks:\n",
    "    if chk[\"hasil\"] != \"OK\":\n",
    "        adjustment_notes.append(f\"Pemeriksaan gagal: {chk['pemeriksaan']} ({chk['keterangan']})\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 5. RINGKASAN\n",
    "# ==============================================================================\n",
    "def size_mb(p: Path) -> float:\n",
    "    return p.stat().st_size / 1024 / 1024\n",
    "\n",
    "\n",
    "print(\"\\n\" + \"=\" * 90)\n",
    "print(\"RINGKASAN TAHAP 6: PEMUATAN KE DUCKDB (FORMAT PARQUET)\")\n",
    "print(\"=\" * 90)\n",
    "for res in (res_clean, res_quar):\n",
    "    print(\n",
    "        f\"{res['label']:<11}: {fmt(res['rows']):>10} record | \"\n",
    "        f\"{res['cols']} kolom aktif (dari {res['cols_source']} kolom sumber, {len(res['dropped_columns'])} kolom ganda disatukan, \"\n",
    "        f\"{len(res['removed_columns'])} kolom konstan/perantara dihapus) | \"\n",
    "        f\"DB {size_mb(res['db_path']):.1f} MB | parquet final {size_mb(res['final_parquet']):.1f} MB\"\n",
    "    )\n",
    "    print(f\"             DB      : {res['db_path']}\")\n",
    "    print(f\"             Parquet : {res['final_parquet']}\")\n",
    "print(f\"Clean Set per status routing : {routing_clean}\")\n",
    "print(f\"Quarantine per status routing: {routing_quar}\")\n",
    "print(f\"eventDate NULL di Clean (parsial/interval, nilai asli di verbatimEventDateRaw): {fmt(event_date_null_clean)}\")\n",
    "\n",
    "print(\"\\nPEMERIKSAAN:\")\n",
    "print(pd.DataFrame(checks).to_string(index=False))\n",
    "\n",
    "print(\"\\nAUDIT & PENYATUAN KOLOM GANDA:\")\n",
    "print(pd.concat([res_clean[\"audit\"], res_quar[\"audit\"]], ignore_index=True).to_string(index=False))\n",
    "\n",
    "df_all_dropped = pd.DataFrame(res_clean[\"dropped_columns\"] + res_quar[\"dropped_columns\"])\n",
    "if not df_all_dropped.empty:\n",
    "    print(\"\\nDAFTAR KOLOM GANDA YANG DIHAPUS (DIJADIKAN 1 KOLOM UTAMA):\")\n",
    "    print(df_all_dropped.to_string(index=False))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 90)\n",
    "print(\"CATATAN PENYESUAIAN\")\n",
    "print(\"=\" * 90)\n",
    "if adjustment_notes:\n",
    "    for i, note in enumerate(adjustment_notes, start=1):\n",
    "        print(f\"{i}. {note}\")\n",
    "else:\n",
    "    print(\"Tidak ada. Seluruh kolom ganda (DOUBLE) sudah otomatis disatukan menjadi 1 kolom utama.\")\n",
    "\n",
    "with open(out_dir / \"06_duckdb_load_report.json\", \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump({\n",
    "        \"generated_at\": datetime.now().isoformat(timespec=\"seconds\"),\n",
    "        \"clean\": {k: (str(v) if isinstance(v, Path) else v) for k, v in res_clean.items() if k != \"audit\"},\n",
    "        \"quarantine\": {k: (str(v) if isinstance(v, Path) else v) for k, v in res_quar.items() if k != \"audit\"},\n",
    "        \"checks\": checks,\n",
    "        \"redundancy_audit\": pd.concat([res_clean[\"audit\"], res_quar[\"audit\"]], ignore_index=True).to_dict(orient=\"records\"),\n",
    "        \"adjustment_notes\": adjustment_notes,\n",
    "    }, f, indent=2, default=str)"
   ]
  },
