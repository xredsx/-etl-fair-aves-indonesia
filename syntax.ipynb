    "dim_scores_map = {}\n",
    "\n",
    "for dim_name in dim_order:\n",
    "    sub = df_fair_indicators[df_fair_indicators[\"Dimensi\"] == dim_name]\n",
    "    w_sum = float(sub[\"Bobot (w_i)\"].sum())\n",
    "    ws_sum = float(sub[\"Skor_Tertimbang (w_i * s_i)\"].sum())\n",
    "    dim_score = ws_sum / w_sum if w_sum else 0.0\n",
    "    dim_scores_map[dim_name] = dim_score\n",
    "    dim_summary_rows.append({\n",
    "        \"Dimensi_FAIR\": dim_name,\n",
    "        \"Jumlah_Indikator\": len(sub),\n",
    "        \"Total_Bobot (Sum w_i)\": int(w_sum),\n",
    "        \"Total_Skor_Tertimbang (Sum w_i*s_i)\": round(ws_sum, 4),\n",
    "        \"Skor_Dimensi (0-1)\": round(dim_score, 4),\n",
    "        \"Skor_Dimensi (%)\": round(dim_score * 100.0, 2),\n",
    "    })\n",
    "\n",
    "FAIR_F = dim_scores_map[\"Findable (F)\"]\n",
    "FAIR_A = dim_scores_map[\"Accessible (A)\"]\n",
