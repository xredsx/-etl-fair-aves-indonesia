    "    f\"jumlah record ({n_clean_total:,} Clean & {n_quar_total:,} Quarantine), dan tanggal pembuatan ({desc_meta['created_date']}).\"\n",
    ")\n",
    "\n",
    "license_ratio = qref_stats[2] / n_clean_total if n_clean_total else 0.0\n",
    "has_meta_license = bool(dataset_metadata_fair[\"R1_1_license_and_usage_terms\"][\"dataset_curation_license\"])\n",
    "s_R1_1 = 1.0 if (has_meta_license and license_ratio >= 0.99) else round(license_ratio, 4)\n",
    "bukti_R1_1 = (\n",
    "    f\"Mencantumkan lisensi eksplisit pada level dataset ({dataset_metadata_fair['R1_1_license_and_usage_terms']['dataset_curation_license']}) \"\n",
    "    f\"dan kolom 'license' pada level record yang terisi {qref_stats[2]:,}/{n_clean_total:,} record ({license_ratio * 100:.2f}%).\"\n",
