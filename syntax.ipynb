   "source": [
    "import gc, json, duckdb # Modul garbage collector, JSON, dan mesin basis data analitik DuckDB\n",
    "from datetime import datetime # Utilitas pencatatan waktu muat (timestamp log)\n",
    "from pathlib import Path # Manajemen path direktori dan berkas lintas platform\n",
    "import pandas as pd # Library manipulasi tabel kamus data, audit redundansi, dan log ETL\n",
    "\n",
    "for _o in list(globals().values()) + gc.get_objects(): # Tutup koneksi DuckDB yang masih aktif di memori Jupyter agar tidak lock\n",
    "    try:\n",
    "        if isinstance(_o, duckdb.DuckDBPyConnection): _o.close()\n",
    "    except Exception: pass\n",
    "\n",
    "OUT_DIR = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\") # Direktori utama output pipeline ETL\n",
    "CLEAN_PQ, QUAR_PQ = OUT_DIR / \"clean_set_aves_indonesia.parquet\", OUT_DIR / \"quarantine_store_aves_indonesia.parquet\" # Input Parquet Tahap 5\n",
    "REP_45, DB_DIR, FIN_DIR = OUT_DIR / \"04_05_validation_and_routing_report.json\", OUT_DIR / \"db\", OUT_DIR / \"final_parquet\" # Path laporan & folder DB\n",
    "DB_DIR.mkdir(parents=True, exist_ok=True); FIN_DIR.mkdir(parents=True, exist_ok=True) # Pastikan folder db/ dan final_parquet/ tersedia\n",
    "CLEAN_DB, QUAR_DB = DB_DIR / \"clean_store_aves_indonesia.duckdb\", DB_DIR / \"quarantine_store_aves_indonesia.duckdb\" # Path berkas DuckDB\n",
    "CLEAN_TBL, QUAR_TBL, COMP = \"occurrence_clean\", \"occurrence_quarantine\", \"ZSTD\" # Nama tabel utama & algoritma kompresi Parquet final\n",
    "KEEP_RED, DBL_PCT, DEDUP_DER = False, 100.0, True # Konfigurasi penyatuan kolom ganda (100% identik) & kolom turunan\n",
    "PROT_COLS = {\"verbatimScientificName\", \"taxonKey\", \"acceptedTaxonKey\"} # Kolom asal-usul & kunci taksonomi yang dilindungi dari penghapusan\n",
    "CLEAN_CONST = [\"status_completeness\", \"status_uniqueness\", \"status_spatial\", \"status_taxonomy\", \"taxonomyValidationStatus\", \"duplicate_type\", \"Invalid_Reasons\"] # Kolom bernilai tunggal di Clean Set\n",
    "CLEAN_INTER = [\"spatialPreliminaryStatus\", \"spatialLandClass\", \"fuzzyEditDistance\", \"isTaxonKeyConsistent\"] # Kolom perantara yang tidak dimuat ke Clean Set\n",
    "for _p in (CLEAN_PQ, QUAR_PQ): # Validasi keberadaan file Parquet hasil Tahap 4 & 5\n",
    "    if not _p.exists(): raise FileNotFoundError(f\"Berkas {_p} belum ada. Jalankan Tahap 4 & 5 terlebih dahulu.\")\n",
    "\n",
    "CORE_29 = [(\"gbifID\", \"Identitas\", \"Identitas unik catatan dari GBIF\", \"\"), (\"occurrenceID\", \"Identitas\", \"Identitas kejadian observasi\", \"\"), (\"datasetKey\", \"Duplicate & Provenance\", \"Kunci dataset GBIF sumber catatan\", \"Atribut sumber pada GBIF Simple CSV (Tahap 1 & 2)\"), (\"basisOfRecord\", \"Identitas\", \"Jenis dasar pencatatan\", \"Huruf kapital (Tahap 2)\"), (\"occurrenceStatus\", \"Identitas\", \"Status keberadaan organisme\", \"Huruf kapital (Tahap 2)\"), (\"eventDate\", \"Temporal\", \"Tanggal kejadian/observasi\", \"Format ISO 8601 bertipe DATE; NULL bila parsial/interval/tidak terbaca, nilai asli ada di verbatimEventDateRaw\"), (\"year\", \"Temporal\", \"Tahun observasi\", \"\"), (\"month\", \"Temporal\", \"Bulan observasi\", \"\"), (\"countryCode\", \"Spatial\", \"Negara lokasi observasi\", \"Huruf kapital (Tahap 2)\"), (\"stateProvince\", \"Spatial\", \"Provinsi lokasi observasi\", \"\"), (\"decimalLatitude\", \"Spatial\", \"Lintang lokasi observasi\", \"Bertipe angka desimal; koma desimal diperbaiki (Tahap 2)\"), (\"decimalLongitude\", \"Spatial\", \"Bujur lokasi observasi\", \"Bertipe angka desimal; koma desimal diperbaiki (Tahap 2)\"), (\"hasCoordinate\", \"Spatial\", \"Indikator ketersediaan koordinat\", \"Atribut turunan bertipe boolean (Tahap 1 & 2)\"), (\"hasGeospatialIssues\", \"Spatial\", \"Indikator masalah geospasial\", \"Atribut turunan dari flag issue GBIF bertipe boolean (Tahap 1 & 2)\"), (\"scientificName\", \"Taksonomi\", \"Nama ilmiah pada catatan GBIF\", \"Diseragamkan ke nama yang diterima pada Catalogue of Life bila taksonomi VALID (Tahap 3); nama asli di verbatimScientificName\"), (\"verbatimScientificName\", \"Taksonomi\", \"Nama ilmiah sebagaimana berasal dari publisher\", \"\"), (\"acceptedScientificName\", \"Taksonomi\", \"Nama ilmiah yang diterima menurut Catalogue of Life (COL XR)\", \"Dibentuk dan diisi dari hasil pencocokan Catalogue of Life bila taksonomi VALID (Tahap 3)\"), (\"taxonKey\", \"Taksonomi\", \"Identitas takson Catalogue of Life pada unduhan GBIF\", \"\"), (\"acceptedTaxonKey\", \"Taksonomi\", \"Identifier takson yang diterima pada Catalogue of Life (COL XR)\", \"Dibentuk dan diisi dari hasil pencocokan Catalogue of Life bila taksonomi VALID (Tahap 3)\"), (\"taxonomicStatus\", \"Taksonomi\", \"Status takson pada Catalogue of Life\", \"Dibentuk di Tahap 3; menjadi ACCEPTED bila taksonomi VALID\"), (\"taxonRank\", \"Taksonomi\", \"Tingkatan takson\", \"Huruf kapital (Tahap 2)\"), (\"family\", \"Taksonomi\", \"Famili organisme\", \"Dilengkapi dari Catalogue of Life bila kosong & taksonomi VALID (Tahap 3)\"), (\"genus\", \"Taksonomi\", \"Genus organisme\", \"Dilengkapi dari Catalogue of Life bila kosong & taksonomi VALID (Tahap 3)\"), (\"species\", \"Taksonomi\", \"Spesies organisme\", \"Dilengkapi dari Catalogue of Life bila kosong & taksonomi VALID (Tahap 3)\"), (\"institutionCode\", \"Duplicate & Provenance\", \"Institusi sumber catatan\", \"\"), (\"collectionCode\", \"Duplicate & Provenance\", \"Kode koleksi sumber\", \"\"), (\"catalogNumber\", \"Duplicate & Provenance\", \"Nomor katalog catatan\", \"\"), (\"recordedBy\", \"Duplicate & Provenance\", \"Pencatat/pengamat\", \"\"), (\"publisher\", \"Duplicate & Provenance\", \"Nama organisasi penerbit data\", \"Atribut turunan dari publishingOrgKey via GBIF Registry API (Tahap 1)\")] # Metadata 29 atribut Darwin Core\n",
    "ETL_EXTRA = [(\"license\", \"Tambahan ETL - Sumber\", \"Lisensi penggunaan data pada level record\", \"Tahap 2\"), (\"verbatimEventDateRaw\", \"Tambahan ETL - Temporal\", \"Nilai eventDate asli dari sumber sebelum standardisasi\", \"Tahap 2\"), (\"eventDateParseStatus\", \"Tambahan ETL - Temporal\", \"Status hasil standardisasi eventDate\", \"Tahap 2\"), (\"matchedTaxonKey\", \"Tambahan ETL - Taksonomi\", \"Kunci takson hasil pencocokan Catalogue of Life (GBIF Species Match API v2)\", \"Tahap 3\"), (\"matchedAcceptedScientificName\", \"Tambahan ETL - Taksonomi\", \"Nama diterima hasil pencocokan Catalogue of Life (GBIF Species Match API v2)\", \"Tahap 3\"), (\"matchType\", \"Tambahan ETL - Taksonomi\", \"Jenis kecocokan (EXACT, VARIANT, FUZZY, HIGHERRANK, NONE)\", \"Tahap 3\"), (\"matchedRank\", \"Tambahan ETL - Taksonomi\", \"Tingkat takson hasil pencocokan Catalogue of Life\", \"Tahap 3\"), (\"matchedStatus\", \"Tambahan ETL - Taksonomi\", \"Status takson awal pada Catalogue of Life sebelum penyeragaman\", \"Tahap 3\"), (\"taxonomicMatchCategory\", \"Tambahan ETL - Taksonomi\", \"Kategori pencocokan Tabel 2.5 (Accepted, Synonym resolved, Higher-rank, Fuzzy, No match)\", \"Tahap 3\"), (\"taxonomyValidationStatus\", \"Tambahan ETL - Taksonomi\", \"Keputusan validasi taksonomi (VALID/INVALID)\", \"Tahap 3\"), (\"fuzzyEditDistance\", \"Tambahan ETL - Taksonomi\", \"Jarak edit Levenshtein pada fuzzy match\", \"Tahap 3\"), (\"isTaxonKeyConsistent\", \"Tambahan ETL - Taksonomi\", \"Kesesuaian taxonKey bawaan dataset terhadap matchedTaxonKey Catalogue of Life\", \"Tahap 3\"), (\"spatialLandClass\", \"Tambahan ETL - Spasial\", \"Kelas daratan titik (INDONESIA_LAND, SEA_OR_COAST, OTHER_COUNTRY_LAND, OUTSIDE_BBOX, NO_COORD)\", \"Tahap 2\"), (\"distanceToIndonesiaLandKm\", \"Tambahan ETL - Spasial\", \"Jarak titik ke daratan Indonesia terdekat (km)\", \"Tahap 2\"), (\"spatialPreliminaryStatus\", \"Tambahan ETL - Spasial\", \"Status awal spasial (CLEAN_LAND, CLEAN_COASTAL_TOLERANCE, NEEDS_HABITAT_CHECK, NO_COORD)\", \"Tahap 2\"), (\"spatialHabitatStatus\", \"Tambahan ETL - Spasial\", \"Hasil pengecekan habitat spesies (NOT_REQUIRED, SUPPORTED, ANOMALY, UNVERIFIABLE_TAXON)\", \"Tahap 3\"), (\"spatialHabitatSupportKm\", \"Tambahan ETL - Spasial\", \"Jarak ke koordinat pendukung ke-N dari spesies yang sama (km)\", \"Tahap 3\"), (\"spatial_validation_detail\", \"Tambahan ETL - Spasial\", \"Rincian hasil validasi spasial-habitat\", \"Tahap 4\"), (\"vmt_validation_detail\", \"Tambahan ETL - Temporal\", \"Rincian hasil validasi metadata dan temporal (Tabel 2.9)\", \"Tahap 4\"), (\"status_completeness\", \"Hasil Validasi & Routing\", \"Status dimensi kelengkapan (VALID/INVALID)\", \"Tahap 4\"), (\"status_uniqueness\", \"Hasil Validasi & Routing\", \"Status dimensi keunikan (VALID/INVALID)\", \"Tahap 4\"), (\"status_spatial\", \"Hasil Validasi & Routing\", \"Status dimensi validitas spasial (VALID/INVALID)\", \"Tahap 4\"), (\"status_taxonomy\", \"Hasil Validasi & Routing\", \"Status dimensi resolusi taksonomi (VALID/INVALID)\", \"Tahap 4\"), (\"status_metadata_temporal\", \"Hasil Validasi & Routing\", \"Status dimensi metadata & temporal (VALID/WARNING/INVALID)\", \"Tahap 4\"), (\"duplicate_type\", \"Hasil Validasi & Routing\", \"Jenis duplikat (UNIQUE, DUP_EXACT, DUP_OCCURRENCE_ID, DUP_CATALOG)\", \"Tahap 4\"), (\"record_routing_status\", \"Hasil Validasi & Routing\", \"Hasil routing akhir (Clean, Warning, Quarantine)\", \"Tahap 5\"), (\"Invalid_Reasons\", \"Hasil Validasi & Routing\", \"Dimensi yang berstatus INVALID (dipisah titik koma)\", \"Tahap 5\")] # Metadata atribut tambahan ETL\n",
    "RED_COLS = {\"eventDateParsed\": (\"eventDate\", \"isinya sama dengan eventDate (bertipe DATE di DuckDB)\")} # Kolom pembantu yang selalu digabung ke eventDate\n",
    "PAIR_CHKS = [(\"eventDate vs eventDateParsed\", 'TRY_CAST(\"eventDate\" AS DATE)', '\"eventDateParsed\"', [\"eventDate\", \"eventDateParsed\"], \"eventDate\", \"eventDateParsed\", False), (\"scientificName vs acceptedScientificName\", '\"scientificName\"', '\"acceptedScientificName\"', [\"scientificName\", \"acceptedScientificName\"], \"scientificName\", \"acceptedScientificName\", False), (\"scientificName vs matchedAcceptedScientificName\", '\"scientificName\"', '\"matchedAcceptedScientificName\"', [\"scientificName\", \"matchedAcceptedScientificName\"], \"scientificName\", \"matchedAcceptedScientificName\", False), (\"acceptedScientificName vs matchedAcceptedScientificName\", '\"acceptedScientificName\"', '\"matchedAcceptedScientificName\"', [\"acceptedScientificName\", \"matchedAcceptedScientificName\"], \"acceptedScientificName\", \"matchedAcceptedScientificName\", False), (\"scientificName vs verbatimScientificName\", '\"scientificName\"', '\"verbatimScientificName\"', [\"scientificName\", \"verbatimScientificName\"], \"scientificName\", \"verbatimScientificName\", False), (\"taxonKey vs acceptedTaxonKey\", '\"taxonKey\"', '\"acceptedTaxonKey\"', [\"taxonKey\", \"acceptedTaxonKey\"], \"taxonKey\", \"acceptedTaxonKey\", False), (\"taxonKey vs matchedTaxonKey\", '\"taxonKey\"', '\"matchedTaxonKey\"', [\"taxonKey\", \"matchedTaxonKey\"], \"taxonKey\", \"matchedTaxonKey\", False), (\"acceptedTaxonKey vs matchedTaxonKey\", '\"acceptedTaxonKey\"', '\"matchedTaxonKey\"', [\"acceptedTaxonKey\", \"matchedTaxonKey\"], \"acceptedTaxonKey\", \"matchedTaxonKey\", False), (\"hasCoordinate vs (lintang & bujur terisi)\", '\"hasCoordinate\"', '(\"decimalLatitude\" IS NOT NULL AND \"decimalLongitude\" IS NOT NULL)', [\"hasCoordinate\", \"decimalLatitude\", \"decimalLongitude\"], \"decimalLatitude\", \"hasCoordinate\", True), (\"year vs tahun dari eventDate\", '\"year\"', 'year(TRY_CAST(\"eventDate\" AS DATE))', [\"year\", \"eventDate\"], \"eventDate\", \"year\", True), (\"month vs bulan dari eventDate\", '\"month\"', 'month(TRY_CAST(\"eventDate\" AS DATE))', [\"month\", \"eventDate\"], \"eventDate\", \"month\", True)] # Pasangan audit redundansi\n",
    "\n",
    "CORE_NMS, ETL_NMS, adj_notes = [c[0] for c in CORE_29], [c[0] for c in ETL_EXTRA], [] # Daftar nama kolom & penampung catatan penyesuaian\n",
    "sql_p = lambda p: p.as_posix().replace(\"'\", \"''\"); fmt = lambda n: f\"{int(n):,}\" # Helper format path SQL & ribuan\n",
    "run_q = lambda con, sql: con.execute(sql).fetchall(); one_q = lambda con, sql: run_q(con, sql)[0] # Helper eksekusi kueri DuckDB\n",
    "def reg_tbl(con, tbl_nm: str, df_obj: pd.DataFrame): con.register(\"_tmp_df\", df_obj); run_q(con, f'CREATE OR REPLACE TABLE \"{tbl_nm}\" AS SELECT * FROM _tmp_df'); con.unregister(\"_tmp_df\") # Helper simpan DataFrame ke tabel DuckDB\n",
    "\n",
    "def build_db(db_p: Path, tbl: str, pq_p: Path, lbl: str) -> dict: # Fungsi pembangun basis data DuckDB, kamus data, view, dan Parquet final\n",
    "    for sfx in (\"\", \".wal\"): # Hapus berkas database lama dan write-ahead log (.wal) sebelum membuat ulang\n",
    "        if (f := Path(str(db_p) + sfx)).exists(): f.unlink()\n",
    "    src = f\"read_parquet('{sql_p(pq_p)}')\" # Ekspresi pembacaan Parquet sumber di DuckDB\n",
    "    with duckdb.connect(str(db_p)) as con: # Buka koneksi tulis ke berkas DuckDB\n",
    "        s_cols = [r[0] for r in run_q(con, f\"DESCRIBE SELECT * FROM {src}\")]; s_set = set(s_cols) # Ambil daftar kolom Parquet sumber\n",
    "        if (m_core := [c for c in CORE_NMS if c not in s_set]): raise KeyError(f\"[{lbl}] Kolom wajib 29 atribut tidak lengkap: {m_core}\")\n",
    "        if (m_etl := [c for c in ETL_NMS if c not in s_set]): adj_notes.append(f\"[{lbl}] Kolom ETL tidak ditemukan & dilewati: {m_etl}\")\n",
    "        drop_map = {rc: (kt, 100.0) for rc, (kt, _) in RED_COLS.items() if rc in s_set and not KEEP_RED} # Inisialisasi peta penggabungan kolom\n",
    "        aud_rows = [] # 1) Audit kesamaan nilai antar pasangan kolom sebelum memilih kolom tabel utama\n",
    "        for nm, ea, eb, req, kc, dc, is_der in PAIR_CHKS:\n",
    "            if not all(c in s_set for c in req): continue # Lewati jika salah satu kolom pasangan tidak ada\n",
    "            n_cmp, n_sm = one_q(con, f\"SELECT COUNT(*), SUM(CASE WHEN ({ea}) IS NOT DISTINCT FROM ({eb}) THEN 1 ELSE 0 END) FROM {src}\")\n",
    "            n_sm = int(n_sm or 0); pct = n_sm / n_cmp * 100 if n_cmp else 0.0 # Persentase baris yang bernilai identik\n",
    "            is_dbl = n_cmp > 0 and n_sm >= n_cmp * DBL_PCT / 100; is_prt = dc in PROT_COLS # Cek apakah 100% identik & apakah dilindungi\n",
    "            sh_drp = is_dbl and not is_prt and not KEEP_RED and (DEDUP_DER or not is_der) # Keputusan penyatuan kolom\n",
    "            eff_k = kc\n",
    "            while eff_k in drop_map: eff_k = drop_map[eff_k][0] # Telusuri kolom tujuan akhir bila terjadi rantai penggabungan\n",
    "            if sh_drp:\n",
    "                if dc not in drop_map: drop_map[dc] = (eff_k, round(pct, 4))\n",
    "                act = f\"DIJADIKAN 1 -> simpan '{eff_k}', hapus '{dc}'\"\n",
    "            elif is_dbl and is_prt: act = f\"DOUBLE tetapi '{dc}' kolom terlindungi (tetap dimuat)\"; adj_notes.append(f\"[{lbl}] {nm}: identik 100% tetapi '{dc}' di PROTECTED_COLUMNS.\")\n",
    "            elif is_dbl: act = \"DOUBLE (tetap dimuat sesuai konfigurasi)\"\n",
    "            else: act = f\"hampir sama, {fmt(n_cmp - n_sm)} baris berbeda (tetap dimuat)\" if pct >= 90 else \"berbeda (tetap dimuat)\"\n",
    "            aud_rows.append({\"database\": lbl, \"pasangan_kolom\": nm, \"jumlah_dibandingkan\": int(n_cmp), \"baris_berbeda\": int(n_cmp - n_sm), \"identik_persen\": round(pct, 4), \"keterangan\": \"DOUBLE (isi identik)\" if is_dbl else (\"hampir sama\" if pct >= 90 else \"berbeda\"), \"tindakan\": act})\n",
    "\n",
    "        mrg_into = {} # Petakan daftar kolom ganda yang diwakili oleh masing-masing kolom utama\n",
    "        for dc, (kc, _) in drop_map.items():\n",
    "            while kc in drop_map: kc = drop_map[kc][0]\n",
    "            mrg_into.setdefault(kc, []).append(dc)\n",
    "        unk = [c for c in s_cols if c not in CORE_NMS and c not in ETL_NMS and c not in RED_COLS] # Kolom tambahan di luar daftar standar\n",
    "        cands = CORE_NMS + [c for c in ETL_NMS if c in s_set] + unk + ([c for c in RED_COLS if c in s_set] if KEEP_RED else [])\n",
    "        ord_c, drp_list = [c for c in cands if c not in drop_map], [c for c in s_cols if c in drop_map] # Susun kandidat kolom aktif\n",
    "        non_unq = one_q(con, f\"SELECT COUNT(*) FROM {src} WHERE \\\"duplicate_type\\\" <> 'UNIQUE'\")[0] if \"duplicate_type\" in s_set else 0\n",
    "\n",
    "        rem_rows = [] # 2) Pada Clean Set, hapus kolom validasi yang bernilai konstan tunggal serta kolom perantara\n",
    "        if lbl == \"CLEAN\":\n",
    "            for c in CLEAN_CONST:\n",
    "                if c not in ord_c: continue\n",
    "                if (nv := one_q(con, f'SELECT COUNT(DISTINCT \"{c}\") FROM {src}')[0]) > 1: adj_notes.append(f\"[{lbl}] Kolom '{c}' memiliki {nv} nilai berbeda, tidak dihapus.\"); continue\n",
    "                v = one_q(con, f'SELECT MIN(\"{c}\") FROM {src}')[0]; rem_rows.append({\"database\": lbl, \"kolom_dihapus\": c, \"alasan\": \"isi konstan pada Clean Set\", \"nilai_tunggal\": \"kosong semua\" if v is None else str(v)})\n",
    "            for c in CLEAN_INTER:\n",
    "                if c in ord_c: rem_rows.append({\"database\": lbl, \"kolom_dihapus\": c, \"alasan\": \"kolom perantara/turunan\", \"nilai_tunggal\": \"\"})\n",
    "            rem_set = {r[\"kolom_dihapus\"] for r in rem_rows}; ord_c = [c for c in ord_c if c not in rem_set] # Saring hingga tersisa 41 kolom bersih\n",
    "        rem_list = [r[\"kolom_dihapus\"] for r in rem_rows]\n",
    "\n",
    "        prts = [f'TRY_CAST(\"{c}\" AS DATE) AS \"{c}\"' if c == \"eventDate\" else f'\"{c}\"' for c in ord_c] # Konversi eventDate ke tipe DATE SQL\n",
    "        if (l_dt := one_q(con, f'SELECT COUNT(*) FROM {src} WHERE \"eventDate\" IS NOT NULL AND TRY_CAST(\"eventDate\" AS DATE) IS NULL')[0]): adj_notes.append(f\"[{lbl}] {fmt(l_dt)} eventDate gagal cast ke DATE.\")\n",
    "        run_q(con, f'CREATE OR REPLACE TABLE \"{tbl}\" AS SELECT {\", \".join(prts)} FROM {src}') # 3) Buat tabel utama di DuckDB\n",
    "        n_r = one_q(con, f'SELECT COUNT(*) FROM \"{tbl}\"')[0]; tps = {r[0]: r[1] for r in run_q(con, f'DESCRIBE \"{tbl}\"')} # Hitung baris & tipe data\n",
    "\n",
    "        meta = {c[0]: (c[1], c[2], c[3], \"Struktur 29 atribut\") for c in CORE_29}; meta.update({c[0]: (c[1], c[2], f\"Dihasilkan di {c[3]}\", c[3]) for c in ETL_EXTRA}) # 4) Bangun tabel data_dictionary\n",
    "        d_rows = []\n",
    "        for i, c in enumerate(ord_c, 1):\n",
    "            grp, fn, nt, sb = meta.get(c, (\"Lainnya\", \"\", \"\", \"Tidak ada di struktur\"))\n",
    "            if (rep := mrg_into.get(c, [])): ex = f\"Mewakili kolom ganda yang disatukan: {', '.join(rep)}\"; nt = f\"{nt}; {ex}\" if nt else ex\n",
    "            d_rows.append({\"no\": i, \"kelompok\": grp, \"atribut\": c, \"tipe_data_duckdb\": tps.get(c, \"\"), \"fungsi\": fn, \"catatan_etl\": nt, \"sumber\": sb})\n",
    "        reg_tbl(con, \"data_dictionary\", pd.DataFrame(d_rows)) # Simpan kamus data ke dalam DuckDB\n",
    "        drp_rows = [{\"database\": lbl, \"kolom_dihapus\": dc, \"disatukan_ke_kolom\": drop_map[dc][0], \"identik_persen\": drop_map[dc][1]} for dc in drp_list]\n",
    "        reg_tbl(con, \"etl_removed_columns\", pd.DataFrame(rem_rows, columns=[\"database\", \"kolom_dihapus\", \"alasan\", \"nilai_tunggal\"]))\n",
    "        reg_tbl(con, \"etl_merged_columns\", pd.DataFrame(drp_rows, columns=[\"database\", \"kolom_dihapus\", \"disatukan_ke_kolom\", \"identik_persen\"]))\n",
    "        for c_nm, t_nm in [(\"05_rekapitulasi_routing_record.csv\", \"etl_routing_summary\"), (\"04_rekapitulasi_validasi_5_dimensi.csv\", \"etl_dimension_summary\"), (\"04_rincian_validasi_spasial_habitat.csv\", \"etl_spatial_detail\"), (\"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\", \"etl_before_after_summary\")]:\n",
    "            if (cp := OUT_DIR / c_nm).exists(): reg_tbl(con, t_nm, pd.read_csv(cp)) # Sematkan tabel ringkasan evaluasi Tahap 4 & 5 ke dalam DB\n",
    "\n",
    "        run_q(con, f'CREATE OR REPLACE VIEW v_routing_in_this_db AS SELECT record_routing_status, COUNT(*) AS jumlah_record, ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 4) AS proporsi_persen FROM \"{tbl}\" GROUP BY record_routing_status ORDER BY record_routing_status')\n",
    "        if lbl == \"CLEAN\": # Buat view pemisah record Clean murni dan Warning pada Clean DB\n",
    "            run_q(con, f\"CREATE OR REPLACE VIEW v_clean_only AS SELECT * FROM \\\"{tbl}\\\" WHERE record_routing_status = 'Clean'\")\n",
    "            run_q(con, f\"CREATE OR REPLACE VIEW v_warning_only AS SELECT * FROM \\\"{tbl}\\\" WHERE record_routing_status = 'Warning'\")\n",
    "        else: # Buat tabel agregasi diagnostik penyebab karantina pada Quarantine DB\n",
    "            run_q(con, f'CREATE OR REPLACE TABLE quarantine_reason_by_dimension AS SELECT dimensi_invalid, COUNT(*) AS jumlah_record FROM (SELECT unnest(string_split(\"Invalid_Reasons\", \\';\\')) AS dimensi_invalid FROM \"{tbl}\" WHERE \"Invalid_Reasons\" IS NOT NULL) GROUP BY dimensi_invalid ORDER BY jumlah_record DESC')\n",
    "            run_q(con, f'CREATE OR REPLACE TABLE quarantine_reason_combination AS SELECT \"Invalid_Reasons\" AS kombinasi_dimensi_invalid, COUNT(*) AS jumlah_record FROM \"{tbl}\" GROUP BY \"Invalid_Reasons\" ORDER BY jumlah_record DESC')\n",
    "            run_q(con, f'CREATE OR REPLACE TABLE quarantine_spatial_detail AS SELECT spatial_validation_detail, COUNT(*) AS jumlah_record FROM \"{tbl}\" GROUP BY spatial_validation_detail ORDER BY jumlah_record DESC')\n",
    "\n",
    "        df_aud = pd.DataFrame(aud_rows); reg_tbl(con, \"etl_redundancy_audit\", df_aud) # Simpan tabel hasil audit redundansi kolom\n",
    "        _, n_dist_id, n_null_id = one_q(con, f'SELECT COUNT(*), COUNT(DISTINCT \"gbifID\"), COUNT(*) FILTER (WHERE \"gbifID\" IS NULL) FROM \"{tbl}\"')\n",
    "        d_occ = one_q(con, f'SELECT COUNT(*) FROM (SELECT \"occurrenceID\" FROM \"{tbl}\" WHERE \"occurrenceID\" IS NOT NULL GROUP BY \"occurrenceID\" HAVING COUNT(*) > 1)')[0]\n",
    "        fin_pq = FIN_DIR / f\"{tbl}.parquet\"; fin_pq.unlink(missing_ok=True) # 5) Ekspor tabel akhir ke Apache Parquet berformat kompresi ZSTD\n",
    "        run_q(con, f\"COPY \\\"{tbl}\\\" TO '{sql_p(fin_pq)}' (FORMAT PARQUET, COMPRESSION {COMP}, ROW_GROUP_SIZE 122880)\")\n",
    "        reg_tbl(con, \"etl_load_log\", pd.DataFrame([{\"loaded_at\": datetime.now().isoformat(timespec=\"seconds\"), \"tabel\": tbl, \"jumlah_record\": int(n_r), \"jumlah_kolom_awal\": len(s_cols), \"jumlah_kolom_dihapus_ganda\": len(drp_list), \"jumlah_kolom_dihapus_konstan_perantara\": len(rem_list), \"jumlah_kolom_akhir\": len(ord_c), \"kolom_ganda_dihapus\": \", \".join(drp_list), \"kolom_konstan_perantara_dihapus\": \", \".join(rem_list), \"sumber_parquet\": pq_p.name, \"parquet_final\": fin_pq.name, \"kompresi\": COMP}])) # Catat log pemuatan\n",
    "        run_q(con, \"CHECKPOINT\") # Sinkronisasi perubahan ke disk\n",
    "    return {\"label\": lbl, \"table\": tbl, \"rows\": int(n_r), \"cols_source\": len(s_cols), \"cols\": len(ord_c), \"loaded_columns\": ord_c, \"dropped_columns\": drp_rows, \"removed_columns\": rem_rows, \"non_unique_source\": int(non_unq), \"distinct_gbifID\": int(n_dist_id), \"null_gbifID\": int(n_null_id), \"dup_occurrenceID\": int(d_occ), \"audit\": df_aud, \"final_parquet\": fin_pq, \"db_path\": db_p}\n",
    "\n",
    "print(\"Memuat Clean Set & Quarantine Store ke DuckDB serta mengekspor Parquet ZSTD...\")\n",
    "res_c, res_q = build_db(CLEAN_DB, CLEAN_TBL, CLEAN_PQ, \"CLEAN\"), build_db(QUAR_DB, QUAR_TBL, QUAR_PQ, \"QUARANTINE\") # Bangun kedua DB\n",
    "\n",
    "c_set, m_null = set(res_c[\"loaded_columns\"]), {} # Verifikasi integritas silang antara Clean DB dan Quarantine DB\n",
    "with duckdb.connect(\":memory:\") as vc:\n",
    "    run_q(vc, f\"ATTACH '{sql_p(CLEAN_DB)}' AS c (READ_ONLY)\"); run_q(vc, f\"ATTACH '{sql_p(QUAR_DB)}' AS q (READ_ONLY)\")\n",
    "    ov_gbif = one_q(vc, f'SELECT COUNT(*) FROM c.\"{CLEAN_TBL}\" a JOIN q.\"{QUAR_TBL}\" b ON a.\"gbifID\" = b.\"gbifID\"')[0] # Cek irisan gbifID\n",
    "    rt_c, rt_q = dict(run_q(vc, f'SELECT record_routing_status, COUNT(*) FROM c.\"{CLEAN_TBL}\" GROUP BY 1')), dict(run_q(vc, f'SELECT record_routing_status, COUNT(*) FROM q.\"{QUAR_TBL}\" GROUP BY 1'))\n",
    "    for col in [\"occurrenceID\", \"scientificName\", \"taxonRank\", \"decimalLatitude\", \"decimalLongitude\", \"basisOfRecord\", \"publisher\", \"recordedBy\", \"verbatimEventDateRaw\"]:\n",
    "        if col in c_set: m_null[col] = one_q(vc, f'SELECT COUNT(*) FROM c.\"{CLEAN_TBL}\" WHERE \"{col}\" IS NULL')[0] # Cek NULL pada atribut wajib Clean DB\n",
    "    ed_null_c = one_q(vc, f'SELECT COUNT(*) FROM c.\"{CLEAN_TBL}\" WHERE \"eventDate\" IS NULL')[0] # Jumlah tanggal parsial di Clean DB\n",
    "\n",
    "rep = json.loads(REP_45.read_text(encoding=\"utf-8\")) if REP_45.exists() else {}; tot_ld = res_c[\"rows\"] + res_q[\"rows\"]; chks = []\n",
    "add_ck = lambda nm, ok, dt: chks.append({\"pemeriksaan\": nm, \"hasil\": \"OK\" if ok else \"PERIKSA\", \"keterangan\": dt}) # Helper tabel pemeriksaan\n",
    "if rep:\n",
    "    add_ck(\"Total record Clean + Quarantine = total Tahap 4/5\", tot_ld == rep.get(\"total_records_validated\"), f\"dimuat {fmt(tot_ld)} | Tahap 4/5 {fmt(rep.get('total_records_validated', 0))}\")\n",
    "    add_ck(\"Jumlah Clean Set sesuai laporan Tahap 4/5\", res_c[\"rows\"] == rep.get(\"clean_set_records\"), f\"dimuat {fmt(res_c['rows'])} | laporan {fmt(rep.get('clean_set_records', 0))}\")\n",
    "    add_ck(\"Jumlah Quarantine sesuai laporan Tahap 4/5\", res_q[\"rows\"] == rep.get(\"quarantine_records\"), f\"dimuat {fmt(res_q['rows'])} | laporan {fmt(rep.get('quarantine_records', 0))}\")\n",
    "add_ck(\"Clean DB hanya berisi Clean/Warning\", set(rt_c) <= {\"Clean\", \"Warning\"}, f\"isi: {rt_c}\")\n",
    "add_ck(\"Quarantine DB hanya berisi Quarantine\", set(rt_q) <= {\"Quarantine\"}, f\"isi: {rt_q}\")\n",
    "add_ck(\"gbifID unik di Clean\", res_c[\"distinct_gbifID\"] + res_c[\"null_gbifID\"] == res_c[\"rows\"], f\"{fmt(res_c['rows'])} baris | {fmt(res_c['distinct_gbifID'])} unik\")\n",
    "add_ck(\"gbifID unik di Quarantine\", res_q[\"distinct_gbifID\"] + res_q[\"null_gbifID\"] == res_q[\"rows\"], f\"{fmt(res_q['rows'])} baris | {fmt(res_q['distinct_gbifID'])} unik\")\n",
    "add_ck(\"Tidak ada gbifID yang sama di Clean dan Quarantine\", ov_gbif == 0, f\"irisan: {fmt(ov_gbif)} record\")\n",
    "add_ck(\"occurrenceID tidak berulang di Clean\", res_c[\"dup_occurrenceID\"] == 0, f\"{fmt(res_c['dup_occurrenceID'])} duplikat\")\n",
    "add_ck(\"Semua record Clean bertipe duplikat UNIQUE\", res_c[\"non_unique_source\"] == 0, f\"{fmt(res_c['non_unique_source'])} non-UNIQUE\")\n",
    "nbad = {k: v for k, v in m_null.items() if v}; add_ck(\"Kolom wajib di Clean tidak ada yang kosong\", not nbad, \"semua terisi\" if not nbad else f\"kosong: {nbad}\")\n",
    "add_ck(\"Kolom ganda (DOUBLE) telah disatukan menjadi 1 kolom\", not KEEP_RED, f\"CLEAN: {res_c['cols_source']}->{res_c['cols']} kolom | QUARANTINE: {res_q['cols_source']}->{res_q['cols']} kolom\")\n",
    "add_ck(\"Kolom konstan/perantara dihapus dari Clean Set\", all(r[\"kolom_dihapus\"] not in c_set for r in res_c[\"removed_columns\"]), f\"CLEAN: {len(res_c['removed_columns'])} dihapus\")\n",
    "\n",
    "(OUT_DIR / \"06_duckdb_load_report.json\").write_text(json.dumps({\"generated_at\": datetime.now().isoformat(timespec=\"seconds\"), \"clean\": {k: (str(v) if isinstance(v, Path) else v) for k, v in res_c.items() if k != \"audit\"}, \"quarantine\": {k: (str(v) if isinstance(v, Path) else v) for k, v in res_q.items() if k != \"audit\"}, \"checks\": chks, \"redundancy_audit\": pd.concat([res_c[\"audit\"], res_q[\"audit\"]], ignore_index=True).to_dict(orient=\"records\"), \"adjustment_notes\": adj_notes}, indent=2, default=str), encoding=\"utf-8\") # Simpan JSON laporan Tahap 6\n",
    "sz_mb = lambda p: p.stat().st_size / 1024 / 1024 # Helper ukuran berkas dalam MB\n",
    "for r in (res_c, res_q): print(f\"[{r['label']}] {fmt(r['rows'])} record | {r['cols']} kolom aktif | DB: {sz_mb(r['db_path']):.1f} MB | Parquet: {sz_mb(r['final_parquet']):.1f} MB\")\n",
    "print(pd.DataFrame(chks).to_string(index=False)) # Cetak hasil pemeriksaan integritas\n",
    "\n",
    "with duckdb.connect(\":memory:\") as qcon: # Contoh pemakaian analitik SQL baca-saja (READ_ONLY) pada Clean DB hasil Tahap 6\n",
    "    qcon.sql(f\"ATTACH '{sql_p(CLEAN_DB)}' AS clean_db (READ_ONLY);\") # Pasang Clean DB\n",
    "    for ttl, sql in [(\"Contoh 1 - Top 5 Spesies Aves\", f\"SELECT scientificName AS nama_ilmiah_accepted, taxonKey AS taxon_key_col, family AS famili, COUNT(*) AS total_observasi, COUNT(DISTINCT stateProvince) AS jumlah_provinsi FROM clean_db.main.{CLEAN_TBL} GROUP BY 1, 2, 3 ORDER BY 4 DESC LIMIT 5\"), (\"Contoh 2 - Agregasi Basis of Record\", f\"SELECT basisOfRecord, COUNT(*) AS jumlah_record, COUNT(DISTINCT scientificName) AS jumlah_spesies_unik FROM clean_db.main.{CLEAN_TBL} GROUP BY 1 ORDER BY 2 DESC\"), (\"Contoh 3 - Distribusi Status Routing\", f\"SELECT record_routing_status, COUNT(*) AS jumlah_record FROM clean_db.main.{CLEAN_TBL} GROUP BY 1 ORDER BY 2 DESC\")]:\n",
    "        print(f\"\\n=== {ttl} ===\"); qcon.sql(sql).show() # Tampilkan hasil 3 contoh kueri analitik SQL"
   ]
  },
