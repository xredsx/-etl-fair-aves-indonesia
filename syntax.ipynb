    "import json, os, re, time, urllib.parse as uparse, urllib.request as ureq # Modul standar JSON, OS, regex, waktu, dan HTTP\n",
    "from collections import Counter # Struktur penghitung distribusi frekuensi kategori\n",
    "from concurrent.futures import ThreadPoolExecutor, as_completed # Eksekusi multi-thread paralel untuk request API COL\n",
    "from pathlib import Path # Manajemen path berkas lintas platform\n",
    "import numpy as np, pandas as pd, pyarrow as pa, matplotlib.pyplot as plt # Library komputasi array, dataframe, Arrow, dan grafik\n",
    "try: import pandas.core.arrays.arrow.extension_types # Pengaman registrasi tipe ekstensi Arrow di Pandas\n",
    "except Exception: pass # Abaikan jika sudah terdaftar\n",
    "import pyarrow.parquet as pq # Modul pembaca dan penulis berkas Apache Parquet\n",
    "from scipy.spatial import cKDTree # Struktur pohon spasial 3D untuk pencarian tetangga terdekat (habitat spesies)\n",
    "try:\n",
    "    import requests # Library HTTP session persisten untuk mempercepat ribuan panggilan API\n",
    "    from requests.adapters import HTTPAdapter # Adapter koneksi pool HTTP\n",
    "    _SESS = requests.Session(); _AD = HTTPAdapter(pool_connections=32, pool_maxsize=32, max_retries=0) # Buat koneksi pool 32 thread\n",
    "    _SESS.mount(\"https://\", _AD); _SESS.mount(\"http://\", _AD); _SESS.headers.update({\"User-Agent\": \"UB-DataScience-Thesis-ETL/3.0-COL\"})\n",
    "except ImportError: _SESS = None # Fallback ke urllib.request apabila library requests belum terpasang\n",
    "\n",
    "OUT_DIR, CHUNK, MAX_FZ_DIST, MIN_FZ_CONF = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"), 100_000, 2, 80 # Direktori kerja & ambang verifikasi fuzzy\n",
    "COL_KEY, COL_API = \"7ddf754f-d193-4cc9-b351-99906754a03b\", \"https://api.gbif.org/v2/species/match\" # ChecklistKey Catalogue of Life XR & endpoint v2\n",
    "HARM_PQ, NORM_PQ = OUT_DIR / \"harmonized_aves_indonesia.parquet\", OUT_DIR / \"normalized_taxonomy_aves_indonesia.parquet\" # Input & output Parquet\n",
    "T1_REP, TAX_CACHE_P = OUT_DIR / \"01_baseline_profile_report.json\", OUT_DIR / \"03_col_species_match_cache.json\" # Laporan Tahap 1 & cache API COL\n",
    "if not HARM_PQ.exists(): raise FileNotFoundError(f\"Berkas {HARM_PQ} belum ada. Jalankan Tahap 2 terlebih dahulu.\") # Validasi berkas prasyarat\n",
    "HIGH_RANKS = {\"DOMAIN\", \"SUPERKINGDOM\", \"KINGDOM\", \"SUBKINGDOM\", \"INFRAKINGDOM\", \"SUPERPHYLUM\", \"PHYLUM\", \"SUBPHYLUM\", \"INFRAPHYLUM\", \"PARVPHYLUM\", \"SUPERCLASS\", \"CLASS\", \"SUBCLASS\", \"INFRACLASS\", \"PARVCLASS\", \"SUPERORDER\", \"ORDER\", \"SUBORDER\", \"INFRAORDER\", \"PARVORDER\", \"SUPERFAMILY\", \"FAMILY\", \"SUBFAMILY\", \"TRIBE\", \"SUBTRIBE\", \"GENUS\", \"SUBGENUS\", \"SECTION\", \"SUBSECTION\"} # Daftar rank di atas spesies\n",
    "ORD_CATS = [\"Accepted\", \"Synonym resolved\", \"Higher-rank match\", \"Fuzzy match\", \"No match\"] # 5 kategori hasil pencocokan taksonomi (Tabel 2.5)\n",
    "HAB_RAD_KM, HAB_MIN_NB, HAB_REF, HAB_NMAX, R_EARTH = 50.0, 3, \"ALL\", 10, 6371.0088 # Parameter radius & tetangga minimum validasi habitat\n",
    "SENS_RAD, SENS_N, TRUST_ST = [5, 10, 25, 50, 100, 200, 500], [1, 3, 5, 10], {\"CLEAN_LAND\", \"CLEAN_COASTAL_TOLERANCE\"} # Parameter kurva sensitivitas\n",
    "\n",
    "def canon_words(sci: str) -> str: # Ekstrak kata kanonik (genus + penunjuk spesies/subspesies) tanpa nama pengarang atau tahun\n",
    "    if not sci or pd.isna(sci): return \"\" # Kembalikan string kosong jika input kosong\n",
    "    toks, out = re.sub(r\"\\([^)]*\\)\", \" \", str(sci).strip()).split(), [] # Hapus teks dalam tanda kurung dan pecah per kata\n",
    "    for i, t in enumerate(toks): # Iterasi setiap token kata\n",
    "        ct = re.sub(r\"[^a-zA-Z\\-]\", \"\", t) # Bersihkan karakter non-huruf\n",
    "        if not ct: continue # Lewati jika token kosong\n",
    "        if i == 0 or (ct.islower() and len(out) < 3): out.append(ct.lower()) # Ambil kata pertama (genus) dan maksimal 2 epitet huruf kecil\n",
    "        else: break # Hentikan saat bertemu nama pengarang (diawali huruf kapital setelah genus)\n",
    "    return \" \".join(out) # Gabungkan kembali kata kanonik dengan spasi\n",
    "\n",
    "def lev_dist(s1: str, s2: str) -> int: # Perhitungan jarak edit Levenshtein (jumlah selisih karakter antara dua nama kanonik)\n",
    "    if len(s1) < len(s2): return lev_dist(s2, s1) # Pastikan s1 selalu lebih panjang atau sama dengan s2\n",
    "    if not s2: return len(s1) # Jika s2 kosong, jarak edit sama dengan panjang s1\n",
    "    prv = list(range(len(s2) + 1)) # Inisialisasi baris pertama matriks pemrograman dinamis\n",
    "    for i, c1 in enumerate(s1): # Iterasi karakter pada string pertama\n",
    "        cur = [i + 1] # Elemen pertama baris saat ini\n",
    "        for j, c2 in enumerate(s2): cur.append(min(prv[j + 1] + 1, cur[j] + 1, prv[j] + (c1 != c2))) # Operasi sisip, hapus, atau substitusi\n",
    "        prv = cur # Geser baris saat ini menjadi baris sebelumnya\n",
    "    return prv[-1] # Kembalikan nilai jarak edit akhir\n",
    "\n",
    "def classify_match(in_nm: str, m_nm: str | None, mt: str | None, st: str | None, conf, mr: str | None = None) -> tuple[str, str, int | None]: # Klasifikasi Tabel 2.5\n",
    "    mt_u, st_u, mr_u, cf = (mt or \"NONE\").upper().strip(), (st or \"\").upper().strip(), (mr or \"\").upper().strip(), float(conf) if conf is not None else 0.0\n",
    "    if mt_u in (\"NONE\", \"API_ERROR\") or not mt_u or not m_nm: return \"No match\", \"INVALID\", None # Tidak ditemukan di Catalogue of Life\n",
    "    if mt_u == \"HIGHERRANK\" or mr_u in HIGH_RANKS: return \"Higher-rank match\", \"INVALID\", None # Hanya cocok di tingkat Genus/Famili/Ordo/Kelas\n",
    "    if mt_u in (\"EXACT\", \"VARIANT\"): return (\"Synonym resolved\" if \"SYNONYM\" in st_u else \"Accepted\"), \"VALID\", 0 # Cocok eksak sebagai Accepted atau Sinonim\n",
    "    if mt_u == \"FUZZY\": # Jika pencocokan bersifat pendekatan ejaan (Fuzzy match), verifikasi jarak edit Levenshtein & confidence\n",
    "        ci, co = canon_words(in_nm), canon_words(m_nm); d = lev_dist(ci, co) if (ci and co) else 99 # Hitung selisih huruf nama kanonik\n",
    "        return \"Fuzzy match\", (\"VALID\" if (d <= MAX_FZ_DIST and cf >= MIN_FZ_CONF) else \"INVALID\"), d # Lolos jika <= 2 huruf & confidence >= 80\n",
    "    return \"No match\", \"INVALID\", None # Fallback keamanan\n",
    "\n",
    "def parse_v2(d: dict) -> dict: # Ekstraksi atribut taksonomi dari struktur JSON respons GBIF Species Match API v2 (COL XR)\n",
    "    dg, us, au, cl = d.get(\"diagnostics\") or {}, d.get(\"usage\") or {}, d.get(\"acceptedUsage\") or {}, d.get(\"classification\") or [] # Sub-objek JSON\n",
    "    mt = str(dg.get(\"matchType\") or d.get(\"matchType\") or \"NONE\").upper().strip(); cf = dg.get(\"confidence\", d.get(\"confidence\")) # Tipe & skor kecocokan\n",
    "    rst = us.get(\"status\") or d.get(\"taxonomicStatus\") or dg.get(\"status\") or d.get(\"status\"); st = str(rst).upper().strip() if rst else None # Status takson\n",
    "    uk = us.get(\"key\") if us.get(\"key\") is not None else d.get(\"usageKey\"); ak = au.get(\"key\") if au.get(\"key\") is not None else d.get(\"acceptedUsageKey\") # Kunci takson\n",
    "    syn = bool(d.get(\"synonym\")) or (st is not None and \"SYNONYM\" in st) or (ak is not None and uk is not None and str(ak) != str(uk)) # Deteksi sinonim\n",
    "    if syn and (st is None or \"SYNONYM\" not in st): st = \"SYNONYM\" # Pastikan label status menjadi SYNONYM bila merujuk ke acceptedUsage\n",
    "    elif not syn and st is None and uk is not None and mt not in (\"NONE\", \"API_ERROR\"): st = \"ACCEPTED\" # Default ACCEPTED untuk kecocokan langsung\n",
    "    fk = str(ak if ak is not None else uk).strip() if (ak is not None or uk is not None) else None # Kunci takson final (utamakan accepted key)\n",
    "    rn = us.get(\"name\") or us.get(\"canonicalName\") or d.get(\"scientificName\") or d.get(\"canonicalName\") or d.get(\"species\") # Nama ilmiah yang cocok\n",
    "    an = au.get(\"name\") or au.get(\"canonicalName\") or rn; mr = au.get(\"rank\") or us.get(\"rank\") or d.get(\"rank\") # Nama accepted & tingkatan takson\n",
    "    cm = {str(n[\"rank\"]).upper().strip(): str(n[\"name\"]).strip() for n in cl if isinstance(n, dict) and n.get(\"rank\") and n.get(\"name\")} if isinstance(cl, list) else {} # Hierarki\n",
    "    return {\"match_type\": mt, \"confidence\": cf, \"status\": st, \"final_taxon_key\": fk, \"matched_usage_key\": str(uk).strip() if uk is not None else None, \"matched_raw_name\": rn, \"accepted_sci_name\": an, \"matched_rank\": mr, \"matched_family\": cm.get(\"FAMILY\"), \"matched_genus\": cm.get(\"GENUS\"), \"matched_species\": cm.get(\"SPECIES\")}\n",
    "\n",
    "def fetch_col(qt: tuple) -> tuple[str, dict]: # Request pencocokan 1 kombinasi takson unik ke API Catalogue of Life dengan fallback otomatis\n",
    "    ck, n_q, r_q, g_q, f_q = qt # Unpack tuple kueri (cache_key, nama, rank, genus, family)\n",
    "    empty = {\"checklistKey\": COL_KEY, \"matchedTaxonKey\": None, \"matchedUsageKey\": None, \"matchedAcceptedScientificName\": None, \"matchedRawScientificName\": None, \"matchType\": \"NONE\", \"matchedStatus\": None, \"matchedRank\": None, \"matchedFamily\": None, \"matchedGenus\": None, \"matchedSpecies\": None, \"confidence\": None, \"taxonomicMatchCategory\": \"No match\", \"taxonomyValidationStatus\": \"INVALID\", \"fuzzyEditDistance\": None, \"apiSuccess\": True}\n",
    "    if not n_q: return ck, empty # Kembalikan hasil kosong jika nama ilmiah kosong\n",
    "    def _call(prm: dict) -> dict | None: # Fungsi pemanggil HTTP dengan mekanisme retry hingga 5 kali\n",
    "        for att in range(5):\n",
    "            try:\n",
    "                if _SESS is not None:\n",
    "                    r = _SESS.get(COL_API, params=prm, timeout=15)\n",
    "                    if r.status_code == 200: return r.json()\n",
    "                else:\n",
    "                    with ureq.urlopen(ureq.Request(f\"{COL_API}?{uparse.urlencode(prm)}\", headers={\"User-Agent\": \"UB-DataScience-Thesis-ETL/3.0-COL\"}), timeout=15) as r: return json.loads(r.read().decode(\"utf-8\"))\n",
    "            except Exception: time.sleep(0.3 * (att + 1)) # Jeda eksponensial ringan jika terjadi timeout jaringan\n",
    "        return None\n",
    "    p = {\"checklistKey\": COL_KEY, \"scientificName\": n_q, \"kingdom\": \"Animalia\", \"class\": \"Aves\", \"verbose\": \"true\"} # Parameter dasar API v2 COL\n",
    "    if r_q and r_q.upper() not in (\"UNRANKED\", \"OTHER\"): p[\"taxonRank\"] = r_q # Sertakan filter rank bila spesifik\n",
    "    if g_q: p[\"genus\"] = g_q # Sertakan filter genus bila ada\n",
    "    if f_q: p[\"family\"] = f_q # Sertakan filter family bila ada\n",
    "    dt = _call(p); pr = parse_v2(dt) if dt is not None else None # Panggil API tahap pertama dengan konteks hierarki lengkap\n",
    "    wc = len(canon_words(n_q).split()) # Hitung jumlah kata kanonik pada nama input\n",
    "    if pr is not None and (pr[\"match_type\"] == \"NONE\" or (wc >= 2 and (pr[\"match_type\"] == \"HIGHERRANK\" or (pr[\"matched_rank\"] or \"\").upper() in HIGH_RANKS))) and (r_q or g_q or f_q): # Fallback tanpa filter genus/family jika terlempar ke HIGHERRANK\n",
    "        dfb = _call({\"checklistKey\": COL_KEY, \"scientificName\": n_q, \"kingdom\": \"Animalia\", \"class\": \"Aves\", \"verbose\": \"true\"}) # Kueri ulang hanya dengan nama ilmiah\n",
    "        if dfb is not None and (pfb := parse_v2(dfb))[\"match_type\"] not in (\"NONE\", \"API_ERROR\"):\n",
    "            if pr[\"match_type\"] == \"NONE\" or (pfb[\"match_type\"] != \"HIGHERRANK\" and (pfb[\"matched_rank\"] or \"\").upper() not in HIGH_RANKS): pr = pfb # Pakai hasil fallback\n",
    "    if pr is None: return ck, {**empty, \"matchType\": \"API_ERROR\", \"apiSuccess\": False} # Tandai gagal koneksi agar bisa diulang pada eksekusi berikutnya\n",
    "    cat, vst, ed = classify_match(n_q, pr[\"matched_raw_name\"], pr[\"match_type\"], pr[\"status\"], pr[\"confidence\"], pr[\"matched_rank\"]) # Klasifikasi Tabel 2.5\n",
    "    return ck, {\"checklistKey\": COL_KEY, \"matchedTaxonKey\": pr[\"final_taxon_key\"], \"matchedUsageKey\": pr[\"matched_usage_key\"], \"matchedAcceptedScientificName\": pr[\"accepted_sci_name\"], \"matchedRawScientificName\": pr[\"matched_raw_name\"], \"matchType\": pr[\"match_type\"], \"matchedStatus\": pr[\"status\"], \"matchedRank\": pr[\"matched_rank\"], \"matchedFamily\": pr[\"matched_family\"], \"matchedGenus\": pr[\"matched_genus\"], \"matchedSpecies\": pr[\"matched_species\"], \"confidence\": pr[\"confidence\"], \"taxonomicMatchCategory\": cat, \"taxonomyValidationStatus\": vst, \"fuzzyEditDistance\": ed, \"apiSuccess\": True}\n",
    "\n",
    "pf_h = pq.ParquetFile(HARM_PQ); u_combos = {} # Buka Parquet Tahap 2 dan siapkan kamus kombinasi takson unik\n",
    "for b in pf_h.iter_batches(batch_size=CHUNK, columns=[\"verbatimScientificName\", \"scientificName\", \"taxonRank\", \"genus\", \"family\"]): # Ekstrak kombinasi unik per batch\n",
    "    d = b.to_pandas(); nm = d[\"verbatimScientificName\"].fillna(d[\"scientificName\"]).fillna(\"\").astype(str).str.strip() # Utamakan verbatimScientificName\n",
    "    cdf = pd.DataFrame({\"n\": nm, \"r\": d[\"taxonRank\"].fillna(\"\").astype(str).str.strip(), \"g\": d[\"genus\"].fillna(\"\").astype(str).str.strip(), \"f\": d[\"family\"].fillna(\"\").astype(str).str.strip()}).drop_duplicates()\n",
    "    for r in cdf.itertuples(index=False):\n",
    "        if (ck := f\"{r.n}||{r.r}||{r.g}||{r.f}\") not in u_combos: u_combos[ck] = (ck, r.n, r.r, r.g, r.f) # Simpan kombinasi unik\n",
    "\n",
    "t_cache = {k: v for k, v in json.loads(TAX_CACHE_P.read_text(encoding=\"utf-8\")).items() if isinstance(v, dict) and v.get(\"checklistKey\") == COL_KEY} if TAX_CACHE_P.exists() else {} # Muat cache COL\n",
    "pend = [q for k, q in u_combos.items() if k not in t_cache or not t_cache[k].get(\"apiSuccess\", False)] # Daftar kombinasi yang belum ada di cache lokal\n",
    "print(f\"Kombinasi unik taksonomi: {len(u_combos):,} | Perlu request API COL baru: {len(pend):,}\") # Info jumlah kueri API\n",
    "if pend: # Jika ada kombinasi baru, jalankan request paralel dengan 24 worker thread\n",
    "    done = 0\n",
    "    with ThreadPoolExecutor(max_workers=24) as ex:\n",
    "        futs = {ex.submit(fetch_col, q): q[0] for q in pend}\n",
    "        for ft in as_completed(futs):\n",
    "            ck, res = ft.result(); t_cache[ck] = res; done += 1\n",
    "            if done % 500 == 0 or done == len(pend): print(f\"  [API COL] {done:,}/{len(pend):,} selesai...\"); TAX_CACHE_P.write_text(json.dumps(t_cache, ensure_ascii=False, indent=2, default=str), encoding=\"utf-8\")\n",
    "\n",
    "for ck, qt in u_combos.items(): # Evaluasi ulang kategori & jarak edit Levenshtein pada seluruh entri cache agar konsisten dengan threshold\n",
    "    if ck in t_cache:\n",
    "        it = t_cache[ck]; cat, vst, ed = classify_match(qt[1], it.get(\"matchedRawScientificName\") or it.get(\"matchedAcceptedScientificName\"), it.get(\"matchType\"), it.get(\"matchedStatus\"), it.get(\"confidence\"), it.get(\"matchedRank\"))\n",
    "        it[\"taxonomicMatchCategory\"], it[\"taxonomyValidationStatus\"], it[\"fuzzyEditDistance\"] = cat, vst, ed\n",
    "TAX_CACHE_P.write_text(json.dumps(t_cache, ensure_ascii=False, indent=2, default=str), encoding=\"utf-8\") # Simpan cache final ke JSON\n",
    "\n",
    "m_tk, m_an, m_mt = {k: v.get(\"matchedTaxonKey\") for k, v in t_cache.items()}, {k: v.get(\"matchedAcceptedScientificName\") for k, v in t_cache.items()}, {k: v.get(\"matchType\") for k, v in t_cache.items()} # Kamus lookup cepat\n",
    "m_mr, m_ms, m_mf = {k: v.get(\"matchedRank\") for k, v in t_cache.items()}, {k: v.get(\"matchedStatus\") for k, v in t_cache.items()}, {k: v.get(\"matchedFamily\") for k, v in t_cache.items()}\n",
    "m_mg, m_msp, m_cat = {k: v.get(\"matchedGenus\") for k, v in t_cache.items()}, {k: v.get(\"matchedSpecies\") for k, v in t_cache.items()}, {k: v.get(\"taxonomicMatchCategory\") for k, v in t_cache.items()}\n",
    "m_vst, m_fd = {k: v.get(\"taxonomyValidationStatus\") for k, v in t_cache.items()}, {k: v.get(\"fuzzyEditDistance\") for k, v in t_cache.items()}\n",
    "\n",
    "NORM_PQ.unlink(missing_ok=True); n_sch = pq.read_schema(HARM_PQ); ex_names = set(n_sch.names) # Siapkan skema Parquet Tahap 3\n",
    "for nf in [pa.field(\"acceptedScientificName\", pa.string()), pa.field(\"acceptedTaxonKey\", pa.string()), pa.field(\"taxonomicStatus\", pa.string()), pa.field(\"matchedTaxonKey\", pa.string()), pa.field(\"matchedAcceptedScientificName\", pa.string()), pa.field(\"matchType\", pa.string()), pa.field(\"matchedRank\", pa.string()), pa.field(\"matchedStatus\", pa.string()), pa.field(\"taxonomicMatchCategory\", pa.string()), pa.field(\"taxonomyValidationStatus\", pa.string()), pa.field(\"fuzzyEditDistance\", pa.int64()), pa.field(\"isTaxonKeyConsistent\", pa.bool_())]:\n",
    "    if nf.name not in ex_names: n_sch = n_sch.append(nf); ex_names.add(nf.name) # Tambahkan 12 kolom hasil normalisasi taksonomi\n",
    "nw = pq.ParquetWriter(NORM_PQ, n_sch, compression=\"snappy\"); ord_c = [f.name for f in n_sch] # Inisialisasi penulis Parquet Tahap 3\n",
    "\n",
    "n_norm = tk_cons = 0; cat_cnt = Counter({c: 0 for c in ORD_CATS}); fz_sub = Counter({\"Fuzzy_Valid_Accepted (<=2 huruf)\": 0, \"Fuzzy_Invalid (>2 huruf)\": 0}) # Counter statistik\n",
    "smp_ex, ck_rec_cnt = {}, Counter(); s_str = lambda v: \"-\" if (pd.isna(v) or v is None) else str(v) # Penampung contoh Tabel 2.5 & frekuensi kunci\n",
    "\n",
    "for b_idx, b in enumerate(pf_h.iter_batches(batch_size=CHUNK), start=1): # Pemetaan hasil pencocokan COL XR ke seluruh 1,55 juta record\n",
    "    d = b.to_pandas(); n_norm += len(d); nm = d[\"verbatimScientificName\"].fillna(d[\"scientificName\"]).fillna(\"\").astype(str).str.strip()\n",
    "    cks = nm + \"||\" + d[\"taxonRank\"].fillna(\"\").astype(str).str.strip() + \"||\" + d[\"genus\"].fillna(\"\").astype(str).str.strip() + \"||\" + d[\"family\"].fillna(\"\").astype(str).str.strip()\n",
    "    ck_rec_cnt.update(cks.value_counts().to_dict()) # Hitung jumlah record per kombinasi unik untuk bobot grafik fuzzy\n",
    "    d[\"matchedTaxonKey\"], d[\"matchedAcceptedScientificName\"], d[\"matchType\"] = cks.map(m_tk).astype(\"string\"), cks.map(m_an).astype(\"string\"), cks.map(m_mt).astype(\"string\")\n",
    "    d[\"matchedRank\"], d[\"matchedStatus\"], d[\"taxonomicMatchCategory\"] = cks.map(m_mr).astype(\"string\"), cks.map(m_ms).astype(\"string\"), cks.map(m_cat).astype(\"string\")\n",
    "    d[\"taxonomyValidationStatus\"], d[\"fuzzyEditDistance\"] = cks.map(m_vst).astype(\"string\"), pd.to_numeric(cks.map(m_fd), errors=\"coerce\").astype(\"Int64\")\n",
    "    v_tax = d[\"taxonomyValidationStatus\"] == \"VALID\" # Masker baris dengan taksonomi yang dinyatakan VALID\n",
    "    d[\"scientificName\"] = pd.Series(np.where(v_tax & d[\"matchedAcceptedScientificName\"].notna(), d[\"matchedAcceptedScientificName\"], d[\"scientificName\"]), index=d.index, dtype=\"string\") # Update ke nama Accepted\n",
    "    b_an = d[\"acceptedScientificName\"].astype(\"string\") if \"acceptedScientificName\" in d.columns else pd.Series(pd.NA, index=d.index, dtype=\"string\")\n",
    "    b_ak = d[\"acceptedTaxonKey\"].astype(\"string\") if \"acceptedTaxonKey\" in d.columns else pd.Series(pd.NA, index=d.index, dtype=\"string\")\n",
    "    b_ts = d[\"taxonomicStatus\"].astype(\"string\") if \"taxonomicStatus\" in d.columns else d[\"matchedStatus\"]\n",
    "    d[\"acceptedScientificName\"] = pd.Series(np.where(v_tax & d[\"matchedAcceptedScientificName\"].notna(), d[\"matchedAcceptedScientificName\"], b_an), index=d.index, dtype=\"string\") # Isi kolom Darwin Core\n",
    "    d[\"acceptedTaxonKey\"] = pd.Series(np.where(v_tax & d[\"matchedTaxonKey\"].notna(), d[\"matchedTaxonKey\"], b_ak), index=d.index, dtype=\"string\")\n",
    "    d[\"taxonomicStatus\"] = pd.Series(np.where(v_tax, \"ACCEPTED\", b_ts), index=d.index, dtype=\"string\")\n",
    "    d[\"family\"] = d[\"family\"].fillna(cks.map(m_mf).astype(\"string\").where(v_tax)).astype(\"string\") # Lengkapi family kosong dari hierarki COL\n",
    "    d[\"genus\"] = d[\"genus\"].fillna(cks.map(m_mg).astype(\"string\").where(v_tax)).astype(\"string\") # Lengkapi genus kosong dari hierarki COL\n",
    "    d[\"species\"] = d[\"species\"].fillna(cks.map(m_msp).astype(\"string\").where(v_tax)).astype(\"string\") # Lengkapi species kosong dari hierarki COL\n",
    "    otk, mtk = d[\"taxonKey\"].astype(\"string\").str.strip(), d[\"matchedTaxonKey\"].astype(\"string\").str.strip()\n",
    "    cmask = otk.notna() & mtk.notna() & (otk != \"\") & (otk == mtk); d[\"isTaxonKeyConsistent\"] = cmask.astype(\"boolean\"); tk_cons += int(cmask.sum()) # Cek konsistensi taxonKey\n",
    "    cat_cnt.update(d[\"taxonomicMatchCategory\"].value_counts().to_dict()); is_fz = d[\"taxonomicMatchCategory\"] == \"Fuzzy match\"\n",
    "    fz_sub[\"Fuzzy_Valid_Accepted (<=2 huruf)\"] += int((is_fz & v_tax).sum()); fz_sub[\"Fuzzy_Invalid (>2 huruf)\"] += int((is_fz & (~v_tax)).sum())\n",
    "    for c in ORD_CATS: # Simpan 1 contoh riil pertama untuk setiap kategori Tabel 2.5\n",
    "        if c not in smp_ex and len(sub := d[d[\"taxonomicMatchCategory\"] == c]) > 0:\n",
    "            r0 = sub.iloc[0]; smp_ex[c] = {\"Kategori\": c, \"verbatimScientificName\": s_str(r0[\"verbatimScientificName\"]), \"matchedAcceptedScientificName\": s_str(r0[\"matchedAcceptedScientificName\"]), \"matchedTaxonKey\": s_str(r0[\"matchedTaxonKey\"]), \"Status_Validasi_Tahap4\": s_str(r0[\"taxonomyValidationStatus\"])}\n",
    "    nw.write_table(pa.Table.from_pandas(d[ord_c], schema=n_sch, preserve_index=False)); print(f\"  [Batch {b_idx:02d}] {n_norm:,} record selesai dinormalisasi...\")\n",
    "nw.close() # Tutup penulisan tahap pertama Parquet Tahap 3\n",
    "\n",
    "dist_rows = [{\"Kategori_Tabel_2_5\": c, \"Jumlah_Record (n_status)\": int(cat_cnt.get(c, 0)), \"Persentase_P_status (%)\": round(int(cat_cnt.get(c, 0)) / n_norm * 100.0, 4), \"Contoh_Input_Verbatim\": smp_ex.get(c, {}).get(\"verbatimScientificName\", \"-\"), \"Contoh_Hasil_Matched\": smp_ex.get(c, {}).get(\"matchedAcceptedScientificName\", \"-\"), \"Contoh_matchedTaxonKey\": smp_ex.get(c, {}).get(\"matchedTaxonKey\", \"-\"), \"Keputusan_Validasi\": (\"VALID (Diubah ke Accepted)\" if c in [\"Accepted\", \"Synonym resolved\"] else f\"VALID jika <= {MAX_FZ_DIST} huruf ({fz_sub['Fuzzy_Valid_Accepted (<=2 huruf)']:,}) / INVALID ({fz_sub['Fuzzy_Invalid (>2 huruf)']:,})\" if c == \"Fuzzy match\" else \"INVALID (Masuk Quarantine)\")} for c in ORD_CATS] # Susun Tabel 2.5\n",
    "pd.DataFrame(dist_rows).to_csv(OUT_DIR / \"03_distribusi_normalisasi_taksonomi_tabel_2_5.csv\", index=False) # Ekspor CSV Tabel 2.5\n",
    "n_acc, n_syn, n_fzv, n_fzi = int(cat_cnt[\"Accepted\"]), int(cat_cnt[\"Synonym resolved\"]), int(fz_sub[\"Fuzzy_Valid_Accepted (<=2 huruf)\"]), int(fz_sub[\"Fuzzy_Invalid (>2 huruf)\"])\n",
    "trt_base, trt_ver, tk_pct = (n_acc + n_syn) / n_norm * 100.0, (n_acc + n_syn + n_fzv) / n_norm * 100.0, tk_cons / n_norm * 100.0 # Hitung skor TRT & konsistensi\n",
    "if T1_REP.exists(): # Perbarui nilai TRT baseline pada laporan JSON Tahap 1 agar terhubung otomatis ke Tahap 5\n",
    "    try:\n",
    "        t1_r = json.loads(T1_REP.read_text(encoding=\"utf-8\"))\n",
    "        if \"baseline_metrics\" in t1_r: t1_r[\"baseline_metrics\"][\"TRT\"] = round(float(trt_base), 4)\n",
    "        t1_r.setdefault(\"baseline_details_with_warning_excluded\", {})[\"i_t_unstandardized_or_unresolved_taxonomy\"] = int(n_norm - (n_acc + n_syn))\n",
    "        T1_REP.write_text(json.dumps(t1_r, indent=2), encoding=\"utf-8\")\n",
    "    except Exception: pass\n",
    "(OUT_DIR / \"03_taxonomic_normalization_report.json\").write_text(json.dumps({\"reference_taxonomy\": \"Catalogue of Life eXtended Release (COL XR)\", \"checklist_key\": COL_KEY, \"api_endpoint\": COL_API, \"total_records\": int(n_norm), \"unique_taxonomic_combinations_queried\": len(u_combos), \"TRT_baseline_eq_2_5_pct\": round(float(trt_base), 4), \"TRT_with_verified_fuzzy_pct\": round(float(trt_ver), 4), \"n_accepted\": n_acc, \"n_synonym_resolved\": n_syn, \"n_fuzzy_valid_resolved\": n_fzv, \"n_fuzzy_invalid_exceeded\": n_fzi, \"n_higher_rank_invalid\": int(cat_cnt[\"Higher-rank match\"]), \"n_no_match_invalid\": int(cat_cnt[\"No match\"]), \"taxon_key_consistent_records\": int(tk_cons), \"taxon_key_consistent_pct\": round(float(tk_pct), 4), \"category_distribution_eq_2_1\": dist_rows}, indent=2, default=str), encoding=\"utf-8\") # Simpan JSON laporan taksonomi\n",
    "\n",
    "fz_rows = [{\"jarak_huruf\": lev_dist(ci, co), \"confidence\": v.get(\"confidence\"), \"jumlah_record\": int(ck_rec_cnt.get(ck, 0))} for ck, v in t_cache.items() if str(v.get(\"matchType\", \"\")).upper() == \"FUZZY\" and (ci := canon_words(ck.split(\"||\")[0])) and (co := canon_words(v.get(\"matchedRawScientificName\") or v.get(\"matchedAcceptedScientificName\")))] # Kumpulkan data grafik fuzzy\n",
    "if fz_rows: # Buat grafik 3 panel analisis sensitivitas threshold jarak edit Levenshtein\n",
    "    df_fz = pd.DataFrame(fz_rows); df_fz[\"confidence\"] = pd.to_numeric(df_fz[\"confidence\"], errors=\"coerce\"); df_fz[\"jarak_plot\"] = df_fz[\"jarak_huruf\"].clip(upper=8)\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(19, 5.2)); g = df_fz.groupby(\"jarak_plot\")[\"jumlah_record\"].sum().reindex(range(9), fill_value=0)\n",
    "    pct = (g / g.sum() * 100) if g.sum() > 0 else g.astype(float); bars = axes[0].bar(g.index, pct.values, color=[\"#2a9d8f\" if i <= MAX_FZ_DIST else \"#e76f51\" for i in g.index])\n",
    "    for b, v in zip(bars, pct.values):\n",
    "        if v > 0: axes[0].text(b.get_x() + b.get_width() / 2, v, f\"{v:.1f}%\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "    ax2 = axes[0].twinx(); ax2.plot(g.index, pct.cumsum().values, color=\"black\", marker=\"o\", linewidth=1.5); ax2.set_ylim(0, 105); ax2.set_ylabel(\"Persen kumulatif (%)\")\n",
    "    axes[0].axvline(MAX_FZ_DIST + 0.5, color=\"red\", linestyle=\"--\"); axes[0].set_xticks(range(9)); axes[0].set_xticklabels([str(i) if i < 8 else \"8+\" for i in range(9)]); axes[0].set_title(\"Sebaran jarak edit fuzzy match\")\n",
    "    c_vals, yp = [int(cat_cnt.get(c, 0)) for c in ORD_CATS], np.arange(len(ORD_CATS)); axes[1].barh(yp, c_vals, color=[\"#2a9d8f\", \"#52b788\", \"#e9c46a\", \"#f4a261\", \"#e76f51\"])\n",
    "    for y_i, v in zip(yp, c_vals): axes[1].text(v, y_i, f\" {v:,} ({v / n_norm * 100:.2f}%)\", va=\"center\", fontsize=8)\n",
    "    axes[1].set_yticks(yp); axes[1].set_yticklabels(ORD_CATS, fontsize=8); axes[1].invert_yaxis(); axes[1].set_xlim(0, max(c_vals) * 1.38 if max(c_vals) > 0 else 1); axes[1].set_title(\"Distribusi kategori pencocokan COL XR (Tabel 2.5)\")\n",
    "    ts = list(range(7)); trts = [(n_acc + n_syn + int(df_fz[(df_fz[\"jarak_huruf\"] <= t) & (df_fz[\"confidence\"].fillna(0) >= MIN_FZ_CONF)][\"jumlah_record\"].sum())) / n_norm * 100 for t in ts]\n",
    "    axes[2].plot(ts, trts, marker=\"o\", color=\"#264653\"); axes[2].axvline(MAX_FZ_DIST, color=\"red\", linestyle=\"--\", label=f\"Dipilih = {MAX_FZ_DIST}\"); axes[2].set_title(\"Sensitivitas TRT terhadap threshold jarak edit\"); axes[2].legend()\n",
    "    for t, v in zip(ts, trts): axes[2].text(t, v, f\"{v:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "    plt.tight_layout(); plt.savefig(OUT_DIR / \"03_grafik_threshold_fuzzy.png\", dpi=200); plt.show()\n",
    "\n",
    "_sp_c = {}; to_xyz = lambda la, lo: R_EARTH * np.column_stack([np.cos(np.radians(la)) * np.cos(np.radians(lo)), np.cos(np.radians(la)) * np.sin(np.radians(lo)), np.sin(np.radians(la))]) # Konversi koordinat bola ke 3D ECEF (km)\n",
    "c2a = lambda ch: 2 * R_EARTH * np.arcsin(np.clip(ch / (2 * R_EARTH), 0.0, 1.0)) # Konversi jarak tali busur (chord) 3D ke jarak busur permukaan bumi (km)\n",
    "def sp_lbl(an) -> str | None: # Ambil 2 kata pertama nama kanonik sebagai kunci spesies untuk analisis cKDTree habitat\n",
    "    if an is None or pd.isna(an): return None\n",
    "    if an not in _sp_c: w = canon_words(str(an)).split(); _sp_c[an] = \" \".join(w[:2]) if len(w) >= 2 else None\n",
    "    return _sp_c[an]\n",
    "sp_ser = lambda df: df[\"matchedAcceptedScientificName\"].map(sp_lbl).where(df[\"taxonomyValidationStatus\"] == \"VALID\", None) # Series nama spesies valid\n",
    "\n",
    "agg_f = [] # Langkah A: Kumpulkan koordinat unik per spesies beserta jumlah record dari Parquet Tahap 3\n",
    "with open(NORM_PQ, \"rb\") as fh:\n",
    "    for b in pq.ParquetFile(fh).iter_batches(batch_size=CHUNK, columns=[\"matchedAcceptedScientificName\", \"taxonomyValidationStatus\", \"decimalLatitude\", \"decimalLongitude\", \"spatialPreliminaryStatus\"]):\n",
    "        d = b.to_pandas(); d[\"species\"] = sp_ser(d); d = d[d[\"species\"].notna() & d[\"decimalLatitude\"].notna() & d[\"decimalLongitude\"].notna() & (d[\"spatialPreliminaryStatus\"] != \"NO_COORD\")]\n",
    "        if len(d) > 0: agg_f.append(d.groupby([\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialPreliminaryStatus\"], observed=True).size().rename(\"n\").reset_index())\n",
    "\n",
    "hab_cnt, r_sp, r_la, r_lo, r_w, r_da, r_dt = Counter(), [], [], [], [], [], [] # Penampung hasil kueri tetangga terdekat cKDTree\n",
    "if agg_f: # Langkah B: Bangun cKDTree 3D per spesies dan hitung jarak ke tetangga ke-1..10 untuk titik NEEDS_HABITAT_CHECK\n",
    "    pts = pd.concat(agg_f, ignore_index=True).groupby([\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialPreliminaryStatus\"], observed=True)[\"n\"].sum().reset_index()\n",
    "    for sp_n, g in pts.groupby(\"species\", sort=False):\n",
    "        flg = (g[\"spatialPreliminaryStatus\"] == \"NEEDS_HABITAT_CHECK\").to_numpy()\n",
    "        if not flg.any(): continue # Lewati spesies yang seluruh titiknya sudah berada di daratan atau pesisir <= 1 km\n",
    "        xyz = to_xyz(g[\"decimalLatitude\"].to_numpy(), g[\"decimalLongitude\"].to_numpy()); tr = g[\"spatialPreliminaryStatus\"].isin(TRUST_ST).to_numpy(); q = xyz[flg]\n",
    "        da = c2a(cKDTree(xyz).query(q, k=HAB_NMAX + 1)[0][:, 1:]) # Jarak ke tetangga terdekat (selain titik itu sendiri) pada seluruh titik spesies\n",
    "        dt = c2a(cKDTree(xyz[tr]).query(q, k=HAB_NMAX)[0]) if tr.any() else np.full((q.shape[0], HAB_NMAX), np.inf) # Jarak ke titik daratan/pesisir\n",
    "        r_sp.extend([sp_n] * q.shape[0]); r_la.append(g[\"decimalLatitude\"].to_numpy()[flg]); r_lo.append(g[\"decimalLongitude\"].to_numpy()[flg]); r_w.append(g[\"n\"].to_numpy()[flg]); r_da.append(da); r_dt.append(dt)\n",
    "\n",
    "if r_sp: # Susun tabel hasil evaluasi dukungan habitat (SUPPORTED jika tetangga ke-3 berjarak <= 50 km, selain itu ANOMALY)\n",
    "    D_all, D_tr, w_flg = np.vstack(r_da), np.vstack(r_dt), np.concatenate(r_w).astype(\"int64\"); sup_km = (D_all if HAB_REF == \"ALL\" else D_tr)[:, HAB_MIN_NB - 1]\n",
    "    flg_res = pd.DataFrame({\"species\": r_sp, \"decimalLatitude\": np.concatenate(r_la), \"decimalLongitude\": np.concatenate(r_lo), \"spatialHabitatSupportKm\": np.where(np.isfinite(sup_km), sup_km, np.nan), \"spatialHabitatStatus\": np.where(sup_km <= HAB_RAD_KM, \"SUPPORTED\", \"ANOMALY\")})\n",
    "else: flg_res = pd.DataFrame(columns=[\"species\", \"decimalLatitude\", \"decimalLongitude\", \"spatialHabitatStatus\", \"spatialHabitatSupportKm\"]); D_all = D_tr = np.empty((0, HAB_NMAX)); w_flg = np.empty(0)\n",
    "\n",
    "tmp_p = NORM_PQ.with_suffix(\".habitat_tmp.parquet\"); tmp_p.unlink(missing_ok=True) # Langkah C: Sisipkan 2 kolom habitat ke Parquet Tahap 3\n",
    "with open(NORM_PQ, \"rb\") as fh:\n",
    "    pf_n = pq.ParquetFile(fh); f_sch = pf_n.schema_arrow\n",
    "    for nf in [pa.field(\"spatialHabitatStatus\", pa.string()), pa.field(\"spatialHabitatSupportKm\", pa.float64())]:\n",
    "        if nf.name not in f_sch.names: f_sch = f_sch.append(nf)\n",
    "    hw = pq.ParquetWriter(tmp_p, f_sch, compression=\"snappy\")\n",
    "    for b in pf_n.iter_batches(batch_size=CHUNK):\n",
    "        d = b.to_pandas(); sp_r = sp_ser(d); nds = d[\"spatialPreliminaryStatus\"] == \"NEEDS_HABITAT_CHECK\"\n",
    "        st, sup = pd.Series(\"NOT_REQUIRED\", index=d.index, dtype=\"object\"), pd.Series(np.nan, index=d.index, dtype=\"float64\"); st[nds & sp_r.isna()] = \"UNVERIFIABLE_TAXON\"\n",
    "        if (chk := nds & sp_r.notna()).any() and len(flg_res):\n",
    "            m = pd.DataFrame({\"species\": sp_r[chk].to_numpy(), \"decimalLatitude\": d.loc[chk, \"decimalLatitude\"].to_numpy(), \"decimalLongitude\": d.loc[chk, \"decimalLongitude\"].to_numpy()}).merge(flg_res, on=[\"species\", \"decimalLatitude\", \"decimalLongitude\"], how=\"left\")\n",
    "            st[chk], sup[chk] = m[\"spatialHabitatStatus\"].fillna(\"ANOMALY\").to_numpy(), m[\"spatialHabitatSupportKm\"].to_numpy()\n",
    "        elif chk.any(): st[chk] = \"ANOMALY\"\n",
    "        d[\"spatialHabitatStatus\"], d[\"spatialHabitatSupportKm\"] = st.astype(\"string\"), sup; hab_cnt.update(d[\"spatialHabitatStatus\"].value_counts().to_dict())\n",
    "        hw.write_table(pa.Table.from_pandas(d[f_sch.names], schema=f_sch, preserve_index=False))\n",
    "    hw.close()\n",
    "os.replace(tmp_p, NORM_PQ); n_need = sum(hab_cnt.get(k, 0) for k in [\"SUPPORTED\", \"ANOMALY\", \"UNVERIFIABLE_TAXON\"]) # Ganti file Parquet utama dengan hasil final\n",
    "(OUT_DIR / \"03_habitat_check_report.json\").write_text(json.dumps({\"parameters\": {\"radius_km\": HAB_RAD_KM, \"min_neighbor_coordinates\": HAB_MIN_NB, \"reference\": HAB_REF, \"species_key\": \"dua kata pertama nama kanonik matchedAcceptedScientificName (taksonomi VALID pada Catalogue of Life)\"}, \"records_needing_check\": int(n_need), \"status_counts\": {k: int(v) for k, v in hab_cnt.items()}}, indent=2), encoding=\"utf-8\") # Simpan JSON laporan habitat\n",
    "print(f\"\\n[TAHAP 3 SELESAI] TRT Baseline: {trt_base:.2f}% -> TRT Verified: {trt_ver:.2f}% | Habitat Supported: {hab_cnt['SUPPORTED']:,} | Anomaly: {hab_cnt['ANOMALY']:,}\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(21, 6)); tot_w = float(w_flg.sum()) if len(w_flg) else 0.0 # Langkah D: Plot grafik 3 panel evaluasi habitat\n",
    "for ax, D, ttl in [(axes[0], D_all, \"Referensi: semua titik spesies\"), (axes[1], D_tr, \"Referensi: hanya titik daratan/pesisir\")]:\n",
    "    for n_ in SENS_N:\n",
    "        sh = [w_flg[D[:, n_ - 1] <= r_].sum() / tot_w * 100 for r_ in SENS_RAD] if tot_w > 0 else [0] * len(SENS_RAD)\n",
    "        ax.plot(SENS_RAD, sh, marker=\"o\", linewidth=2.8 if (n_ == HAB_MIN_NB and HAB_REF == (\"ALL\" if D is D_all else \"TRUSTED\")) else 1.3, label=f\"min {n_} koordinat\")\n",
    "    ax.axvline(HAB_RAD_KM, color=\"red\", linestyle=\"--\", linewidth=1); ax.set_xscale(\"log\"); ax.set_xticks(SENS_RAD); ax.set_xticklabels([str(r_) for r_ in SENS_RAD]); ax.set_ylim(0, 105); ax.set_title(ttl); ax.legend(fontsize=8, loc=\"lower right\")\n",
    "labs = [\"SUPPORTED\", \"ANOMALY\", \"UNVERIFIABLE_TAXON\"]; vals = [int(hab_cnt.get(k, 0)) for k in labs]; bars = axes[2].bar(labs, vals, color=[\"#2a9d8f\", \"#d62828\", \"#adb5bd\"])\n",
    "for b, v in zip(bars, vals): axes[2].text(b.get_x() + b.get_width() / 2, v, f\"{v:,}\\n({(v / n_need * 100) if n_need else 0:.1f}%)\", ha=\"center\", va=\"bottom\", fontsize=9)\n",
    "axes[2].set_ylim(0, (max(vals) if max(vals) > 0 else 1) * 1.25); axes[2].set_title(f\"Hasil pengecekan habitat (radius {HAB_RAD_KM:g} km, min {HAB_MIN_NB} koordinat)\")\n",
    "plt.tight_layout(); plt.savefig(OUT_DIR / \"03_grafik_pengecekan_habitat.png\", dpi=200); plt.show() # Simpan PNG grafik pengecekan habitat"
   ]
