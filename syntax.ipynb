    "import gc, hashlib, json, subprocess, urllib.error as uerr, urllib.request as ureq # Modul standar sistem, hash SHA-256, JSON, Git, dan HTTP\n",
    "from datetime import datetime # Utilitas waktu pembuatan dokumen metadata dan laporan evaluasi FAIR\n",
    "from pathlib import Path # Manajemen path direktori dan berkas lintas platform\n",
    "import duckdb, pandas as pd, pyarrow.parquet as pq # Library basis data analitik DuckDB, dataframe Pandas, dan Apache Parquet\n",
    "try: from IPython.display import display # Fungsi tampilan tabel interaktif di Jupyter Notebook\n",
    "except ImportError: display = lambda obj: print(obj.to_string(index=False) if isinstance(obj, pd.DataFrame) else obj) # Fallback konsol\n",
    "\n",
    "for _o in list(globals().values()) + gc.get_objects(): # Tutup koneksi DuckDB yang masih aktif di memori Jupyter agar tidak lock\n",
    "    try:\n",
    "        if isinstance(_o, duckdb.DuckDBPyConnection): _o.close()\n",
    "    except Exception: pass\n",
    "\n",
    "PROJ_DIR, OUT_DIR = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\"), Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\") # Direktori proyek & output ETL\n",
    "GH_URL_MANUAL, PID_MANUAL = \"https://github.com/xredsx/-etl-fair-aves-indonesia.git\", \"\" # URL repositori GitHub publik & DOI opsional\n",
    "GH_TOKEN, APPLY_41_COLS, MAX_GH_MB, DO_GIT_PUSH = \"\", True, 95.0, False # Opsi sinkronisasi 41 kolom Clean DB & saklar auto-push Git\n",
    "COL_KEY = \"7ddf754f-d193-4cc9-b351-99906754a03b\" # ChecklistKey resmi Catalogue of Life eXtended Release (COL XR)\n",
    "DB_DIR, FIN_DIR = OUT_DIR / \"db\", OUT_DIR / \"final_parquet\" # Folder penyimpanan DuckDB dan Parquet final hasil Tahap 6\n",
    "CLEAN_DB, QUAR_DB = DB_DIR / \"clean_store_aves_indonesia.duckdb\", DB_DIR / \"quarantine_store_aves_indonesia.duckdb\" # Path berkas DuckDB\n",
    "CLEAN_TBL, QUAR_TBL = \"occurrence_clean\", \"occurrence_quarantine\" # Nama tabel utama Clean Set & Quarantine Store\n",
    "CLEAN_PQ, QUAR_PQ = FIN_DIR / f\"{CLEAN_TBL}.parquet\", FIN_DIR / f\"{QUAR_TBL}.parquet\" # Path berkas Parquet final ZSTD\n",
    "META_JSON, REP_45_P, DELTA_CSV_P = OUT_DIR / \"07_dataset_metadata_fair.json\", OUT_DIR / \"04_05_validation_and_routing_report.json\", OUT_DIR / \"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\" # Path metadata & laporan\n",
    "for _p in (CLEAN_DB, QUAR_DB, CLEAN_PQ): # Validasi ketersediaan berkas keluaran Tahap 6 sebelum evaluasi FAIR\n",
    "    if not _p.exists(): raise FileNotFoundError(f\"Berkas {_p} belum ditemukan. Jalankan Tahap 6 terlebih dahulu.\")\n",
    "\n",
    "CLEAN_41_ORD = [\"gbifID\", \"occurrenceID\", \"basisOfRecord\", \"occurrenceStatus\", \"datasetKey\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\", \"publisher\", \"eventDate\", \"year\", \"month\", \"countryCode\", \"stateProvince\", \"decimalLatitude\", \"decimalLongitude\", \"hasGeospatialIssues\", \"scientificName\", \"verbatimScientificName\", \"taxonKey\", \"acceptedTaxonKey\", \"taxonomicStatus\", \"taxonRank\", \"family\", \"genus\", \"species\", \"license\", \"verbatimEventDateRaw\", \"eventDateParseStatus\", \"vmt_validation_detail\", \"matchType\", \"matchedRank\", \"matchedStatus\", \"taxonomicMatchCategory\", \"distanceToIndonesiaLandKm\", \"spatialHabitatStatus\", \"spatialHabitatSupportKm\", \"spatial_validation_detail\", \"status_metadata_temporal\", \"record_routing_status\"] # Urutan baku 41 kolom Clean DB (Tabel 4.13)\n",
    "DWC_29 = [\"gbifID\", \"occurrenceID\", \"datasetKey\", \"basisOfRecord\", \"occurrenceStatus\", \"eventDate\", \"year\", \"month\", \"countryCode\", \"stateProvince\", \"decimalLatitude\", \"decimalLongitude\", \"hasCoordinate\", \"hasGeospatialIssues\", \"scientificName\", \"verbatimScientificName\", \"acceptedScientificName\", \"taxonKey\", \"acceptedTaxonKey\", \"taxonomicStatus\", \"taxonRank\", \"family\", \"genus\", \"species\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\", \"publisher\"] # 29 atribut inti Darwin Core\n",
    "DWC_STD = DWC_29 + [\"license\"] # Seluruh atribut standar Darwin Core termasuk license\n",
    "\n",
    "sql_p = lambda p: p.as_posix().replace(\"'\", \"''\"); run_q = lambda c, q: c.execute(q).fetchall(); one_q = lambda c, q: run_q(c, q)[0] # Helper SQL\n",
    "def open_db(p: Path): # Buka koneksi DuckDB dalam mode baca-saja (fallback baca-tulis bila sesi sudah terbuka)\n",
    "    try: return duckdb.connect(str(p), read_only=True)\n",
    "    except duckdb.ConnectionException: return duckdb.connect(str(p), read_only=False)\n",
    "def q_df(c, q: str) -> pd.DataFrame: cur = c.execute(q); return pd.DataFrame(cur.fetchall(), columns=[d[0] for d in cur.description]) # Helper SQL ke DataFrame\n",
    "def sha256_file(p: Path) -> str: # Hitung hash kriptografis SHA-256 berkas Parquet sebagai Persistent Content Identifier\n",
    "    h = hashlib.sha256()\n",
    "    with open(p, \"rb\") as f:\n",
    "        for ch in iter(lambda: f.read(1048576), b\"\"): h.update(ch)\n",
    "    return h.hexdigest()\n",
    "\n",
    "if APPLY_41_COLS and CLEAN_DB.exists(): # Sinkronisasi opsional agar tabel Clean DB berisi tepat 41 kolom bersih sesuai Tabel 4.13 Bab IV\n",
    "    with duckdb.connect(str(CLEAN_DB)) as con:\n",
    "        ex_c = [r[0] for r in run_q(con, f'DESCRIBE \"{CLEAN_TBL}\"')]; tgt_c = [c for c in CLEAN_41_ORD if c in ex_c]\n",
    "        if len(ex_c) != len(tgt_c) or ex_c != tgt_c:\n",
    "            run_q(con, f'CREATE OR REPLACE TABLE \"{CLEAN_TBL}_tmp\" AS SELECT {\", \".join(f\"{chr(34)}{c}{chr(34)}\" for c in tgt_c)} FROM \"{CLEAN_TBL}\"')\n",
    "            run_q(con, f'DROP TABLE \"{CLEAN_TBL}\"'); run_q(con, f'ALTER TABLE \"{CLEAN_TBL}_tmp\" RENAME TO \"{CLEAN_TBL}\"')\n",
    "            run_q(con, f\"CREATE OR REPLACE VIEW v_clean_only AS SELECT * FROM \\\"{CLEAN_TBL}\\\" WHERE record_routing_status = 'Clean'\")\n",
    "            run_q(con, f\"CREATE OR REPLACE VIEW v_warning_only AS SELECT * FROM \\\"{CLEAN_TBL}\\\" WHERE record_routing_status = 'Warning'\")\n",
    "            if \"data_dictionary\" in {r[0] for r in run_q(con, \"SELECT table_name FROM information_schema.tables WHERE table_schema='main'\")}:\n",
    "                run_q(con, f\"CREATE OR REPLACE TABLE data_dictionary_tmp AS SELECT ROW_NUMBER() OVER () AS no, kelompok, atribut, tipe_data_duckdb, fungsi, catatan_etl, sumber FROM data_dictionary WHERE atribut IN ({', '.join(chr(39) + c + chr(39) for c in tgt_c)})\")\n",
    "                run_q(con, \"DROP TABLE data_dictionary\"); run_q(con, \"ALTER TABLE data_dictionary_tmp RENAME TO data_dictionary\")\n",
    "            CLEAN_PQ.unlink(missing_ok=True); run_q(con, f\"COPY \\\"{CLEAN_TBL}\\\" TO '{sql_p(CLEAN_PQ)}' (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 122880)\"); run_q(con, \"CHECKPOINT\"); run_q(con, \"VACUUM\")\n",
    "\n",
    "def push_to_github(proj_d: Path, repo_url: str, token: str = \"\"): # Fungsi otomatis pembuat .gitignore, README.md, commit, & push ke GitHub\n",
    "    cu = repo_url.strip().rstrip(\"/\")[:-4] if repo_url.strip().rstrip(\"/\").endswith(\".git\") else repo_url.strip().rstrip(\"/\")\n",
    "    ign = [\"*.csv\", \"!output/*.csv\", \"*.zip\", \"output/raw_aves_indonesia.parquet\", \"output/harmonized_aves_indonesia.parquet\", \"output/normalized_taxonomy_aves_indonesia.parquet\", \"output/clean_set_aves_indonesia.parquet\", \"output/quarantine_store_aves_indonesia.parquet\", \"*.wal\", \"*.tmp\", \"__pycache__/\", \".ipynb_checkpoints/\"]\n",
    "    for f in proj_d.rglob(\"*\"): # Abaikan otomatis berkas > 95 MB agar tidak ditolak batas 100 MB server GitHub\n",
    "        if f.is_file() and \".git\" not in f.parts and (f.stat().st_size / 1048576) > MAX_GH_MB and (rp := f.relative_to(proj_d).as_posix()) not in ign: ign.append(rp)\n",
    "    (proj_d / \".gitignore\").write_text(\"\\n\".join(ign) + \"\\n\", encoding=\"utf-8\")\n",
    "    (proj_d / \"README.md\").write_text(f\"# Pipeline ETL Berbasis FAIR: Aves Indonesia (GBIF & Catalogue of Life XR)\\n- **Peneliti**: Raditya Sajid (S1 Sains Data, Universitas Brawijaya)\\n- **Otoritas Taksonomi**: Catalogue of Life XR (`{COL_KEY}`)\\n\", encoding=\"utf-8\")\n",
    "    r_git = lambda args, chk=True: subprocess.run([\"git\", \"-C\", str(proj_d)] + args, text=True, capture_output=True, check=chk)\n",
    "    if not (proj_d / \".git\").exists(): r_git([\"init\"])\n",
    "    r_git([\"config\", \"http.postBuffer\", \"524288000\"], False); r_git([\"branch\", \"-M\", \"main\"], False)\n",
    "    if not r_git([\"config\", \"user.name\"], False).stdout.strip(): r_git([\"config\", \"user.name\", \"Raditya Sajid\"], False)\n",
    "    if not r_git([\"config\", \"user.email\"], False).stdout.strip(): r_git([\"config\", \"user.email\", \"radityasajid@student.ub.ac.id\"], False)\n",
    "    pu = f\"https://{token.strip()}@github.com/{cu.split('github.com/', 1)[1]}.git\" if (token.strip() and \"github.com/\" in cu) else f\"{cu}.git\"\n",
    "    r_git([\"remote\", \"set-url\" if \"origin\" in r_git([\"remote\"], False).stdout.split() else \"add\", \"origin\", pu])\n",
    "    r_git([\"add\", \".\"])\n",
    "    if r_git([\"status\", \"--porcelain\"], False).stdout.strip(): r_git([\"commit\", \"-m\", \"Unggah keluaran pipeline ETL Aves Indonesia dan metadata evaluasi FAIR\"])\n",
    "    if (pr := r_git([\"push\", \"-u\", \"origin\", \"main\", \"--force\"], False)).returncode != 0: raise RuntimeError(f\"Gagal git push:\\n{pr.stderr}\")\n",
    "    if token.strip(): r_git([\"remote\", \"set-url\", \"origin\", f\"{cu}.git\"], False)\n",
    "\n",
    "if DO_GIT_PUSH and GH_URL_MANUAL.strip(): push_to_github(PROJ_DIR, GH_URL_MANUAL, GH_TOKEN) # Jalankan push Git bila DO_GIT_PUSH=True\n",
    "\n",
    "def detect_github(base_d: Path, man_url: str = \"\") -> dict: # Deteksi otomatis repositori Git lokal & verifikasi akses HTTP/HTTPS publik GitHub\n",
    "    res = {\"git_repo_detected\": False, \"git_root\": None, \"remote_origin_url\": None, \"github_https_url\": None, \"github_owner_repo\": None, \"local_commit_sha\": None, \"pushed_to_remote\": False, \"http_accessible\": False, \"http_status_code\": None, \"is_open_free_access\": False, \"github_has_files_online\": False, \"detection_method\": \"Belum terdeteksi\", \"detail_message\": \"\"}\n",
    "    g_dir = next((d for d in [base_d, base_d.parent, base_d.parent.parent, Path.cwd()] if d and (d / \".git\").exists()), None); raw_u = man_url.strip()\n",
    "    if g_dir: # Jika ditemukan folder .git lokal, ekstrak URL origin, commit SHA terakhir, dan status branch remote\n",
    "        res[\"git_repo_detected\"], res[\"git_root\"] = True, str(g_dir)\n",
    "        for cmd, key in [([\"remote\", \"get-url\", \"origin\"], \"rem\"), ([\"rev-parse\", \"HEAD\"], \"local_commit_sha\"), ([\"branch\", \"-r\"], \"br\")]:\n",
    "            try:\n",
    "                out = subprocess.check_output([\"git\", \"-C\", str(g_dir)] + cmd, stderr=subprocess.DEVNULL, text=True, timeout=5).strip()\n",
    "                if key == \"rem\" and out and not raw_u: raw_u, res[\"detection_method\"] = out, f\"Otomatis dari .git ({g_dir})\"\n",
    "                elif key == \"local_commit_sha\" and out: res[\"local_commit_sha\"] = out\n",
    "                elif key == \"br\" and out: res[\"pushed_to_remote\"] = True\n",
    "            except Exception: pass\n",
    "    if man_url.strip(): res[\"detection_method\"] = \"Input konfigurasi GITHUB_REPO_URL_MANUAL\"\n",
    "    if raw_u: # Normalisasi URL Git/SSH menjadi URL HTTPS standar\n",
    "        cu = (\"https://github.com/\" + raw_u.split(\"git@github.com:\", 1)[1]) if raw_u.startswith(\"git@github.com:\") else raw_u\n",
    "        cu = cu[:-4] if cu.endswith(\".git\") else cu; res[\"remote_origin_url\"], res[\"github_https_url\"] = raw_u, cu\n",
    "        if \"github.com/\" in cu and len(pts := cu.split(\"github.com/\", 1)[1].strip(\"/\").split(\"/\")) >= 2: res[\"github_owner_repo\"] = f\"{pts[0]}/{pts[1]}\"\n",
    "    if res[\"github_owner_repo\"]: # Verifikasi keberadaan dan status publik repositori melalui GitHub REST API\n",
    "        try:\n",
    "            with ureq.urlopen(ureq.Request(f\"https://api.github.com/repos/{res['github_owner_repo']}\", headers={\"User-Agent\": \"Skripsi-FAIR-Evaluator/1.0\"}), timeout=8) as r:\n",
    "                sc, inf = r.getcode(), json.loads(r.read().decode(\"utf-8\"))\n",
    "                res[\"http_accessible\"], res[\"http_status_code\"], res[\"is_open_free_access\"], res[\"github_has_files_online\"] = (sc == 200), sc, (sc == 200 and not inf.get(\"private\", True)), (inf.get(\"size\", 0) > 0)\n",
    "                if res[\"github_has_files_online\"]: res[\"pushed_to_remote\"] = True\n",
    "        except uerr.HTTPError as e: res[\"http_status_code\"] = e.code\n",
    "        except Exception: pass\n",
    "    res[\"detail_message\"] = f\"SUDAH DIUPLOAD KE GITHUB & PUBLIK ({res['github_https_url']} | HTTP {res['http_status_code']})\" if (res[\"http_accessible\"] and res[\"github_has_files_online\"]) else (f\"Terdeteksi remote GitHub ({res['github_https_url']}), status HTTP: {res['http_status_code']}\" if res[\"github_https_url\"] else \"BELUM DIUPLOAD KE GITHUB\")\n",
    "    return res\n",
    "\n",
    "gh_st = detect_github(OUT_DIR, GH_URL_MANUAL); cc, cq = open_db(CLEAN_DB), open_db(QUAR_DB) # Cek status GitHub & buka koneksi kedua DuckDB\n",
    "try: # Ekstrak statistik cakupan spasial, temporal, taksonomi, lisensi, dan referensi dari DuckDB\n",
    "    c_cols = [r[0] for r in run_q(cc, f'DESCRIBE SELECT * FROM \"{CLEAN_TBL}\"')]; c_set = set(c_cols)\n",
    "    n_c, n_q = one_q(cc, f'SELECT COUNT(*) FROM \"{CLEAN_TBL}\"')[0], one_q(cq, f'SELECT COUNT(*) FROM \"{QUAR_TBL}\"')[0]\n",
    "    rt_dist = dict(run_q(cc, f'SELECT record_routing_status, COUNT(*) FROM \"{CLEAN_TBL}\" GROUP BY 1'))\n",
    "    y_ex = '\"year\"' if \"year\" in c_set else 'EXTRACT(YEAR FROM \"eventDate\")'\n",
    "    sp_tm = one_q(cc, f'SELECT MIN(decimalLatitude), MAX(decimalLatitude), MIN(decimalLongitude), MAX(decimalLongitude), MIN(eventDate), MAX(eventDate), MIN({y_ex}), MAX({y_ex}), COUNT(DISTINCT scientificName), COUNT(DISTINCT family), COUNT(DISTINCT genus), COUNT(DISTINCT stateProvince) FROM \"{CLEAN_TBL}\"')\n",
    "    qref = one_q(cc, f\"SELECT COUNT(*) FILTER (WHERE taxonKey IS NOT NULL), COUNT(*) FILTER (WHERE datasetKey IS NOT NULL), COUNT(*) FILTER (WHERE license IS NOT NULL AND TRIM(CAST(license AS VARCHAR)) <> ''), COUNT(*) FILTER (WHERE occurrenceID IS NOT NULL AND TRIM(CAST(occurrenceID AS VARCHAR)) <> '') FROM \\\"{CLEAN_TBL}\\\"\")\n",
    "    lic_dist = dict(run_q(cc, f\"SELECT COALESCE(CAST(license AS VARCHAR), 'UNSPECIFIED'), COUNT(*) FROM \\\"{CLEAN_TBL}\\\" GROUP BY 1 ORDER BY 2 DESC\"))\n",
    "    ex_tbls = {r[0] for r in run_q(cc, \"SELECT table_name FROM information_schema.tables WHERE table_schema = 'main'\")}\n",
    "    mrg_info = q_df(cc, \"SELECT * FROM etl_merged_columns\").to_dict(orient=\"records\") if \"etl_merged_columns\" in ex_tbls else []\n",
    "finally: cc.close(); cq.close()\n",
    "\n",
    "c_sha, q_sha = sha256_file(CLEAN_PQ), (sha256_file(QUAR_PQ) if QUAR_PQ.exists() else \"\") # Hitung SHA-256 kedua file Parquet final\n",
    "pid = PID_MANUAL.strip() or (f\"{gh_st['github_https_url']}{'/tree/' + gh_st['local_commit_sha'][:10] if gh_st['local_commit_sha'] else ''}#sha256:{c_sha[:16]}\" if gh_st[\"github_https_url\"] else f\"urn:sha256:aves-indonesia-clean:{c_sha}\") # Bentuk Persistent Identifier (F1)\n",
    "dwc_act = [c for c in DWC_STD if c in c_set]; dwc_mrg = [m[\"kolom_dihapus\"] for m in mrg_info if m.get(\"kolom_dihapus\") in DWC_STD]\n",
    "c29_cnt = len([c for c in DWC_29 if c in c_set or c in dwc_mrg]) # Hitung pemetaan 29 atribut inti Darwin Core\n",
    "st45_m = json.loads(REP_45_P.read_text(encoding=\"utf-8\")) if REP_45_P.exists() else {}\n",
    "df_dx = pd.read_csv(DELTA_CSV_P) if DELTA_CSV_P.exists() else pd.DataFrame(st45_m.get(\"before_vs_after_comparison_eq_2_7\", [])) # Tabel Delta X\n",
    "\n",
    "meta_fair = {\"metadata_schema\": \"FAIR-DataCite-DarwinCore-v1.0\", \"generated_at\": datetime.now().isoformat(timespec=\"seconds\"), \"F1_persistent_identifier\": {\"dataset_id\": pid, \"sha256_clean_parquet\": c_sha, \"sha256_quarantine_parquet\": q_sha, \"github_repository_url\": gh_st[\"github_https_url\"], \"github_commit_sha\": gh_st[\"local_commit_sha\"]}, \"F2_R1_descriptive_metadata\": {\"title\": \"Dataset Kurasi Kemunculan Burung (Aves) Indonesia Berstandar Darwin Core dan FAIR\", \"description\": \"Dataset hasil pipeline ETL 6 tahap dari Global Biodiversity Information Facility (GBIF) berformat Simple CSV untuk kelas Aves di wilayah Indonesia, dilengkapi validasi 5 dimensi kualitas data serta pemisahan Clean Set dan Quarantine Store.\", \"created_date\": datetime.now().strftime(\"%Y-%m-%d\"), \"taxonomic_coverage\": {\"kingdom\": \"Animalia\", \"class\": \"Aves\", \"distinct_families\": int(sp_tm[9] or 0), \"distinct_genera\": int(sp_tm[10] or 0), \"distinct_species_scientificName\": int(sp_tm[8] or 0), \"reference_backbone\": f\"Catalogue of Life eXtended Release (COL XR, checklistKey={COL_KEY}) via GBIF Species Match API v2\"}, \"spatial_coverage\": {\"country\": \"Indonesia (ID)\", \"min_latitude\": round(float(sp_tm[0]), 6) if sp_tm[0] is not None else None, \"max_latitude\": round(float(sp_tm[1]), 6) if sp_tm[1] is not None else None, \"min_longitude\": round(float(sp_tm[2]), 6) if sp_tm[2] is not None else None, \"max_longitude\": round(float(sp_tm[3]), 6) if sp_tm[3] is not None else None, \"distinct_provinces\": int(sp_tm[11] or 0)}, \"temporal_coverage\": {\"min_eventDate_iso8601\": str(sp_tm[4]) if sp_tm[4] is not None else None, \"max_eventDate_iso8601\": str(sp_tm[5]) if sp_tm[5] is not None else None, \"min_year\": int(sp_tm[6]) if sp_tm[6] is not None else None, \"max_year\": int(sp_tm[7]) if sp_tm[7] is not None else None}, \"record_counts\": {\"total_records_processed\": int(n_c + n_q), \"clean_set_records\": int(n_c), \"clean_routing_breakdown\": {k: int(v) for k, v in rt_dist.items()}, \"quarantine_store_records\": int(n_q)}, \"data_quality_before_vs_after_etl\": df_dx.to_dict(orient=\"records\") if not df_dx.empty else []}, \"F3_data_identifiers_and_distributions\": {\"described_dataset_id\": pid, \"distributions\": [{\"artifact_role\": \"Clean Set DuckDB Database\", \"file_name\": CLEAN_DB.name, \"table_name\": CLEAN_TBL, \"format\": \"DuckDB\", \"records\": int(n_c), \"columns\": len(c_cols)}, {\"artifact_role\": \"Clean Set Final Parquet\", \"file_name\": CLEAN_PQ.name, \"format\": \"Apache Parquet (ZSTD)\", \"sha256\": c_sha, \"records\": int(n_c)}, {\"artifact_role\": \"Quarantine Store DuckDB Database\", \"file_name\": QUAR_DB.name, \"table_name\": QUAR_TBL, \"format\": \"DuckDB\", \"records\": int(n_q)}, {\"artifact_role\": \"Quarantine Store Final Parquet\", \"file_name\": QUAR_PQ.name, \"format\": \"Apache Parquet (ZSTD)\", \"sha256\": q_sha, \"records\": int(n_q)}]}, \"A1_access_protocol_and_github_status\": {\"access_protocol\": \"HTTPS (GitHub Public Repository)\" if gh_st[\"http_accessible\"] else \"Local File System (Belum Diunggah ke GitHub)\", \"github_uploaded_and_verified\": bool(gh_st[\"http_accessible\"] and gh_st[\"github_has_files_online\"]), \"github_url\": gh_st[\"github_https_url\"], \"http_status_code\": gh_st[\"http_status_code\"], \"open_free_access\": bool(gh_st[\"is_open_free_access\"]), \"detection_summary\": gh_st[\"detail_message\"]}, \"I1_I2_I3_interoperability_and_standards\": {\"machine_readable_formats\": [\"Apache Parquet (ZSTD)\", \"DuckDB Relational Table\", \"JSON Metadata\"], \"community_standard\": \"Darwin Core (DwC) Simple Darwin Core\", \"vocabulary_authorities\": [\"Darwin Core Terms (tdwg.org)\", f\"Catalogue of Life eXtended Release (COL XR, checklistKey={COL_KEY})\"], \"darwin_core_columns_active\": dwc_act, \"darwin_core_columns_merged_deduplicated\": dwc_mrg, \"qualified_references_coverage\": {\"taxonKey_populated_records\": int(qref[0]), \"taxonKey_coverage_pct\": round(qref[0] * 100.0 / n_c, 4) if n_c else 0.0, \"datasetKey_populated_records\": int(qref[1]), \"datasetKey_coverage_pct\": round(qref[1] * 100.0 / n_c, 4) if n_c else 0.0}}, \"R1_1_license_and_usage_terms\": {\"dataset_curation_license\": \"CC-BY-4.0 (mengikuti atribusi sumber GBIF pada tiap record)\", \"record_level_license_column\": \"license\", \"record_level_license_populated_pct\": round(qref[2] * 100.0 / n_c, 4) if n_c else 0.0, \"record_level_license_distribution\": {str(k): int(v) for k, v in lic_dist.items()}}, \"R1_2_provenance\": {\"primary_source\": \"Global Biodiversity Information Facility (GBIF) Occurrence Download (Simple CSV, Taxonomy: Catalogue of Life) - Class Aves, Country ID\", \"record_level_provenance_columns\": [c for c in [\"gbifID\", \"occurrenceID\", \"datasetKey\", \"publisher\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\"] if c in c_set], \"etl_pipeline_stages\": [\"Tahap 1: Ekstraksi & Ingesti Data Mentah GBIF Simple CSV Aves Indonesia\", \"Tahap 2: Harmonisasi Skema Darwin Core, Normalisasi Temporal ISO 8601, & Klasifikasi Spasial Daratan/Pesisir\", f\"Tahap 3: Resolusi Taksonomi Catalogue of Life (COL XR, checklistKey={COL_KEY}) & Evaluasi Habitat Spasial Spesies\", \"Tahap 4: Evaluasi Multi-Dimensi Kualitas Data (L, U, VS, TRT, VMT)\", \"Tahap 5: Routing Record Otomatis ke Clean Set dan Quarantine Store beserta Invalid_Reasons\", \"Tahap 6: Deduplikasi Kolom Identik, Pemuatan ke DuckDB, Pembuatan Kamus Data, & Ekspor Parquet ZSTD\"]}} # Dokumen metadata FAIR\n",
    "META_JSON.write_text(json.dumps(meta_fair, indent=2, ensure_ascii=False), encoding=\"utf-8\") # Simpan berkas 07_dataset_metadata_fair.json\n",
    "\n",
    "pq_cols = pq.read_schema(CLEAN_PQ).names; dm = meta_fair[\"F2_R1_descriptive_metadata\"]; f3m = meta_fair[\"F3_data_identifiers_and_distributions\"] # Evaluasi 12 indikator FAIR\n",
    "s_F1 = 1.0 if (bool(pid) and qref[3] == n_c) else 0.5 # F1: Identifier persisten tingkat dataset + gbifID/occurrenceID unik 100%\n",
    "s_F2 = 1.0 if all([dm.get(\"title\"), dm.get(\"description\"), dm[\"taxonomic_coverage\"][\"distinct_species_scientificName\"] > 0, dm[\"spatial_coverage\"][\"min_latitude\"] is not None, dm[\"temporal_coverage\"][\"min_eventDate_iso8601\"] is not None, dm[\"record_counts\"][\"clean_set_records\"] == n_c]) else 0.0 # F2: Metadata deskriptif kaya\n",
    "s_F3 = 1.0 if (f3m.get(\"described_dataset_id\") == pid and len(f3m.get(\"distributions\", [])) >= 2) else 0.0 # F3: Tautan eksplisit metadata ke file fisik & SHA-256\n",
    "s_A1 = 1.0 if ((gh_st[\"http_accessible\"] and gh_st[\"github_has_files_online\"]) or (gh_st[\"github_https_url\"] and gh_st[\"pushed_to_remote\"])) else 0.0 # A1: Akses HTTPS standar\n",
    "s_A1_1 = 1.0 if ((gh_st[\"is_open_free_access\"] and gh_st[\"github_has_files_online\"]) or (gh_st[\"github_https_url\"] and gh_st[\"pushed_to_remote\"])) else 0.0 # A1.1: Protokol terbuka & gratis\n",
    "s_I1 = 1.0 if (CLEAN_PQ.exists() and CLEAN_DB.exists() and len(pq_cols) == len(c_cols) and len(dwc_act) >= 20) else 0.0 # I1: Format terstruktur mesin Parquet & DuckDB\n",
    "s_I2 = 1.0 if (all(c in c_set for c in [\"scientificName\", \"taxonKey\", \"taxonRank\", \"taxonomicStatus\", \"family\", \"genus\", \"species\"]) and \"data_dictionary\" in ex_tbls) else 0.0 # I2: Kosakata FAIR DwC & COL XR\n",
    "tk_rat, dk_rat, lic_rat = (qref[0] / n_c if n_c else 0.0), (qref[1] / n_c if n_c else 0.0), (qref[2] / n_c if n_c else 0.0) # Rasio referensi & lisensi\n",
    "s_I3, s_R1 = round((tk_rat + dk_rat) / 2.0, 4), (1.0 if (s_F2 == 1.0 and bool(dm.get(\"created_date\"))) else 0.0) # I3: Referensi terkualifikasi | R1: Metadata cukup\n",
    "s_R1_1 = 1.0 if (bool(meta_fair[\"R1_1_license_and_usage_terms\"][\"dataset_curation_license\"]) and lic_rat >= 0.99) else round(lic_rat, 4) # R1.1: Lisensi eksplisit\n",
    "s_R1_2 = 1.0 if (len(meta_fair[\"R1_2_provenance\"][\"etl_pipeline_stages\"]) == 6 and \"etl_load_log\" in ex_tbls and all(c in c_set for c in [\"gbifID\", \"datasetKey\", \"publisher\", \"recordedBy\", \"verbatimScientificName\", \"verbatimEventDateRaw\"])) else 0.0 # R1.2: Provenansi lengkap\n",
    "s_R1_3 = 1.0 if (c29_cnt >= 29 and all(c in c_set for c in [\"eventDate\", \"decimalLatitude\", \"decimalLongitude\"])) else 0.0 # R1.3: Kepatuhan standar komunitas Darwin Core\n",
    "\n",
    "ind_rows = [ # Susun Tabel 2.10: Evaluasi 12 Indikator RDA FAIR Data Maturity Model beserta bobot (Essential=3, Important=2)\n",
    "    (\"Findable (F)\", \"F1\", \"F1. Persistent Identifier\", \"Dataset/output memiliki persistent identifier unik.\", \"Essential\", 3, s_F1, f\"PID: {pid} | SHA-256: {c_sha[:16]}... | occurrenceID 100% ({n_c:,} record).\"),\n",
    "    (\"Findable (F)\", \"F2\", \"F2. Rich Metadata\", \"Tersedia metadata deskriptif (judul, deskripsi, cakupan, jumlah record).\", \"Essential\", 3, s_F2, f\"07_dataset_metadata_fair.json memuat {dm['taxonomic_coverage']['distinct_species_scientificName']:,} spesies COL XR, cakupan spasial-temporal, & {n_c:,} record.\"),\n",
    "    (\"Findable (F)\", \"F3\", \"F3. Metadata–Data Identifier\", \"Metadata mencantumkan identifier dataset dan distribusi berkas secara eksplisit.\", \"Essential\", 3, s_F3, f\"Mencantumkan described_dataset_id ({pid}) beserta nama berkas fisik ({CLEAN_DB.name}, {CLEAN_PQ.name}) & hash SHA-256.\"),\n",
    "    (\"Accessible (A)\", \"A1\", \"A1. Standardized Access Protocol\", \"Dataset dapat diakses melalui protokol standar HTTP/HTTPS.\", \"Essential\", 3, s_A1, f\"Akses HTTPS terverifikasi ({gh_st['github_https_url']} | HTTP {gh_st['http_status_code']}).\" if s_A1 == 1.0 else \"Dataset masih di penyimpanan lokal (belum terdeteksi push GitHub publik).\"),\n",
    "    (\"Accessible (A)\", \"A1.1\", \"A1.1. Open/Free Access\", \"Dataset dapat diakses melalui protokol terbuka tanpa pembayaran.\", \"Important\", 2, s_A1_1, f\"Repositori publik GitHub ({gh_st['github_https_url']}) bebas biaya akses.\" if s_A1_1 == 1.0 else \"Akses protokol terbuka daring belum aktif.\"),\n",
    "    (\"Interoperable (I)\", \"I1\", \"I1. Knowledge Representation\", \"Dataset tersimpan dalam format mesin dengan struktur Darwin Core.\", \"Important\", 2, s_I1, f\"Tersimpan dalam Parquet ZSTD ({CLEAN_PQ.name}) & tabel DuckDB ({CLEAN_TBL}, {len(c_cols)} kolom).\"),\n",
    "    (\"Interoperable (I)\", \"I2\", \"I2. FAIR Vocabulary\", \"Menggunakan istilah baku Darwin Core dan taksonomi Catalogue of Life (COL XR).\", \"Important\", 2, s_I2, f\"{len(dwc_act)} atribut Darwin Core aktif + {len(dwc_mrg)} atribut disatukan, terhubung ke COL XR ({COL_KEY}).\"),\n",
    "    (\"Interoperable (I)\", \"I3\", \"I3. Qualified References\", \"Memiliki referensi bermakna terhadap entitas eksternal (taxonKey & datasetKey).\", \"Important\", 2, s_I3, f\"taxonKey terisi {tk_rat * 100:.2f}% ({qref[0]:,}) & datasetKey terisi {dk_rat * 100:.2f}% ({qref[1]:,}).\"),\n",
    "    (\"Reusable (R)\", \"R1\", \"R1. Sufficient Metadata\", \"Metadata memuat deskripsi, cakupan, jumlah record, dan tanggal pembuatan.\", \"Essential\", 3, s_R1, f\"Memuat deskripsi kurasi, jumlah record ({n_c:,} Clean, {n_q:,} Quarantine), & tanggal ({dm['created_date']}).\"),\n",
    "    (\"Reusable (R)\", \"R1.1\", \"R1.1. License\", \"Menyertakan informasi lisensi penggunaan secara eksplisit.\", \"Essential\", 3, s_R1_1, f\"Lisensi dataset CC-BY-4.0 & kolom license terisi pada {lic_rat * 100:.2f}% ({qref[2]:,}) record.\"),\n",
    "    (\"Reusable (R)\", \"R1.2\", \"R1.2. Provenance\", \"Menyertakan sumber GBIF, nilai asli verbatim, log waktu muat, dan tahapan ETL.\", \"Important\", 2, s_R1_2, \"Memuat datasetKey, publisher, recordedBy, verbatimScientificName, verbatimEventDateRaw, etl_load_log, & 6 tahap ETL.\"),\n",
    "    (\"Reusable (R)\", \"R1.3\", \"R1.3. Community Standard\", \"Struktur dan tipe data mengikuti standar komunitas Simple Darwin Core.\", \"Essential\", 3, s_R1_3, f\"Seluruh {c29_cnt}/29 atribut inti Darwin Core terpetakan, eventDate DATE ISO 8601, koordinat float64 WGS84.\"),\n",
    "]\n",
    "df_fair = pd.DataFrame(ind_rows, columns=[\"Dimensi\", \"Kode_Indikator\", \"Nama_Indikator\", \"Operasionalisasi_dan_Kriteria_Pemenuhan\", \"Prioritas\", \"Bobot (w_i)\", \"Skor_Pemenuhan (s_i)\", \"Bukti_Operasional_Keluaran_Pipeline\"])\n",
    "df_fair[\"Skor_Tertimbang (w_i * s_i)\"] = df_fair[\"Bobot (w_i)\"] * df_fair[\"Skor_Pemenuhan (s_i)\"] # Hitung skor tertimbang per indikator\n",
    "df_fair[\"Status_Pemenuhan\"] = df_fair[\"Skor_Pemenuhan (s_i)\"].apply(lambda s: \"Terpenuhi (100%)\" if s >= 0.9999 else (\"Terpenuhi Sebagian\" if s > 0 else \"Belum Terpenuhi (0%)\"))\n",
    "\n",
    "dim_sc = {d: round(float(g[\"Skor_Tertimbang (w_i * s_i)\"].sum() / g[\"Bobot (w_i)\"].sum()), 4) for d, g in df_fair.groupby(\"Dimensi\", sort=False)} # Skor per dimensi (Persamaan 2.8)\n",
    "ov_fair = round(float(df_fair[\"Skor_Tertimbang (w_i * s_i)\"].sum() / df_fair[\"Bobot (w_i)\"].sum()), 4) # Overall FAIR Score (Persamaan 2.9)\n",
    "df_fair.to_csv(OUT_DIR / \"07_tabel_2_10_evaluasi_indikator_fair.csv\", index=False, encoding=\"utf-8-sig\") # Simpan CSV Tabel 2.10\n",
    "(OUT_DIR / \"07_fair_compliance_report.json\").write_text(json.dumps({\"evaluated_at\": datetime.now().isoformat(timespec=\"seconds\"), \"dimension_scores_eq_2_8\": dim_sc, \"overall_fair_score_eq_2_9\": ov_fair, \"github_detection\": gh_st, \"before_vs_after_quality_delta_x\": df_dx.to_dict(orient=\"records\") if not df_dx.empty else [], \"indicators_table_2_10\": df_fair.to_dict(orient=\"records\")}, indent=2, ensure_ascii=False), encoding=\"utf-8\") # Simpan JSON laporan FAIR\n",
    "\n",
    "pd.set_option(\"display.max_columns\", None); pd.set_option(\"display.max_colwidth\", None); pd.set_option(\"display.width\", 1000) # Format tampilan tabel\n",
    "if not df_dx.empty: print(\"=== 0. EVALUASI KUALITAS DATA SEBELUM vs SESUDAH ETL (DELTA X) ===\"); display(df_dx)\n",
    "print(f\"\\n=== 1. HASIL EVALUASI 12 INDIKATOR FAIR (Overall Score = {ov_fair * 100:.2f}% | Dimensi: {dim_sc}) ===\")\n",
    "display(df_fair[[\"Dimensi\", \"Kode_Indikator\", \"Nama_Indikator\", \"Prioritas\", \"Bobot (w_i)\", \"Skor_Pemenuhan (s_i)\", \"Skor_Tertimbang (w_i * s_i)\", \"Bukti_Operasional_Keluaran_Pipeline\"]])\n",
    "\n",
    "with open_db(CLEAN_DB) as cb: # Tampilkan 5 sampel bukti fisik pada level record di DuckDB untuk Bab IV Skripsi\n",
    "    ak_ex = '\"acceptedTaxonKey\" AS acceptedTaxonKey_COL' if \"acceptedTaxonKey\" in c_set else ('\"matchedTaxonKey\" AS acceptedTaxonKey_COL' if \"matchedTaxonKey\" in c_set else '\"taxonKey\" AS acceptedTaxonKey_COL')\n",
