    "import json # Modul standar pembacaan dan penulisan laporan JSON\n",
    "from collections import Counter # Struktur penghitung frekuensi status validasi dan routing\n",
    "from datetime import date # Utilitas tanggal referensi ekstraksi dataset\n",
    "from pathlib import Path # Manajemen path direktori dan berkas lintas platform\n",
    "import matplotlib.pyplot as plt, numpy as np, pandas as pd, pyarrow as pa # Library visualisasi, array, dataframe, dan Arrow\n",
    "try: import pandas.core.arrays.arrow.extension_types # Pengaman registrasi tipe ekstensi Arrow di Pandas\n",
    "except Exception: pass # Abaikan jika sudah terdaftar\n",
    "import pyarrow.parquet as pq # Modul pembaca dan penulis berkas Apache Parquet\n",
    "\n",
    "OUT_DIR, CHUNK, EXT_DATE, TRT_MODE = Path(r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"), 100_000, date.today(), \"ACCEPTED_ONLY\" # Konfigurasi utama Tahap 4 & 5\n",
    "NORM_PQ = OUT_DIR / \"normalized_taxonomy_aves_indonesia.parquet\" # Input Parquet dari Tahap 3 (COL XR + Habitat)\n",
    "CLEAN_PQ, QUAR_PQ = OUT_DIR / \"clean_set_aves_indonesia.parquet\", OUT_DIR / \"quarantine_store_aves_indonesia.parquet\" # Output Parquet Tahap 5\n",
    "T1_REP, T3_REP = OUT_DIR / \"01_baseline_profile_report.json\", OUT_DIR / \"03_taxonomic_normalization_report.json\" # Laporan JSON Tahap 1 & 3\n",
    "if not NORM_PQ.exists(): raise FileNotFoundError(f\"Berkas {NORM_PQ} belum ada. Jalankan Tahap 3 terlebih dahulu.\") # Validasi prasyarat\n",
    "\n",
    "MAND_9 = [\"occurrenceID\", \"scientificName\", \"taxonRank\", \"decimalLatitude\", \"decimalLongitude\", \"eventDate\", \"basisOfRecord\", \"publisher\", \"recordedBy\"] # 9 atribut wajib (Tabel 2.7)\n",
    "DIM_COLS = [(\"Completeness\", \"status_completeness\"), (\"Uniqueness\", \"status_uniqueness\"), (\"Spatial\", \"status_spatial\"), (\"Taxonomy\", \"status_taxonomy\"), (\"Metadata_Temporal\", \"status_metadata_temporal\")] # 5 dimensi kualitas data\n",
    "DIM_LBLS, ST_COLS = np.array([l for l, _ in DIM_COLS]), [c for _, c in DIM_COLS] # Array nama dimensi & daftar kolom status\n",
    "\n",
    "def flag_dups(hashes: np.ndarray, pres: np.ndarray, seen: set) -> np.ndarray: # Deteksi duplikasi tervekktorisasi lintas batch\n",
    "    flg = np.zeros(len(hashes), dtype=bool); idx = np.flatnonzero(pres) # Inisialisasi array boolean False & ambil indeks non-NULL\n",
    "    if idx.size == 0: return flg # Kembalikan seluruhnya False jika tidak ada nilai yang terisi\n",
    "    keys = hashes[idx]; wb = pd.Series(keys).duplicated(keep=\"first\").to_numpy(); kl = keys.tolist() # Cek duplikat internal batch\n",
    "    pr = np.fromiter((k in seen for k in kl), dtype=bool, count=len(kl)); flg[idx] = wb | pr; seen.update(kl) # Cek terhadap batch sebelumnya & update set\n",
    "    return flg # Kembalikan array boolean duplikat (True jika duplikat, False jika kemunculan pertama/unik)\n",
    "\n",
    "for p in (CLEAN_PQ, QUAR_PQ): p.unlink(missing_ok=True) # Hapus berkas Parquet lama sebelum menulis hasil baru\n",
    "pf_n = pq.ParquetFile(NORM_PQ); val_sch = pq.read_schema(NORM_PQ); sch_names = set(val_sch.names) # Baca skema Parquet Tahap 3\n",
    "req_c = {\"spatialPreliminaryStatus\", \"spatialLandClass\", \"spatialHabitatStatus\", \"taxonomyValidationStatus\", \"acceptedScientificName\", \"acceptedTaxonKey\", \"taxonomicStatus\", \"matchedTaxonKey\", \"matchedAcceptedScientificName\"} # Kolom wajib Tahap 2 & 3\n",
    "if (miss_c := req_c - sch_names): raise KeyError(f\"Kolom Tahap 2/3 belum lengkap: {sorted(miss_c)}. Jalankan ulang Tahap 2 & 3.\") # Validasi skema input\n",
    "\n",
    "for vf in [pa.field(\"spatial_validation_detail\", pa.string()), pa.field(\"vmt_validation_detail\", pa.string()), pa.field(\"status_completeness\", pa.string()), pa.field(\"status_uniqueness\", pa.string()), pa.field(\"status_spatial\", pa.string()), pa.field(\"status_taxonomy\", pa.string()), pa.field(\"status_metadata_temporal\", pa.string()), pa.field(\"duplicate_type\", pa.string()), pa.field(\"record_routing_status\", pa.string()), pa.field(\"Invalid_Reasons\", pa.string())]:\n",
    "    if vf.name not in sch_names: val_sch = val_sch.append(vf); sch_names.add(vf.name) # Tambahkan 10 kolom validasi & routing Tahap 4-5\n",
    "ord_cols = [f.name for f in val_sch] # Daftar urutan kolom skema output\n",
    "cw, qw = pq.ParquetWriter(CLEAN_PQ, val_sch, compression=\"snappy\"), pq.ParquetWriter(QUAR_PQ, val_sch, compression=\"snappy\") # Writer Clean & Quarantine\n",
    "\n",
    "n_val = n_clean_set = n_clean_only = 0; seen_ex, seen_occ, seen_cat = set(), set(), set() # Counter total baris & himpunan hash keunikan\n",
    "dim_cnt = {l: Counter() for l, _ in DIM_COLS}; mand_miss = Counter({c: 0 for c in MAND_9}) # Counter status per dimensi & atribut wajib\n",
    "sp_det_cnt, vmt_det_cnt = Counter(), Counter() # Counter rincian sub-kategori spasial & metadata-temporal\n",
    "dup_brk = Counter({\"UNIQUE\": 0, \"DUP_EXACT\": 0, \"DUP_OCCURRENCE_ID\": 0, \"DUP_CATALOG\": 0}) # Counter jenis duplikasi berprioritas\n",
    "dup_rul = Counter({\"dup_exact_non_null\": 0, \"dup_occurrenceID\": 0, \"dup_catalog\": 0, \"dup_union_total\": 0}) # Counter masing-masing aturan duplikasi\n",
    "rout_cnt, inv_rsn_cnt, inv_dim_cnt = Counter({\"Clean\": 0, \"Warning\": 0, \"Quarantine\": 0}), Counter(), Counter() # Counter hasil routing & alasan karantina\n",
    "cs_val = Counter({\"L\": 0, \"U\": 0, \"VS\": 0, \"TRT\": 0, \"VMT_strict\": 0, \"VMT_with_warning\": 0}) # Counter record valid di dalam Clean Set\n",
    "\n",
    "for b_idx, batch in enumerate(pf_n.iter_batches(batch_size=CHUNK), start=1): # Loop utama evaluasi 5 dimensi & routing per 100.000 baris\n",
    "    d = batch.to_pandas(); nb = len(d); n_val += nb; m_mand = pd.Series(False, index=d.index) # Konversi batch ke DataFrame Pandas\n",
    "    for mc in MAND_9: # 1. Dimensi Kelengkapan (L - Tabel 2.7 & Persamaan 2.2: pemeriksaan 9 atribut wajib)\n",
    "        cc = \"verbatimEventDateRaw\" if mc == \"eventDate\" else mc # Untuk eventDate, periksa ketersediaan tanggal asli (termasuk tanggal parsial)\n",
    "        cm = d[cc].isna() if mc in (\"decimalLatitude\", \"decimalLongitude\") else (d[cc].isna() | (d[cc].astype(\"string\").str.strip() == \"\")) # Cek NULL/kosong\n",
    "        mand_miss[mc] += int(cm.sum()); m_mand |= cm # Akumulasi jumlah kosong per atribut & gabungkan masker ketidaklengkapan baris\n",
    "    d[\"status_completeness\"] = pd.Series(np.where(m_mand, \"INVALID\", \"VALID\"), index=d.index, dtype=\"string\") # Tetapkan status dimensi L\n",
    "\n",
    "    tk_s = d[\"acceptedTaxonKey\"].fillna(d[\"taxonKey\"]).astype(\"string\").str.strip() # 2. Dimensi Keunikan (U - Tabel 2.8 & Persamaan 2.3)\n",
    "    ed_s = d[\"eventDate\"].fillna(d[\"verbatimEventDateRaw\"]).astype(\"string\").str.strip() # Kunci tanggal observasi\n",
    "    rc_s, pb_s = d[\"recordedBy\"].astype(\"string\").str.strip(), d[\"publisher\"].astype(\"string\").str.strip() # Kunci pengamat & penerbit\n",
    "    ex_ok = (tk_s.notna() & (tk_s != \"\") & d[\"decimalLatitude\"].notna() & d[\"decimalLongitude\"].notna() & ed_s.notna() & (ed_s != \"\") & rc_s.notna() & (rc_s != \"\") & pb_s.notna() & (pb_s != \"\")).to_numpy() # Masker 6 kolom eksak lengkap\n",
    "    ex_h = pd.util.hash_pandas_object(pd.DataFrame({\"tk\": tk_s.fillna(\"\"), \"la\": d[\"decimalLatitude\"].astype(\"string\").fillna(\"\"), \"lo\": d[\"decimalLongitude\"].astype(\"string\").fillna(\"\"), \"ed\": ed_s.fillna(\"\"), \"rc\": rc_s.fillna(\"\"), \"pb\": pb_s.fillna(\"\")}), index=False).to_numpy() # Hash 6 kolom\n",
    "    oc_v = d[\"occurrenceID\"].astype(\"string\").str.strip(); oc_ok = (oc_v.notna() & (oc_v != \"\")).to_numpy() # Masker occurrenceID terisi\n",
    "    oc_h = pd.util.hash_pandas_object(oc_v.fillna(\"\"), index=False).to_numpy() # Hash occurrenceID\n",
    "    ct_ok = (d[\"institutionCode\"].notna() & (d[\"institutionCode\"].astype(\"string\").str.strip() != \"\") & d[\"collectionCode\"].notna() & (d[\"collectionCode\"].astype(\"string\").str.strip() != \"\") & d[\"catalogNumber\"].notna() & (d[\"catalogNumber\"].astype(\"string\").str.strip() != \"\")).to_numpy() # Masker triplet katalog lengkap\n",
    "    ct_h = pd.util.hash_pandas_object(d[[\"institutionCode\", \"collectionCode\", \"catalogNumber\"]].astype(\"string\").fillna(\"\"), index=False).to_numpy() # Hash katalog\n",
    "    d_ex, d_oc, d_ct = flag_dups(ex_h, ex_ok, seen_ex), flag_dups(oc_h, oc_ok, seen_occ), flag_dups(ct_h, ct_ok, seen_cat) # Deteksi 3 aturan duplikasi\n",
    "    d_any = d_ex | d_oc | d_ct; dup_rul[\"dup_exact_non_null\"] += int(d_ex.sum()); dup_rul[\"dup_occurrenceID\"] += int(d_oc.sum()); dup_rul[\"dup_catalog\"] += int(d_ct.sum()); dup_rul[\"dup_union_total\"] += int(d_any.sum())\n",
    "    dt_arr = np.select([d_ex, d_oc, d_ct], [\"DUP_EXACT\", \"DUP_OCCURRENCE_ID\", \"DUP_CATALOG\"], default=\"UNIQUE\") # Label tipe duplikat berprioritas\n",
    "    d[\"duplicate_type\"] = pd.Series(dt_arr, index=d.index, dtype=\"string\"); d[\"status_uniqueness\"] = pd.Series(np.where(dt_arr == \"UNIQUE\", \"VALID\", \"INVALID\"), index=d.index, dtype=\"string\")\n",
    "    dup_brk.update(d[\"duplicate_type\"].value_counts().to_dict()) # Update frekuensi kategori keunikan\n",
    "\n",
    "    pr_sp, l_cls = d[\"spatialPreliminaryStatus\"].fillna(\"NO_COORD\").astype(str).to_numpy(), d[\"spatialLandClass\"].fillna(\"NO_COORD\").astype(str).to_numpy() # 3. Dimensi Validitas Spasial (VS)\n",
    "    hb_st, g_iss = d[\"spatialHabitatStatus\"].fillna(\"NOT_REQUIRED\").astype(str).to_numpy(), d[\"hasGeospatialIssues\"].fillna(False).to_numpy(dtype=bool)\n",
    "    nd_ck = pr_sp == \"NEEDS_HABITAT_CHECK\" # Titik di luar daratan & > 1 km dari pantai yang telah diuji cKDTree habitat pada Tahap 3\n",
    "    sp_det = np.select([pr_sp == \"NO_COORD\", l_cls == \"OUTSIDE_BBOX\", g_iss, pr_sp == \"CLEAN_LAND\", pr_sp == \"CLEAN_COASTAL_TOLERANCE\", nd_ck & (hb_st == \"SUPPORTED\"), nd_ck & (hb_st == \"UNVERIFIABLE_TAXON\"), nd_ck & (hb_st == \"ANOMALY\")], [\"INVALID_NO_COORD\", \"INVALID_OUTSIDE_BBOX\", \"INVALID_GEOSPATIAL_ISSUE\", \"VALID_CLEAN_LAND\", \"VALID_COASTAL_TOLERANCE_LE_1KM\", \"VALID_HABITAT_SUPPORTED_GT_1KM\", \"INVALID_UNVERIFIABLE_TAXON\", \"INVALID_HABITAT_ANOMALY\"], default=\"INVALID_HABITAT_ANOMALY\") # Klasifikasi 8 detail spasial\n",
    "    sp_st = np.where(np.isin(sp_det, [\"VALID_CLEAN_LAND\", \"VALID_COASTAL_TOLERANCE_LE_1KM\", \"VALID_HABITAT_SUPPORTED_GT_1KM\"]), \"VALID\", \"INVALID\") # Status dimensi VS\n",
    "    d[\"spatial_validation_detail\"], d[\"status_spatial\"] = pd.Series(sp_det, index=d.index, dtype=\"string\"), pd.Series(sp_st, index=d.index, dtype=\"string\")\n",
    "    sp_det_cnt.update(d[\"spatial_validation_detail\"].value_counts().to_dict()) # Update counter rincian spasial-habitat\n",
    "\n",
    "    d[\"status_taxonomy\"] = pd.Series(np.where(d[\"taxonomyValidationStatus\"].fillna(\"INVALID\") == \"VALID\", \"VALID\", \"INVALID\"), index=d.index, dtype=\"string\") # 4. Dimensi Resolusi Taksonomi (TRT)\n",
    "\n",
    "    bor_inv = (d[\"basisOfRecord\"].isna() | (d[\"basisOfRecord\"].astype(\"string\").str.strip() == \"\")).to_numpy(dtype=bool) # 5. Dimensi Metadata & Temporal (VMT)\n",
    "    ed_st, ed_p = d[\"eventDateParseStatus\"].fillna(\"MISSING\").astype(str).to_numpy(), d[\"eventDateParsed\"] # Status parsing & objek tanggal\n",
    "    ed_fut = (ed_p.notna() & (ed_p > EXT_DATE)).to_numpy(dtype=bool) | (ed_st == \"INVALID_FUTURE_DATE\") # Cek tanggal observasi di masa depan\n",
    "    ed_bad = np.isin(ed_st, [\"MISSING\", \"INVALID_UNPARSEABLE\"]); vmt_inv = bor_inv | ed_bad | ed_fut # Syarat mutlak VMT INVALID\n",
    "    ed_dt = pd.to_datetime(d[\"eventDate\"], format=\"%Y-%m-%d\", errors=\"coerce\") # Konversi tanggal ISO untuk cek kesesuaian year & month\n",
    "    yr_mis = (d[\"year\"].notna() & ed_dt.notna() & (d[\"year\"] != ed_dt.dt.year)).to_numpy(dtype=bool) # Ketidaksesuaian kolom year\n",
    "    mn_mis = (d[\"month\"].notna() & ed_dt.notna() & (d[\"month\"] != ed_dt.dt.month)).to_numpy(dtype=bool) # Ketidaksesuaian kolom month\n",
    "    pb_mis = (d[\"publisher\"].isna() | (d[\"publisher\"].astype(\"string\").str.strip() == \"\")).to_numpy(dtype=bool) # Kolom publisher kosong\n",
    "    ed_prt, ed_amb = (ed_st == \"WARNING_PARTIAL_OR_INTERVAL\"), (ed_st == \"WARNING_AMBIGUOUS\") # Tanggal parsial/interval atau slash ambigu\n",
    "    vmt_wrn = (~vmt_inv) & (ed_prt | ed_amb | yr_mis | mn_mis | pb_mis) # Syarat VMT WARNING (masih layak masuk Clean Set)\n",
    "    vmt_det = np.select([bor_inv, ed_fut, ed_bad, ed_prt, ed_amb, yr_mis | mn_mis, pb_mis], [\"INVALID_MISSING_BASIS_OF_RECORD\", \"INVALID_FUTURE_DATE\", \"INVALID_MISSING_OR_UNPARSEABLE_DATE\", \"WARNING_PARTIAL_OR_INTERVAL_DATE\", \"WARNING_AMBIGUOUS_SLASH_DATE\", \"WARNING_YEAR_MONTH_MISMATCH\", \"WARNING_MISSING_PUBLISHER\"], default=\"VALID_ISO_AND_METADATA\") # Rincian Tabel 2.9\n",
    "    d[\"vmt_validation_detail\"] = pd.Series(vmt_det, index=d.index, dtype=\"string\")\n",
    "    d[\"status_metadata_temporal\"] = pd.Series(np.select([vmt_inv, vmt_wrn], [\"INVALID\", \"WARNING\"], default=\"VALID\"), index=d.index, dtype=\"string\")\n",
    "    vmt_det_cnt.update(d[\"vmt_validation_detail\"].value_counts().to_dict()) # Update counter rincian VMT\n",
    "\n",
    "    st_df = d[ST_COLS]; inv_m, wrn_m = (st_df == \"INVALID\").to_numpy(dtype=bool), (st_df == \"WARNING\").to_numpy(dtype=bool) # Matriks keputusan Routing Tahap 5\n",
    "    any_inv = inv_m.any(axis=1); any_wrn = (~any_inv) & wrn_m.any(axis=1) # Quarantine jika ada minimal 1 dimensi INVALID\n",
    "    d[\"record_routing_status\"] = pd.Series(np.select([any_inv, any_wrn], [\"Quarantine\", \"Warning\"], default=\"Clean\"), index=d.index, dtype=\"string\")\n",
    "    rsn_arr = np.full(nb, None, dtype=object) # Array penampung string alasan karantina (misal \"Completeness;Taxonomy\")\n",
    "    for i in np.flatnonzero(any_inv): # Catat kombinasi dimensi penyebab INVALID pada setiap baris Quarantine\n",
    "        d_inv = DIM_LBLS[inv_m[i]]; rsn_arr[i] = \";\".join(d_inv)\n",
    "        for dl in d_inv: inv_dim_cnt[dl] += 1 # Hitung kontribusi masing-masing dimensi terhadap total Quarantine\n",
    "    d[\"Invalid_Reasons\"] = pd.Series(rsn_arr, index=d.index, dtype=\"string\")\n",
    "    for dl, cs in DIM_COLS: dim_cnt[dl].update(d[cs].value_counts().to_dict()) # Akumulasi status 5 dimensi\n",
    "    rout_cnt.update(d[\"record_routing_status\"].value_counts().to_dict()); inv_rsn_cnt.update(d[\"Invalid_Reasons\"].dropna().value_counts().to_dict())\n",
    "\n",
    "    df_c, df_q = d[d[\"record_routing_status\"].isin([\"Clean\", \"Warning\"])][ord_cols], d[d[\"record_routing_status\"] == \"Quarantine\"][ord_cols] # Pisahkan Clean Set vs Quarantine\n",
    "    n_clean_set += len(df_c); n_clean_only += int((d[\"record_routing_status\"] == \"Clean\").sum())\n",
    "    if len(df_c) > 0: # Hitung metrik kualitas sesudah ETL pada Clean Set dan tulis ke clean_set_aves_indonesia.parquet\n",
    "        cs_val[\"L\"] += int((df_c[\"status_completeness\"] == \"VALID\").sum()); cs_val[\"U\"] += int((df_c[\"status_uniqueness\"] == \"VALID\").sum())\n",
    "        cs_val[\"VS\"] += int((df_c[\"status_spatial\"] == \"VALID\").sum()); cs_val[\"TRT\"] += int((df_c[\"status_taxonomy\"] == \"VALID\").sum())\n",
    "        cs_val[\"VMT_strict\"] += int((df_c[\"status_metadata_temporal\"] == \"VALID\").sum()); cs_val[\"VMT_with_warning\"] += int((df_c[\"status_metadata_temporal\"] != \"INVALID\").sum())\n",
    "        cw.write_table(pa.Table.from_pandas(df_c, schema=val_sch, preserve_index=False))\n",
    "    if len(df_q) > 0: qw.write_table(pa.Table.from_pandas(df_q, schema=val_sch, preserve_index=False)) # Tulis baris gagal ke quarantine_store_aves_indonesia.parquet\n",
    "    print(f\"  [Batch {b_idx:02d}] {n_val:,} record selesai divalidasi & di-routing...\")\n",
    "cw.close(); qw.close() # Tutup kedua penulis Parquet\n",
    "\n",
    "val_rows = [{\"Dimensi_Kualitas\": dn, \"Valid\": int(cd.get(\"VALID\", 0)), \"Valid (%)\": round(int(cd.get(\"VALID\", 0)) / n_val * 100, 4), \"Warning\": int(cd.get(\"WARNING\", 0)), \"Warning (%)\": round(int(cd.get(\"WARNING\", 0)) / n_val * 100, 4), \"Invalid\": int(cd.get(\"INVALID\", 0)), \"Invalid (%)\": round(int(cd.get(\"INVALID\", 0)) / n_val * 100, 4)} for dn, cd in dim_cnt.items()] # Rekap 5 dimensi\n",
    "pd.DataFrame(val_rows).to_csv(OUT_DIR / \"04_rekapitulasi_validasi_5_dimensi.csv\", index=False) # Simpan CSV rekapitulasi 5 dimensi\n",
    "comp_rows = [{\"No\": i, \"Atribut_Wajib_Tabel_2_7\": mc, \"Jumlah_Terisi\": n_val - int(mand_miss[mc]), \"Persentase_Terisi (%)\": round((n_val - int(mand_miss[mc])) / n_val * 100, 4), \"Jumlah_Kosong_NULL\": int(mand_miss[mc]), \"Persentase_Kosong (%)\": round(int(mand_miss[mc]) / n_val * 100, 4)} for i, mc in enumerate(MAND_9, 1)] # Rincian Tabel 2.7\n",
    "pd.DataFrame(comp_rows).to_csv(OUT_DIR / \"04_rincian_kelengkapan_9_atribut_wajib.csv\", index=False) # Simpan CSV kelengkapan 9 atribut wajib\n",
    "\n",
    "dup_info = [(\"UNIQUE\", \"VALID\", \"Record unik (kemunculan pertama/asli)\", int(dup_brk[\"UNIQUE\"])), (\"DUP_EXACT\", \"INVALID\", \"Duplikasi eksak 6 atribut non-NULL (acceptedTaxonKey/taxonKey, lat, lon, eventDate, recordedBy, publisher)\", int(dup_brk[\"DUP_EXACT\"])), (\"DUP_OCCURRENCE_ID\", \"INVALID\", \"Duplikasi kunci occurrenceID (di luar duplikat eksak)\", int(dup_brk[\"DUP_OCCURRENCE_ID\"])), (\"DUP_CATALOG\", \"INVALID\", \"Duplikasi kombinasi institutionCode + collectionCode + catalogNumber (di luar eksak & occurrenceID)\", int(dup_brk[\"DUP_CATALOG\"]))]\n",
    "pd.DataFrame([{\"Kategori_Keunikan\": k, \"Status_Dimensi_U\": st, \"Keterangan\": ds, \"Jumlah_Record\": c, \"Proporsi (%)\": round(c / n_val * 100, 4)} for k, st, ds, c in dup_info]).to_csv(OUT_DIR / \"04_rincian_keunikan_duplikasi.csv\", index=False) # Simpan CSV rincian duplikasi\n",
    "\n",
    "sp_ord = [(\"VALID_CLEAN_LAND\", \"VALID\", \"Daratan Indonesia (CLEAN_LAND)\"), (\"VALID_COASTAL_TOLERANCE_LE_1KM\", \"VALID\", \"Luar Daratan <= 1 km dari Pantai (CLEAN_COASTAL_TOLERANCE)\"), (\"VALID_HABITAT_SUPPORTED_GT_1KM\", \"VALID\", \"Luar Daratan > 1 km & Habitat Spesies Sesuai (SUPPORTED)\"), (\"INVALID_HABITAT_ANOMALY\", \"INVALID\", \"Luar Daratan > 1 km & Anomali Habitat Spesies (ANOMALY)\"), (\"INVALID_UNVERIFIABLE_TAXON\", \"INVALID\", \"Luar Daratan > 1 km & Takson Tidak Terverifikasi (UNVERIFIABLE_TAXON)\"), (\"INVALID_GEOSPATIAL_ISSUE\", \"INVALID\", \"Memiliki Flag Isu Geospasial GBIF (hasGeospatialIssues=True)\"), (\"INVALID_OUTSIDE_BBOX\", \"INVALID\", \"Koordinat di Luar Bounding Box Indonesia\"), (\"INVALID_NO_COORD\", \"INVALID\", \"Koordinat Kosong atau (0, 0)\")]\n",
    "sp_rows = [{\"Kategori_Detail_Spasial\": k, \"Status_Dimensi_VS\": st, \"Keterangan\": ds, \"Jumlah_Record\": int(sp_det_cnt.get(k, 0)), \"Proporsi (%)\": round(int(sp_det_cnt.get(k, 0)) / n_val * 100, 4)} for k, st, ds in sp_ord]\n",
    "pd.DataFrame(sp_rows).to_csv(OUT_DIR / \"04_rincian_validasi_spasial_habitat.csv\", index=False) # Simpan CSV rincian spasial-habitat\n",
    "\n",
    "vmt_ord = [(\"VALID_ISO_AND_METADATA\", \"VALID\", \"Tanggal ISO 8601 valid, konsisten dengan year/month, serta basisOfRecord & publisher terisi\"), (\"WARNING_PARTIAL_OR_INTERVAL_DATE\", \"WARNING\", \"Tanggal parsial (YYYY / YYYY-MM) atau interval tanggal (verbatimEventDateRaw dipertahankan)\"), (\"WARNING_AMBIGUOUS_SLASH_DATE\", \"WARNING\", \"Tanggal format garis miring ambigu DD/MM vs MM/DD\"), (\"WARNING_YEAR_MONTH_MISMATCH\", \"WARNING\", \"Ketidaksesuaian nilai kolom year/month terhadap tanggal eventDate\"), (\"WARNING_MISSING_PUBLISHER\", \"WARNING\", \"Atribut publisher kosong meskipun tanggal dan basisOfRecord valid\"), (\"INVALID_MISSING_OR_UNPARSEABLE_DATE\", \"INVALID\", \"Tanggal eventDate kosong atau tidak dapat dikenali\"), (\"INVALID_FUTURE_DATE\", \"INVALID\", \"Tanggal observasi melebihi tanggal ekstraksi dataset\"), (\"INVALID_MISSING_BASIS_OF_RECORD\", \"INVALID\", \"Atribut basisOfRecord kosong\")]\n",
    "vmt_rows = [{\"Kategori_Detail_VMT\": k, \"Status_Dimensi_VMT\": st, \"Keterangan\": ds, \"Jumlah_Record\": int(vmt_det_cnt.get(k, 0)), \"Proporsi (%)\": round(int(vmt_det_cnt.get(k, 0)) / n_val * 100, 4)} for k, st, ds in vmt_ord]\n",
    "pd.DataFrame(vmt_rows).to_csv(OUT_DIR / \"04_rincian_validasi_metadata_temporal.csv\", index=False) # Simpan CSV rincian VMT\n",
    "\n",
    "rout_rows = [{\"Status_Akhir_Record\": rs, \"Target_Penyimpanan\": \"Clean Set (DuckDB & Parquet)\" if rs in [\"Clean\", \"Warning\"] else \"Quarantine Store (DuckDB & Parquet)\", \"Jumlah_Record\": int(rout_cnt.get(rs, 0)), \"Proporsi (%)\": round(int(rout_cnt.get(rs, 0)) / n_val * 100, 4)} for rs in [\"Clean\", \"Warning\", \"Quarantine\"]]\n",
    "pd.DataFrame(rout_rows).to_csv(OUT_DIR / \"05_rekapitulasi_routing_record.csv\", index=False) # Simpan CSV rekapitulasi routing Tahap 5\n",
    "n_quar = int(rout_cnt.get(\"Quarantine\", 0))\n",
    "quar_rows = [{\"No\": i, \"Kombinasi_Invalid_Reasons\": rc, \"Jumlah_Record\": int(c), \"Proporsi_terhadap_Quarantine (%)\": round(c / n_quar * 100, 4) if n_quar else 0.0, \"Proporsi_terhadap_Total_Dataset (%)\": round(c / n_val * 100, 4)} for i, (rc, c) in enumerate(inv_rsn_cnt.most_common(), 1)]\n",
    "pd.DataFrame(quar_rows).to_csv(OUT_DIR / \"05_rincian_alasan_quarantine.csv\", index=False) # Simpan CSV rincian kombinasi alasan Quarantine\n",
    "\n",
    "t1_d = json.loads(T1_REP.read_text(encoding=\"utf-8\")) if T1_REP.exists() else {}; t1_m, t1_tot = t1_d.get(\"baseline_metrics\", {}), t1_d.get(\"total_records\") # Muat baseline Tahap 1\n",
    "t3_d = json.loads(T3_REP.read_text(encoding=\"utf-8\")) if T3_REP.exists() else {} # Muat laporan taksonomi Tahap 3\n",
    "L_bef = float(t1_m.get(\"L\") or (dim_cnt[\"Completeness\"][\"VALID\"] / n_val * 100)); U_bef = float(t1_m.get(\"U\") or (dim_cnt[\"Uniqueness\"][\"VALID\"] / n_val * 100))\n",
    "VS_bef = float(t1_m.get(\"VS\") or 0.0); VMT_bef = float(t1_m.get(\"VMT\") or (dim_cnt[\"Metadata_Temporal\"][\"VALID\"] / n_val * 100))\n",
    "TRT_bef = (float(t3_d[\"n_accepted\"]) / n_val * 100.0) if (TRT_MODE == \"ACCEPTED_ONLY\" and t3_d.get(\"n_accepted\") is not None) else float(t3_d.get(\"TRT_baseline_eq_2_5_pct\") or t1_m.get(\"TRT\") or (dim_cnt[\"Taxonomy\"][\"VALID\"] / n_val * 100))\n",
    "L_aft, U_aft, VS_aft, TRT_aft, VMT_aft, VMT_str = [(cs_val[k] / n_clean_set * 100 if n_clean_set else 0.0) for k in (\"L\", \"U\", \"VS\", \"TRT\", \"VMT_with_warning\", \"VMT_strict\")] # Skor sesudah ETL\n",
    "\n",
    "delta_rows = [{\"Kode\": kd, \"Dimensi_Kualitas\": nm, \"Baseline_Sebelum_ETL (%)\": round(bf, 4), \"Sesudah_ETL_Clean_Set (%)\": round(af, 4), \"Kenaikan_Delta_X (%)\": round(af - bf, 4)} for kd, nm, bf, af in [(\"L\", \"Kelengkapan (Completeness)\", L_bef, L_aft), (\"U\", \"Keunikan (Uniqueness)\", U_bef, U_aft), (\"VS\", \"Validitas Spasial (Spatial Validity)\", VS_bef, VS_aft), (\"TRT\", \"Tingkat Resolusi Taksonomi (Catalogue of Life XR)\", TRT_bef, TRT_aft), (\"VMT\", \"Validitas Metadata & Temporal\", VMT_bef, VMT_aft)]] # Tabel Persamaan 2.7\n",
    "df_delta = pd.DataFrame(delta_rows); df_delta.to_csv(OUT_DIR / \"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\", index=False) # Simpan CSV perbandingan Delta X\n",
    "\n",
    "(OUT_DIR / \"04_05_validation_and_routing_report.json\").write_text(json.dumps({\"total_records_validated\": int(n_val), \"clean_set_records\": int(n_clean_set), \"clean_only_records\": int(n_clean_only), \"warning_records_in_clean_set\": int(rout_cnt.get(\"Warning\", 0)), \"quarantine_records\": int(n_quar), \"retention_rate_pct\": round(n_clean_set / n_val * 100, 4), \"trt_baseline_mode\": TRT_MODE, \"dimension_status_breakdown\": val_rows, \"completeness_9_mandatory_breakdown\": comp_rows, \"duplicate_breakdown\": {k: int(v) for k, v in dup_brk.items()}, \"duplicate_rule_totals\": {k: int(v) for k, v in dup_rul.items()}, \"spatial_habitat_detail_breakdown\": sp_rows, \"vmt_detail_breakdown\": vmt_rows, \"routing_summary\": rout_rows, \"invalid_records_by_single_dimension\": {k: int(v) for k, v in inv_dim_cnt.items()}, \"top_invalid_reasons_combinations\": dict(inv_rsn_cnt.most_common(15)), \"before_vs_after_comparison_eq_2_7\": delta_rows, \"clean_set_post_etl_metrics\": {\"L_after\": round(L_aft, 4), \"U_after\": round(U_aft, 4), \"VS_after\": round(VS_aft, 4), \"TRT_after\": round(TRT_aft, 4), \"VMT_after\": round(VMT_aft, 4), \"VMT_after_strict_iso\": round(VMT_str, 4)}, \"consistency_checks\": {\"tahap1_total_records\": t1_tot, \"tahap3_total_records\": t3_d.get(\"total_records\"), \"tahap4_5_total_records\": int(n_val), \"clean_plus_quarantine_equals_total\": (n_clean_set + n_quar) == n_val}}, indent=2, default=str), encoding=\"utf-8\") # Simpan JSON laporan Tahap 4 & 5\n",
    "print(f\"\\n[TAHAP 4 & 5 SELESAI] Total: {n_val:,} | Clean Set: {n_clean_set:,} ({n_clean_set / n_val * 100:.2f}%) | Quarantine: {n_quar:,} ({n_quar / n_val * 100:.2f}%)\")\n",
    "print(df_delta.to_string(index=False)) # Tampilkan tabel perbandingan Delta X di konsol\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(21, 6)); x_i, w = np.arange(len(df_delta)), 0.36 # Plot grafik 3 panel Tahap 4 & 5\n",
    "b1 = axes[0].bar(x_i - w / 2, df_delta[\"Baseline_Sebelum_ETL (%)\"], w, label=\"Sebelum ETL (Baseline)\", color=\"#e76f51\")\n",
    "b2 = axes[0].bar(x_i + w / 2, df_delta[\"Sesudah_ETL_Clean_Set (%)\"], w, label=\"Sesudah ETL (Clean Set)\", color=\"#2a9d8f\")\n",
    "for brs in (b1, b2):\n",
    "    for b in brs: v = b.get_height(); axes[0].text(b.get_x() + b.get_width() / 2, v + 0.8, f\"{v:.2f}%\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
    "axes[0].set_xticks(x_i); axes[0].set_xticklabels(df_delta[\"Kode\"], fontsize=9); axes[0].set_ylim(0, 115); axes[0].set_title(\"Perbandingan Skor 5 Dimensi Sebelum vs Sesudah ETL\"); axes[0].legend(fontsize=8.5, loc=\"lower right\")\n",
    "r_l, r_v = [\"Clean\", \"Warning\", \"Quarantine\"], [int(rout_cnt.get(k, 0)) for k in [\"Clean\", \"Warning\", \"Quarantine\"]]; bars = axes[1].bar(r_l, r_v, color=[\"#2a9d8f\", \"#e9c46a\", \"#d62828\"])\n",
    "for b, v in zip(bars, r_v): axes[1].text(b.get_x() + b.get_width() / 2, v, f\"{v:,}\\n({(v / n_val * 100) if n_val else 0:.2f}%)\", ha=\"center\", va=\"bottom\", fontsize=8.5)\n",
    "axes[1].set_ylim(0, max(r_v) * 1.25 if max(r_v) > 0 else 1); axes[1].set_title(f\"Hasil Routing Data Tahap 5 (Retensi Clean Set: {n_clean_set / n_val * 100:.2f}%)\")\n",
    "d_ord = [\"Taxonomy\", \"Uniqueness\", \"Spatial\", \"Completeness\", \"Metadata_Temporal\"]; iv_v, yp = [int(inv_dim_cnt.get(d, 0)) for d in d_ord], np.arange(len(d_ord))\n",
    "axes[2].barh(yp, iv_v, color=\"#e76f51\"); axes[2].set_yticks(yp); axes[2].set_yticklabels(d_ord, fontsize=8.5); axes[2].invert_yaxis(); axes[2].set_xlim(0, max(iv_v) * 1.42 if max(iv_v) > 0 else 1); axes[2].set_title(\"Kontribusi Dimensi Penyebab Quarantine\")\n",
    "for y_i, v in zip(yp, iv_v): axes[2].text(v, y_i, f\" {v:,} ({(v / n_quar * 100) if n_quar else 0.0:.1f}% dr Quarantine)\", va=\"center\", fontsize=8)\n",
    "plt.tight_layout(); plt.savefig(OUT_DIR / \"04_05_grafik_validasi_dan_routing.png\", dpi=200); plt.show() # Simpan PNG grafik Tahap 4 & 5"
   ]
