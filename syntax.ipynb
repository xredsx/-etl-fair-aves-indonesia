    "    and \"data_dictionary\" in existing_clean_tables\n",
    ")\n",
    "s_I2 = 1.0 if has_i2 else 0.0\n",
    "bukti_I2 = (\n",
    "    f\"Menggunakan istilah baku Darwin Core ({len(dwc_present_in_clean)} atribut aktif + {len(merged_dwc_names)} atribut identik yang disatukan) \"\n",
    "    f\"serta kosakata taksonomi terkendali Catalogue of Life eXtended Release (taxonKey & acceptedTaxonKey COL XR, scientificName berstatus ACCEPTED).\"\n",
    ")\n",
    "\n",
    "taxon_key_ratio = qref_stats[0] / n_clean_total if n_clean_total else 0.0\n",
    "dataset_key_ratio = qref_stats[1] / n_clean_total if n_clean_total else 0.0\n",
    "s_I3 = round((taxon_key_ratio + dataset_key_ratio) / 2.0, 4)\n",
    "bukti_I3 = (\n",
    "    f\"Memiliki referensi eksternal bermakna pada level record: taxonKey terisi {qref_stats[0]:,}/{n_clean_total:,} \"\n",
    "    f\"({taxon_key_ratio * 100:.2f}%) menuju Catalogue of Life (COL XR) dan datasetKey terisi {qref_stats[1]:,}/{n_clean_total:,} \"\n",
    "    f\"({dataset_key_ratio * 100:.2f}%) menuju sumber dataset GBIF.\"\n",
    ")\n",
    "\n",
    "# --- REUSABLE (R) ---\n",
