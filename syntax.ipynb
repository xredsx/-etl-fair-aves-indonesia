   "source": [
    "# TAHAP 7: EVALUASI KUALITAS DATA SEBELUM-SESUDAH ETL (DELTA X),\n",
    "# EVALUASI OTOMATIS KEPATUHAN FAIR (12 INDIKATOR - TABEL 2.10),\n",
    "# DETEKSI OTOMATIS UPLOAD GITHUB, & TAMPILAN BUKTI FISIK (UNTUK BAB IV SKRIPSI)\n",
    "import gc\n",
    "import hashlib\n",
    "import json\n",
    "import subprocess\n",
    "import sys\n",
    "import urllib.error\n",
    "import urllib.request\n",
    "from datetime import datetime\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "try:\n",
    "    import duckdb\n",
    "except ImportError:\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"duckdb\", \"-q\"])\n",
    "    import duckdb\n",
    "try:\n",
    "    import pyarrow.parquet as pq\n",
    "except ImportError:\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"pyarrow\", \"-q\"])\n",
    "    import pyarrow.parquet as pq\n",
    "try:\n",
    "    from IPython.display import display\n",
    "except ImportError:\n",
    "    def display(obj):\n",
    "        print(obj.to_string(index=False) if isinstance(obj, pd.DataFrame) else obj)\n",
    "# Bersihkan koneksi DuckDB yang masih menggantung di sesi Jupyter Notebook\n",
    "for _name, _val in list(globals().items()):\n",
    "    if isinstance(_val, duckdb.DuckDBPyConnection):\n",
    "        try:\n",
    "            _val.close()\n",
    "        except Exception:\n",
    "            pass\n",
    "for _obj in gc.get_objects():\n",
    "    try:\n",
    "        if isinstance(_obj, duckdb.DuckDBPyConnection):\n",
    "            _obj.close()\n",
    "    except Exception:\n",
    "        pass\n",
    "# 1. KONFIGURASI DIREKTORI & DETEKSI GITHUB / PERSISTENT IDENTIFIER\n",
    "OUTPUT_DIR = r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"\n",
    "# Opsional: Isi manual URL repositori GitHub / Zenodo Anda jika folder lokal bukan repo git.\n",
    "# Jika dikosongkan (\"\"), skrip akan otomatis mendeteksi dari konfigurasi .git lokal.\n",
    "GITHUB_REPO_URL_MANUAL = \"\"\n",
    "PERSISTENT_DOI_OR_PID_MANUAL = \"\"   # Contoh: \"https://doi.org/10.5281/zenodo.xxxxxxx\" bila ada\n",
    "COL_CHECKLIST_KEY = \"7ddf754f-d193-4cc9-b351-99906754a03b\"\n",
    "out_dir = Path(OUTPUT_DIR)\n",
    "db_dir = out_dir / \"db\"\n",
    "final_parquet_dir = out_dir / \"final_parquet\"\n",
    "CLEAN_DB_PATH = db_dir / \"clean_store_aves_indonesia.duckdb\"\n",
    "QUARANTINE_DB_PATH = db_dir / \"quarantine_store_aves_indonesia.duckdb\"\n",
    "CLEAN_TABLE = \"occurrence_clean\"\n",
    "QUARANTINE_TABLE = \"occurrence_quarantine\"\n",
    "CLEAN_PARQUET_FINAL = final_parquet_dir / f\"{CLEAN_TABLE}.parquet\"\n",
    "QUARANTINE_PARQUET_FINAL = final_parquet_dir / f\"{QUARANTINE_TABLE}.parquet\"\n",
    "METADATA_JSON_PATH = out_dir / \"07_dataset_metadata_fair.json\"\n",
    "STAGE_3_REPORT_PATH = out_dir / \"03_taxonomic_normalization_report.json\"\n",
    "STAGE_4_5_REPORT_PATH = out_dir / \"04_05_validation_and_routing_report.json\"\n",
    "STAGE_5_DELTA_CSV_PATH = out_dir / \"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\"\n",
    "STAGE_6_REPORT_PATH = out_dir / \"06_duckdb_load_report.json\"\n",
    "for _p in (CLEAN_DB_PATH, QUARANTINE_DB_PATH, CLEAN_PARQUET_FINAL):\n",
    "    if not _p.exists():\n",
    "        raise FileNotFoundError(\n",
    "            f\"File {_p} belum ditemukan. Pastikan skrip Tahap 6 sudah dijalankan.\"\n",
    "        )\n",
    "def open_db(db_path: Path):\n",
    "    \"\"\"Buka koneksi DuckDB tanpa konflik konfigurasi di Jupyter Notebook.\"\"\"\n",
    "    try:\n",
    "        return duckdb.connect(str(db_path), read_only=True)\n",
    "    except duckdb.ConnectionException:\n",
    "        return duckdb.connect(str(db_path), read_only=False)\n",
    "def run_sql(con, sql: str) -> list:\n",
    "    return con.execute(sql).fetchall()\n",
    "def fetch_one(con, sql: str):\n",
    "    return run_sql(con, sql)[0]\n",
    "def query_df(con, sql: str) -> pd.DataFrame:\n",
    "    cur = con.execute(sql)\n",
    "    cols = [d[0] for d in cur.description]\n",
    "    rows = cur.fetchall()\n",
    "    return pd.DataFrame(rows, columns=cols)\n",
    "def compute_sha256(file_path: Path) -> str:\n",
    "    h = hashlib.sha256()\n",
    "    with open(file_path, \"rb\") as f:\n",
    "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
    "            h.update(chunk)\n",
    "    return h.hexdigest()\n",
    "# 2. FUNGSI DETEKSI OTOMATIS STATUS UPLOAD GITHUB & PROTOKOL HTTP/HTTPS\n",
    "def detect_github_upload_status(base_dir: Path, manual_url: str = \"\") -> dict:\n",
    "    \"\"\"\n",
    "    Mendeteksi secara otomatis apakah project/dataset sudah dihubungkan dan\n",
    "    diunggah (push) ke GitHub serta memverifikasi akses HTTP/HTTPS publiknya.\n",
    "    \"\"\"\n",
    "    result = {\n",
    "        \"git_repo_detected\": False,\n",
    "        \"git_root\": None,\n",
    "        \"remote_origin_url\": None,\n",
    "        \"github_https_url\": None,\n",
    "        \"github_owner_repo\": None,\n",
    "        \"local_commit_sha\": None,\n",
    "        \"pushed_to_remote\": False,\n",
    "        \"http_accessible\": False,\n",
    "        \"http_status_code\": None,\n",
    "        \"is_open_free_access\": False,\n",
    "        \"github_has_files_online\": False,\n",
    "        \"detection_method\": \"Belum terdeteksi\",\n",
    "        \"detail_message\": \"\",\n",
    "    }\n",
    "    search_dirs = [base_dir, base_dir.parent, base_dir.parent.parent, Path.cwd()]\n",
    "    git_dir = None\n",
    "    for d in search_dirs:\n",
    "        if d and (d / \".git\").exists():\n",
    "            git_dir = d\n",
    "            break\n",
    "    raw_url = manual_url.strip()\n",
    "    if git_dir:\n",
    "        result[\"git_repo_detected\"] = True\n",
    "        result[\"git_root\"] = str(git_dir)\n",
    "        try:\n",
    "            rem = subprocess.check_output(\n",
    "                [\"git\", \"-C\", str(git_dir), \"remote\", \"get-url\", \"origin\"],\n",
    "                stderr=subprocess.DEVNULL,\n",
    "                text=True,\n",
    "                timeout=5,\n",
    "            ).strip()\n",
    "            if rem and not raw_url:\n",
    "                raw_url = rem\n",
    "                result[\"detection_method\"] = f\"Otomatis dari .git ({git_dir})\"\n",
    "        except Exception:\n",
    "            pass\n",
    "        try:\n",
    "            sha = subprocess.check_output(\n",
    "                [\"git\", \"-C\", str(git_dir), \"rev-parse\", \"HEAD\"],\n",
    "                stderr=subprocess.DEVNULL,\n",
    "                text=True,\n",
    "                timeout=5,\n",
    "            ).strip()\n",
    "            result[\"local_commit_sha\"] = sha\n",
    "        except Exception:\n",
    "            pass\n",
    "        try:\n",
    "            remotes_branch = subprocess.check_output(\n",
    "                [\"git\", \"-C\", str(git_dir), \"branch\", \"-r\"],\n",
    "                stderr=subprocess.DEVNULL,\n",
    "                text=True,\n",
    "                timeout=5,\n",
    "            ).strip()\n",
    "            if remotes_branch:\n",
    "                result[\"pushed_to_remote\"] = True\n",
    "        except Exception:\n",
    "            pass\n",
    "    if manual_url.strip():\n",
    "        result[\"detection_method\"] = \"Input konfigurasi GITHUB_REPO_URL_MANUAL\"\n",
    "    if raw_url:\n",
    "        result[\"remote_origin_url\"] = raw_url\n",
    "        clean_url = raw_url\n",
    "        if clean_url.startswith(\"git@github.com:\"):\n",
    "            clean_url = \"https://github.com/\" + clean_url.split(\"git@github.com:\", 1)[1]\n",
    "        if clean_url.endswith(\".git\"):\n",
    "            clean_url = clean_url[:-4]\n",
    "        result[\"github_https_url\"] = clean_url\n",
    "        if \"github.com/\" in clean_url:\n",
    "            parts = clean_url.split(\"github.com/\", 1)[1].strip(\"/\").split(\"/\")\n",
    "            if len(parts) >= 2:\n",
    "                result[\"github_owner_repo\"] = f\"{parts[0]}/{parts[1]}\"\n",
    "    if result[\"github_owner_repo\"]:\n",
    "        api_url = f\"https://api.github.com/repos/{result['github_owner_repo']}\"\n",
    "        try:\n",
    "            req = urllib.request.Request(\n",
    "                api_url,\n",
    "                headers={\"User-Agent\": \"Skripsi-FAIR-Evaluator/1.0\"},\n",
    "            )\n",
    "            with urllib.request.urlopen(req, timeout=8) as resp:\n",
    "                status_code = resp.getcode()\n",
    "                repo_info = json.loads(resp.read().decode(\"utf-8\"))\n",
    "                result[\"http_accessible\"] = status_code == 200\n",
    "                result[\"http_status_code\"] = status_code\n",
    "                is_private = repo_info.get(\"private\", True)\n",
    "                result[\"is_open_free_access\"] = (status_code == 200) and (not is_private)\n",
    "                result[\"github_has_files_online\"] = repo_info.get(\"size\", 0) > 0\n",
    "                if result[\"github_has_files_online\"]:\n",
    "                    result[\"pushed_to_remote\"] = True\n",
    "        except urllib.error.HTTPError as e:\n",
    "            result[\"http_status_code\"] = e.code\n",
    "        except Exception:\n",
    "            pass\n",
    "    elif result[\"github_https_url\"] and result[\"github_https_url\"].startswith((\"http://\", \"https://\")):\n",
    "        try:\n",
    "            req = urllib.request.Request(\n",
    "                result[\"github_https_url\"],\n",
    "                headers={\"User-Agent\": \"Skripsi-FAIR-Evaluator/1.0\"},\n",
    "            )\n",
    "            with urllib.request.urlopen(req, timeout=8) as resp:\n",
    "                status_code = resp.getcode()\n",
    "                result[\"http_accessible\"] = status_code == 200\n",
    "                result[\"http_status_code\"] = status_code\n",
    "                result[\"is_open_free_access\"] = status_code == 200\n",
    "                result[\"github_has_files_online\"] = status_code == 200\n",
    "        except urllib.error.HTTPError as e:\n",
    "            result[\"http_status_code\"] = e.code\n",
    "        except Exception:\n",
    "            pass\n",
    "    if result[\"http_accessible\"] and result[\"github_has_files_online\"]:\n",
    "        result[\"detail_message\"] = (\n",
    "            f\"SUDAH DIUPLOAD KE GITHUB & PUBLIK ({result['github_https_url']} | HTTP {result['http_status_code']})\"\n",
    "        )\n",
    "    elif result[\"github_https_url\"] and result[\"pushed_to_remote\"]:\n",
    "        result[\"detail_message\"] = (\n",
    "            f\"Terdeteksi remote GitHub & branch remote ({result['github_https_url']}), \"\n",
    "            f\"status verifikasi HTTP: {result['http_status_code'] or 'Offline/Belum dicek'}\"\n",
    "        )\n",
    "    elif result[\"github_https_url\"]:\n",
    "        result[\"detail_message\"] = (\n",
    "            f\"Remote GitHub ditemukan ({result['github_https_url']}), namun belum terdeteksi push/publik (HTTP {result['http_status_code']})\"\n",
    "        )\n",
    "    else:\n",
    "        result[\"detail_message\"] = (\n",
    "            \"BELUM DIUPLOAD KE GITHUB (Tidak ditemukan remote .git GitHub maupun GITHUB_REPO_URL_MANUAL)\"\n",
    "        )\n",
    "    return result\n",
    "# 3. EKSTRAK METRIK AKTUAL DARI DUCKDB & PARQUET DAN BANGUN METADATA FAIR JSON\n",
    "github_status = detect_github_upload_status(out_dir, GITHUB_REPO_URL_MANUAL)\n",
    "con_clean = open_db(CLEAN_DB_PATH)\n",
    "con_quar = open_db(QUARANTINE_DB_PATH)\n",
    "try:\n",
    "    clean_cols_info = run_sql(con_clean, f'DESCRIBE SELECT * FROM \"{CLEAN_TABLE}\"')\n",
    "    clean_cols = [r[0] for r in clean_cols_info]\n",
    "    clean_col_set = set(clean_cols)\n",
    "    n_clean_total = fetch_one(con_clean, f'SELECT COUNT(*) FROM \"{CLEAN_TABLE}\"')[0]\n",
    "    n_quar_total = fetch_one(con_quar, f'SELECT COUNT(*) FROM \"{QUARANTINE_TABLE}\"')[0]\n",
    "    routing_dist = dict(\n",
    "        run_sql(con_clean, f'SELECT record_routing_status, COUNT(*) FROM \"{CLEAN_TABLE}\" GROUP BY 1')\n",
    "    )\n",
    "    year_expr = '\"year\"' if \"year\" in clean_col_set else 'EXTRACT(YEAR FROM \"eventDate\")'\n",
    "    spatial_temporal = fetch_one(\n",
    "        con_clean,\n",
    "        f\"\"\"\n",
    "        SELECT MIN(decimalLatitude), MAX(decimalLatitude),\n",
    "               MIN(decimalLongitude), MAX(decimalLongitude),\n",
    "               MIN(eventDate), MAX(eventDate),\n",
    "               MIN({year_expr}), MAX({year_expr}),\n",
    "               COUNT(DISTINCT scientificName),\n",
    "               COUNT(DISTINCT family),\n",
    "               COUNT(DISTINCT genus),\n",
    "               COUNT(DISTINCT stateProvince)\n",
    "        FROM \"{CLEAN_TABLE}\"\n",
    "        \"\"\",\n",
    "    )\n",
    "    # Statistik kelengkapan referensi terkualifikasi (I3) & lisensi (R1.1)\n",
    "    qref_stats = fetch_one(\n",
    "        con_clean,\n",
    "        f\"\"\"\n",
    "        SELECT COUNT(*) FILTER (WHERE taxonKey IS NOT NULL),\n",
    "               COUNT(*) FILTER (WHERE datasetKey IS NOT NULL),\n",
