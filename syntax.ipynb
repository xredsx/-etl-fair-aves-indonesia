    "CLEAN_TABLE = \"occurrence_clean\"\n",
    "QUARANTINE_TABLE = \"occurrence_quarantine\"\n",
    "CLEAN_PARQUET_FINAL = final_parquet_dir / f\"{CLEAN_TABLE}.parquet\"\n",
    "QUARANTINE_PARQUET_FINAL = final_parquet_dir / f\"{QUARANTINE_TABLE}.parquet\"\n",
    "METADATA_JSON_PATH = OUTPUT_DIR / \"07_dataset_metadata_fair.json\"\n",
    "STAGE_5_DELTA_CSV_PATH = OUTPUT_DIR / \"05_perbandingan_kualitas_sebelum_sesudah_etl.csv\"\n",
    "\n",
    "# Daftar 41 kolom aktif pada Clean DB sesuai Tabel 4.13 Bab IV\n",
    "CLEAN_41_COLUMNS_ORDER = [\n",
    "    # 1-4: Identitas\n",
    "    \"gbifID\", \"occurrenceID\", \"basisOfRecord\", \"occurrenceStatus\",\n",
    "    # 5-10: Provenansi\n",
    "    \"datasetKey\", \"institutionCode\", \"collectionCode\", \"catalogNumber\", \"recordedBy\", \"publisher\",\n",
    "    # 11-13: Temporal\n",
    "    \"eventDate\", \"year\", \"month\",\n",
    "    # 14-18: Spasial\n",
    "    \"countryCode\", \"stateProvince\", \"decimalLatitude\", \"decimalLongitude\", \"hasGeospatialIssues\",\n",
    "    # 19-27: Taksonomi\n",
    "    \"scientificName\", \"verbatimScientificName\", \"taxonKey\", \"acceptedTaxonKey\",\n",
    "    \"taxonomicStatus\", \"taxonRank\", \"family\", \"genus\", \"species\",\n",
    "    # 28: ETL Sumber\n",
    "    \"license\",\n",
    "    # 29-31: ETL Temporal\n",
    "    \"verbatimEventDateRaw\", \"eventDateParseStatus\", \"vmt_validation_detail\",\n",
    "    # 32-35: ETL Taksonomi\n",
    "    \"matchType\", \"matchedRank\", \"matchedStatus\", \"taxonomicMatchCategory\",\n",
    "    # 36-39: ETL Spasial\n",
    "    \"distanceToIndonesiaLandKm\", \"spatialHabitatStatus\", \"spatialHabitatSupportKm\", \"spatial_validation_detail\",\n",
    "    # 40-41: Validasi & Routing\n",
    "    \"status_metadata_temporal\", \"record_routing_status\",\n",
    "]\n",
    "\n",
    "\n",
    "def sql_path(p: Path) -> str:\n",
    "    return p.as_posix().replace(\"'\", \"''\")\n",
    "\n",
    "\n",
    "def compute_sha256(file_path: Path) -> str:\n",
    "    h = hashlib.sha256()\n",
    "    with open(file_path, \"rb\") as f:\n",
    "        for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n",
    "            h.update(chunk)\n",
    "    return h.hexdigest()\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. SINKRONISASI 41 KOLOM PADA CLEAN DB & PARQUET FINAL (SESUAI TABEL 4.13)\n",
    "# ==============================================================================\n",
    "if APPLY_41_CLEAN_COLUMNS and CLEAN_DB_PATH.exists():\n",
    "    with duckdb.connect(str(CLEAN_DB_PATH)) as con:\n",
    "        existing_cols = [r[0] for r in con.execute(f'DESCRIBE \"{CLEAN_TABLE}\"').fetchall()]\n",
    "        target_cols = [c for c in CLEAN_41_COLUMNS_ORDER if c in existing_cols]\n",
    "        if len(existing_cols) != len(target_cols) or existing_cols != target_cols:\n",
    "            print(f\"[Tahap 6 Sync] Menyesuaikan {CLEAN_TABLE} dari {len(existing_cols)} kolom menjadi {len(target_cols)} kolom bersih...\")\n",
    "            col_expr = \", \".join(f'\"{c}\"' for c in target_cols)\n",
    "            con.execute(f'CREATE OR REPLACE TABLE \"{CLEAN_TABLE}_tmp\" AS SELECT {col_expr} FROM \"{CLEAN_TABLE}\"')\n",
    "            con.execute(f'DROP TABLE \"{CLEAN_TABLE}\"')\n",
    "            con.execute(f'ALTER TABLE \"{CLEAN_TABLE}_tmp\" RENAME TO \"{CLEAN_TABLE}\"')\n",
    "            con.execute(f\"CREATE OR REPLACE VIEW v_clean_only AS SELECT * FROM \\\"{CLEAN_TABLE}\\\" WHERE record_routing_status = 'Clean'\")\n",
    "            con.execute(f\"CREATE OR REPLACE VIEW v_warning_only AS SELECT * FROM \\\"{CLEAN_TABLE}\\\" WHERE record_routing_status = 'Warning'\")\n",
    "\n",
    "            # Perbarui kamus data (data_dictionary) agar berisi 41 kolom sesuai urutan Tabel 4.13\n",
    "            existing_tables = {r[0] for r in con.execute(\"SELECT table_name FROM information_schema.tables WHERE table_schema='main'\").fetchall()}\n",
    "            if \"data_dictionary\" in existing_tables:\n",
    "                con.execute(f\"\"\"\n",
    "                    CREATE OR REPLACE TABLE data_dictionary_tmp AS\n",
    "                    SELECT ROW_NUMBER() OVER () AS no, kelompok, atribut, tipe_data_duckdb, fungsi, catatan_etl, sumber\n",
    "                    FROM data_dictionary\n",
    "                    WHERE atribut IN ({\", \".join(\"'\" + c + \"'\" for c in target_cols)})\n",
    "                \"\"\")\n",
    "                con.execute(\"DROP TABLE data_dictionary\")\n",
    "                con.execute(\"ALTER TABLE data_dictionary_tmp RENAME TO data_dictionary\")\n",
    "\n",
    "            if CLEAN_PARQUET_FINAL.exists():\n",
    "                CLEAN_PARQUET_FINAL.unlink()\n",
    "            con.execute(\n",
    "                f\"COPY \\\"{CLEAN_TABLE}\\\" TO '{sql_path(CLEAN_PARQUET_FINAL)}' (FORMAT PARQUET, COMPRESSION ZSTD, ROW_GROUP_SIZE 122880)\"\n",
    "            )\n",
    "            con.execute(\"CHECKPOINT\")\n",
    "            con.execute(\"VACUUM\")\n",
    "            print(\n",
    "                f\"[Tahap 6 Sync] Selesai: {CLEAN_DB_PATH.name} ({CLEAN_DB_PATH.stat().st_size / 1024 / 1024:.2f} MB) | \"\n",
    "                f\"{CLEAN_PARQUET_FINAL.name} ({CLEAN_PARQUET_FINAL.stat().st_size / 1024 / 1024:.2f} MB)\"\n",
    "            )\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. FUNGSI OTOMATIS INISIALISASI GIT, .GITIGNORE, COMMIT, & PUSH KE GITHUB\n",
    "# ==============================================================================\n",
    "def push_project_to_github(project_dir: Path, repo_url: str, token: str = \"\") -> dict:\n",
    "    clean_url = repo_url.strip().rstrip(\"/\")\n",
    "    if clean_url.endswith(\".git\"):\n",
    "        clean_url = clean_url[:-4]\n",
    "\n",
    "    if not clean_url or \"USERNAME_ANDA\" in clean_url:\n",
    "        raise ValueError(\n",
    "            \"Silakan ganti GITHUB_REPO_URL terlebih dahulu dengan URL repositori GitHub Anda \"\n",
    "            \"(contoh: 'https://github.com/radityasajid/etl-fair-aves-indonesia').\"\n",
    "        )\n",
    "\n",
    "    # 1. Buat .gitignore agar file mentah/perantara yang besar tidak menggagalkan git push (batas GitHub 100 MB/file)\n",
    "    gitignore_lines = [\n",
    "        \"# Abaikan file CSV mentah dan Parquet perantara Tahap 1-5 agar tidak melebihi batas 100 MB GitHub\",\n",
    "        \"*.csv\",\n",
    "        \"!output/*.csv\",\n",
    "        \"*.zip\",\n",
    "        \"output/raw_aves_indonesia.parquet\",\n",
    "        \"output/harmonized_aves_indonesia.parquet\",\n",
    "        \"output/normalized_taxonomy_aves_indonesia.parquet\",\n",
    "        \"output/clean_set_aves_indonesia.parquet\",\n",
    "        \"output/quarantine_store_aves_indonesia.parquet\",\n",
    "        \"*.wal\",\n",
    "        \"*.tmp\",\n",
    "        \"__pycache__/\",\n",
    "        \".ipynb_checkpoints/\",\n",
    "    ]\n",
    "\n",
    "    # Cek otomatis file di dalam output/ yang ukurannya > 95 MB agar tidak ditolak server GitHub\n",
    "    for f in project_dir.rglob(\"*\"):\n",
    "        if f.is_file() and \".git\" not in f.parts:\n",
    "            size_mb = f.stat().st_size / (1024 * 1024)\n",
    "            if size_mb > MAX_GITHUB_FILE_MB:\n",
    "                rel_path = f.relative_to(project_dir).as_posix()\n",
    "                if rel_path not in gitignore_lines:\n",
    "                    print(f\"[Info Git] Mengabaikan file >{MAX_GITHUB_FILE_MB:.0f} MB di .gitignore agar push tidak gagal: {rel_path} ({size_mb:.2f} MB)\")\n",
    "                    gitignore_lines.append(rel_path)\n",
    "\n",
    "    (project_dir / \".gitignore\").write_text(\"\\n\".join(gitignore_lines) + \"\\n\", encoding=\"utf-8\")\n",
    "\n",
    "    # 2. Buat README.md standar repositori dataset penelitian\n",
    "    readme_content = f\"\"\"# Pipeline ETL Berbasis FAIR untuk Integrasi Data Biodiversitas dari GBIF: Studi Kasus Aves Indonesia\n",
    "\n",
    "Repositori ini memuat skrip *pipeline* ETL (*Extract, Transform, Load*), kamus data, dokumen metadata berstandar **FAIR**, serta keluaran akhir basis data **DuckDB** dan **Apache Parquet** untuk penelitian skripsi:\n",
    "\n",
    "- **Judul**: *Rancang Bangun Pipeline ETL Berbasis FAIR untuk Integrasi Data Biodiversitas dari GBIF: Studi Kasus Aves Indonesia*\n",
    "- **Peneliti**: Raditya Sajid (Program Studi S1 Sains Data, Departemen Statistika, FMIPA Universitas Brawijaya)\n",
    "- **Sumber Data**: Global Biodiversity Information Facility (GBIF) — Kelas *Aves* di Indonesia (`https://doi.org/10.15468/dl.w5dmpc`)\n",
    "- **Otoritas Taksonomi**: *Catalogue of Life eXtended Release* (`checklistKey = {COL_CHECKLIST_KEY}`)\n",
    "- **Total Data Diproses**: `1.551.741` *record* (`1.501.875` *Clean Set* | `49.866` *Quarantine Store*)\n",
    "\n",
    "## Struktur Keluaran Utama (`output/`)\n",
    "- `final_parquet/occurrence_clean.parquet`: Dataset bersih berformat *Apache Parquet* (41 kolom aktif).\n",
    "- `final_parquet/occurrence_quarantine.parquet`: Dataset karantina berformat *Apache Parquet* (55 kolom aktif).\n",
    "- `db/clean_store_aves_indonesia.duckdb`: Basis data analitik *DuckDB* untuk *Clean Set*.\n",
    "- `db/quarantine_store_aves_indonesia.duckdb`: Basis data analitik *DuckDB* untuk *Quarantine Store*.\n",
    "- `07_dataset_metadata_fair.json`: Dokumen metadata deskriptif, lisensi, dan provenansi berstandar FAIR.\n",
    "- `07_tabel_2_10_evaluasi_indikator_fair.csv`: Hasil penilaian otomatis 12 indikator *RDA FAIR Data Maturity Model*.\n",
    "\"\"\"\n",
    "    (project_dir / \"README.md\").write_text(readme_content, encoding=\"utf-8\")\n",
    "\n",
    "    # 3. Jalankan perintah Git di dalam PROJECT_DIR\n",
    "    def run_git(args: list[str], check: bool = True) -> subprocess.CompletedProcess:\n",
    "        return subprocess.run(\n",
    "            [\"git\", \"-C\", str(project_dir)] + args,\n",
    "            text=True,\n",
    "            capture_output=True,\n",
    "            check=check,\n",
    "        )\n",
    "\n",
    "    if not (project_dir / \".git\").exists():\n",
    "        print(\"[Git] Menginisialisasi repositori Git lokal...\")\n",
    "        run_git([\"init\"])\n",
    "\n",
    "    # Konfigurasi buffer HTTP besar (500 MB) agar upload Parquet/DuckDB stabil\n",
    "    run_git([\"config\", \"http.postBuffer\", \"524288000\"], check=False)\n",
    "    run_git([\"branch\", \"-M\", \"main\"], check=False)\n",
    "\n",
    "    # Pastikan user.name dan user.email terisi di Git lokal\n",
    "    name_chk = run_git([\"config\", \"user.name\"], check=False).stdout.strip()\n",
    "    if not name_chk:\n",
    "        run_git([\"config\", \"user.name\", \"Raditya Sajid\"], check=False)\n",
    "    email_chk = run_git([\"config\", \"user.email\"], check=False).stdout.strip()\n",
    "    if not email_chk:\n",
    "        run_git([\"config\", \"user.email\", \"radityasajid@student.ub.ac.id\"], check=False)\n",
    "\n",
    "    # Atur remote origin\n",
    "    push_url = f\"{clean_url}.git\"\n",
    "    if token.strip() and \"github.com/\" in clean_url:\n",
    "        repo_part = clean_url.split(\"github.com/\", 1)[1]\n",
    "        push_url = f\"https://{token.strip()}@github.com/{repo_part}.git\"\n",
    "\n",
    "    rem_chk = run_git([\"remote\"], check=False).stdout.split()\n",
    "    if \"origin\" in rem_chk:\n",
    "        run_git([\"remote\", \"set-url\", \"origin\", push_url])\n",
    "    else:\n",
    "        run_git([\"remote\", \"add\", \"origin\", push_url])\n",
    "\n",
    "    print(\"[Git] Menambahkan berkas ke staging area (git add)...\")\n",
    "    run_git([\"add\", \".\"])\n",
    "\n",
    "    status_out = run_git([\"status\", \"--porcelain\"], check=False).stdout.strip()\n",
    "    if status_out:\n",
    "        print(\"[Git] Membuat commit lokal...\")\n",
    "        run_git([\"commit\", \"-m\", \"Unggah keluaran pipeline ETL Aves Indonesia dan metadata evaluasi FAIR\"])\n",
    "    else:\n",
    "        print(\"[Git] Tidak ada perubahan baru yang belum di-commit.\")\n",
    "\n",
    "    print(f\"[Git] Mengunggah (git push) ke {clean_url} ...\")\n",
    "    push_res = run_git([\"push\", \"-u\", \"origin\", \"main\", \"--force\"], check=False)\n",
    "    if push_res.returncode != 0:\n",
    "        raise RuntimeError(\n",
    "            f\"Gagal melakukan git push:\\n{push_res.stderr}\\n\"\n",
    "            \"Pastikan:\\n\"\n",
    "            \"1. Repositori sudah dibuat di https://github.com/new dan berstatus Public.\\n\"\n",
    "            \"2. URL pada GITHUB_REPO_URL sudah benar.\\n\"\n",
    "            \"3. Akun Git di Windows Anda memiliki akses push (atau isi GITHUB_PERSONAL_ACCESS_TOKEN).\"\n",
    "        )\n",
    "\n",
    "    # Kembalikan URL remote origin ke URL bersih tanpa token agar aman di metadata\n",
    "    if token.strip():\n",
    "        run_git([\"remote\", \"set-url\", \"origin\", f\"{clean_url}.git\"], check=False)\n",
    "\n",
    "    sha = run_git([\"rev-parse\", \"HEAD\"], check=False).stdout.strip()\n",
    "    print(f\"[Git] Berhasil diunggah ke GitHub! Commit SHA: {sha[:10]}\")\n",
    "    return {\"github_https_url\": clean_url, \"commit_sha\": sha}\n",
    "\n",
    "\n",
    "# Jalankan proses upload ke GitHub\n",
    "git_push_info = push_project_to_github(PROJECT_DIR, GITHUB_REPO_URL, GITHUB_PERSONAL_ACCESS_TOKEN)\n",
    "\n",
    "# Selanjutnya, jalankan kembali sel Evaluasi Tahap 7 Anda (atau set GITHUB_REPO_URL_MANUAL = GITHUB_REPO_URL di Sel Tahap 7)\n",
    "# lalu lakukan 1 kali commit & push tambahan jika file 07_dataset_metadata_fair.json diperbarui:\n",
    "print(\"\\n\" + \"=\" * 95)\n",
    "print(\"LANGKAH SELANJUTNYA DI JUPYTER NOTEBOOK:\")\n",
    "print(\"1. Pada sel Tahap 7, pastikan GITHUB_REPO_URL_MANUAL = \\\"\" + git_push_info[\"github_https_url\"] + \"\\\"\")\n",
    "print(\"2. Jalankan sel Tahap 7. Sekarang indikator A1 dan A1.1 akan bernilai 1.0 (100,00%)\")\n",
    "print(\"   dan Overall FAIR Score otomatis menjadi 1.0000 (100,00%).\")\n",
    "print(\"=\" * 95)"
   ]
  }
