   "source": [
    "import gc\n",
    "import os\n",
    "import re\n",
    "import subprocess\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "try:\n",
    "    import duckdb\n",
    "except ImportError:\n",
    "    print(\"Menginstal library duckdb...\")\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"duckdb\", \"-q\"])\n",
    "    import duckdb\n",
    "\n",
    "# Bersihkan koneksi DuckDB yang mungkin masih terbuka di sesi Jupyter Notebook\n",
    "for _name, _val in list(globals().items()):\n",
    "    if isinstance(_val, duckdb.DuckDBPyConnection):\n",
    "        try:\n",
    "            _val.close()\n",
    "        except Exception:\n",
    "            pass\n",
    "for _obj in gc.get_objects():\n",
    "    try:\n",
    "        if isinstance(_obj, duckdb.DuckDBPyConnection):\n",
    "            _obj.close()\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. KONFIGURASI DIREKTORI DATABASE DUCKDB & PARQUET FINAL (HASIL TAHAP 6)\n",
    "# ==============================================================================\n",
    "OUTPUT_DIR = r\"C:\\Users\\radit\\Skripsi\\ETL\\output\"\n",
    "\n",
    "out_dir = Path(OUTPUT_DIR)\n",
    "db_dir = out_dir / \"db\"\n",
    "final_parquet_dir = out_dir / \"final_parquet\"\n",
    "\n",
    "CLEAN_DB_PATH = db_dir / \"clean_store_aves_indonesia.duckdb\"\n",
    "QUARANTINE_DB_PATH = db_dir / \"quarantine_store_aves_indonesia.duckdb\"\n",
    "CLEAN_TABLE = \"occurrence_clean\"\n",
    "QUARANTINE_TABLE = \"occurrence_quarantine\"\n",
    "\n",
    "CLEAN_PARQUET_PATH = final_parquet_dir / f\"{CLEAN_TABLE}.parquet\"\n",
    "QUARANTINE_PARQUET_PATH = final_parquet_dir / f\"{QUARANTINE_TABLE}.parquet\"\n",
    "\n",
    "# Nama alias saat database dipasang (ATTACH) pada satu koneksi\n",
    "CLEAN_ALIAS = \"clean_db\"\n",
    "QUARANTINE_ALIAS = \"quarantine_db\"\n",
    "\n",
    "for _db in (CLEAN_DB_PATH, QUARANTINE_DB_PATH):\n",
    "    if not _db.exists():\n",
    "        raise FileNotFoundError(f\"Database {_db} belum ditemukan. Jalankan skrip Tahap 6 terlebih dahulu.\")\n",
    "\n",
    "pd.set_option(\"display.max_columns\", None)\n",
    "pd.set_option(\"display.width\", 140)\n",
    "pd.set_option(\"display.max_colwidth\", 65)\n",
    "\n",
    "\n",
    "def fmt(n) -> str:\n",
    "    return f\"{int(n):,}\"\n",
    "\n",
    "\n",
    "def size_mb(p: Path) -> float:\n",
    "    return p.stat().st_size / 1024 / 1024 if p.exists() else 0.0\n",
    "\n",
    "\n",
    "def sql_path(p: Path) -> str:\n",
    "    return p.as_posix().replace(\"'\", \"''\")\n",
    "\n",
    "\n",
    "def query_df(con, sql: str) -> pd.DataFrame:\n",
    "    cur = con.execute(sql)\n",
    "    cols = [d[0] for d in cur.description]\n",
    "    return pd.DataFrame(cur.fetchall(), columns=cols)\n",
    "\n",
    "\n",
    "def attach_db_safe(con, db_path: Path, alias: str) -> None:\n",
    "    \"\"\"Pasang database dalam mode baca-saja (dengan fallback otomatis bila koneksi masih berada di proses yang sama).\"\"\"\n",
    "    p_str = sql_path(db_path)\n",
    "    try:\n",
    "        con.execute(f\"ATTACH '{p_str}' AS {alias} (READ_ONLY)\")\n",
    "        return\n",
    "    except Exception as e_ro:\n",
    "        # Fallback tanpa READ_ONLY jika masih ada konfigurasi koneksi di proses yang sama\n",
    "        try:\n",
    "            con.execute(f\"ATTACH '{p_str}' AS {alias}\")\n",
    "            return\n",
    "        except Exception:\n",
    "            text = str(e_ro)\n",
    "            lowered = text.lower()\n",
    "            is_lock_error = any(k in lowered for k in (\"another process\", \"already open\", \"could not set lock\", \"conflicting lock\"))\n",
    "            if not is_lock_error:\n",
    "                raise e_ro\n",
    "            m = re.search(r\"PID\\s+(\\d+)\", text)\n",
    "            locked_pid = int(m.group(1)) if m else None\n",
    "            if locked_pid == os.getpid():\n",
    "                sebab = (\n",
    "                    f\"File ini masih dibuka oleh kernel/proses INI sendiri (PID {locked_pid}).\\n\"\n",
    "                    \"Solusi: jalankan Restart Kernel pada notebook ini, lalu jalankan sel ini lagi.\"\n",
    "                )\n",
    "            else:\n",
    "                sebab = (\n",
    "                    f\"File ini sedang dibuka oleh proses lain (PID {locked_pid}).\\n\"\n",
    "                    \"Kemungkinan: notebook/kernel lain atau aplikasi eksternal (DBeaver, DuckDB CLI, VS Code).\\n\"\n",
    "                    f\"Solusi: tutup aplikasi tersebut atau cek proses dengan: tasklist /FI \\\"PID eq {locked_pid}\\\"\"\n",
    "                )\n",
    "            raise RuntimeError(f\"Tidak bisa membuka {db_path.name}.\\n{sebab}\") from None\n",
    "\n",
    "\n",
    "def list_objects(con, alias: str) -> list[tuple[str, str]]:\n",
    "    \"\"\"Daftar (nama, jenis) seluruh tabel dan view pada database yang dipasang.\"\"\"\n",
    "    rows = con.execute(\n",
    "        f\"\"\"\n",
    "        SELECT table_name, table_type\n",
    "        FROM information_schema.tables\n",
    "        WHERE table_catalog = '{alias}' AND table_schema = 'main'\n",
    "        ORDER BY CASE WHEN table_type = 'BASE TABLE' THEN 1 ELSE 2 END, table_name\n",
    "        \"\"\"\n",
    "    ).fetchall()\n",
    "    return [(r[0], r[1]) for r in rows]\n",
    "\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. INSPEKSI KATALOG DUCKDB, STRUKTUR PARQUET, & CONTOH KUERI SQL ANALITIK\n",
    "# ==============================================================================\n",
    "db_list = [\n",
    "    (\"CLEAN DB\", CLEAN_DB_PATH, CLEAN_PARQUET_PATH, CLEAN_ALIAS, CLEAN_TABLE),\n",
    "    (\"QUARANTINE DB\", QUARANTINE_DB_PATH, QUARANTINE_PARQUET_PATH, QUARANTINE_ALIAS, QUARANTINE_TABLE),\n",
    "]\n",
    "\n",
    "con = duckdb.connect(\":memory:\")\n",
    "try:\n",
    "    for _label, _path, _pq_path, _alias, _tbl in db_list:\n",
    "        attach_db_safe(con, _path, _alias)\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    print(\"=\" * 100)\n",
    "    print(\"1. RINGKASAN DATABASE DUCKDB & FILE PARQUET FINAL HASIL TAHAP 6\")\n",
    "    print(\"=\" * 100)\n",
    "    info_rows = []\n",
    "    for label, path, pq_path, alias, main_tbl in db_list:\n",
    "        n_main = con.execute(f'SELECT COUNT(*) FROM {alias}.main.\"{main_tbl}\"').fetchall()[0][0]\n",
    "        n_cols = len(con.execute(f'DESCRIBE SELECT * FROM {alias}.main.\"{main_tbl}\"').fetchall())\n",
    "        n_pq = (\n",
    "            con.execute(f\"SELECT COUNT(*) FROM read_parquet('{sql_path(pq_path)}')\").fetchall()[0][0]\n",
    "            if pq_path.exists()\n",
    "            else 0\n",
    "        )\n",
    "        info_rows.append({\n",
    "            \"database\": label,\n",
    "            \"file_duckdb\": path.name,\n",
    "            \"ukuran_db_mb\": round(size_mb(path), 2),\n",
    "            \"file_parquet_final\": pq_path.name if pq_path.exists() else \"(belum ada)\",\n",
    "            \"ukuran_parquet_mb\": round(size_mb(pq_path), 2),\n",
    "            \"tabel_utama\": main_tbl,\n",
    "            \"jumlah_record\": fmt(n_main),\n",
    "            \"record_parquet\": fmt(n_pq),\n",
    "            \"jumlah_kolom\": n_cols,\n",
    "        })\n",
    "    print(pd.DataFrame(info_rows).to_string(index=False))\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    print(\"\\n\" + \"=\" * 100)\n",
    "    print(\"2. DAFTAR SELURUH TABEL & VIEW DI SETIAP DATABASE DUCKDB\")\n",
    "    print(\"=\" * 100)\n",
    "    catalog_rows = []\n",
    "    objects_by_db = {}\n",
    "    for label, path, _pq_path, alias, main_tbl in db_list:\n",
    "        objs = list_objects(con, alias)\n",
    "        objects_by_db[alias] = {name for name, _ in objs}\n",
    "        for name, ttype in objs:\n",
    "            n_rows = con.execute(f'SELECT COUNT(*) FROM {alias}.main.\"{name}\"').fetchall()[0][0]\n",
    "            cols = con.execute(f'DESCRIBE SELECT * FROM {alias}.main.\"{name}\"').fetchall()\n",
    "            preview = \", \".join(c[0] for c in cols[:5]) + (f\", ... (+{len(cols) - 5} kolom)\" if len(cols) > 5 else \"\")\n",
    "            catalog_rows.append({\n",
    "                \"database\": label,\n",
    "                \"nama_objek\": name,\n",
    "                \"jenis\": \"TABEL\" if ttype == \"BASE TABLE\" else \"VIEW\",\n",
    "                \"jumlah_baris\": fmt(n_rows),\n",
    "                \"jumlah_kolom\": len(cols),\n",
    "                \"contoh_kolom\": preview,\n",
    "            })\n",
    "    print(pd.DataFrame(catalog_rows).to_string(index=False))\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    for label, path, _pq_path, alias, main_tbl in db_list:\n",
    "        print(\"\\n\" + \"=\" * 100)\n",
    "        print(f\"3. KAMUS DATA & STRUKTUR KOLOM TABEL UTAMA {label} ({main_tbl})\")\n",
    "        print(\"=\" * 100)\n",
    "        if \"data_dictionary\" in objects_by_db[alias]:\n",
    "            print(query_df(con, f\"\"\"\n",
    "                SELECT no, kelompok, atribut, tipe_data_duckdb, fungsi, catatan_etl\n",
    "                FROM {alias}.main.data_dictionary ORDER BY no\n",
    "            \"\"\").to_string(index=False))\n",
    "        else:\n",
    "            print(query_df(con, f'DESCRIBE SELECT * FROM {alias}.main.\"{main_tbl}\"').to_string(index=False))\n",
    "\n",
    "        if \"etl_merged_columns\" in objects_by_db[alias]:\n",
    "            df_merged = query_df(con, f\"SELECT * FROM {alias}.main.etl_merged_columns\")\n",
    "            if not df_merged.empty:\n",
    "                print(f\"\\n[Info {label}] Kolom ganda yang telah disatukan ke kolom utama:\")\n",
    "                print(df_merged.to_string(index=False))\n",
    "\n",
    "    # --------------------------------------------------------------------------\n",
    "    print(\"\\n\" + \"=\" * 100)\n",
    "    print(\"4. CONTOH QUERY SQL SIAP PAKAI (DUCKDB & PARQUET)\")\n",
    "    print(\"=\" * 100)\n",
    "\n",
    "    sql_examples = [\n",
    "        (\n",
    "            \"Contoh Query 1 (Clean DB): 10 spesies Aves dengan jumlah observasi terbanyak beserta taxonKey COL XR\",\n",
    "            f\"\"\"\n",
    "SELECT scientificName AS nama_ilmiah_accepted,\n",
    "       taxonKey AS taxon_key_col,\n",
    "       family AS famili,\n",
    "       COUNT(*) AS total_observasi,\n",
    "       COUNT(DISTINCT stateProvince) AS jumlah_provinsi_sebaran\n",
    "FROM {CLEAN_ALIAS}.main.{CLEAN_TABLE}\n",
    "GROUP BY scientificName, taxonKey, family\n",
    "ORDER BY total_observasi DESC\n",
    "LIMIT 10;\n",
    "            \"\"\".strip(),\n",
    "        ),\n",
    "        (\n",
    "            \"Contoh Query 2 (Clean DB): 10 observasi berstatus 'Clean' dengan tanggal pengamatan terbaru\",\n",
    "            f\"\"\"\n",
    "SELECT gbifID,\n",
    "       scientificName,\n",
    "       taxonKey,\n",
    "       family,\n",
    "       stateProvince,\n",
    "       ROUND(decimalLatitude, 4) AS lat,\n",
    "       ROUND(decimalLongitude, 4) AS lon,\n",
    "       eventDate,\n",
    "       publisher\n",
    "FROM {CLEAN_ALIAS}.main.{CLEAN_TABLE}\n",
    "WHERE record_routing_status = 'Clean'\n",
    "  AND eventDate IS NOT NULL\n",
    "ORDER BY eventDate DESC\n",
    "LIMIT 10;\n",
    "            \"\"\".strip(),\n",
    "        ),\n",
    "        (\n",
    "            \"Contoh Query 3 (Quarantine DB): Distribusi penyebab record masuk Quarantine per dimensi kualitas\",\n",
    "            f\"\"\"\n",
    "SELECT dimensi_invalid,\n",
    "       jumlah_record\n",
    "FROM {QUARANTINE_ALIAS}.main.quarantine_reason_by_dimension\n",
    "ORDER BY jumlah_record DESC;\n",
    "            \"\"\".strip(),\n",
    "        ),\n",
    "    ]\n",
    "\n",
    "    if \"etl_before_after_summary\" in objects_by_db.get(CLEAN_ALIAS, set()):\n",
    "        sql_examples.append((\n",
    "            \"Contoh Query 4 (Clean DB): Ringkasan perbandingan kualitas data Sebelum vs Sesudah ETL (Delta X)\",\n",
    "            f\"\"\"\n",
    "SELECT Kode,\n",
    "       Dimensi_Kualitas,\n",
    "       \"Baseline_Sebelum_ETL (%)\",\n",
    "       \"Sesudah_ETL_Clean_Set (%)\",\n",
    "       \"Kenaikan_Delta_X (%)\"\n",
    "FROM {CLEAN_ALIAS}.main.etl_before_after_summary;\n",
    "            \"\"\".strip(),\n",
    "        ))\n",
    "\n",
    "    if CLEAN_PARQUET_PATH.exists():\n",
    "        sql_examples.append((\n",
    "            \"Contoh Query 5 (Direct Parquet Query): Agregasi langsung dari file occurrence_clean.parquet per Basis of Record\",\n",
    "            f\"\"\"\n",
    "SELECT basisOfRecord,\n",
    "       COUNT(*) AS jumlah_record,\n",
    "       COUNT(DISTINCT scientificName) AS jumlah_spesies_unik\n",
    "FROM read_parquet('{sql_path(CLEAN_PARQUET_PATH)}')\n",
    "GROUP BY basisOfRecord\n",
    "ORDER BY jumlah_record DESC;\n",
    "            \"\"\".strip(),\n",
    "        ))\n",
    "\n",
    "    sql_file_lines = [\n",
    "        \"-- =============================================================================\",\n",
    "        \"-- CONTOH QUERY SQL DUCKDB & PARQUET: DATASET AVES INDONESIA (CLEAN & QUARANTINE)\",\n",
    "        \"-- Jalankan di DuckDB CLI / Python setelah memasang kedua database (baca-saja):\",\n",
    "        \"-- =============================================================================\",\n",
    "        f\"ATTACH '{sql_path(CLEAN_DB_PATH)}' AS {CLEAN_ALIAS} (READ_ONLY);\",\n",
    "        f\"ATTACH '{sql_path(QUARANTINE_DB_PATH)}' AS {QUARANTINE_ALIAS} (READ_ONLY);\",\n",
    "        \"\",\n",
    "    ]\n",
    "\n",
    "    for title, sql_text in sql_examples:\n",
    "        print(\"\\n\" + \"-\" * 100)\n",
    "        print(f\"[{title}]\")\n",
    "        print(\"-\" * 100)\n",
    "        print(\"SQL:\")\n",
    "        print(sql_text)\n",
    "        print(\"\\nHasil:\")\n",
    "        df_res = query_df(con, sql_text)\n",
    "        print(df_res.to_string(index=False) if not df_res.empty else \"(Tidak ada baris)\")\n",
    "\n",
    "        sql_file_lines += [f\"-- {title}\", sql_text, \"\"]\n",
    "\n",
    "    sql_out_path = out_dir / \"06_contoh_query_duckdb.sql\"\n",
    "    sql_out_path.write_text(\"\\n\".join(sql_file_lines), encoding=\"utf-8\")\n",
    "    # Simpan juga ke nama lama agar kompatibel bila ada skrip lain yang merujuk\n",
    "    (out_dir / \"07_contoh_query_duckdb.sql\").write_text(\"\\n\".join(sql_file_lines), encoding=\"utf-8\")\n",
    "    print(\"\\n\" + \"=\" * 100)\n",
    "    print(f\"Contoh query SQL berhasil disimpan ke: {sql_out_path}\")\n",
    "    print(\"=\" * 100)\n",
    "finally:\n",
    "    con.close()   # selalu dilepas sehingga file .duckdb tidak tertahan oleh kernel ini"
   ]
